<script>
  /* Top-level visits to /pages/ninja-rewards now resolve into the
     members portal with the Ninja Rewards sidebar tab pre-selected.
     The members portal AJAX-loads page content into its pane, but
     never loads THIS template — it loads the new ninja-rewards JSON
     template via fetch. So the redirect here only ever fires for a
     direct browser visit to /pages/ninja-rewards. */
  (function () {
    try {
      var qs = window.location.search || '';
      var sep = qs ? (qs + '&') : '?';
      window.location.replace('/pages/welcome' + sep + 'tab=ninja-rewards' + window.location.hash);
    } catch (_e) { /* never block render */ }
  })();
</script>
