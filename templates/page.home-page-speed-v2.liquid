<script>
  (function() {
    class FeatureCardsauvbnauzumhj3uhordaigenblockcbc731fkkzyf4 extends HTMLElement {
      constructor() {
        super();
        this.isMobile = window.matchMedia('(max-width: 749px)').matches;
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-features-card-auvbnauzumhj3uhordaigenblockcbc731fkkzyf4');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.cards.forEach((card) => {
          const video = card.querySelector('.ai-features-card-video-auvbnauzumhj3uhordaigenblockcbc731fkkzyf4');
          
          if (this.isMobile) {
            card.addEventListener('click', () => {
              const isActive = card.classList.contains('active');
              
              this.cards.forEach((c) => {
                c.classList.remove('active');
                const v = c.querySelector('.ai-features-card-video-auvbnauzumhj3uhordaigenblockcbc731fkkzyf4');
                if (v) {
                  v.pause();
                  v.currentTime = 0;
                }
              });

              if (!isActive) {
                card.classList.add('active');
                if (video) {
                  video.play();
                }
              }
            });
          } else {
            card.addEventListener('mouseenter', () => {
              if (video) {
                video.play();
              }
            });

            card.addEventListener('mouseleave', () => {
              if (video) {
                video.pause();
                video.currentTime = 0;
              }
            });
          }
        });
      }
    }

    customElements.define('feature-cards-auvbnauzumhj3uhordaigenblockcbc731fkkzyf4', FeatureCardsauvbnauzumhj3uhordaigenblockcbc731fkkzyf4);
  })();
</script>




