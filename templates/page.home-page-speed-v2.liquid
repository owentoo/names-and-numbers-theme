}
html[dir=rtl] .css-slider:not(.css-slider--overlay-navigation) .css-slider-dot-navigation .css-slider-dot:last-child {
  border-radius: 0.625rem 0 0 0.625rem;
}
.css-slider:not(.css-slider--overlay-navigation) .css-slider-dot-navigation .css-slider-dot.active {
  background: var(--color-text-main);
}
.css-slider:not(.css-slider--overlay-navigation) .css-slider-dot-navigation .css-slider-dot.active:first-child {
