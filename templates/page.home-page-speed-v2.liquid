<script>
  (function() {
    class FeatureCardsav01kwu1ya05waxpqnaigenblockcbc731f6lwebd extends HTMLElement {
      constructor() {
        super();
        this.isMobile = window.matchMedia('(max-width: 749px)').matches;
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-features-card-av01kwu1ya05waxpqnaigenblockcbc731f6lwebd');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.cards.forEach((card) => {
          const video = card.querySelector('.ai-features-card-video-av01kwu1ya05waxpqnaigenblockcbc731f6lwebd');
          
          if (this.isMobile) {
            card.addEventListener('click', () => {
              const isActive = card.classList.contains('active');
              
              this.cards.forEach((c) => {
                c.classList.remove('active');
                const v = c.querySelector('.ai-features-card-video-av01kwu1ya05waxpqnaigenblockcbc731f6lwebd');
                if (v) {
                  v.pause();
                  v.currentTime = 0;
                }
              });

              if (!isActive) {
                card.classList.add('active');
                if (video) {
                  video.play();
                }
              }
            });
          } else {
            card.addEventListener('mouseenter', () => {
              if (video) {
                video.play();
              }
            });

            card.addEventListener('mouseleave', () => {
              if (video) {
                video.pause();
                video.currentTime = 0;
              }
            });
          }
        });
      }
    }

    customElements.define('feature-cards-av01kwu1ya05waxpqnaigenblockcbc731f6lwebd', FeatureCardsav01kwu1ya05waxpqnaigenblockcbc731f6lwebd);
