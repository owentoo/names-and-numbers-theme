  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.4),
    transparent
  );
  animation: shimmer 1.2s infinite ease-in-out;
  transition: opacity 0.4s ease;
  opacity: 1;
}
[is-loading=""]::after,
[is-loading]:not([is-loading="true"])::after {
  opacity: 0;
  animation: none;
  pointer-events: none;
}
[is-loading="true"] * {
  visibility: hidden;
}
