  {%- comment -%}
    imageReveal shim — copied verbatim from live theme.liquid (line 887 of 2026-04-27 capture).

    Background: Shopify's standard `snippets/lazy-image.liquid` snippet renders <img> tags
    wrapped in <figure class="lazy-image lazy-image--to-reveal">. The img has an inline onload
    handler calling imageReveal.observe(this.parentNode), which (when in viewport) triggers
    adding `.lazy-image--revealed` to the parent figure. CSS rule `.lazy-image--to-reveal img`
    sets opacity:0 until `.lazy-image--revealed` is added.

    Without this global, the onload handler throws ReferenceError, the revealed class is
    never added, and images stay at opacity:0 — appearing as gray placeholder boxes.

    Affected on home-v2: 4 images (3 in text_columns_images "DTF Process" + 1 in
    media-with-text-overlay facility background fallback).
  {%- endcomment -%}
  <script>
    window.imageReveal = new IntersectionObserver(
      function (entries, observer) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            setTimeout(function () {
              entry.target.classList.remove('lazy-image--to-reveal');
            }, 500);
            entry.target.classList.add('lazy-image--revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '20px 0px 0px 0px' }
    );
  </script>

