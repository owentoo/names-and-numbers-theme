    .njs-header__menu-toggle .njs-header__menu-icon-close { display: none; }
    .njs-header__menu-toggle[aria-expanded="true"] .njs-header__menu-icon-open  { display: none; }
    .njs-header__menu-toggle[aria-expanded="true"] .njs-header__menu-icon-close { display: block; }

    /* Close X button inside the slideout panel + backdrop overlay — both default
       hidden on desktop. Mobile @media block makes them visible/active. */
    .njs-header__nav-close { display: none; }
    .njs-header__backdrop  { display: none; }

    @media (max-width: 1199px) {
      .njs-header__inner { gap: 20px; }
      .njs-header__nav-list { gap: 16px; }
      .njs-header__actions { gap: 14px; }
      .njs-header__phone-label { display: none; }
      .njs-header__logo-img { height: var(--header-logo, 65px); }
    }
    @media (max-width: 767px) {
      .njs-header__inner {
        grid-template-columns: auto 1fr;
        padding: 10px 15px;
        gap: 10px;
      }
      .njs-header__actions { justify-content: flex-end; gap: 8px; }
      .njs-header__menu-toggle { display: inline-flex; }

      /* Slide-out panel (mobile drawer) — slides in from the right.
         Replaces the prior drop-down pattern (Phase 3 mobile rev 2026-04-27). */
      .njs-header__nav {
        display: block;
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(280px, 80vw);
        background: var(--color-background-header, #ffffff);
        box-shadow: -4px 0 12px rgba(0, 0, 0, 0.15);
        z-index: 1001;
        padding: 60px 0 16px;     /* room for close X at top */
        transform: translateX(100%);
        transition: transform 0.25s ease-out;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        will-change: transform;
      }
      .njs-header.njs-header--menu-open .njs-header__nav {
        transform: translateX(0);
      }

      /* Close X button inside the panel — top-right corner. */
      .njs-header__nav-close {
        display: block;
        position: absolute;
        top: 12px;
        right: 12px;
        background: transparent;
        border: 0;
        padding: 8px;
        cursor: pointer;
        color: var(--color-text-header, #000);
        line-height: 0;
      }
      .njs-header__nav-close:focus-visible {
        outline: 2px solid var(--njs-brand-blue, #0180c2);
        outline-offset: 2px;
        border-radius: 4px;
      }

      /* Nav list — vertical stack inside panel. */
      .njs-header__nav-list {
        flex-direction: column;
        gap: 0;
        align-items: stretch;
        padding: 0;
      }
      .njs-header__nav-list li {
        border-bottom: 1px solid var(--color-borders-header, rgba(0, 0, 0, 0.08));
      }
      .njs-header__nav-list li:last-child { border-bottom: 0; }
      .njs-header__nav-list a {
        display: block;
        padding: 14px 20px;
        font-size: 16px;
      }

      /* Backdrop — full-viewport dim layer behind the panel. Fades in/out
         via opacity + pointer-events to allow clean transition timing. */
      .njs-header__backdrop {
        display: block;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease-out;
      }
      body.njs-menu-open .njs-header__backdrop {
        opacity: 1;
        pointer-events: auto;
      }

      .njs-header__rewards { display: none; }
      .njs-header__phone-number { font-size: 13px; }
      .njs-header__signin-text { display: none; }
      .njs-header__signin {
        padding: 8px;
        border-radius: 7px;
      }
      .njs-header__logo-img { height: var(--header-logo, 44px); }
    }

    /* ---- Footer (home-v2 fast) ---- */
    .njs-footer {
      background: var(--color-background-footer, #000000);
      color: var(--color-text-footer, #b9b9b9);
      font-family: var(--font-stack-body-primary, 'Inter', sans-serif);
      font-size: 14px;
      line-height: 1.6;
    }
    .njs-footer a {
      color: inherit;
      text-decoration: none;
      transition: color 0.15s ease;
    }
    .njs-footer a:hover { color: #ffffff; }
    .njs-footer a:focus-visible {
      outline: 2px solid var(--njs-brand-blue, #0180c2);
      outline-offset: 2px;
      border-radius: 2px;
    }
    .njs-footer__main { padding: 48px 0 32px; }
    .njs-footer__inner {
      max-width: var(--theme-max-width, 1400px);
      margin: 0 auto;
      padding: 0 var(--gutter-container, 40px);
      display: grid;
      grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
      gap: 40px;
    }
    .njs-footer__brand { display: flex; flex-direction: column; gap: 16px; }
    .njs-footer__logo-img {
      height: 36px;
      width: auto;
      display: block;
    }
    .njs-footer__tagline {
      margin: 0;
      font-size: 14px;
      line-height: 1.55;
      max-width: 32ch;
    }
    .njs-footer__contact {
      margin: 0;
      font-style: normal;
      font-size: 13px;
      line-height: 1.7;
    }
    .njs-footer__phone {
      font-weight: var(--font-weight-body-primary-bold, 600);
      color: #ffffff;
    }
    .njs-footer__social {
      list-style: none;
      margin: 8px 0 0;
      padding: 0;
      display: flex;
      gap: 14px;
    }
    .njs-footer__social a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
      color: var(--color-text-footer, #b9b9b9);
    }
    .njs-footer__social a:hover {
      background: var(--njs-brand-blue, #0180c2);
      color: #ffffff;
    }
    .njs-footer__social svg { display: block; }
    .njs-footer__heading {
      margin: 0 0 16px;
      font-size: 14px;
      font-weight: var(--font-weight-body-primary-bold, 600);
      color: #ffffff;
      text-transform: none;
      letter-spacing: 0.01em;
    }
    .njs-footer__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
      font-size: 13px;
    }
    .njs-footer__bottom {
      border-top: 1px solid var(--color-borders-footer, rgba(185, 185, 185, 0.15));
      padding: 20px 0;
    }
    .njs-footer__inner--bottom {
      display: block;
      text-align: center;
    }
    .njs-footer__copy {
      margin: 0;
      font-size: 12px;
      color: var(--color-text-footer, #b9b9b9);
    }

    @media (max-width: 1023px) {
      .njs-footer__inner {
        grid-template-columns: 1fr 1fr;
        gap: 32px;
      }
      .njs-footer__brand { grid-column: 1 / -1; }
    }
    @media (max-width: 767px) {
      .njs-footer__main { padding: 32px 0 24px; }
      .njs-footer__inner {
        grid-template-columns: 1fr;
        gap: 28px;
        padding: 0 15px;
      }
      .njs-footer__brand { gap: 12px; }
      .njs-footer__tagline { max-width: none; }
      .njs-footer__heading { margin-bottom: 12px; }
      .njs-footer__list { font-size: 14px; gap: 12px; }
    }
  </style>
</head>

