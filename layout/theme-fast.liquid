  {%- comment -%} Slideout drawer backdrop — sibling of header so it covers the
  whole viewport behind the panel without being clipped by header overflow.
  Visibility/animation controlled by `body.njs-menu-open` class (toggled by JS). {%- endcomment -%}
  <div class="njs-header__backdrop" aria-hidden="true"></div>

  {%- comment -%} Mobile hamburger menu toggle (Phase 3 mobile fix — 2026-04-27).
  Replaces the prior horizontal-scroll mobile nav. Toggles .njs-header--menu-open on
  <header> and .njs-menu-open on <body> (latter prevents background scroll while drawer
  open). Closes on outside click, Escape key, or nav link click. {%- endcomment -%}
  <script>
    (function () {
      var header = document.querySelector('.njs-header');
      var toggle = document.querySelector('.njs-header__menu-toggle');
      var nav = document.getElementById('njs-header-nav');
      var navClose = document.querySelector('.njs-header__nav-close');
      var backdrop = document.querySelector('.njs-header__backdrop');
      if (!header || !toggle || !nav) return;

      function setOpen(isOpen) {
        header.classList.toggle('njs-header--menu-open', isOpen);
        document.body.classList.toggle('njs-menu-open', isOpen);
        toggle.setAttribute('aria-expanded', String(isOpen));
      }

      toggle.addEventListener('click', function (e) {
        e.stopPropagation();
        e.preventDefault();
        setOpen(!header.classList.contains('njs-header--menu-open'));
      });

      // Close X button inside the slideout panel
      if (navClose) {
        navClose.addEventListener('click', function (e) {
          e.stopPropagation();
          setOpen(false);
        });
      }

      // Backdrop click closes menu
      if (backdrop) {
        backdrop.addEventListener('click', function () {
          setOpen(false);
        });
      }

      // Click outside header AND outside the slideout nav closes menu.
      // Backdrop has its own handler above; this catches taps that miss
      // both header and nav (e.g. on the body before the backdrop renders).
      document.addEventListener('click', function (e) {
        if (header.classList.contains('njs-header--menu-open') &&
            !header.contains(e.target) &&
            !nav.contains(e.target)) {
          setOpen(false);
        }
      });

      // Escape key closes menu
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && header.classList.contains('njs-header--menu-open')) {
          setOpen(false);
          toggle.focus();
        }
      });

      // Nav link click closes menu (so navigating same-tab feels right)
      nav.addEventListener('click', function (e) {
        if (e.target.closest('a')) setOpen(false);
      });
    })();
  </script>

