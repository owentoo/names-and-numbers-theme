        {%- if pk == 'upload (vector files preferred)' and li_detail_img == '' -%}{%- assign li_detail_img = p.last -%}{%- endif -%}
        {%- if pk == 'preview gang sheet (low res)' and li_detail_img == '' -%}{%- assign li_detail_img = p.last -%}{%- endif -%}
        {%- if pk == 'width' and p.last != blank -%}{%- assign dj_width = p.last -%}{%- endif -%}
        {%- if pk == 'height' and p.last != blank -%}{%- assign dj_height = p.last -%}{%- endif -%}
      {%- endfor -%}
      {%- if li.image -%}{%- assign li_detail_fallback = li.image | image_url: width: 160 -%}
      {%- elsif li.product.featured_image -%}{%- assign li_detail_fallback = li.product.featured_image | image_url: width: 160 -%}{%- endif -%}
      {%- if li_detail_img == '' -%}{%- assign li_detail_img = li_detail_fallback -%}{%- endif -%}
      "image_url": {{ li_detail_img | json }},
      "fallback_url": {{ li_detail_fallback | json }},
      "width": {{ dj_width | json }},
      "height": {{ dj_height | json }},
      "properties": [
        {%- assign od_prop_count = 0 -%}
        {%- for p in li.properties -%}
          {%- assign pk_char = p.first | slice: 0 -%}
          {%- assign pk_full = p.first | downcase | strip -%}
          {%- if pk_char != '_' and p.last != blank -%}
            {%- unless dj_is_style and pk_full == 'width' -%}
              {%- unless dj_is_style and pk_full == 'height' -%}
                {%- unless pk_full == 'upload (vector files preferred)' -%}
                  {%- if od_prop_count > 0 -%},{%- endif -%}
                  { "key": {{ p.first | json }}, "value": {{ p.last | truncate: 80 | json }} }
                  {%- assign od_prop_count = od_prop_count | plus: 1 -%}
                {%- endunless -%}
              {%- endunless -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      ],
      "fulfillment": {
        {%- if li.fulfillment -%}
        "status": "fulfilled",
        "tracking_number": {{ li.fulfillment.tracking_number | default: '' | json }},
        "tracking_url": {{ li.fulfillment.tracking_url | default: '' | json }},
        "tracking_company": {{ li.fulfillment.tracking_company | default: '' | json }},
        "shipment_status": {{ li.fulfillment.shipment_status | default: '' | json }},
        "created_at": {{ li.fulfillment.created_at | date: "%b %-d, %Y" | json }}
        {%- else -%}
        "status": "unfulfilled"
        {%- endif -%}
      }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
{%- endcapture -%}
<script type="application/json" class="od-detail-data" data-order="{{ order.name | handleize }}">{{ detail_json | strip_newlines }}</script>

{%- comment -%} Merged: 6 variant captures into single pass {%- endcomment -%}
{%- assign variant_ids = '' -%}
{%- assign line_item_ids = '' -%}
{%- assign variant_quantities = '' -%}
{%- assign variant_inventories = '' -%}
{%- assign variant_inv_policies = '' -%}
{%- assign variant_inv_trackers = '' -%}
{%- for li in order.line_items -%}
  {%- assign variant_ids = variant_ids | append: li.variant_id | append: ',' -%}
  {%- assign line_item_ids = line_item_ids | append: li.id | append: ',' -%}
  {%- assign variant_quantities = variant_quantities | append: li.quantity | append: ',' -%}
  {%- assign variant_inventories = variant_inventories | append: li.variant.inventory_quantity | append: ',' -%}
  {%- assign variant_inv_policies = variant_inv_policies | append: li.variant.inventory_policy | append: ',' -%}
  {%- assign variant_inv_trackers = variant_inv_trackers | append: li.variant.inventory_management | append: ',' -%}
{%- endfor -%}

  {%- comment -%} Desktop row {%- endcomment -%}
  <div class="ao-order-row{% if line_count > 1 %} ao-has-items{% endif %}" data-order-id="{{ order.name | handleize }}" data-created="{{ order.created_at | date: '%s' }}" data-status="{{ fulfillment_label | handleize }}" data-search="{{ search_blob | strip_html | strip_newlines | downcase | escape }}">
    <div class="all-orders__row"{% if line_count > 1 %} data-toggle-order="{{ order.name | handleize }}"{% endif %}>
    <div class="all-orders__col all-orders__col--order">
      <div class="all-orders__order-name-row">
        <a href="#" class="all-orders__order-name-link ao-view-details-btn" data-order-handle="{{ order.name | handleize }}">{{ order.name }}</a>
        {{ trackings_html_desktop }}
      </div>
      <div class="all-orders__order-date">{{ order.created_at | date: "%b %-d, %Y" }}</div>
      <div class="all-orders__order-product">{{ product_name }}</div>
      <div class="all-orders__order-desc">{{ item_desc }}{%- if line_count > 1 -%} &mdash; <button type="button" class="ao-expand-btn" style="display:inline;background:none;border:none;outline:none;font-size:inherit;font-weight:600;color:#019AFF;padding:0;margin:0;cursor:pointer;font-family:inherit;-webkit-appearance:none;appearance:none;" data-toggle-order="{{ order.name | handleize }}" onclick="event.stopPropagation(); if(window.__aoToggle) window.__aoToggle(this.getAttribute('data-toggle-order'))">view all <span class="ao-arrow">↓</span></button>{%- endif -%}</div>
      {%- if order_nickname != blank -%}
        <div class="all-orders__order-nickname"><span class="all-orders__nickname-label">Order Nickname:</span> <span class="all-orders__nickname-value">{{ order_nickname }}</span></div>
      {%- endif -%}
      {%- assign ao_toggle_value_d = order.name | handleize -%}
      {% render 'order-thumb-strip', order: order, line_count: line_count, toggle_value: ao_toggle_value_d, toggle_attr: 'data-toggle-order' %}
    </div>
    <div class="all-orders__col all-orders__col--status">
      {%- if is_reprint -%}<span class="ao-reprint-label">{{ reprint_label_text }}</span>{%- endif -%}
      <span class="ao-status {{ badge_class }}">
        {%- unless order.cancelled -%}
        <span class="ao-status-icon">
          {%- if fulfillment == "fulfilled" -%}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          {%- elsif fulfillment_label == "Artwork Blocked" -%}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          {%- else -%}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {%- endif -%}
        </span>
        {%- endunless -%}
        {{ fulfillment_label }}
      </span>
      {%- if fulfillment_label == "Artwork Blocked" -%}
        <span class="ao-blocked-msg">please call us<br><a href="tel:8883563665">888-356-3665</a></span>
      {%- endif -%}
    </div>
    <div class="all-orders__col all-orders__col--total">
      <span class="all-orders__price">{%- if zero_price_order -%}{{ zero_price_label }}{%- else -%}{{ order.total_price | money }}{%- endif -%}</span>
    </div>
    <div class="all-orders__col all-orders__col--action">
      <div class="ao-actions">
        <a href="#" class="ao-view-details-btn" data-order-handle="{{ order.name | handleize }}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg> Details</a>
        <a href="#" class="ao-invoice-link" onclick="event.stopPropagation();event.preventDefault();window.__ntInvoice(this);" data-order-invoice="{{ order.name | handleize }}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg> Invoice</a>
        {%- unless hide_reorder -%}
        <div class="all-orders__reorder-wrap" style="display:none">
          {%- for li in order.line_items -%}
            <textarea class="ao-propitems {{ li.variant_id }}">{ {% for property in li.properties %}{{ property.first | json }}:{{ property.last | json }}{% if forloop.last == false %},{% endif %}{% endfor %} }</textarea>
          {%- endfor -%}
        </div>
        <button type="button" class="all-orders__reorder-btn" data-corder-id="{{ order.name }}" data-lineitem-ids="{{ line_item_ids }}" data-variant-ids="{{ variant_ids }}" data-variant-quantities="{{ variant_quantities }}" data-variant-inventories="{{ variant_inventories }}" data-variant-inventory-policies="{{ variant_inv_policies }}" data-variant-inventory-trackers="{{ variant_inv_trackers }}">
          <svg class="ao-btn-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          <span class="ao-btn-text">Reorder</span>
          <span class="ao-spinner-container"><svg class="ao-spinner" viewBox="0 0 20 20" aria-label="Loading" role="status"><path d="M7.229 1.173a9.25 9.25 0 1 0 11.655 11.412 1.25 1.25 0 1 0-2.4-.698 6.75 6.75 0 1 1-8.506-8.329 1.25 1.25 0 1 0-.75-2.385z" fill="currentColor"/></svg></span>
        </button>
        {%- endunless -%}
      </div>
    </div>
  </div>

  {%- if line_count > 1 -%}
  <div class="ao-line-items">
    {% render 'order-line-items', order: order, zero_price_order: zero_price_order, zero_price_label: zero_price_label, hide_reorder: hide_reorder %}
  </div>
  {%- endif -%}
</div>

