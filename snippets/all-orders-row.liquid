    {%- if dj_variant_title != blank and dj_variant_title != 'Default Title' -%}{%- assign dj_vt_suffix = ' - ' | append: dj_variant_title -%}{%- if dj_display_title contains dj_vt_suffix -%}{%- assign dj_display_title = dj_display_title | remove: dj_vt_suffix -%}{%- endif -%}{%- endif -%}
