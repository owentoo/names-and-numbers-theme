      "sku": {{ li.sku | default: '' | json }},
      {%- assign li_detail_img = '' -%}
      {%- assign li_detail_fallback = '' -%}
      {%- assign dj_width = '' -%}
      {%- assign dj_height = '' -%}
      {%- for p in li.properties -%}
        {%- assign pk = p.first | downcase | strip -%}
