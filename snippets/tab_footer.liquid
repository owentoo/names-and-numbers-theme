<link rel="stylesheet" href="{{ 'tabFooter.css' | asset_url }}">
<div class="tabFooter">
  <div class="tabFooter-shipping">
    {%- if footer_bold != blank -%}
      <span class="tabFooter-title">{{ footer_bold | escape }}</span>
    {%- endif -%}
    {%- if footer_sub != blank -%}
      <span class="tabFooter-sub">{{ footer_sub | escape }}</span>
    {%- endif -%}
  </div>
  {%- if cta_url != blank -%}
    <a href="{{ cta_url }}" class="tabFooter-cta" style="background: {{ accent_color }};">
      {{ cta_text | default: 'Learn More' | escape }}&nbsp;&rarr;
    </a>
  {%- endif -%}
</div>
<div class="tabFooter-accent" style="background: {{ accent_color }};"></div>
