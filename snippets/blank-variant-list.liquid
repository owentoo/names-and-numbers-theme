<style>input.itemQuantity::-webkit-outer-spin-button,input.itemQuantity::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}</style>
{% assign vtitle = variant.title | split : "/" %}
{% assign vtitle = vtitle.last %}
      <div class="flex-item text-center">
        <div class="variant-price-2" style="display:block;width:72px;">
          <label
            class="font-size--down-2 line-height--up-1 large--line-height--down-1 large--font-size--down-1 padding-top--down-3 large--padding-top--down-1 padding-bottom--down-3 font-bold"
            style="font-weight: 700;"
          >
            {{- vtitle -}}
          </label>
          {% if variant.inventory_quantity <= 0 %}
            <div style="border-radius: 4px;display:block;border: 1px solid #e0e0e0;width:100%;color: #000000;padding-top:4px;padding-bottom:4px;background-color: #e1e1e1;height:55px;line-height:45px;">
              <label>OUT</label>
            </div>
          {% else %}
            <div style="display:inline-flex; align-items:stretch; border:1px solid #ccc; border-radius:4px; overflow:hidden; height:28px; margin-top:4px;">
              <input
                class="text-center itemQuantity"
                type="number"
                min="0"
                data-id="{{ variant.id }}"
                data-price="{{ variant.price }}"
                data-variant-price="{{ variant.price | money_without_currency }}"
                data-tiers="{{ variant.metafields.custom.tier_pricing }}"
                data-tp="{{ variant.metafields.custom.tier_pricing | base64_encode }}"
                data-label="{{ vtitle }}"
                data-gtin="{{ variant.sku }}"
                data-max="{{ variant.inventory_quantity }}"
                placeholder=""
                value=""
                style="width:32px; border:none; text-align:center; font-size:13px; font-weight:600; -moz-appearance:textfield; padding:0; margin:0; background:#fff; color:#333;"
              >
              <div style="display:flex; flex-direction:column; width:20px;">
                <button type="button" data-dir="up" style="flex:1; background:#2d2d2d; color:#fff; border:none; border-bottom:1px solid #555; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:7px; padding:0; margin:0; line-height:1;">&#9650;</button>
                <button type="button" data-dir="down" style="flex:1; background:#2d2d2d; color:#fff; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:7px; padding:0; margin:0; line-height:1;">&#9660;</button>
              </div>
            </div>
            <label class="font-size--down-2 line-height--up-1 large--line-height--down-1 large--font-size--down-1 padding-top--down-5 large--padding-top--down-0 font-bold">
              <small
                data-variant-id="{{ variant.id }}"
                class="font-size--down-3 large--font-size--down-2 font-bold text-primary variant-price-2 padding-bottom--down-1 label-price"
                style="color: #03406C;font-size:1.1em;font-weight:700;"
              >
                {{- variant.price | money -}}
              </small>
            </label>
            <div style="font-size:0.8em;">
              {% if variant.inventory_quantity >= 999 %}
                <div>999+</div>
              {% else %}
                <div>{{ variant.inventory_quantity }}</div>
              {% endif %}
              <div>In Stock</div>
            </div>
          {% endif %}
        </div>
      </div>

<script>
if (!window._bvlStepperBound) {
  window._bvlStepperBound = true;
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-dir]');
    if (!btn) return;
    var wrap = btn.closest('div').parentElement;
    var input = wrap.querySelector('input.itemQuantity');
    if (!input) return;
    var val = parseInt(input.value) || 0;
    var max = parseInt(input.getAttribute('data-max')) || 99999;
    if (btn.getAttribute('data-dir') === 'up') {
      if (val < max) input.value = val + 1;
    } else {
      if (val > 0) input.value = val - 1;
    }
    input.dispatchEvent(new Event('input', {bubbles:true}));
    input.dispatchEvent(new KeyboardEvent('keyup', {bubbles:true}));
  });
}
</script>
