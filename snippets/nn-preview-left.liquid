{%- comment -%}
  Left-column preview for the Names & Numbers PDP.
  Renders BOTH the standard product image gallery (default) and the live
  jersey mockup (revealed after the customer first interacts with the
  configurator). The configurator's JS toggles `data-nn-left-mode` between
  "default" and "configuring" on the wrapper.

  Caller (sections/bySizeNew.liquid) passes section, selectedProduct,
  gallery_class, and hideVariantImages.
{%- endcomment -%}

{{ 'names-and-numbers.css' | asset_url | stylesheet_tag }}

<div class="nn-preview-left" data-nn-left-mode="default">

  <!-- Default state: theme's product image gallery -->
  <div class="nn-left-gallery">
    {% render "product-gallery",
       section: section,
       product: selectedProduct,
       gallery_class: gallery_class,
       hideVariantImages: hideVariantImages %}
  </div>

  <!-- Configuring state: transparent shirt PNG over a colored container,
       with the name/number rendered as an SVG overlay on top.
       (Same technique as the Ninja Size Guide tiles in product-gallery.liquid.) -->
  <div class="nn-left-jersey">
    <div class="nn-preview-frame">
      <span class="nn-preview-badge">LIVE PREVIEW</span>
      <span class="nn-preview-chip" data-nn-chip>—</span>

      <div class="nn-shirt-wrap" data-nn-shirt-bg style="background-color: #000000;">
        <img
          class="nn-shirt-img"
          data-nn-shirt-img
          data-front-src="https://cdn.shopify.com/s/files/1/0558/0265/8899/files/Names_and_Numbers_Front.png?v=1779819795"
          data-back-src="https://cdn.shopify.com/s/files/1/0558/0265/8899/files/Names_and_Numbers_Back.png?v=1779819795"
          src="https://cdn.shopify.com/s/files/1/0558/0265/8899/files/Names_and_Numbers_Back.png?v=1779819795"
          alt=""
          aria-hidden="true"
        >
        <svg class="nn-shirt-overlay" viewBox="0 0 480 560" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <text data-nn-jersey-name   x="240" y="220" text-anchor="middle" font-family="sans-serif" font-weight="700" font-size="64"  fill="#ffffff" letter-spacing="2">RIVERA</text>
          <text data-nn-jersey-number x="240" y="380" text-anchor="middle" font-family="sans-serif" font-weight="700" font-size="128" fill="#ffffff">23</text>
        </svg>
      </div>
    </div>

    <div class="nn-shirt-colors">
      <span class="nn-shirt-colors__label">Change preview color</span>
      <div class="nn-shirt-colors__grid" data-nn-shirt-colors>
        <button type="button" class="nn-shirt-swatch is-selected" data-shirt-hex="#000000" title="Black"  style="background:#000000"></button>
        <button type="button" class="nn-shirt-swatch" data-shirt-hex="#ffffff" title="White"  style="background:#ffffff"></button>
        <button type="button" class="nn-shirt-swatch" data-shirt-hex="#d8d8d8" title="Gray"   style="background:#d8d8d8"></button>
        <button type="button" class="nn-shirt-swatch" data-shirt-hex="#c8102e" title="Red"    style="background:#c8102e"></button>
        <button type="button" class="nn-shirt-swatch" data-shirt-hex="#ff3900" title="Orange" style="background:#ff3900"></button>
        <button type="button" class="nn-shirt-swatch" data-shirt-hex="#ffc121" title="Gold"   style="background:#ffc121"></button>
        <button type="button" class="nn-shirt-swatch" data-shirt-hex="#f5e851" title="Yellow" style="background:#f5e851"></button>
        <button type="button" class="nn-shirt-swatch" data-shirt-hex="#82d145" title="Green"  style="background:#82d145"></button>
        <button type="button" class="nn-shirt-swatch" data-shirt-hex="#1e4d2b" title="Forest" style="background:#1e4d2b"></button>
        <button type="button" class="nn-shirt-swatch" data-shirt-hex="#0033a0" title="Royal"  style="background:#0033a0"></button>
        <button type="button" class="nn-shirt-swatch" data-shirt-hex="#0b1d3a" title="Navy"   style="background:#0b1d3a"></button>
        <button type="button" class="nn-shirt-swatch" data-shirt-hex="#7b1e2b" title="Maroon" style="background:#7b1e2b"></button>
        <label class="nn-shirt-swatch nn-shirt-swatch--custom" title="Custom">
          <span class="nn-shirt-swatch__plus" aria-hidden="true">+</span>
          <input type="color" data-nn-shirt-custom value="#ff00ff">
        </label>
      </div>
    </div>

  </div>

</div>
