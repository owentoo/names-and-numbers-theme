<script>
(function() {
  /* Claim the next un-initialized .md-container. The snippet can be rendered
     more than once on the same page (e.g. dtf-upload-tabs "Recent Designs" tab
     plus the "Choose a previously uploaded design" picker modal), and each
     render emits its own copy of this script. Without :not([data-md-init]),
     every IIFE re-initializes the first container and later ones stay stuck
     on the loading spinner. */
  var container = document.querySelector('.md-container:not([data-md-init])');
  if (!container) return;
  container.setAttribute('data-md-init', '1');

  var CUSTOMER_ID = container.getAttribute('data-customer-id');
  if (!CUSTOMER_ID) return;

  var IS_PICKER = container.getAttribute('data-picker') === 'true';
  var FORCED_TYPE = container.getAttribute('data-forced-type') || '';
  var ALLOW_MULTI = container.getAttribute('data-allow-multi') === 'true';

  var API = 'https://hpz51rjda5.execute-api.us-east-1.amazonaws.com/production';
  var IMGIX_HOST = 'ninjauploads-production.imgix.net';
  var S3_HOST = 'ninja-services-production-ninjauploadss3bucket-zks2mguobhe4.s3.amazonaws.com';
  var STORAGE_KEY = 'nt-designs-archived-' + CUSTOMER_ID;
  /* --- State --- */
  var allDesigns = [];
  var pendingUploads = [];
  var localUploadedDesigns = [];
  var uploadedPreviewMap = {};
  var uploadTileErrors = {};
  var sourceFilter = 'all';
  var typeFilter = (FORCED_TYPE === 'bysize' || FORCED_TYPE === 'gangsheet') ? FORCED_TYPE : 'all';
  var searchQuery = '';
  var selectedDesignIds = [];
  var uploadTileErrorTimers = {};

  /* --- DOM refs --- */
  var gridEl = container.querySelector('.md-grid');
  var loadingEl = container.querySelector('.md-loading');
  var emptyEl = container.querySelector('.md-empty');
  var archiveBanner = container.querySelector('.md-archive-banner');
  var modalOverlay = container.querySelector('.md-modal-overlay');
  var modalName = container.querySelector('.md-modal__name');
  var modalCancel = container.querySelector('.md-modal__cancel');
  var modalConfirm = container.querySelector('.md-modal__confirm');
  var toastEl = container.querySelector('.md-toast');
  var searchInput = container.querySelector('.md-search-input');
  var searchClear = container.querySelector('.md-search-clear');
  var uploadInputs = container.querySelectorAll('.md-upload-input');
  var selectionBar = container.querySelector('.md-selection-bar');

  /* ─────────────────────────────────────────────────────────────────
     Position the selection action bar INSIDE the dtfut panel-wrap.
     .dtfut has `filter: drop-shadow(...)` in dtf-upload-tabs.css, which
     creates a containing block for any position:fixed descendant — so the
     bar\'s default `position: fixed; bottom: 24px` resolves to .dtfut
     instead of the viewport. We previously worked around this by moving
     the bar to <body>, but that left the bar floating at viewport bottom,
     visually disconnected from the panel on desktop.
     New approach: reparent the bar to `.dtfut__panel-wrap` and switch it
     to position:absolute pinned to the bottom of that wrapper. The bar
     stays visually inside the picker panel, and z-index:9998 keeps it
     above the design grid (which has no explicit z-index).
     Skipped for the picker modal context (.customTabelPopup--md-picker)
     and the standalone /account/designs page — those already work. */
  if (selectionBar && container.closest('.dtfut') && !container.closest('.customTabelPopup--md-picker')) {
    var panelWrap = container.closest('.dtfut').querySelector('.dtfut__panel-wrap');
    if (panelWrap) {
      panelWrap.appendChild(selectionBar);
      selectionBar.style.position = 'absolute';
      selectionBar.style.left = '0';
      selectionBar.style.right = '0';
      selectionBar.style.bottom = '0';
      selectionBar.style.transform = 'none';
      selectionBar.style.width = '100%';
      selectionBar.style.maxWidth = '100%';
      selectionBar.style.borderRadius = '0 0 12px 12px';
      selectionBar.style.margin = '0';
      selectionBar.style.zIndex = '50';
    }
  }

  /* Query summary/action buttons FROM the bar (not the container) — they
     live inside the bar, and the bar may have been reparented to body
     above. deselectAllBtn lives outside the bar so it stays in container. */
  var selectionSummary = selectionBar && selectionBar.querySelector('.md-selection-bar__summary');
  var deselectAllBtn = container.querySelector('.md-deselect-all');
  var selectionArchiveBtn = selectionBar && selectionBar.querySelector('[data-selection-action="archive"]');
  var selectionPrimaryBtn = selectionBar && selectionBar.querySelector('[data-selection-action="primary"]');
  var selectionSecondaryBtn = selectionBar && selectionBar.querySelector('[data-selection-action="secondary"]');
  var pendingDeleteId = null;

  /* Archive confirm modal elements */
  var archiveOverlay = container.querySelector('.md-archive-overlay');
  var archiveModalName = container.querySelector('.md-archive-modal__name');
  var archiveModalCancel = container.querySelector('.md-archive-modal__cancel');
  var archiveModalConfirm = container.querySelector('.md-archive-modal__confirm');
  var pendingArchiveId = null;
  var pendingArchiveIds = [];


  /* --- Archive helpers (localStorage) --- */
  function getArchived() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } catch(e) { return []; }
  }
  function setArchived(arr) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(arr)); } catch(e) {}
  }
  function isArchived(id) {
    return getArchived().indexOf(String(id)) > -1;
  }
  function archiveItem(id) {
    var arr = getArchived();
    var sid = String(id);
    if (arr.indexOf(sid) === -1) { arr.push(sid); setArchived(arr); }
    try { window.dispatchEvent(new CustomEvent('nt-archive-changed', { detail: { source: 'my-designs', ids: [sid] } })); } catch(e) {}
  }
  function unarchiveItem(id) {
    var arr = getArchived().filter(function(x) { return x !== String(id); });
    setArchived(arr);
    try { window.dispatchEvent(new CustomEvent('nt-archive-changed', { detail: { source: 'my-designs', ids: [String(id)], action: 'unarchive' } })); } catch(e) {}
  }

  /* --- Filename extraction (matches existing pattern) --- */
  function extractFileName(url) {
    var name = url;
    if (url.indexOf('imgix.net') > -1) {
      name = url.replace('https://','').split('?')[0].split('/')[1] || name;
      if (name.indexOf('____image') > -1) {
        var ext = name.split('.').pop();
        name = name.split('____image')[0] + '.' + ext;
      }
    } else if (url.indexOf('upload.cloudlift.app') > -1) {
      name = url.split('transferss/')[1] || name;
    } else if (url.indexOf('ninja-services-production') > -1) {
      name = url.replace('https://','').split('?')[0].split('/')[1] || name;
    } else if (url.indexOf('amazonaws') > -1) {
      name = url.replace('https://','').split('?')[0].split('/')[2] || name;
    }
    try { name = decodeURIComponent(name); } catch(e) {}
    return name;
  }

  /* --- Compressed thumb URL --- */
  function thumbUrl(url, isGang) {
    var compressed = url.replace(S3_HOST, IMGIX_HOST);
    var sep = compressed.indexOf('?') > -1 ? '&' : '?';
    if (needsRemotePreview(url)) {
      /* AI/EPS/PDF/SVG/TIF: convert to PNG — match DTF product page pattern (no trim/dpi that break conversion) */
      if (isGang) {
        return compressed + sep + 'fm=png&w=600&h=600&fit=clip&auto=compress&q=15';
      }
      return compressed + sep + 'fm=png&w=600&auto=compress&q=15';
    }
    if (isGang) {
      /* Gang sheets: fit full image in 600×600 box, no trim so full layout is visible */
      return compressed + sep + 'w=600&h=600&fit=clip&auto=compress&q=15&dpi=72';
    }
    return compressed + sep + 'h=300&auto=compress&q=10&dpi=72&trim=colorUnlessAlpha';
  }

  function sanitizeFileName(name) {
    return (name || 'upload')
      .replace(/[^a-z0-9\s]/gi, '')
      .replace(/[_\s]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .toLowerCase() || 'upload';
  }

  function normalizeFileKey(url) {
    try {
      var clean = (url || '').split('?')[0];
      var parts = clean.split('/');
      return decodeURIComponent(parts[parts.length - 1] || clean);
    } catch (e) {
      return (url || '').split('?')[0];
    }
  }

  function makeUploadMatchKey(fileOrKey, isGangSheet) {
    var sourceValue = '';
    if (typeof fileOrKey === 'string') {
      sourceValue = fileOrKey;
    } else if (fileOrKey) {
      sourceValue = fileOrKey.file || fileOrKey.key || fileOrKey.s3File || '';
    }
    var baseKey = normalizeFileKey(sourceValue);
    return baseKey + '|' + (isGangSheet ? '1' : '0');
  }

  function uniq(arr) {
    return arr.filter(function(item, index) { return arr.indexOf(item) === index; });
  }

  function wait(ms) {
    return new Promise(function(resolve) { setTimeout(resolve, ms); });
  }

  function makeUploadTempId() {
    return 'pending-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);
  }

  function makeVectorPlaceholderThumb(name) {
    var ext = ((name || '').split('.').pop() || 'file').toUpperCase();
    var label = ext.length > 5 ? 'FILE' : ext;
    var svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600">' +
      '<rect width="600" height="600" fill="#f8fafc"/>' +
      '<rect x="46" y="46" width="508" height="508" rx="28" fill="#ffffff" stroke="#dbe5f1" stroke-width="12"/>' +
      '<rect x="150" y="120" width="300" height="360" rx="24" fill="#eff6ff" stroke="#93c5fd" stroke-width="10"/>' +
      '<path d="M220 200h160M220 255h160M220 310h120" stroke="#60a5fa" stroke-width="18" stroke-linecap="round"/>' +
      '<text x="300" y="410" text-anchor="middle" font-family="Arial, sans-serif" font-size="64" font-weight="700" fill="#1d4ed8">' + label + '</text>' +
      '<text x="300" y="485" text-anchor="middle" font-family="Arial, sans-serif" font-size="26" fill="#64748b">Generating preview...</text>' +
    '</svg>';
    return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
  }

  function getPendingVisibleUploads() {
    return pendingUploads.filter(function(item) {
      if (sourceFilter === 'archive') return false;
      if (typeFilter === 'bysize' && item.gangsheet) return false;
      if (typeFilter === 'gangsheet' && !item.gangsheet) return false;
      return true;
    });
  }

  function shouldShowUploadCards() {
    return sourceFilter !== 'archive';
  }

  function getUploadTileError(target) {
    return uploadTileErrors[target] || '';
  }

  function getUploadTileNote(target, defaultText) {
    return getUploadTileError(target) || defaultText;
  }

  function getUploadTileClasses(target) {
    return 'md-upload-tile' + (getUploadTileError(target) ? ' md-upload-tile--error' : '');
  }

  function getUploadCardsHtml() {
    if (!shouldShowUploadCards()) return '';
    var icon = '<span class="md-upload-tile__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4"/><path d="M7 9l5-5 5 5"/><path d="M20 16.5A3.5 3.5 0 0 1 16.5 20h-9A3.5 3.5 0 0 1 4 16.5"/></svg></span>';
    var bySizeTile = '<button type="button" class="' + getUploadTileClasses('bysize') + '" data-upload-open="bysize" data-upload-dropzone="bysize">' + icon + '<span class="md-upload-tile__title">Upload By Size</span><span class="md-upload-tile__browse">Browse</span><span class="md-upload-tile__note">' + getUploadTileNote('bysize', 'Drag &amp; Drop (10 file limit)') + '</span></button>';
    var gangSheetTile = '<button type="button" class="' + getUploadTileClasses('gangsheet') + '" data-upload-open="gangsheet" data-upload-dropzone="gangsheet">' + icon + '<span class="md-upload-tile__title">Upload Gang Sheet</span><span class="md-upload-tile__browse">Browse</span><span class="md-upload-tile__note md-upload-tile__note--muted">' + getUploadTileNote('gangsheet', 'One file at a time') + '</span></button>';
    if (typeFilter === 'bysize') return '<div class="md-upload-card md-upload-card--single md-upload-card--bysize">' + bySizeTile + '</div>';
    if (typeFilter === 'gangsheet') return '<div class="md-upload-card md-upload-card--single md-upload-card--gangsheet">' + gangSheetTile + '</div>';
    /* At 5-per-row the columns are narrow enough that a single dual-stack
       card looks cramped; render the two tiles as their own single cards
       (matching the By Size / Gang Sheet filter views) so they auto-place
       in cols 1 and 2 of row 1 with the same outer card chrome. */
    var standalone = container.closest && container.closest('.md-standalone');
    if (standalone && standalone.getAttribute('data-cols') === '5') {
      return '<div class="md-upload-card md-upload-card--single md-upload-card--bysize">' + bySizeTile + '</div>' +
             '<div class="md-upload-card md-upload-card--single md-upload-card--gangsheet">' + gangSheetTile + '</div>';
    }
    return '<div class="md-upload-card md-upload-card--dual"><div class="md-upload-card__stack">' + bySizeTile + gangSheetTile + '</div></div>';
  }

  function getPendingUploadHtml(item) {
    var pendingBadge = item.gangsheet ? '<span class="md-card__badge md-card__badge--gangsheet">Gang Sheet</span>' : '<span class="md-card__badge md-card__badge--bysize">By Size</span>';
    return '<div class="md-card md-card--uploading' + (item.gangsheet ? ' md-card--gangsheet' : '') + '" data-pending-upload-id="' + item.id + '">' +
      '<div class="md-card__thumb">' +
        pendingBadge +
        (item.previewUrl ? '<img src="' + item.previewUrl + '" alt="' + item.fileName.replace(/"/g, '&quot;') + '" loading="lazy">' : '') +
        '<div class="md-card__upload-spinner"></div>' +
        '<div class="md-card__upload-copy">Uploading...</div>' +
      '</div>' +
      '<div class="md-card__info">' +
        '<p class="md-card__name" data-tooltip="' + item.fileName.replace(/"/g, '&quot;') + '">' + smartFileName(item.fileName, 22) + '</p>' +
        '<p class="md-card__meta"><span>Upload in progress</span></p>' +
      '</div>' +
      '<div class="md-card__action"><div class="md-card__action-row"><span class="md-card__action-btn" style="text-decoration:none;cursor:default;color:#9ca3af;">Please wait</span></div></div>' +
    '</div>';
  }

  /* --- File extension --- */
  function fileExt(url) {
    try {
      var path = url.split('?')[0];
      var ext = path.split('.').pop().toLowerCase();
      if (ext.length > 5) return '';
      return ext.toUpperCase();
    } catch(e) { return ''; }
  }

  /* --- Smart filename truncation: keep the extension attached after truncation --- */
  function smartFileName(name, maxLen) {
    if (!name) return '';
    maxLen = maxLen || 28;
    var dotIdx = name.lastIndexOf('.');
    var ext = dotIdx > -1 ? name.substring(dotIdx + 1).toLowerCase() : '';
    var base = dotIdx > -1 ? name.substring(0, dotIdx) : name;
    var suffix = ext ? '.' + ext : '';
    var totalMax = maxLen - suffix.length;
    if (totalMax < 6) totalMax = 6;
    if (base.length > totalMax) {
      base = base.substring(0, totalMax - 3) + '...';
    }
    return base + suffix;
  }

  /* --- Vector file detection --- */
  var VECTOR_EXTS = ['ai', 'eps', 'pdf', 'svg', 'tif', 'tiff', 'psd'];
  var REMOTE_PREVIEW_EXTS = ['ai', 'eps', 'pdf', 'svg', 'tif', 'tiff', 'psd'];
  function isVectorFile(url) {
    try {
      var ext = url.split('?')[0].split('.').pop().toLowerCase();
      return VECTOR_EXTS.indexOf(ext) > -1;
    } catch(e) { return false; }
  }

  function needsRemotePreview(url) {
    try {
      var ext = url.split('?')[0].split('.').pop().toLowerCase();
      return REMOTE_PREVIEW_EXTS.indexOf(ext) > -1;
    } catch(e) { return false; }
  }

  /* --- Extract width/height from variant_title like "4x6", "10.5 x 12" --- */
  function extractDimensions(str) {
    if (!str) return null;
    var match = str.match(/([\d.]+)[^0-9.]*([\d.]+)/);
    if (match) {
      var width = parseFloat(match[1]);
      var height = parseFloat(match[2]);
      if (width > 0 && height > 0) {
        return { width: String(width), height: String(height) };
      }
    }
    return null;
  }

  /* --- Build vector dimension params if applicable --- */
  function vectorParams(item) {
    if (!isVectorFile(item.file)) return '';
    var dims = extractDimensions(item.variantTitle);
    if (dims) return '&orderFileWidth=' + dims.width + '&orderFileHeight=' + dims.height;
    return '';
  }

  function getOriginalOrderFile(item) {
    if (!item) return '';
    /* AI/EPS/PSD: DTF page uses sendApiRequest which expects the S3 or full URL */
    /* PDF: DTF page converts S3→imgix+fm=png explicitly */
    /* TIF/TIFF/SVG: DTF page has no special handler — send imgix URL so the browser can render via imgix auto-conversion */
    var ext = fileExt(item.file);
    var needsS3 = ['ai', 'eps', 'pdf', 'psd'].indexOf(ext) > -1;
    if (needsS3) {
      if (item.s3File) return item.s3File.split('?')[0];
      return item.file.replace(IMGIX_HOST, S3_HOST).split('?')[0];
    }
    return item.file.split('?')[0];
  }

  /* --- Reorder URL --- */
  function reorderUrl(item) {
    var f = getOriginalOrderFile(item);
    var vp = vectorParams(item);
    /* For purchased designs (item.orderName present) we route through the
       JSON `?my_designs_selection=` payload so the orderName travels with
       the design to the product page. The `?file=` shape can only carry a
       URL; the destination's cart-add pipeline can't recover "previously
       on order # NT-…" from a bare file URL alone. The consumer side
       (bySize.js / bySize_popular.js / pdp_transferBySize-multiupload.js
       sharedSelection readers) seeds window.__designReUsedByUrl +
       __designReUsedByName + the legacy `ordername` / `grt_photo_id` /
       `designtype` globals from the payload, and the cart-serialize code
       stamps `properties[design re-used]` from there. Uploads (no
       orderName) keep the lighter `?file=` path for backward compat. */
    if (item.gangsheet) {
      if (item.orderName) {
        var gsPayload = [{ id: String(item.id), name: item.fileName, fileURL: f, orderName: String(item.orderName) }];
        return buildDestinationUrl('/products/premium-dtf-gang-sheets?my_designs_selection=' + encodeURIComponent(JSON.stringify(gsPayload)));
      }
      return buildDestinationUrl('/products/premium-dtf-gang-sheets?file=' + encodeURIComponent(f) + vp);
    }
    if (item.orderName) {
      var bsPayload = [{ id: String(item.id), name: item.fileName, fileURL: f, orderName: String(item.orderName) }];
      var dims = extractDimensions(item.variantTitle);
      if (dims) { bsPayload[0].designWidth = dims.width; bsPayload[0].designHeight = dims.height; }
      return buildDestinationUrl('/products/dtf-transfers?my_designs_selection=' + encodeURIComponent(JSON.stringify(bsPayload)));
    }
    return buildDestinationUrl('/products/dtf-transfers?file=' + encodeURIComponent(f) + vp);
  }

  function uvReorderUrl(item) {
    var f = getOriginalOrderFile(item);
    var vp = vectorParams(item);
    return buildDestinationUrl('/products/uv-dtf-stickers-decals-by-size?file=' + encodeURIComponent(f) + vp);
  }

  function buildDestinationUrl(path) {
    var url = new URL(path, window.location.origin);
    var currentParams = new URLSearchParams(window.location.search);
    if (currentParams.has('preview_theme_id')) {
      url.searchParams.set('preview_theme_id', currentParams.get('preview_theme_id'));
    }
    return url.pathname + url.search;
  }

  function buildBulkSelectionPayload(items) {
    return items.map(function(item) {
      var payload = {
        id: String(item.id),
        name: item.fileName,
        fileURL: getOriginalOrderFile(item)
      };
      var dims = extractDimensions(item.variantTitle);
      if (dims) {
        payload.designWidth = dims.width;
        payload.designHeight = dims.height;
      }
      /* Carry the source order name into the destination product page so
         the upload pipeline there can stamp properties[design re-used]
         with "previously on order # NT-…" on cart-add. The consumer
         (bySize_popular.js / bySize.js / pdp_transferBySize-multiupload.js
         sharedSelection reader) populates window.__designReUsedByName /
         __designReUsedByUrl from this. Only set when present + on a
         purchased-source design (uploads have no orderName). */
      if (item.orderName) {
        payload.orderName = String(item.orderName);
      }
      return payload;
    });
  }

  function openBulkBySizeSelection(productPath, items) {
    var url = new URL(productPath, window.location.origin);
    url.searchParams.set('my_designs_selection', encodeURIComponent(JSON.stringify(buildBulkSelectionPayload(items))));
    var currentParams = new URLSearchParams(window.location.search);
    if (currentParams.has('preview_theme_id')) {
      url.searchParams.set('preview_theme_id', currentParams.get('preview_theme_id'));
    }
    window.location.href = url.pathname + url.search;
  }

  function getSelectedDesigns() {
    return selectedDesignIds.map(function(id) {
      return allDesigns.find(function(item) { return String(item.id) === String(id); });
    }).filter(Boolean);
  }

  function hasSelectedGangSheet(items) {
    return items.some(function(item) { return item.gangsheet; });
  }

  function isSelectionDisabled(item, selectedItems) {
    if (sourceFilter === 'archive') return false;
    if (selectedItems.length === 0) return false;
    var isSelected = selectedDesignIds.indexOf(String(item.id)) > -1;
    if (isSelected) return false;
    /* Picker mode on gang-sheet products: never disable — clicks always
       replace the current selection (single-select). */
    if (IS_PICKER && FORCED_TYPE === 'gangsheet') return false;
    /* Picker mode on non-multi-upload products: single-select with replace. */
    if (IS_PICKER && !ALLOW_MULTI) return false;
    return false;
  }

  function clearSelection() {
    selectedDesignIds = [];
  }

  function getUploadInput(target) {
    return container.querySelector('.md-upload-input[data-upload-target="' + target + '"]');
  }

  function isValidUploadFile(file) {
    return !!(file && file.name && file.size > 0 && file.size <= 5368709120);
  }

  function isValidGangSheetFile(file) {
    if (!file || !file.name) return false;
    var ext = '.' + ((file.name.split('.').pop() || '').toLowerCase());
    return ['.ai', '.png', '.pdf'].indexOf(ext) > -1;
  }

  function showUploadTileError(target, message) {
    uploadTileErrors[target] = message;
    render();
    if (uploadTileErrorTimers[target]) {
      clearTimeout(uploadTileErrorTimers[target]);
    }
    uploadTileErrorTimers[target] = setTimeout(function() {
      delete uploadTileErrors[target];
      render();
    }, 3000);
  }

  function crc32FromArrayBuffer(arrayBuffer) {
    var table = crc32FromArrayBuffer.table || (function() {
      var c;
      var table = [];
      for (var n = 0; n < 256; n++) {
        c = n;
        for (var k = 0; k < 8; k++) {
          c = ((c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1));
        }
        table[n] = c >>> 0;
      }
      crc32FromArrayBuffer.table = table;
      return table;
    })();
    var crc = 0 ^ (-1);
    var bytes = new Uint8Array(arrayBuffer);
    for (var i = 0; i < bytes.length; i++) {
      crc = (crc >>> 8) ^ table[(crc ^ bytes[i]) & 0xFF];
    }
    return ((crc ^ (-1)) >>> 0).toString(16);
  }

  async function getFileCrc(file) {
    try {
      var buffer = await file.arrayBuffer();
      return crc32FromArrayBuffer(buffer);
    } catch (e) {
      return '';
    }
  }

  async function getPresignedUploadUrl(fileName, fileType) {
    var response = await fetch(API + '/uploads/getPresignedUploadUrl?file_name=' + encodeURIComponent(fileName) + '&file_type=' + encodeURIComponent(fileType || 'application/octet-stream'));
    if (!response.ok) throw new Error('Failed to get upload URL');
    return response.json();
  }

  async function saveUploadRecord(payload) {
    console.log('[My Designs] saveUploadRecord payload:', JSON.stringify(payload));
    var body = JSON.stringify([payload]);
    /* Use $.ajax to match the DTF product page request format exactly */
    return new Promise(function(resolve, reject) {
      $.ajax({
        url: API + '/uploads/saveData',
        method: 'post',
        dataType: 'json',
        data: body,
        success: function(resp) {
          console.log('[My Designs] saveUploadRecord success:', JSON.stringify(resp));
          resolve(resp);
        },
        error: function(xhr) {
          console.error('[My Designs] saveUploadRecord failed:', xhr.status, xhr.responseText);
          reject(new Error('Failed to save upload (' + xhr.status + ')'));
        }
      });
    });
  }

  async function uploadFileToLibrary(file, isGangSheet) {
    var ext = (file.name.split('.').pop() || '').toLowerCase();
    var randomName = sanitizeFileName(file.name.split('.').slice(0, -1).join('.') || file.name) + '____image_' + Date.now() + '_' + Math.floor(Math.random() * 1000) + (ext ? '.' + ext : '');
    console.log('[My Designs] uploadFileToLibrary start:', file.name, 'type:', file.type, 'size:', file.size, 'randomName:', randomName);
    var presignData = await getPresignedUploadUrl(randomName, file.type || 'application/octet-stream');
    console.log('[My Designs] presignData:', JSON.stringify(presignData));
    if (!presignData || !presignData.url || !presignData.sourceUrl) throw new Error('Upload URL was not returned');

    var putResponse = await fetch(presignData.url, {
      method: 'PUT',
      body: file
    });
    console.log('[My Designs] S3 PUT status:', putResponse.status, putResponse.statusText);
    if (!putResponse.ok) throw new Error('Upload failed (S3 PUT ' + putResponse.status + ')');

    var filePath = (presignData.sourceUrl || '').replace(S3_HOST, IMGIX_HOST);
    if (!filePath) {
      filePath = 'https://' + IMGIX_HOST + '/' + randomName;
    }
    var fileCrc = await getFileCrc(file);

    await wait(1500);

    await saveUploadRecord({
      variant_title: 'custom',
      file: filePath,
      customer_id: CUSTOMER_ID,
      file_name: file.name,
      file_crc: fileCrc,
      product_id: 'my-designs',
      gangsheet: !!isGangSheet
    });

    return {
      key: normalizeFileKey(filePath),
      file: filePath,
      s3File: presignData.sourceUrl,
      fileName: file.name,
      gangsheet: !!isGangSheet
    };
  }

  function addPendingUpload(file, isGangSheet) {
    var isRemotePreview = needsRemotePreview(file && file.name ? file.name : '');
    var pending = {
      id: makeUploadTempId(),
      fileName: file.name,
      gangsheet: !!isGangSheet,
      previewUrl: isRemotePreview ? '' : URL.createObjectURL(file)
    };
    pendingUploads.push(pending);
    render();
    return pending.id;
  }

  function removePendingUpload(id) {
    pendingUploads = pendingUploads.filter(function(item) {
      if (item.id === id) {
        if (item.previewUrl) {
          var previewStillInUse = Object.keys(uploadedPreviewMap).some(function(key) {
            return uploadedPreviewMap[key] === item.previewUrl;
          });
          if (!previewStillInUse) {
            try { URL.revokeObjectURL(item.previewUrl); } catch (e) {}
          }
        }
        return false;
      }
      return true;
    });
  }

  function getRenderThumb(item) {
    var key = normalizeFileKey(item.file);
    var s3Key = item.s3File ? normalizeFileKey(item.s3File) : '';
    return item.localThumb || uploadedPreviewMap[key] || (s3Key ? uploadedPreviewMap[s3Key] : '') || item.thumb;
  }

  function setUploadedPreview(uploadRef, previewSrc) {
    if (!uploadRef || !previewSrc) return;
    uploadedPreviewMap[uploadRef.key] = previewSrc;
    if (uploadRef.s3File) {
      uploadedPreviewMap[normalizeFileKey(uploadRef.s3File)] = previewSrc;
    }
  }

  function hasResolvedUploadPreview(item) {
    if (!item) return false;
    if (!needsRemotePreview(item.file || '')) return true;
    var key = normalizeFileKey(item.file || '');
    var s3Key = item.s3File ? normalizeFileKey(item.s3File) : '';
    return !!(uploadedPreviewMap[key] || (s3Key && uploadedPreviewMap[s3Key]));
  }

  function updateLocalUploadedThumb(uploadRef, previewSrc) {
    if (!uploadRef || !previewSrc) return;
    var matchKey = makeUploadMatchKey(uploadRef.file, !!uploadRef.gangsheet);
    var didUpdate = false;

    localUploadedDesigns = localUploadedDesigns.map(function(item) {
      if (makeUploadMatchKey(item, !!item.gangsheet) === matchKey) {
        didUpdate = true;
        return Object.assign({}, item, { localThumb: previewSrc, thumb: previewSrc });
      }
      return item;
    });

    allDesigns = allDesigns.map(function(item) {
      if (makeUploadMatchKey(item, !!item.gangsheet) === matchKey) {
        return Object.assign({}, item, { localThumb: previewSrc, thumb: previewSrc });
      }
      return item;
    });

    return didUpdate;
  }

  function syncLocalUploadedDesigns(fetchedDesigns) {
    var nextSelectedIds = selectedDesignIds.slice();

    localUploadedDesigns = localUploadedDesigns.map(function(localItem) {
      var matchKey = makeUploadMatchKey(localItem, !!localItem.gangsheet);
      var fetchedItem = fetchedDesigns.find(function(item) {
        return makeUploadMatchKey(item, !!item.gangsheet) === matchKey;
      });

      if (!fetchedItem) return localItem;

      if (String(localItem.id).indexOf('local-') === 0) {
        nextSelectedIds = nextSelectedIds.map(function(id) {
          return String(id) === String(localItem.id) ? String(fetchedItem.id) : id;
        });
      }

      return Object.assign({}, localItem, fetchedItem, {
        id: fetchedItem.id,
        localThumb: localItem.localThumb || fetchedItem.localThumb || '',
        thumb: localItem.localThumb || fetchedItem.thumb,
        timestamp: fetchedItem.timestamp || localItem.timestamp,
        fileName: fetchedItem.fileName || localItem.fileName,
        s3File: fetchedItem.s3File || localItem.s3File
      });
    });

    selectedDesignIds = uniq(nextSelectedIds);
  }

  function refreshUploadedImgixPreview(uploadRef, attempt) {
    if (!uploadRef || !needsRemotePreview(uploadRef.file)) return Promise.resolve('');
    var imgixSrc = thumbUrl(uploadRef.s3File || uploadRef.file, uploadRef.gangsheet);
    if (!imgixSrc || imgixSrc.indexOf(IMGIX_HOST) === -1) return Promise.resolve('');

    return new Promise(function(resolve) {
      var tries = typeof attempt === 'number' ? attempt : 0;
      var retrySrc = imgixSrc + (imgixSrc.indexOf('?') > -1 ? '&' : '?') + 'preview_refresh=' + Date.now() + '-' + tries;
      var probe = new Image();

      probe.onload = function() {
        setUploadedPreview(uploadRef, imgixSrc);
        updateLocalUploadedThumb(uploadRef, imgixSrc);
        render();
        resolve(imgixSrc);
      };

      probe.onerror = function() {
        if (tries >= 14) {
          resolve('');
          return;
        }
        setTimeout(function() {
          refreshUploadedImgixPreview(uploadRef, tries + 1).then(resolve);
        }, 1200);
      };

      probe.src = retrySrc;
    });
  }

  async function fetchDesignData() {
    var results = await Promise.all([
      fetch(API + '/uploads/fetchDataNew?customer_id=' + CUSTOMER_ID).then(function(r) { return r.json(); }).catch(function() { return []; }),
      fetch(API + '/uploads/orderDataNew?customer_id=' + CUSTOMER_ID + '&gangsheet=false').then(function(r) { return r.json(); }).catch(function() { return []; }),
      fetch(API + '/uploads/orderDataNew?customer_id=' + CUSTOMER_ID + '&gangsheet=true').then(function(r) { return r.json(); }).catch(function() { return []; })
    ]);

    var uploadData = results[0] && results[0].data ? results[0].data : results[0];
    var purchaseBySize = results[1] && results[1].data ? results[1].data : results[1];
    var purchaseGang = results[2] && results[2].data ? results[2].data : results[2];
    var designs = [];
    if (Array.isArray(uploadData)) uploadData.forEach(function(item) { designs.push(processItem(item, 'upload')); });
    if (Array.isArray(purchaseBySize)) purchaseBySize.forEach(function(item) { designs.push(processItem(item, 'purchase', false)); });
    if (Array.isArray(purchaseGang)) purchaseGang.forEach(function(item) { designs.push(processItem(item, 'purchase', true)); });
    syncLocalUploadedDesigns(designs);
    var localKeys = localUploadedDesigns.map(function(item) {
      return makeUploadMatchKey(item, !!item.gangsheet);
    });
    designs = designs.filter(function(item) {
      return localKeys.indexOf(makeUploadMatchKey(item, !!item.gangsheet)) === -1;
    });
    designs = localUploadedDesigns.concat(designs);
    designs.sort(function(a, b) { return (b.timestamp || 0) - (a.timestamp || 0); });
    return designs;
  }

  async function fetchDesigns(options) {
    options = options || {};
    if (!options.silent) {
      loadingEl.style.display = 'flex';
      gridEl.style.display = 'none';
      emptyEl.style.display = 'none';
    }

    allDesigns = await fetchDesignData();

    if (!options.silent) {
      loadingEl.style.display = 'none';
    }

    if (typeof options.afterLoad === 'function') options.afterLoad(allDesigns);
    render();
  }

  function selectUploadedRefs(uploadedRefs) {
    if (!uploadedRefs || uploadedRefs.length === 0) return [];
    var matchedIds = allDesigns.filter(function(item) {
      var itemKey = normalizeFileKey(item.file);
      return uploadedRefs.some(function(ref) {
        return ref.key === itemKey && !!ref.gangsheet === !!item.gangsheet;
      });
    }).map(function(item) { return String(item.id); });
    if (matchedIds.length) {
      selectedDesignIds = uniq(selectedDesignIds.concat(matchedIds));
    }
    return matchedIds;
  }

  function addLocalUploadedDesign(uploadRef, previewUrl) {
    var localId = 'local-' + uploadRef.key + '-' + Date.now();
    var localThumb = previewUrl || '';
    var localDesign = {
      id: localId,
      file: uploadRef.file,
      s3File: uploadRef.s3File || '',
      fileName: uploadRef.fileName,
      thumb: localThumb || thumbUrl(uploadRef.file, uploadRef.gangsheet),
      localThumb: localThumb,
      date: '',
      timestamp: Math.floor(Date.now() / 1000),
      gangsheet: !!uploadRef.gangsheet,
      source: 'upload',
      variantTitle: '',
      orderName: ''
    };
    localUploadedDesigns = localUploadedDesigns.filter(function(item) {
      return makeUploadMatchKey(item, !!item.gangsheet) !== makeUploadMatchKey(uploadRef.file, !!uploadRef.gangsheet);
    });
    localUploadedDesigns.unshift(localDesign);
    selectedDesignIds = uniq(selectedDesignIds.filter(function(id) { return id.indexOf('local-') !== 0; }).concat([String(localId)]));
    /* De-dupe allDesigns against ALL local uploads (not just current), to prevent brief duplicate render between upload complete and fetch */
    var localKeySet = {};
    localUploadedDesigns.forEach(function(d) { localKeySet[makeUploadMatchKey(d, !!d.gangsheet)] = true; });
    allDesigns = localUploadedDesigns.concat(allDesigns.filter(function(item) {
      return !localKeySet[makeUploadMatchKey(item, !!item.gangsheet)];
    }));
    allDesigns.sort(function(a, b) { return (b.timestamp || 0) - (a.timestamp || 0); });
    return localId;
  }

  async function resolveUploadedDesign(uploadRef, pendingId) {
    var pendingItem = pendingUploads.find(function(entry) { return entry.id === pendingId; });
    var needsImgixPreview = needsRemotePreview(uploadRef.file);

    if (needsImgixPreview) {
      /* Keep the spinner visible while imgix generates the PNG preview */
      var imgixThumb = await refreshUploadedImgixPreview(uploadRef);
      addLocalUploadedDesign(uploadRef, imgixThumb || '');
      removePendingUpload(pendingId);
      render();
    } else {
      var localPreview = pendingItem && pendingItem.previewUrl ? pendingItem.previewUrl : '';
      addLocalUploadedDesign(uploadRef, localPreview);
      removePendingUpload(pendingId);
      render();
    }

    await wait(needsImgixPreview ? 250 : 1200);
    await fetchDesigns({ silent: true, afterLoad: function() {
      selectUploadedRefs([uploadRef]);
    }});
  }

  async function handleUploadFiles(fileList, isGangSheet, fromDrop) {
    var files = Array.prototype.slice.call(fileList || []).filter(isValidUploadFile);
    if (!files.length) return;

    if (isGangSheet && files.some(function(file) { return !isValidGangSheetFile(file); })) {
      showUploadTileError('gangsheet', 'We accept the following file types png, ai, pdf');
      return;
    }

    if (isGangSheet && files.length > 1) {
      files = [files[0]];
      showToast('Gang sheet upload only accepts 1 file at a time.');
    }

    if (!isGangSheet && files.length > 10) {
      showUploadTileError('bysize', '10 file limit at a time');
      showToast('You can upload up to 10 by size files at once.');
      return;
    }

    for (var i = 0; i < files.length; i++) {
      var file = files[i];
      var pendingId = addPendingUpload(file, isGangSheet);
      try {
        var uploadRef = await uploadFileToLibrary(file, isGangSheet);
        var pendingItem = pendingUploads.find(function(entry) { return entry.id === pendingId; });
        if (pendingItem && pendingItem.previewUrl && !needsRemotePreview(uploadRef.file)) {
          uploadedPreviewMap[uploadRef.key] = pendingItem.previewUrl;
          if (uploadRef.s3File) {
            uploadedPreviewMap[normalizeFileKey(uploadRef.s3File)] = pendingItem.previewUrl;
          }
        }
        await resolveUploadedDesign(uploadRef, pendingId);
      } catch (e) {
        console.error('[My Designs] Upload error:', e.message, e);
        removePendingUpload(pendingId);
        render();
        showToast('Upload failed. Please try again.');
      }
    }
  }

  function toggleDesignSelection(id) {
    var sid = String(id);
    var item = allDesigns.find(function(entry) { return String(entry.id) === sid; });
    if (!item) return;
    var index = selectedDesignIds.indexOf(sid);
    if (index > -1) {
      selectedDesignIds.splice(index, 1);
      render();
      return;
    }

    var selectedItems = getSelectedDesigns();
    if (isSelectionDisabled(item, selectedItems)) return;

    if (sourceFilter === 'archive') {
      selectedDesignIds.push(sid);
      render();
      return;
    }

    if (IS_PICKER && !ALLOW_MULTI) {
      selectedDesignIds = [sid];
    } else {
      selectedDesignIds.push(sid);
    }
    render();
  }

  function updateSelectionBar(visibleItems) {
    var visibleIds = visibleItems.map(function(item) { return String(item.id); });
    selectedDesignIds = selectedDesignIds.filter(function(id) {
      return visibleIds.indexOf(String(id)) > -1;
    });

    var selectedItems = getSelectedDesigns();
    if (!selectionBar) return;
    if (selectedItems.length === 0) {
      selectionBar.style.display = 'none';
      if (deselectAllBtn) deselectAllBtn.style.display = 'none';
      return;
    }

    var count = selectedItems.length;
    if (deselectAllBtn) deselectAllBtn.style.display = 'inline-flex';
    var selectionNote = container.querySelector('.md-selection-bar__note');
    if (sourceFilter === 'archive') {
      selectionSummary.textContent = count + ' ' + (count === 1 ? 'item selected' : 'items selected');
      selectionPrimaryBtn.textContent = count === 1 ? 'Restore Image' : 'Restore Images';
      selectionPrimaryBtn.classList.add('md-selection-bar__btn--success');
      selectionPrimaryBtn.classList.remove('md-selection-bar__btn--primary');
      if (selectionArchiveBtn) selectionArchiveBtn.style.display = 'none';
      selectionSecondaryBtn.style.display = 'none';
      if (selectionNote) { selectionNote.textContent = ''; selectionNote.style.display = 'none'; }
      selectionBar.style.display = 'flex';
      return;
    }

    selectionPrimaryBtn.classList.add('md-selection-bar__btn--primary');
    selectionPrimaryBtn.classList.remove('md-selection-bar__btn--success');
    selectionSummary.textContent = count + ' ' + (count === 1 ? 'item selected' : 'items selected');

    if (IS_PICKER) {
      selectionPrimaryBtn.textContent = count === 1 ? 'Use Design' : 'Use Designs';
      if (selectionArchiveBtn) selectionArchiveBtn.style.display = 'inline-flex';
      selectionSecondaryBtn.style.display = 'none';
      if (selectionNote) { selectionNote.textContent = ''; selectionNote.style.display = 'none'; }
      selectionBar.style.display = 'flex';
      return;
    }

    if (selectionArchiveBtn) selectionArchiveBtn.style.display = 'inline-flex';
    var blockMultiGangSheet = count > 1 && hasSelectedGangSheet(selectedItems);
    if (blockMultiGangSheet) {
      selectionPrimaryBtn.style.display = 'none';
      selectionSecondaryBtn.style.display = 'none';
      if (selectionNote) {
        selectionNote.textContent = 'Only 1 gang sheet can be ordered at a time';
        selectionNote.style.display = '';
      }
    } else {
      selectionPrimaryBtn.style.display = '';
      selectionSecondaryBtn.style.display = '';
      if (selectionNote) { selectionNote.textContent = ''; selectionNote.style.display = 'none'; }
      var isGangSheetOnly = count === 1 && selectedItems[0].gangsheet;
      if (isGangSheetOnly) {
        selectionPrimaryBtn.textContent = 'Order as DTF Gang Sheet';
        selectionSecondaryBtn.textContent = 'Other Ordering Options';
      } else if (count === 1) {
        selectionPrimaryBtn.textContent = 'Order as DTF';
        selectionSecondaryBtn.textContent = 'Other Ordering Options';
      } else {
        selectionPrimaryBtn.textContent = 'Order as DTF';
        selectionSecondaryBtn.textContent = 'Order as UV DTF';
      }
    }

    selectionBar.style.display = 'flex';
  }

  /* --- Relative time label --- */
  function timeAgoLabel(timestamp, source) {
    if (!timestamp) return source === 'upload' ? 'Uploaded' : 'Purchased';
    var nowSec = Math.floor(Date.now() / 1000);
    var diff = nowSec - timestamp;
    if (diff < 0) diff = 0;
    var days = Math.floor(diff / 86400);
    var prefix = source === 'upload' ? 'Uploaded' : 'Purchased';
    if (days === 0) {
      var hours = Math.floor(diff / 3600);
      if (hours === 0) return prefix + ' just now';
      if (hours === 1) return prefix + ' 1 hour ago';
      return prefix + ' ' + hours + ' hours ago';
    }
    if (days === 1) return prefix + ' 1 day ago';
    return prefix + ' ' + days + ' days ago';
  }

  /* --- Toast --- */
  function showToast(msg) {
    toastEl.textContent = msg;
    toastEl.classList.add('md-toast--visible');
    setTimeout(function() { toastEl.classList.remove('md-toast--visible'); }, 3000);
  }

  /* --- Count badges --- */
  function updateCounts() {
    var archived = getArchived();
    var counts = { all: 0, uploads: 0, purchases: 0, archive: 0, allType: 0, bysize: 0, gangsheet: 0 };

    allDesigns.forEach(function(d) {
      /* Source counts respect the current type filter */
      if (typeFilter === 'bysize' && d.gangsheet) return;
      if (typeFilter === 'gangsheet' && !d.gangsheet) return;
      var isArch = archived.indexOf(String(d.id)) > -1;
      if (isArch) {
        counts.archive++;
      } else {
        counts.all++;
        if (d.source === 'upload') counts.uploads++;
        if (d.source === 'purchase') counts.purchases++;
      }
    });

    /* Type counts depend on current source filter */
    var filtered = allDesigns.filter(function(d) {
      var isArch = archived.indexOf(String(d.id)) > -1;
      if (sourceFilter === 'archive') return isArch;
      if (isArch) return false;
      if (sourceFilter === 'uploads') return d.source === 'upload';
      if (sourceFilter === 'purchases') return d.source === 'purchase';
      return true;
    });
    filtered.forEach(function(d) {
      counts.allType++;
      if (d.gangsheet) counts.gangsheet++; else counts.bysize++;
    });

    /* Update DOM */
    container.querySelectorAll('[data-source]').forEach(function(btn) {
      var key = btn.getAttribute('data-source');
      var c = key === 'all' ? counts.all : key === 'uploads' ? counts.uploads : key === 'purchases' ? counts.purchases : counts.archive;
      btn.querySelector('.md-tab__count').textContent = c;
      btn.style.display = c === 0 ? 'none' : '';
    });
    container.querySelectorAll('[data-type]').forEach(function(btn) {
      var key = btn.getAttribute('data-type');
      var c = key === 'all' ? counts.allType : key === 'bysize' ? counts.bysize : counts.gangsheet;
      btn.querySelector('.md-tab__count').textContent = c;
      btn.style.display = c === 0 ? 'none' : '';
    });
  }

  /* --- Render grid --- */
  function render() {
    var archived = getArchived();
    var q = searchQuery.toLowerCase().trim();
    var isArchiveView = sourceFilter === 'archive';

    /* Show/hide archive banner */
    archiveBanner.style.display = isArchiveView ? 'flex' : 'none';

    /* Filter designs */
    var visible = allDesigns.filter(function(d) {
      var isArch = archived.indexOf(String(d.id)) > -1;
      /* Source filter */
      if (isArchiveView) { if (!isArch) return false; }
      else { if (isArch) return false; }

      if (!isArchiveView) {
        var isLocalUploadCard = String(d.id).indexOf('local-') === 0;
        if (sourceFilter === 'uploads' && d.source !== 'upload' && !isLocalUploadCard) return false;
        if (sourceFilter === 'purchases' && d.source !== 'purchase' && !isLocalUploadCard) return false;
      }

      /* Type filter */
      if (typeFilter === 'bysize' && d.gangsheet) return false;
      if (typeFilter === 'gangsheet' && !d.gangsheet) return false;

      /* Search — fuzzy match: each search word must appear somewhere in the searchable string.
         Underscores, hyphens, and dots in filenames are treated as spaces so
         "awz test" matches "awz_test", "awz-test", "awz.test", etc. */
      if (q) {
        var typeLabel = d.gangsheet ? 'gang sheet' : 'by size';
        var sourceLabel = d.source === 'upload' ? 'upload' : 'purchase';
        var searchable = (d.fileName + ' ' + typeLabel + ' ' + sourceLabel).toLowerCase().replace(/[_\-\.]/g, ' ');
        var words = q.replace(/[_\-\.]/g, ' ').split(/\s+/).filter(function(w) { return w.length > 0; });
        var allMatch = words.every(function(w) { return searchable.indexOf(w) > -1; });
        if (!allMatch) return false;
      }

      return true;
    });

    updateSelectionBar(visible);
    var pendingVisible = getPendingVisibleUploads();
    var uploadCardsHtml = getUploadCardsHtml();

    /* Build HTML */
    if (visible.length === 0 && pendingVisible.length === 0 && !uploadCardsHtml) {
      gridEl.style.display = 'none';
      emptyEl.style.display = 'block';
      emptyEl.querySelector('.md-empty__title').textContent = isArchiveView ? 'No archived designs' : 'No designs found';
      emptyEl.querySelector('.md-empty__sub').textContent = isArchiveView ? 'Designs you archive will appear here.' : 'Try adjusting your filters or upload a new design.';
    } else {
      emptyEl.style.display = 'none';
      gridEl.style.display = 'grid';

      var html = uploadCardsHtml;
      pendingVisible.forEach(function(item) {
        html += getPendingUploadHtml(item);
      });
      visible.forEach(function(d) {
        var selectedItems = getSelectedDesigns();
        var isSelected = selectedDesignIds.indexOf(String(d.id)) > -1;
        var selectionDisabled = isArchiveView ? false : isSelectionDisabled(d, selectedItems);
        var renderThumb = getRenderThumb(d);
        var typeBadge = d.gangsheet ? '<span class="md-card__badge md-card__badge--gangsheet">Gang Sheet</span>' : '<span class="md-card__badge md-card__badge--bysize">By Size</span>';
        var selectClass = 'md-card__select';
        if (isSelected) selectClass += ' md-card__select--selected';
        if (selectionDisabled) selectClass += ' md-card__select--disabled';
        var selectSquare = '<button type="button" class="' + selectClass + '" data-select-id="' + d.id + '" aria-label="' + (isSelected ? 'Deselect design' : 'Select design') + '" aria-pressed="' + (isSelected ? 'true' : 'false') + '">' +
          '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3.5 8 6.5 11 12.5 5"></polyline></svg>' +
        '</button>';

        var bottomAction = '';
        if (isArchiveView) {
          bottomAction = '<div class="md-card__action-row">' +
                           '<button class="md-card__view-img" data-view-src="' + renderThumb + '" data-view-name="' + d.fileName.replace(/"/g, '&quot;') + '">View<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button>' +
                           '<button class="md-card__action-restore" data-restore-id="' + d.id + '">Restore</button>' +
                         '</div>';
        } else {
          bottomAction = '<div class="md-card__action-row">' +
                           '<button class="md-card__view-img" data-view-src="' + renderThumb + '" data-view-name="' + d.fileName.replace(/"/g, '&quot;') + '">View<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button>' +
                           '<button class="md-card__action-btn md-card__archive-icon" data-archive-id="' + d.id + '" aria-label="Archive" data-tooltip="Archive">' +
                             '<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M6 6l1 14h10l1-14"/><path d="M10 10v6"/><path d="M14 10v6"/></svg>' +
                           '</button>' +
                           '<button class="md-card__trash" data-archive-id="' + d.id + '" aria-label="Archive" data-tooltip="Archive">' +
                             '<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M6 6l1 14h10l1-14"/><path d="M10 10v6"/><path d="M14 10v6"/></svg>' +
                           '</button>' +
                         '</div>';
        }

        var cardClass = 'md-card' + (d.gangsheet ? ' md-card--gangsheet' : '');
        if (isSelected) cardClass += ' md-card--selected';
        if (selectionDisabled) cardClass += ' md-card--selection-disabled';
        html += '<div class="' + cardClass + '" data-design-id="' + d.id + '">' +
          '<div class="md-card__thumb">' +
            selectSquare +
            typeBadge +
            '<img src="' + renderThumb + '" alt="' + d.fileName.replace(/"/g, '&quot;') + '" loading="lazy" onerror="this.style.display=\'none\'">' +
          '</div>' +
          '<div class="md-card__info">' +
            '<p class="md-card__name" data-tooltip="' + d.fileName.replace(/"/g, '&quot;') + '">' + smartFileName(d.fileName, 22) + '</p>' +
            '<p class="md-card__meta">' +
              '<span>' + timeAgoLabel(d.timestamp, d.source) + '</span>' +
            '</p>' +
          '</div>' +
          '<div class="md-card__action">' + bottomAction + '</div>' +
        '</div>';
      });

      gridEl.innerHTML = html;
    }

    updateCounts();
    syncRowHeights();
  }

  /* Match all grid rows to row 1's height. Row 1 is taller than later rows
     when the dual upload card's content exceeds the image-card intrinsic
     height (e.g. at 5 per row). We measure the dual card and expose its
     height to CSS as --md-row-height; CSS uses it via grid-auto-rows.

     Mobile note: at <=749px the dual card spans 2 rows (grid-row: 1 / span 2),
     so its offsetHeight is ~2× one row. Feeding that back into grid-auto-rows
     would double the row min-height each frame until the ResizeObserver loop
     guard kicks in, leaving the upload box gigantic. We skip the row-matching
     trick on mobile — the 1- and 2-col layouts size fine naturally. */
  var _rowHeightObserver = null;
  function syncRowHeights() {
    if (!gridEl) return;
    var dual = gridEl.querySelector('.md-upload-card--dual');
    if (_rowHeightObserver) {
      _rowHeightObserver.disconnect();
      _rowHeightObserver = null;
    }
    var isMobile = window.matchMedia && window.matchMedia('(max-width: 749px)').matches;
    if (!dual || isMobile || typeof ResizeObserver === 'undefined') {
      gridEl.style.removeProperty('--md-row-height');
      return;
    }
    _rowHeightObserver = new ResizeObserver(function(entries) {
      for (var i = 0; i < entries.length; i++) {
        /* Use offsetHeight (border-box) so the value includes the dual
           card's padding + border. contentRect.height excludes those and
           leaves row 2 ~26px shorter than row 1. */
        var h = entries[i].target.offsetHeight;
        if (h > 0) gridEl.style.setProperty('--md-row-height', h + 'px');
      }
    });
    _rowHeightObserver.observe(dual);
  }

  /* --- Process API data --- */
  function processItem(raw, source, isGang) {
    var gang = typeof raw.gangsheet !== 'undefined' ? !!raw.gangsheet : !!isGang;

    /* Filename: prefer file_name from API, fall back to URL extraction */
    var fileName = (raw.file_name && raw.file_name.length > 0) ? raw.file_name : extractFileName(raw.file || '');

    /* Date: use human-readable string fields; formatted_date is a Unix timestamp (number) */
    var dateStr = raw.uploaded_date || raw.order_date || raw.purchased_at || '';
    if (typeof dateStr !== 'string') dateStr = '';
    if (source === 'upload' && dateStr.indexOf('Purchased') > -1) {
      dateStr = dateStr.replace('Purchased', 'Uploaded');
    }

    /* Stable ID: photo_id (uploads) or derive from file URL (orders) */
    var id = raw.photo_id || raw.id || '';
    if (!id && raw.file) {
      id = source + '-' + raw.file.split('/').pop().split('?')[0];
    }
    if (!id) {
      id = source + '-' + Math.random().toString(36).substr(2,9);
    }

    /* Timestamp for sorting (numeric, higher = newer) */
    var ts = 0;
    if (typeof raw.formatted_date === 'number') {
      ts = raw.formatted_date;
    } else if (typeof raw.formatted_date === 'string' && raw.formatted_date.length > 0) {
      ts = new Date(raw.formatted_date).getTime() / 1000 || 0;
    }

    return {
      id: id,
      file: raw.file || '',
      s3File: isVectorFile(raw.file || '') ? (raw.file || '').replace(IMGIX_HOST, S3_HOST).split('?')[0] : '',
      fileName: fileName,
      thumb: thumbUrl(raw.file || '', gang),
      date: dateStr,
      timestamp: ts,
      gangsheet: gang,
      source: source,
      variantTitle: raw.variant_title || '',
      orderName: raw.order_name || ''
    };
  }

  /* --- Event: Source tabs --- */
  container.querySelectorAll('[data-source]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      container.querySelectorAll('[data-source]').forEach(function(b) { b.classList.remove('md-tab--active'); });
      btn.classList.add('md-tab--active');
      sourceFilter = btn.getAttribute('data-source');
      clearSelection();
      render();
    });
  });

  /* --- Event: Per-row toggle from the standalone section ---
     The standalone My Designs section (sections/my-designs.liquid) owns the
     Per Row picker. When the user changes cols, the upload card layout
     changes shape (e.g. 1 dual card → 2 single cards at 5-per-row), so the
     section dispatches `mds:cols-change` and we rebuild the grid. */
  (function bindMdsColsChange() {
    var standalone = container.closest && container.closest('.md-standalone');
    if (!standalone) return;
    standalone.addEventListener('mds:cols-change', function() { render(); });
  })();

  /* --- Event: Type tabs --- */
  container.querySelectorAll('[data-type]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      container.querySelectorAll('[data-type]').forEach(function(b) { b.classList.remove('md-tab--active'); });
      btn.classList.add('md-tab--active');
      typeFilter = btn.getAttribute('data-type');
      clearSelection();
      render();
    });
  });

  /* --- Event: Search --- */
  searchInput.addEventListener('input', function() {
    searchQuery = searchInput.value;
    searchClear.style.display = searchQuery ? 'block' : 'none';
    clearSelection();
    render();
  });
  searchClear.addEventListener('click', function() {
    searchInput.value = '';
    searchQuery = '';
    searchClear.style.display = 'none';
    clearSelection();
    render();
  });

  uploadInputs.forEach(function(input) {
    input.addEventListener('change', function(e) {
      var isGangSheet = input.getAttribute('data-upload-target') === 'gangsheet';
      handleUploadFiles(e.target.files, isGangSheet, false);
      input.value = '';
    });
  });

  container.addEventListener('click', function(e) {
    var uploadBtn = e.target.closest('[data-upload-open]');
    if (!uploadBtn) return;
    e.preventDefault();
    e.stopPropagation();
    var target = uploadBtn.getAttribute('data-upload-open');
    var input = getUploadInput(target);
    if (input) input.click();
  });

  container.addEventListener('dragover', function(e) {
    var uploadTile = e.target.closest('[data-upload-dropzone]');
    if (!uploadTile) return;
    e.preventDefault();
    uploadTile.classList.add('md-upload-tile--dragover');
  });

  container.addEventListener('dragleave', function(e) {
    var uploadTile = e.target.closest('[data-upload-dropzone]');
    if (!uploadTile) return;
    if (uploadTile.contains(e.relatedTarget)) return;
    uploadTile.classList.remove('md-upload-tile--dragover');
  });

  container.addEventListener('drop', function(e) {
    var uploadTile = e.target.closest('[data-upload-dropzone]');
    if (!uploadTile) return;
    e.preventDefault();
    uploadTile.classList.remove('md-upload-tile--dragover');
    var target = uploadTile.getAttribute('data-upload-dropzone');
    handleUploadFiles(e.dataTransfer.files, target === 'gangsheet', true);
  });

  /* --- Event: Restore / Archive / Delete (delegated) --- */
  container.addEventListener('click', function(e) {
    var selectBtn = e.target.closest('[data-select-id]');
    if (selectBtn) {
      e.preventDefault();
      e.stopPropagation();
      if (selectBtn.classList.contains('md-card__select--disabled')) return;
      toggleDesignSelection(selectBtn.getAttribute('data-select-id'));
      return;
    }

    var thumbArea = e.target.closest('.md-card__thumb');
    if (thumbArea && !e.target.closest('.md-card__trash') && !e.target.closest('.md-card__badge')) {
      var thumbCard = thumbArea.closest('.md-card[data-design-id]');
      if (thumbCard) {
        e.preventDefault();
        e.stopPropagation();
        toggleDesignSelection(thumbCard.getAttribute('data-design-id'));
        return;
      }
    }

    /* Restore button — unarchive and re-render */
    var restoreBtn = e.target.closest('[data-restore-id]');
    if (restoreBtn) {
      e.preventDefault();
      e.stopPropagation();
      var id = restoreBtn.getAttribute('data-restore-id');
      var card = container.querySelector('.md-card[data-design-id="' + id + '"]');
      unarchiveItem(id);
      if (card) {
        card.classList.add('md-card--fading');
        setTimeout(function() { render(); }, 300);
      } else {
        render();
      }
      showToast('Design restored');
      return;
    }

    /* Archive button — open confirmation modal */
    var archBtn = e.target.closest('[data-archive-id]');
    if (archBtn) {
      e.preventDefault();
      e.stopPropagation();
      pendingArchiveIds = [];
      pendingArchiveId = archBtn.getAttribute('data-archive-id');
      var design = allDesigns.find(function(d) { return String(d.id) === String(pendingArchiveId); });
      archiveModalName.textContent = design ? design.fileName : 'this design';
      archiveOverlay.style.display = 'flex';
      return;
    }

    /* Delete button — open delete modal */
    var delBtn = e.target.closest('[data-delete-id]');
    if (delBtn) {
      e.preventDefault();
      pendingDeleteId = delBtn.getAttribute('data-delete-id');
      var design = allDesigns.find(function(d) { return String(d.id) === String(pendingDeleteId); });
      modalName.textContent = design ? design.fileName : 'this design';
      modalOverlay.style.display = 'flex';
      return;
    }
  });

  /* --- Modal cancel --- */
  modalCancel.addEventListener('click', function() {
    modalOverlay.style.display = 'none';
    pendingDeleteId = null;
  });
  modalOverlay.addEventListener('click', function(e) {
    if (e.target === modalOverlay) {
      modalOverlay.style.display = 'none';
      pendingDeleteId = null;
    }
  });

  /* --- Modal confirm delete --- */
  modalConfirm.addEventListener('click', function() {
    if (!pendingDeleteId) return;
    var id = pendingDeleteId;
    modalOverlay.style.display = 'none';

    /* Fade out card */
    var card = container.querySelector('.md-card[data-design-id="' + id + '"]');
    if (card) card.classList.add('md-card--fading');

    /* Call delete API */
    fetch(API + '/uploads/deleteData?customer_id=' + CUSTOMER_ID + '&photo_id=' + id)
      .then(function() {
        /* Remove from data */
        allDesigns = allDesigns.filter(function(d) { return String(d.id) !== String(id); });
        unarchiveItem(id);
        setTimeout(function() { render(); }, 300);
        showToast('Design permanently deleted');
      })
      .catch(function() {
        showToast('Failed to delete. Please try again.');
        if (card) card.classList.remove('md-card--fading');
      });

    pendingDeleteId = null;
  });

  /* --- Archive Confirm Modal --- */
  archiveModalCancel.addEventListener('click', function() {
    archiveOverlay.style.display = 'none';
    pendingArchiveId = null;
    pendingArchiveIds = [];
  });
  archiveOverlay.addEventListener('click', function(e) {
    if (e.target === archiveOverlay) {
      archiveOverlay.style.display = 'none';
      pendingArchiveId = null;
      pendingArchiveIds = [];
    }
  });
  archiveModalConfirm.addEventListener('click', function() {
    if (!pendingArchiveId && !pendingArchiveIds.length) return;
    archiveOverlay.style.display = 'none';
    var ids = pendingArchiveIds.length ? pendingArchiveIds.slice() : [pendingArchiveId];
    ids.forEach(function(id) {
      archiveItem(id);
      var card = container.querySelector('.md-card[data-design-id="' + id + '"]');
      if (card) {
        card.classList.add('md-card--fading');
      }
    });
    setTimeout(function() { render(); }, 300);
    showToast(ids.length === 1 ? 'Design archived' : 'Designs archived');
    pendingArchiveId = null;
    pendingArchiveIds = [];
  });

  /* --- Ordering Options Modal --- */
  var ooOverlay = container.querySelector('.md-oo-overlay');
  var ooClose = container.querySelector('.md-oo-close');
  var ooCurrentFile = '';

  /* Open modal from "More Ordering Options" button */
  container.addEventListener('click', function(e) {
    var ooBtn = e.target.closest('[data-oo-file]');
    if (ooBtn) {
      e.preventDefault();
      e.stopPropagation();
      ooCurrentFile = decodeURIComponent(ooBtn.getAttribute('data-oo-file'));
      var vp = decodeURIComponent(ooBtn.getAttribute('data-oo-vp') || '');
      /* Set hrefs on all product cards — append vector dimension params if present */
      ooOverlay.querySelectorAll('.md-oo-card').forEach(function(card) {
        var handle = card.getAttribute('data-handle');
        card.href = '/products/' + handle + '?file=' + encodeURIComponent(ooCurrentFile) + vp;
      });
      ooOverlay.style.display = 'flex';
    }
  });

  /* Close modal */
  if (ooClose) {
    ooClose.addEventListener('click', function() { ooOverlay.style.display = 'none'; });
  }
  if (ooOverlay) {
    ooOverlay.addEventListener('click', function(e) {
      if (e.target === ooOverlay) ooOverlay.style.display = 'none';
    });
  }

  /* --- Gang Sheet Ordering Options Modal --- */
  var ooGsOverlay = container.querySelector('.md-oo-gs-overlay');
  var ooGsClose = container.querySelector('.md-oo-gs-close');

  /* Open gang sheet modal from "More Ordering Options" button */
  container.addEventListener('click', function(e) {
    var gsBtn = e.target.closest('[data-oo-gs-file]');
    if (gsBtn) {
      e.preventDefault();
      e.stopPropagation();
      var gsFile = decodeURIComponent(gsBtn.getAttribute('data-oo-gs-file'));
      var gsVp = decodeURIComponent(gsBtn.getAttribute('data-oo-vp') || '');
      /* Set hrefs on all gang sheet product cards — append vector dimension params if present */
      ooGsOverlay.querySelectorAll('.md-oo-gs-card').forEach(function(card) {
        var handle = card.getAttribute('data-gs-handle');
        var variant = card.getAttribute('data-gs-variant');
        var url = '/products/' + handle + '?';
        if (variant) url += 'variant=' + variant + '&';
        url += 'file=' + encodeURIComponent(gsFile) + gsVp;
        card.href = url;
      });
      ooGsOverlay.style.display = 'flex';
    }
  });

  /* Close gang sheet modal */
  if (ooGsClose) {
    ooGsClose.addEventListener('click', function() { ooGsOverlay.style.display = 'none'; });
  }
  if (ooGsOverlay) {
    ooGsOverlay.addEventListener('click', function(e) {
      if (e.target === ooGsOverlay) ooGsOverlay.style.display = 'none';
    });
  }

  if (selectionPrimaryBtn) {
    selectionPrimaryBtn.addEventListener('click', function() {
      var selectedItems = getSelectedDesigns();
      if (selectedItems.length === 0) return;
      if (sourceFilter === 'archive') {
        selectedItems.forEach(function(item) {
          unarchiveItem(item.id);
        });
        clearSelection();
        render();
        showToast(selectedItems.length === 1 ? 'Image restored' : 'Images restored');
        return;
      }
      if (IS_PICKER) {
        container.dispatchEvent(new CustomEvent('md-picker:use-designs', {
          bubbles: true,
          detail: { items: selectedItems }
        }));
        // Clear the selection + re-render so the action bar dismisses after
        // the customer\'s pick is applied. The modal picker doesn\'t care
        // (its overlay hides anyway), but the inline dtfut Previous Designs
        // tab would otherwise show a stale "1 item selected" bar pinned to
        // the upload section post-upload.
        clearSelection();
        render();
        return;
      }
      if (selectedItems.length === 1 && selectedItems[0].gangsheet) {
        window.location.href = reorderUrl(selectedItems[0]);
        return;
      }
      if (selectedItems.length === 1) {
        window.location.href = reorderUrl(selectedItems[0]);
        return;
      }
      openBulkBySizeSelection('/products/dtf-transfers', selectedItems);
    });
  }

  if (selectionArchiveBtn) {
    selectionArchiveBtn.addEventListener('click', function() {
      var selectedItems = getSelectedDesigns();
      if (selectedItems.length === 0 || sourceFilter === 'archive') return;
      pendingArchiveId = null;
      pendingArchiveIds = selectedItems.map(function(item) { return String(item.id); });
      archiveModalName.textContent = selectedItems.length === 1 ? selectedItems[0].fileName : (selectedItems.length + ' selected designs');
      archiveOverlay.style.display = 'flex';
    });
  }

  if (selectionSecondaryBtn) {
    selectionSecondaryBtn.addEventListener('click', function() {
      var selectedItems = getSelectedDesigns();
      if (selectedItems.length === 0) return;
      if (selectedItems.length === 1 && selectedItems[0].gangsheet) {
        var gangSheetItem = selectedItems[0];
        var gsVp = vectorParams(gangSheetItem);
        ooGsOverlay.querySelectorAll('.md-oo-gs-card').forEach(function(card) {
          var handle = card.getAttribute('data-gs-handle');
          var variant = card.getAttribute('data-gs-variant');
          var url = '/products/' + handle + '?';
          if (variant) url += 'variant=' + variant + '&';
          url += 'file=' + encodeURIComponent(gangSheetItem.file.split('?')[0]) + gsVp;
          card.href = url;
        });
        ooGsOverlay.style.display = 'flex';
        return;
      }
      if (selectedItems.length === 1) {
        var bySizeItem = selectedItems[0];
        var bsVp = vectorParams(bySizeItem);
        ooCurrentFile = bySizeItem.file.split('?')[0];
        ooOverlay.querySelectorAll('.md-oo-card').forEach(function(card) {
          var handle = card.getAttribute('data-handle');
          card.href = '/products/' + handle + '?file=' + encodeURIComponent(ooCurrentFile) + bsVp;
        });
        ooOverlay.style.display = 'flex';
        return;
      }
      openBulkBySizeSelection('/products/uv-dtf-stickers-decals-by-size', selectedItems);
    });
  }

  if (deselectAllBtn) {
    deselectAllBtn.addEventListener('click', function() {
      clearSelection();
      render();
    });
  }

  /* --- Image Lightbox --- */
  var lightbox = container.querySelector('.md-lightbox');
  var lightboxImg = lightbox ? lightbox.querySelector('.md-lightbox__img') : null;
  var lightboxClose = lightbox ? lightbox.querySelector('.md-lightbox__close') : null;
  var lightboxSpinner = lightbox ? lightbox.querySelector('.md-lightbox__spinner') : null;

  /* Stash the lightbox's original parent so we can put it back on
     close. The lightbox needs to live in <body> while open so its
     position:fixed escapes any transformed/filtered ancestor (the
     gang-sheet picker modal traps it inside the centered modal box,
     making the dark overlay narrow and white space visible outside
     that area). */
  var lightboxOriginalParent = lightbox ? lightbox.parentNode : null;

  function openLightbox(src, alt) {
    if (!lightbox || !lightboxImg) return;
    /* Move to body so the dark backdrop covers the full viewport */
    if (lightbox.parentNode !== document.body) {
      document.body.appendChild(lightbox);
    }
    /* Show spinner, hide image until loaded */
    lightboxImg.classList.add('md-lightbox__img--loading');
    if (lightboxSpinner) lightboxSpinner.classList.add('md-lightbox__spinner--visible');
    /* Use a higher-res version for the lightbox (handle both standard and vector/convert thumb URLs) */
    var hiRes = src.replace(/h=300/, 'h=1200').replace(/q=10/, 'q=70')
                   .replace(/w=600&auto/, 'w=2000&auto').replace(/q=15/, 'q=70');
    lightboxImg.onload = function() {
      lightboxImg.classList.remove('md-lightbox__img--loading');
      if (lightboxSpinner) lightboxSpinner.classList.remove('md-lightbox__spinner--visible');
    };
    lightboxImg.onerror = function() {
      lightboxImg.classList.remove('md-lightbox__img--loading');
      if (lightboxSpinner) lightboxSpinner.classList.remove('md-lightbox__spinner--visible');
    };
    lightboxImg.src = hiRes;
    lightboxImg.alt = alt || '';
    lightbox.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    if (!lightbox) return;
    lightbox.style.display = 'none';
    lightboxImg.onload = null;
    lightboxImg.onerror = null;
    lightboxImg.src = '';
    lightboxImg.classList.remove('md-lightbox__img--loading');
    if (lightboxSpinner) lightboxSpinner.classList.remove('md-lightbox__spinner--visible');
    document.body.style.overflow = '';
    /* Put the lightbox back where we found it so subsequent renders /
       container queries don't get confused by a missing element. */
    if (lightboxOriginalParent && lightbox.parentNode !== lightboxOriginalParent) {
      lightboxOriginalParent.appendChild(lightbox);
    }
  }

  /* Click "View Image" button */
  container.addEventListener('click', function(e) {
    var btn = e.target.closest('.md-card__view-img');
    if (btn) {
      e.preventDefault();
      openLightbox(btn.getAttribute('data-view-src'), btn.getAttribute('data-view-name'));
    }
  });

  /* Close lightbox — close on EXPLICIT X click, ESC key, OR any click
     inside the lightbox that's not on the image itself or the close
     button. Earlier this only fired when `e.target === lightbox`, but
     when the lightbox uses overflow:auto + align-items:flex-start
     (gang-sheet override in product-page-popups.liquid) clicks can
     land on the inner scrollable container instead of the lightbox
     root. Checking "is the click outside the image and outside the
     close button" works regardless of intermediate scroll wrappers. */
  if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
  if (lightbox) {
    lightbox.addEventListener('click', function(e) {
      if (e.target === lightboxImg) return;
      if (e.target.closest && e.target.closest('.md-lightbox__close')) return;
      closeLightbox();
    });
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && lightbox && lightbox.style.display !== 'none') closeLightbox();
  });

  /* --- Listen for archive changes from Recent Designs → re-render --- */
  window.addEventListener('nt-archive-changed', function(e) {
    if (e.detail && e.detail.source === 'recent-designs') {
      render();
    }
  });

  /* --- Init --- */
  fetchDesigns();

  /* --- Picker modal dismiss behaviour ---
     Close the "Choose a previously uploaded design" modal when the user clicks the
     backdrop (anything outside the white panel), the close button, or
     presses Escape. The overlay CSS uses display:grid !important to beat
     jQuery fadeIn's inline style, so we must close with setProperty()
     using !important as well. */
  if (IS_PICKER) {
    var pickerOverlay = container.closest('.customTabelPopup__overlay-3');
    var pickerModal = container.closest('.customTabelPopup--md-picker');
    var closePickerOverlay = function() {
      if (!pickerOverlay) return;
      pickerOverlay.style.setProperty('display', 'none', 'important');
    };
    if (pickerOverlay) {
      pickerOverlay.addEventListener('click', function(e) {
        if (e.target === pickerOverlay) closePickerOverlay();
      });
      document.addEventListener('keydown', function(e) {
        if (e.key !== 'Escape' && e.key !== 'Esc') return;
        if (getComputedStyle(pickerOverlay).display === 'none') return;
        closePickerOverlay();
      });
      var pickerClose = pickerOverlay.querySelector('.customTabelPopup__close');
      if (pickerClose) {
        /* The existing inline onclick uses style.display='none' which can't
           beat our !important rule; replace it with a matching close. */
        pickerClose.onclick = null;
        pickerClose.addEventListener('click', function(e) {
          e.stopPropagation();
          closePickerOverlay();
        });
      }
    }
    /* Guard: prevent clicks inside the white panel from bubbling to the
       backdrop handler above (so scrollbar clicks, etc. don't dismiss). */
    if (pickerModal) {
      pickerModal.addEventListener('click', function(e) { e.stopPropagation(); });
    }
    /* Expose closer so the USE DESIGNS bridge can cleanly close too.
       Only set when this picker actually owns an overlay — the dtf-upload-tabs
       "Recent Designs" panel renders my-designs-panel with picker:true but
       has no .customTabelPopup__overlay-3 ancestor, and we don't want it to
       overwrite the modal picker's working closer. */
    if (pickerOverlay) window.__closeMdPicker = closePickerOverlay;

    /* Reset picker to a fresh state (no selection, default tab, empty
       search, scrolled to top) each time the overlay is opened. */
    var resetPickerState = function() {
      sourceFilter = 'all';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      var clearBtn = container.querySelector('.md-search-clear');
      if (clearBtn) clearBtn.style.display = 'none';
      container.querySelectorAll('[data-source]').forEach(function(b) { b.classList.remove('md-tab--active'); });
      var allTab = container.querySelector('[data-source="all"]');
      if (allTab) allTab.classList.add('md-tab--active');
      clearSelection();
      if (gridEl) gridEl.scrollTop = 0;
      if (pickerModal) pickerModal.scrollTop = 0;
      render();
    };
    /* Body scroll lock: prevent the product page behind the modal from
       scrolling when the user drags on mobile. iOS-safe via position:fixed. */
    function lockBodyScroll() {
      if (document.body.hasAttribute('data-md-picker-locked')) return;
      var y = window.scrollY || window.pageYOffset || 0;
      document.body.setAttribute('data-md-picker-locked', String(y));
      document.body.style.position = 'fixed';
      document.body.style.top = '-' + y + 'px';
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
    }
    function unlockBodyScroll() {
      if (!document.body.hasAttribute('data-md-picker-locked')) return;
      var y = parseInt(document.body.getAttribute('data-md-picker-locked'), 10) || 0;
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      document.body.removeAttribute('data-md-picker-locked');
      window.scrollTo(0, y);
    }
    if (pickerOverlay && typeof MutationObserver !== 'undefined') {
      var wasVisible = getComputedStyle(pickerOverlay).display !== 'none';
      if (wasVisible) lockBodyScroll();
      new MutationObserver(function() {
        var nowVisible = getComputedStyle(pickerOverlay).display !== 'none';
        if (nowVisible && !wasVisible) { resetPickerState(); lockBodyScroll(); }
        if (!nowVisible && wasVisible) unlockBodyScroll();
        wasVisible = nowVisible;
      }).observe(pickerOverlay, { attributes: true, attributeFilter: ['style', 'class'] });
    }
  }

})();
</script>
