{%- comment -%}
  My Designs panel — shared between the standalone page and the
  product-page "Choose a previously uploaded design" picker modal.
  Pass `picker: true` to render in picker mode (hides delete/archive
  actions, shows USE DESIGNS in the selection bar).
{%- endcomment -%}

{%- assign md_is_picker = picker | default: false -%}
{%- assign md_forced_type = forced_type | default: '' -%}
{%- assign md_allow_multi = allow_multi | default: false -%}

<div class="md-container{% if md_is_picker %} md-container--picker{% endif %}{% if md_forced_type != '' %} md-container--forced-type md-container--forced-{{ md_forced_type }}{% endif %}" data-customer-id="{{ customer.id }}"{% if md_is_picker %} data-picker="true"{% endif %}{% if md_forced_type != '' %} data-forced-type="{{ md_forced_type }}"{% endif %}{% if md_allow_multi %} data-allow-multi="true"{% endif %}>

  {%- comment -%} ===== FILTER BAR ===== {%- endcomment -%}
  <div class="md-header">
    <h2 class="md-title">My Designs</h2>
  </div>

  <div class="md-filters">
    <div class="md-filters__row">
      <div class="md-filters__groups">
        <div class="md-filters__group" data-filter-group="source">
          <button class="md-tab md-tab--active" data-source="all">All Images <span class="md-tab__count">0</span></button>
          <button class="md-tab" data-source="purchases">Purchases <span class="md-tab__count">0</span></button>
          <button class="md-tab" data-source="uploads">Uploads <span class="md-tab__count">0</span></button>
          <button class="md-tab" data-source="archive">Archive <span class="md-tab__count">0</span></button>
        </div>
        <div class="md-filters__group" data-filter-group="type">
          <button class="md-tab md-tab--active" data-type="all">All Types <span class="md-tab__count">0</span></button>
          <button class="md-tab" data-type="bysize">By Size <span class="md-tab__count">0</span></button>
          <button class="md-tab" data-type="gangsheet">Gang Sheet <span class="md-tab__count">0</span></button>
        </div>
      </div>
      <div class="md-filters__search">
        <svg class="md-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" class="md-search-input" placeholder="Search by file name..." autocomplete="off">
        <button type="button" class="md-search-clear" style="display:none">&times;</button>
      </div>
    </div>
  </div>
  <div class="md-selection-toolbar">
    <button type="button" class="md-deselect-all" style="display:none">Deselect All</button>
  </div>

  {%- comment -%} ===== ARCHIVE WARNING BANNER ===== {%- endcomment -%}
  <div class="md-archive-banner" style="display:none">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    <span>These images have been archived. You can restore them from here.</span>
  </div>

  {%- comment -%} ===== LOADING STATE ===== {%- endcomment -%}
  <div class="md-loading">
    <div class="md-loading__spinner"></div>
    <span>Loading your designs...</span>
  </div>

  {%- comment -%} ===== IMAGE GRID ===== {%- endcomment -%}
  <div class="md-grid" style="display:none"></div>
  <div class="md-upload-inputs" hidden>
    <input type="file" class="md-upload-input" data-upload-target="bysize" accept=".png,.jpg,.jpeg,.webp,.svg,.pdf,.ai,.eps,.psd,.tif,.tiff" multiple>
    <input type="file" class="md-upload-input" data-upload-target="gangsheet" accept=".png,.pdf,.ai">
  </div>

  {%- comment -%} ===== EMPTY STATE ===== {%- endcomment -%}
  <div class="md-empty" style="display:none">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
    <p class="md-empty__title">No designs found</p>
    <p class="md-empty__sub">Try adjusting your filters or upload a new design.</p>
  </div>

  {%- comment -%} ===== SELECTION ACTION BAR ===== {%- endcomment -%}
  <div class="md-selection-bar" style="display:none" aria-live="polite">
    <div class="md-selection-bar__summary-group">
      <button type="button" class="md-selection-bar__btn md-selection-bar__btn--danger" data-selection-action="archive">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"/><path d="M7 7l1 12a1.5 1.5 0 0 0 1.49 1.38h5.02A1.5 1.5 0 0 0 16 19L17 7"/><path d="M10 11v5"/><path d="M14 11v5"/></svg>
        <span>Archive</span>
      </button>
      <div class="md-selection-bar__summary">0 items selected</div>
    </div>
    <div class="md-selection-bar__note" aria-live="polite"></div>
    <div class="md-selection-bar__actions">
      <button type="button" class="md-selection-bar__btn md-selection-bar__btn--primary" data-selection-action="primary"></button>
      <button type="button" class="md-selection-bar__btn md-selection-bar__btn--secondary" data-selection-action="secondary"></button>
    </div>
  </div>

  {%- comment -%} ===== DELETE MODAL ===== {%- endcomment -%}
  <div class="md-modal-overlay" style="display:none">
    <div class="md-modal">
      <h3 class="md-modal__title">Delete Permanently</h3>
      <p class="md-modal__text">Are you sure you want to delete "<span class="md-modal__name"></span>"? This action cannot be undone.</p>
      <div class="md-modal__actions">
        <button type="button" class="md-modal__cancel">Cancel</button>
        <button type="button" class="md-modal__confirm">Yes, delete permanently</button>
      </div>
    </div>
  </div>

  {%- comment -%} ===== ARCHIVE CONFIRM MODAL ===== {%- endcomment -%}
  <div class="md-archive-overlay" style="display:none">
    <div class="md-modal">
      <h3 class="md-modal__title">Archive Design</h3>
      <p class="md-modal__text">Are you sure you want to archive "<span class="md-archive-modal__name"></span>"? You can restore it later from the Archive tab.</p>
      <div class="md-modal__actions">
        <button type="button" class="md-archive-modal__cancel">Cancel</button>
        <button type="button" class="md-archive-modal__confirm">Yes, archive</button>
      </div>
    </div>
  </div>

  {%- comment -%} ===== IMAGE LIGHTBOX MODAL ===== {%- endcomment -%}
  <div class="md-lightbox" style="display:none">
    <button class="md-lightbox__close" aria-label="Close">&times;</button>
    <div class="md-lightbox__spinner"><div></div><div></div><div></div><p class="md-lightbox__spinner-text">Loading image, may take a few seconds</p></div>
    <img class="md-lightbox__img" src="" alt="">
  </div>

