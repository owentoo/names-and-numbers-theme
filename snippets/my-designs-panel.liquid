{%- comment -%} ============================= CSS ============================= {%- endcomment -%}
<style>
  /* --- Container & Header --- */
  .md-container { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #111; position: relative; }
  .md-header { margin-bottom: 20px; }
  .md-title { font-size: 22px; font-weight: 700; color: #111; margin: 0; }
  .md-selection-toolbar { display: flex; justify-content: flex-end; min-height: 20px; margin: 8px 0 20px; }
  .md-deselect-all { background: none; border: none; padding: 0; color: #019aff; font-size: 13px; font-weight: 600; font-family: inherit; cursor: pointer; }
  .md-deselect-all:hover { color: #0079cc; text-decoration: underline; }

  /* --- Filter Bar --- */
  .md-filters { margin-bottom: 20px; }
  .md-filters__row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .md-filters__groups { display: flex; justify-content: space-between; width: 100%; gap: 12px; flex-wrap: wrap; }
  .md-filters__group { display: inline-flex; background: #f3f4f6; border-radius: 8px; padding: 3px; gap: 2px; }
  .md-tab { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; border: none; border-radius: 6px; background: transparent; color: #6b7280; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.15s; white-space: nowrap; font-family: inherit; }
  .md-tab:hover { color: #019AFF; background: #e0f2ff; }
  .md-tab--active { background: #019AFF; color: #fff !important; box-shadow: 0 1px 3px rgba(1,154,255,0.3); }
  .md-tab--active:hover { background: #019AFF; color: #fff !important; }
  .md-tab__count { font-size: 11px; font-weight: 600; background: #e5e7eb; color: #6b7280; border-radius: 10px; padding: 1px 7px; min-width: 20px; text-align: center; line-height: 16px; }
  .md-tab--active .md-tab__count { background: rgba(255,255,255,0.25); color: #fff; }

  /* --- Search --- */
  .md-filters__search { position: relative; min-width: 220px; flex-shrink: 0; }
  .md-search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #9ca3af; pointer-events: none; }
  .md-search-input { width: 100%; padding: 8px 32px 8px 36px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; font-family: inherit; color: #111; background: #fff; outline: none; transition: border-color 0.15s; box-sizing: border-box; }
  .md-search-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
  .md-search-input::placeholder { color: #9ca3af; }
  .md-search-clear { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #9ca3af; font-size: 18px; cursor: pointer; padding: 0 4px; line-height: 1; }
  .md-search-clear:hover { color: #374151; }

  /* --- Archive Banner --- */
  .md-archive-banner { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: #fefce8; border: 1px solid #fde68a; border-radius: 8px; margin-bottom: 20px; font-size: 13px; color: #854d0e; }
  .md-archive-banner svg { flex-shrink: 0; color: #ca8a04; }

  /* --- Loading --- */
  .md-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 80px 20px; color: #94a3b8; font-size: 14px; }
  .md-loading__spinner { width: 32px; height: 32px; border: 3px solid #e2e8f0; border-top-color: #3b82f6; border-radius: 50%; animation: md-spin 0.7s linear infinite; }
  @keyframes md-spin { to { transform: rotate(360deg); } }

  /* --- Grid --- */
  .md-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }

  /* All grid rows match row 1 height. JS sets --md-row-height to the
     measured dual upload card height when present; otherwise falls back to
     auto so rows size to their content. min-height on each card is the
     reliable lever — grid-auto-rows alone proved flaky with the var()
     fallback inside minmax(). */
  .md-grid { grid-auto-rows: minmax(var(--md-row-height, auto), auto); }
  .md-grid > .md-card { min-height: var(--md-row-height, auto); }

  /* --- Card --- */
  .md-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; transition: box-shadow 0.2s, transform 0.15s, opacity 0.3s; position: relative; display: flex; flex-direction: column; }
  /* Push the View/trash row to the bottom so it sits flush even when grid
     stretches the card to a taller row height (e.g. row 1 with the dual
     upload card). Without this, the action row stays under the filename
     and leaves empty space below. */
  .md-card .md-card__action { margin-top: auto; }
  .md-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); transform: translateY(-2px); }
  .md-card--fading { opacity: 0; transform: scale(0.95); pointer-events: none; }

  /* Thumbnail — canonical site-wide transparent-checker pattern. SVG
     inlined (rather than var(--nt-checker-image)) because the picker
     popup renders my-designs-panel inside a stacking context where the
     :root custom properties were silently failing to resolve in some
     surfaces. The inlined SVG matches the one in assets/theme.css
     :root and assets/__blanksUploadHelper.css `file-preview preview-block`,
     so all upload-transparency surfaces (file preview, cart preview,
     My Designs tiles, Recent Designs, Previous Designs picker) now
     paint the exact same checker. !important guards against the older
     light-grey gradient bleeding back in via specificity. */
  .md-card__thumb { position: relative; aspect-ratio: 1; overflow: hidden;
    background-color: #f2f2f2 !important;
    background-image: url("data:image/svg+xml;base64,") !important;
    background-position: center center !important;
    background-size: 10px !important;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    box-sizing: border-box;
  }
  .md-card__thumb img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; object-position: center; display: block; }
  /* Gang sheet thumbnails: scale down to show entire sheet in the card */
  .md-card--gangsheet .md-card__thumb img { object-fit: contain; object-position: center; }
  .md-card--uploading .md-card__thumb { cursor: default; }
  .md-card--uploading .md-card__thumb::after { content: ''; position: absolute; inset: 0; background: rgba(255,255,255,0.72); z-index: 1; }
  .md-card__upload-spinner { position: absolute; top: 50%; left: 50%; width: 36px; height: 36px; margin: -18px 0 0 -18px; border: 3px solid rgba(1,154,255,0.18); border-top-color: #019aff; border-radius: 50%; animation: md-spin 0.7s linear infinite; z-index: 2; }
  .md-card__upload-copy { position: absolute; left: 12px; right: 12px; bottom: 14px; text-align: center; font-size: 11px; font-weight: 600; color: #4b5563; z-index: 2; }
  .md-card__badge { position: absolute; top: 8px; right: 8px; font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.03em; z-index: 2; }
  .md-card__badge--bysize { background: #dbeafe; color: #1e40af; }
  .md-card__badge--gangsheet { background: #fae8ff; color: #7e22ce; }
  .md-card__badge--upload { background: #f0fdf4; color: #16a34a; }
  .md-card__badge--purchase { background: #fff7ed; color: #c2410c; }

  .md-card--selected { border-color: #019aff; box-shadow: 0 0 0 2px rgba(1,154,255,0.14), 0 12px 24px rgba(1,154,255,0.12); }
  .md-card--selection-disabled .md-card__thumb::after { content: ''; position: absolute; inset: 0; background: rgba(255,255,255,0.45); z-index: 1; pointer-events: none; }
  .md-card__select { position: absolute; top: 8px; left: 8px; z-index: 4; width: 22px; height: 22px; border: 1.5px solid #cbd5e1; border-radius: 6px; background: rgba(255,255,255,0.96); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: all 0.15s; box-shadow: 0 1px 3px rgba(15,23,42,0.08); }
  .md-card__select:hover { border-color: #019aff; }
  .md-card__select svg { width: 13px; height: 13px; stroke: #fff; opacity: 0; transition: opacity 0.15s; }
  .md-card__select--selected { border-color: #019aff; background: #019aff; }
  .md-card__select--selected svg { opacity: 1; }
  .md-card__select--disabled { background: #e5e7eb; border-color: #d1d5db; cursor: not-allowed; }
  .md-card__select--disabled svg { display: none; }

  /* Mobile archive trash icon button (hidden on desktop) */
  .md-card__trash { display: none; }

  /* Mobile restore text (hidden on desktop, shown on mobile) */
  .md-card__action-restore { display: none; font-size: 11px; font-weight: 600; color: #16a34a; text-decoration: none; font-family: inherit; cursor: pointer; background: none; border: none; padding: 0; transition: color 0.15s; }
  .md-card__action-restore:hover { color: #15803d; }

  /* Archive confirm modal — reuse .md-modal styles, override confirm button to blue */
  .md-archive-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; z-index: 9999; padding: 20px; }
  /* !important on color/background to beat the site\'s global <button> rules,
     which otherwise paint the "Yes, archive" label as dark text on the
     blue fill. */
  .md-archive-modal__confirm { padding: 10px 20px; border: none !important; border-radius: 8px; background: #019AFF !important; color: #fff !important; font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; transition: background 0.15s; }
  .md-archive-modal__confirm:hover { background: #0079cc !important; color: #fff !important; }
  .md-archive-modal__cancel { padding: 10px 20px; border: 1px solid #d1d5db; border-radius: 8px; background: #fff; color: #374151; font-size: 13px; font-weight: 500; cursor: pointer; font-family: inherit; transition: background 0.15s; }
  .md-archive-modal__cancel:hover { background: #f9fafb; }

  /* Card info */
  .md-card__info { padding: 10px 12px 12px; }
  .md-card__name { font-size: 12px; font-weight: 600; color: #111; margin: 0 0 4px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; line-height: 1.4; }
  .md-card__meta { font-size: 11px; color: #9ca3af; margin: 0; display: flex; align-items: center; gap: 6px; }
  .md-card__meta-dot { width: 3px; height: 3px; border-radius: 50%; background: #d1d5db; flex-shrink: 0; }

  /* Card bottom actions */
  .md-card__action { padding: 0 12px 10px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .md-card__action-btn { background: none; border: none; font-size: 11px; color: #6b7280; cursor: pointer; padding: 0; font-family: inherit; text-decoration: underline; transition: color 0.15s; }
  .md-card__action-btn:hover { color: #111; }
  .md-card__archive-icon { background: none; border: none; color: #6b7280; cursor: pointer; padding: 0; display: inline-flex; align-items: center; justify-content: center; transition: color 0.15s, opacity 0.15s; }
  .md-card__archive-icon:hover { color: #111; opacity: 0.85; }
  .md-card__archive-icon svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; }
  .md-card__action-row { display: flex; align-items: center; justify-content: space-between; width: 100%; }
  .md-card__view-img { background: none; border: none; font-size: 11px; color: #019AFF; cursor: pointer; padding: 0; font-family: inherit; font-weight: 500; transition: color 0.15s; display: inline-flex; align-items: center; gap: 3px; }
  .md-card__view-img:hover { color: #0079cc; }

  /* Upload cards */
  .md-upload-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; box-sizing: border-box; }
  .md-upload-card--single { padding: 12px; height: 100%; }
  .md-upload-card--dual { padding: 12px; height: 100%; }
  /* Dual upload card holds both tiles stacked inside one cell. Desktop pins
     it to row 1 spanning 2 image-card columns. Mobile makes it span the
     full width across rows 1 & 2 so each tile keeps a comfortable height. */
  .md-upload-card--dual { grid-column: 1 / span 2; grid-row: 1; }
  @media (max-width: 749px) {
    .md-upload-card--dual { grid-column: 1 / -1; grid-row: 1 / span 2; }
  }
  .md-upload-card__stack { display: flex; flex-direction: column; gap: 10px; height: 100%; }
  .md-upload-tile { width: 100%; border: 1.5px dashed #cbd5e1; border-radius: 12px; background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 18px 14px; box-sizing: border-box; color: #111827; font-family: inherit; cursor: pointer; transition: border-color 0.15s, background 0.15s, box-shadow 0.15s; }
  .md-upload-tile:hover { border-color: #019aff; box-shadow: 0 8px 22px rgba(1,154,255,0.12); background: linear-gradient(180deg, #ffffff 0%, #eff8ff 100%); }
  .md-upload-tile--dragover { border-color: #019aff; background: linear-gradient(180deg, #eef8ff 0%, #dff2ff 100%); box-shadow: 0 0 0 2px rgba(1,154,255,0.12); }
  .md-upload-tile--error { border-color: #ef4444; background: linear-gradient(180deg, #fff7f7 0%, #ffeaea 100%); box-shadow: 0 0 0 2px rgba(239,68,68,0.12); }
  .md-upload-tile--error .md-upload-tile__icon { background: #fee2e2; color: #dc2626; }
  .md-upload-tile--error .md-upload-tile__note { color: #dc2626; }
  .md-upload-card--single .md-upload-tile { height: 100%; min-height: 100%; }
  .md-upload-card--dual .md-upload-tile { flex: 1; min-height: 0; padding: 10px 14px; }
  .md-upload-card--dual .md-upload-tile__icon { margin-top: 0; margin-bottom: 6px; }
  .md-upload-card--dual .md-upload-tile__title { margin-bottom: 6px; }
  .md-upload-card--dual .md-upload-tile__browse { margin-bottom: 4px; }
  .md-upload-card--dual .md-upload-tile__note { margin-top: 2px; top: 0; }
  .md-upload-tile__icon { width: 36px; height: 36px; border-radius: 999px; background: #e0f2ff; color: #019aff; display: inline-flex; align-items: center; justify-content: center; margin-top: 5px; margin-bottom: 12px; }
  .md-upload-tile__icon svg { width: 17px; height: 17px; }
  .md-upload-tile__title { font-size: 11.7px; font-weight: 700; color: #111827; margin-bottom: 10px; line-height: 1.3; }
  .md-upload-tile__browse { display: inline-flex; align-items: center; justify-content: center; min-width: 83px; padding: 7px 13px; border-radius: 999px; background: #019aff; color: #fff; font-size: 10.8px; font-weight: 700; margin-bottom: 8px; }
  .md-upload-tile__note { font-size: 9.9px; color: #6b7280; line-height: 1.35; margin-top: 4px; position: relative; top: -5px; }
  .md-upload-tile__note--muted { color: #6b7280; }

  /* Bulk selection bar */
  .md-selection-bar { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); display: flex; align-items: center; gap: 18px; padding: 14px 18px; background: rgba(17,24,39,0.96); color: #fff; border-radius: 16px; box-shadow: 0 18px 48px rgba(15,23,42,0.28); z-index: 9998; width: min(calc(100vw - 32px), 760px); box-sizing: border-box; }
  /* Hide the fixed selection bar whenever ANY ancestor of the panel is
     `hidden`. Covers the mauh "Previous" panel on mobile-app-home and
     any other tab system that uses the `hidden` attribute and KEEPS
     the bar inside the panel. */
  [hidden] .md-selection-bar,
  [hidden] .md-selection-bar * {
    display: none !important;
  }

  /* dtfut tabs special case: the JS below (line ~781) reparents the
     bar out of its tab panel and appends it to .dtfut__panel-wrap so
     it lays out at the bottom of the panel card. That puts the bar
     OUTSIDE the [hidden] Previous Designs panel — the rule above
     can't reach it. Use :has() to check whether the Previous Designs
     panel is currently `.is-active` within the wrap; if not, hide
     the bar. The bar's own JS still controls its visibility WITHIN
     the recent tab via the inline display:none/flex (selection
     count > 0). */
  .dtfut__panel-wrap:not(:has(.dtfut__panel[data-dtfut-panel="recent"].is-active)) .md-selection-bar,
  .dtfut__panel-wrap:not(:has(.dtfut__panel[data-dtfut-panel="recent"].is-active)) .md-selection-bar * {
    display: none !important;
  }
  .md-selection-bar__summary-group { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
  .md-selection-bar__summary { font-size: 14px; font-weight: 700; white-space: nowrap; }
  .md-selection-bar__note { font-size: 12px; font-weight: 600; color: #f87171; text-align: right; margin-left: auto; }
  .md-selection-bar__actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex: 1; }
  .md-selection-bar__btn { border-radius: 999px; border: 1px solid transparent; padding: 11px 18px; font-size: 13px; font-weight: 700; font-family: inherit; cursor: pointer; transition: transform 0.15s, filter 0.15s, background 0.15s, border-color 0.15s; white-space: nowrap; }
  .md-selection-bar__btn:hover { filter: brightness(1.05); transform: translateY(-1px); }
  .md-selection-bar__btn--primary { background: #019aff; color: #fff; }
  .md-selection-bar__btn--secondary { background: transparent; color: #fff; border-color: rgba(255,255,255,0.3); }
  .md-selection-bar__btn--success { background: #16a34a; color: #fff; }
  .md-selection-bar__btn--danger { background: #4b5563; color: #fff; display: inline-flex; align-items: center; gap: 8px; }
  .md-selection-bar__btn--danger svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* Image lightbox */
  .md-lightbox { position: fixed; inset: 0; background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center; z-index: 99999; padding: 24px; cursor: pointer; }
  .md-lightbox__close { position: absolute; top: 16px; right: 20px; background: none; border: none; color: #fff; font-size: 36px; cursor: pointer; line-height: 1; z-index: 2; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; opacity: 0.8; transition: opacity 0.15s; }
  .md-lightbox__close:hover { opacity: 1; }
  .md-lightbox__img { max-width: 90vw; max-height: 85vh; object-fit: contain; border-radius: 8px; box-shadow: 0 8px 40px rgba(0,0,0,0.4); cursor: default; background: #fff; }
  .md-lightbox__img--loading { display: none; }
  .md-lightbox__spinner { display: none; }
  .md-lightbox__spinner--visible { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; justify-content: center; }
  .md-lightbox__spinner-text { width: 100%; text-align: center; color: rgba(255,255,255,0.7); font-size: 13px; margin: 12px 0 0; font-weight: 400; }
  .md-lightbox__spinner div { width: 12px; height: 12px; border-radius: 50%; background: #fff; animation: md-lb-pulse 1.2s ease-in-out infinite; }
  .md-lightbox__spinner div:nth-child(2) { animation-delay: 0.2s; }
  .md-lightbox__spinner div:nth-child(3) { animation-delay: 0.4s; }
  @keyframes md-lb-pulse { 0%, 80%, 100% { opacity: 0.25; transform: scale(0.8); } 40% { opacity: 1; transform: scale(1); } }

  /* --- Empty State --- */
  .md-empty { text-align: center; padding: 60px 20px; }
  .md-empty svg { margin-bottom: 16px; }
  .md-empty__title { font-size: 16px; font-weight: 600; color: #374151; margin: 0 0 6px; }
  .md-empty__sub { font-size: 13px; color: #9ca3af; margin: 0; }

  /* --- Modal --- */
  .md-modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; z-index: 9999; padding: 20px; }
  .md-modal { background: #fff; border-radius: 12px; padding: 28px; max-width: 420px; width: 100%; box-shadow: 0 20px 60px rgba(0,0,0,0.2); }
  .md-modal__title { font-size: 18px; font-weight: 700; color: #111; margin: 0 0 12px; }
  .md-modal__text { font-size: 14px; color: #6b7280; margin: 0 0 24px; line-height: 1.5; }
  .md-modal__name { font-weight: 600; color: #111; }
  .md-modal__actions { display: flex; justify-content: flex-end; gap: 10px; }
  .md-modal__cancel { padding: 10px 20px; border: 1px solid #d1d5db; border-radius: 8px; background: #fff; color: #374151; font-size: 13px; font-weight: 500; cursor: pointer; font-family: inherit; transition: background 0.15s; }
  .md-modal__cancel:hover { background: #f9fafb; }
  .md-modal__confirm { padding: 10px 20px; border: none; border-radius: 8px; background: #dc2626; color: #fff; font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; transition: background 0.15s; }
  .md-modal__confirm:hover { background: #b91c1c; }

  /* --- Toast --- */
  .md-toast { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%) translateY(20px); background: #1f2937; color: #fff; padding: 12px 24px; border-radius: 8px; font-size: 13px; font-weight: 500; opacity: 0; transition: opacity 0.3s, transform 0.3s; z-index: 10000; pointer-events: none; white-space: nowrap; box-shadow: 0 4px 20px rgba(0,0,0,0.25); }
  .md-toast--visible { opacity: 1; transform: translateX(-50%) translateY(0); }

  /* --- Ordering Options Modal --- */
  .md-oo-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; z-index: 9999; padding: 20px; }
  .md-oo-modal { background: #fff; border-radius: 14px; max-width: 720px; width: 100%; max-height: 85vh; box-shadow: 0 20px 60px rgba(0,0,0,0.25); display: flex; flex-direction: column; overflow: hidden; }
  .md-oo-header { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px 0; flex-shrink: 0; }
  .md-oo-title { font-size: 18px; font-weight: 700; color: #111; margin: 0; line-height: 36px; }
  .md-oo-close, .md-oo-gs-close { background: none; border: none; font-size: 28px; color: #6b7280; cursor: pointer; line-height: 1; padding: 0; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 8px; transition: background 0.15s, color 0.15s; font-family: inherit; }
  .md-oo-close:hover, .md-oo-gs-close:hover { background: #f3f4f6; color: #111; }
  .md-oo-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding: 12px 24px 24px; overflow-y: auto; -webkit-overflow-scrolling: touch; }
  .md-oo-card, .md-oo-gs-card { display: flex; flex-direction: column; align-items: center; text-decoration: none; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 10px; padding: 16px 10px 14px; transition: border-color 0.15s, box-shadow 0.15s; cursor: pointer; }
  .md-oo-card:hover, .md-oo-gs-card:hover { border-color: #019AFF; box-shadow: 0 2px 12px rgba(1,154,255,0.12); }
  .md-oo-card img, .md-oo-gs-card img { width: 80px; height: 80px; object-fit: contain; border-radius: 6px; margin-bottom: 10px; }
  .md-oo-card__name { font-size: 12px; font-weight: 600; color: #111; text-align: center; margin-bottom: 4px; }
  .md-oo-card__cta { font-size: 11px; font-weight: 600; color: #019AFF; }

  /* --- Gang Sheet Ordering Options Modal (reuse oo-modal styles) --- */
  .md-oo-gs-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; z-index: 9999; padding: 20px; }

  /* --- Responsive --- */
  @media (max-width: 768px) {
    /* Container padding so nothing touches screen edges */
    .md-container { padding: 0 16px; box-sizing: border-box; overflow: hidden; }
    .md-title { font-size: 18px; }

    /* Filters: stack vertically, full width */
    .md-filters__row { flex-direction: column; gap: 10px; }
    .md-filters__groups { flex-direction: column; width: 100%; gap: 8px; }

    /* Tabs fill evenly across the row, never overflow */
    .md-filters__group { width: 100%; border-radius: 8px; padding: 3px; gap: 2px; box-sizing: border-box; }
    .md-tab { padding: 7px 6px; font-size: 12px; gap: 0; flex: 1; justify-content: center; min-width: 0; }
    .md-tab__count { display: none; }

    .md-filters__search { width: 100%; min-width: 0; }

    /* 2-column grid */
    .md-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }

    .md-card:hover { transform: none; box-shadow: none; }

    .md-card__action-restore { display: inline; }
    .md-card__action { padding: 8px 10px 10px; border-top: 1px solid #f3f4f6; flex-direction: column; align-items: flex-start; gap: 4px; }
    .md-card__action-row { display: flex; }

    /* Hide archive text button on mobile — replaced by trash icon */
    .md-card__action-btn[data-archive-id] { display: none; }
    .md-card__archive-icon { display: none; }

    .md-upload-card--single,
    .md-upload-card--dual { padding: 10px; aspect-ratio: auto; }
    .md-upload-card__stack { gap: 8px; }
    .md-upload-tile { padding: 10px 10px; }
    .md-upload-tile__icon { display: none; }
    .md-upload-tile__title { font-size: 12px; margin-bottom: 8px; }
    .md-upload-tile__browse { min-width: 86px; padding: 7px 12px; font-size: 11px; }
    .md-upload-tile__note { font-size: 10px; margin-top: 0; top: 0; }

    /* Delete permanently removed — users can only restore from archive */

    /* Show mobile trash icon in the bottom action row */
    .md-card__trash { display: inline-flex; position: static; width: 24px; height: 24px; border-radius: 0; background: transparent; align-items: center; justify-content: center; border: none; cursor: pointer; transition: opacity 0.15s; padding: 0; margin-left: auto; }
    .md-card__trash:hover { background: transparent; opacity: 0.75; }
    .md-card__trash svg { width: 14px; height: 14px; stroke: #6b7280; fill: none; stroke-width: 2; }

    /* Fullscreen ordering options modal on mobile */
    .md-oo-overlay { padding: 0; }
    .md-oo-modal { max-width: 100%; border-radius: 0; margin: 0; height: 100vh; height: 100dvh; max-height: 100vh; max-height: 100dvh; }
    .md-oo-grid { grid-template-columns: repeat(3, 1fr); gap: 12px; padding: 16px; }
    .md-oo-header { padding: 18px 16px 0; }
    .md-oo-close, .md-oo-gs-close { font-size: 36px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; }

    /* Fullscreen gang sheet ordering options modal on mobile */
    .md-oo-gs-overlay { padding: 0; }
    .md-oo-gs-overlay .md-oo-modal { max-width: 100%; border-radius: 0; margin: 0; height: 100vh; height: 100dvh; max-height: 100vh; max-height: 100dvh; }
    .md-oo-gs-overlay .md-oo-grid { grid-template-columns: repeat(3, 1fr); gap: 12px; padding: 16px; }
    .md-oo-gs-overlay .md-oo-header { padding: 18px 16px 0; }

    /* Archive confirm modal stacking on mobile */
    .md-archive-overlay .md-modal__actions { flex-direction: column; }
    .md-archive-modal__cancel, .md-archive-modal__confirm { width: 100%; text-align: center; }

    /* Card info tighter on mobile */
    .md-card__info { padding: 8px 10px 6px; }
    .md-card__name { font-size: 11px; }
    .md-card__meta { font-size: 10px; flex-wrap: wrap; }

    /* Badge smaller on mobile */
    .md-card__badge { font-size: 9px; padding: 2px 6px; }
    .md-card__select { width: 20px; height: 20px; }

    .md-selection-bar { bottom: 14px; flex-direction: column; align-items: stretch; gap: 12px; padding: 14px; }
    .md-selection-bar__summary-group { width: 100%; order: 1; justify-content: center; gap: 10px; flex-wrap: wrap; }
    .md-selection-bar__summary { text-align: center; width: 100%; }
    .md-selection-bar__note { text-align: center; width: 100%; margin-left: 0; order: 2; }
    .md-selection-bar__btn--danger { width: 100%; justify-content: center; }
    .md-selection-bar__actions { width: 100%; flex-direction: column; order: 0; }
    .md-selection-bar__btn { width: 100%; }
    .md-selection-toolbar { margin: 8px 0 16px; }

    .md-modal { padding: 20px; }
    .md-modal__actions { flex-direction: column; }
    .md-modal__cancel, .md-modal__confirm { width: 100%; text-align: center; }
  }

  /* Extra small screens */
  @media (max-width: 400px) {
    .md-tab { padding: 6px 4px; font-size: 11px; }
    .md-grid { gap: 8px; }
    .md-card__action-cta { font-size: 10.5px; }
    .md-card__action-btn { font-size: 10.5px; }
  }

  /* ============================ PICKER MODE ============================ */
  /* Applied when rendered inside the product-page "Choose a previously uploaded design"
     modal. Hides destructive / admin affordances and repurposes the
     selection bar primary button as USE DESIGNS. */
  .md-container--picker { padding: 12px 0 0; }
  .md-container--picker .md-title,
  .md-container--picker .md-header,
  .md-container--picker .md-card__trash,
  .md-container--picker .md-card__view-img,
  .md-container--picker .md-card__action,
  .md-container--picker .md-card__action-row,
  .md-container--picker .md-selection-bar__btn--secondary,
  .md-container--picker .md-selection-bar__btn--delete,
  .md-container--picker .md-upload-card,
  .md-container--picker .md-card__info,
  .md-container--picker .md-oo-overlay,
  .md-container--picker .md-oo-gs-overlay { display: none !important; }

  /* Center the overlay's child and size the modal to the viewport.
     The :not() guard keeps the inline display:none from the HTML working —
     !important only kicks in once fadeIn has swapped display to block. */
  .customTabelPopup__overlay-3:has(.customTabelPopup--md-picker):not([style*="display: none"]) {
    display: grid !important;
    place-items: center;
    padding: 20px;
    box-sizing: border-box;
    height: 100%;
  }
  .customTabelPopup--md-picker {
    width: min(900px, calc(100vw - 40px));
    max-width: 900px;
    height: min(860px, calc(100vh - 40px));
    margin: 0 !important;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding-top: 52px; /* room for absolute-positioned header row */
    padding-bottom: 0;
    display: flex;
    flex-direction: column;
  }
  .customTabelPopup--md-picker > .md-container--picker {
    flex: 1 1 auto;
    min-height: 0;
  }

  /* Mobile: keep the inner container as the constrained-height scroll
     context (same approach as desktop). The popup gets `overflow: hidden`
     further down (for selection-bar pinning), so popup-level scrolling
     is not available — the grid must scroll inside .md-container--picker. */
  @media (max-width: 768px) {
    .md-container--picker { padding: 0 12px; }
    .customTabelPopup--md-picker > .md-container--picker { flex: 1 1 0; min-height: 0; }
    .customTabelPopup--md-picker { height: calc(100vh - 20px); height: calc(100dvh - 20px); width: calc(100vw - 20px); }
    .customTabelPopup__overlay-3:has(.customTabelPopup--md-picker):not([style*="display: none"]) { padding: 10px; }
  }

  /* Header row: absolute-position both title and close button at top:20
     so they sit in a shared 24px-tall row and don't push content down. */
  .customTabelPopup--md-picker > h4 {
    top: 20px !important;
    left: 20px !important;
    right: auto;
    margin: 0 !important;
    font-size: 18px;
    font-weight: 700;
    line-height: 24px;
    height: 24px;
  }
  .customTabelPopup__overlay-3 .customTabelPopup--md-picker > .customTabelPopup__close {
    position: absolute;
    top: 20px;
    right: 20px;
    left: auto;
    margin: 0 !important;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  /* When the product forces a design type (by-size PDP, gang-sheet PDP),
     hide the type filter bar. The upload tile and grid filtering follow
     from pre-setting typeFilter to the forced value (see JS init). */
  .md-container--forced-type .md-filters__group[data-filter-group="type"] {
    display: none !important;
  }

  /* Selection bar pinned FLUSH to the bottom of the modal frame.
     CRITICAL: `.md-container` has `position: relative` baked in (line 239).
     The bar lives inside `.md-container--picker`, so without an override
     the bar's `position: absolute` resolves to .md-container (which grows
     with the tile list) instead of the modal frame — making the bar
     float wherever the tile list ends. We strip the relative positioning
     off `.md-container--picker` (picker mode only — base .md-container
     elsewhere keeps it) so the bar climbs the offset-parent chain up to
     `.customTabelPopup--md-picker`. */
  .customTabelPopup--md-picker {
    position: relative !important;
    overflow: hidden !important;
    padding-bottom: 80px !important;
  }
  .customTabelPopup--md-picker > .md-container--picker {
    position: static !important;  /* defeat the inherited `.md-container { position: relative }` */
    overflow-y: auto !important;
    overflow-x: hidden !important;
    overscroll-behavior: contain;
  }
  .customTabelPopup--md-picker .md-selection-bar {
    position: absolute !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    top: auto !important;
    width: 100% !important;
    transform: none !important;
    visibility: visible !important;
    opacity: 1 !important;
    border-radius: 0 0 12px 12px !important;
    padding: 16px 24px !important;
    box-sizing: border-box !important;
    z-index: 10;
  }
  @media (max-width: 768px) {
    .customTabelPopup--md-picker {
      padding-bottom: 72px !important;
    }
    .customTabelPopup--md-picker .md-selection-bar {
      padding: 12px 16px !important;
      border-radius: 0 !important;
    }
  }
</style>

