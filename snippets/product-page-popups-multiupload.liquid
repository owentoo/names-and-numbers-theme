                <h4 style="position: absolute;   top: 20px;">Your Designs</h4>
                {%- comment -%}
                  Default to By Size. Only force Gang Sheet when the product
                  is clearly a gang-sheet one: tag contains "Gang", handle
                  contains "gang", or template suffix contains "gang-sheet".
                {%- endcomment -%}
                {%- assign picker_forced_type = 'bysize' -%}
                {%- assign picker_tag_string = product.tags | join: ',' | downcase -%}
                {%- if product.template_suffix contains 'gang-sheet' or product.handle contains 'gang' or picker_tag_string contains 'gang' -%}
                  {%- assign picker_forced_type = 'gangsheet' -%}
                {%- endif -%}
                {%- comment -%}
                  Per Row picker — desktop (3/4/5) + mobile (1/2/3). Mirrors
                  the layout from sections/dtf-upload-tabs.liquid. JS at the
                  bottom of this file moves the mobile control into the
                  filter row at runtime so search + cols + tabs reflow nicely.
                {%- endcomment -%}
                <div class="ctp-cols ctp-cols--desktop" role="group" aria-label="Images per row">
                  <span class="ctp-cols-label">Per row</span>
                  <button type="button" class="ctp-cols-btn" data-ctp-cols="3">3</button>
                  <button type="button" class="ctp-cols-btn is-active" data-ctp-cols="4">4</button>
                  <button type="button" class="ctp-cols-btn" data-ctp-cols="5">5</button>
                </div>
                <div class="ctp-cols ctp-cols--mobile" role="group" aria-label="Images per row">
                  <span class="ctp-cols-label">Per row</span>
                  <button type="button" class="ctp-cols-btn" data-ctp-cols="1">1</button>
                  <button type="button" class="ctp-cols-btn is-active" data-ctp-cols="2">2</button>
                </div>
                {% render 'my-designs-panel', picker: true, forced_type: picker_forced_type, allow_multi: true %}
              </div>
            </div>

            {%- comment -%} =================================================
              Scoped styles + JS for the multiupload "Your Designs" picker
              modal. Mirrors the picker layout from
              assets/dtf-upload-tabs.css so this modal matches the
              dtf-transfers-by-size-v2 (by-size-tabs) experience:
                - Per Row 3/4/5 control top-right (1/2/3 on mobile)
                - Search bar right-aligned on same row as filter tabs
                - Compact tab pills, no archive tab in picker mode
                - Grid columns driven by data-cols on the picker container
            ================================================= {%- endcomment -%}
            <style>
              /* Compact toolbar: filter pills on the left, search on the right. */
              .customTabelPopup--md-picker .md-header { display: none; }
              .customTabelPopup--md-picker .md-filters { margin-bottom: 10px; }
              .customTabelPopup--md-picker .md-filters__row {
                align-items: center;
                flex-wrap: nowrap;
                gap: 10px;
              }
              .customTabelPopup--md-picker .md-filters__groups {
                width: auto;
                flex: 1 1 auto;
                justify-content: flex-start;
                flex-wrap: nowrap;
                gap: 6px;
              }
              .customTabelPopup--md-picker .md-filters__group {
                padding: 2px;
                gap: 1px;
              }
              .customTabelPopup--md-picker .md-tab {
                padding: 4px 9px;
                font-size: 11.5px;
                gap: 4px;
              }
              .customTabelPopup--md-picker .md-tab__count {
                font-size: 10px;
                padding: 0 5px;
                min-width: 16px;
                line-height: 14px;
              }
              .customTabelPopup--md-picker .md-filters__search {
                min-width: 0;
                width: 200px;
                margin-left: auto;
                flex: 0 0 auto;
              }
              .customTabelPopup--md-picker .md-search-input {
                padding: 5px 28px 5px 30px;
                font-size: 12px;
                border-radius: 6px;
              }
              .customTabelPopup--md-picker .md-search-icon {
                left: 9px;
                width: 13px;
                height: 13px;
              }

              /* Per Row picker — right-aligned above the filter row. */
              .customTabelPopup--md-picker .ctp-cols {
                display: flex;
                align-items: center;
                gap: 6px;
                justify-content: flex-end;
                margin: 0 0 10px;
              }
              .customTabelPopup--md-picker .ctp-cols--mobile { display: none; }
              @media (max-width: 749px) {
                .customTabelPopup--md-picker .ctp-cols--desktop { display: none; }
                .customTabelPopup--md-picker .ctp-cols--mobile { display: flex; }
              }
              .customTabelPopup--md-picker .ctp-cols-label {
                font-size: 11px;
                font-weight: 600;
                color: #6b7280;
                margin-right: 4px;
                text-transform: uppercase;
                letter-spacing: 0.04em;
              }
              .customTabelPopup--md-picker .ctp-cols-btn {
                appearance: none;
                border: 1px solid #e5e7eb;
                background: #fff;
                color: #374151;
                font: 600 12px/1 'DM Sans', system-ui, sans-serif;
                width: 28px;
                height: 26px;
                border-radius: 6px;
                cursor: pointer;
                padding: 0;
                transition: all 0.15s;
              }
              .customTabelPopup--md-picker .ctp-cols-btn:hover { border-color: #019AFF; color: #019AFF; }
              .customTabelPopup--md-picker .ctp-cols-btn.is-active {
                background: #019AFF;
                border-color: #019AFF;
                color: #fff;
                box-shadow: 0 1px 3px rgba(1,154,255,0.3);
              }

              /* Grid column overrides driven by data-cols on the picker container. */
              .customTabelPopup--md-picker[data-cols="1"] .md-grid { grid-template-columns: 1fr !important; }
              .customTabelPopup--md-picker[data-cols="2"] .md-grid { grid-template-columns: repeat(2, 1fr) !important; }
              .customTabelPopup--md-picker[data-cols="3"] .md-grid { grid-template-columns: repeat(3, 1fr) !important; }
              .customTabelPopup--md-picker[data-cols="4"] .md-grid { grid-template-columns: repeat(4, 1fr) !important; }
              .customTabelPopup--md-picker[data-cols="5"] .md-grid { grid-template-columns: repeat(5, 1fr) !important; }

              /* Mobile reflow: relocate mobile per-row into the search row.
                 JS appends .ctp-cols--mobile into .md-filters__row at mount. */
              @media (max-width: 749px) {
                .customTabelPopup--md-picker .md-filters__row {
                  flex-direction: row;
                  flex-wrap: wrap;
                  align-items: center;
                  gap: 10px 12px;
                }
                .customTabelPopup--md-picker .md-filters__search {
                  flex: 1 1 0;
                  width: auto;
                  min-width: 0;
                  order: 0;
                }
                .customTabelPopup--md-picker .md-filters__row .ctp-cols--mobile {
                  order: 1;
                  flex: 0 0 auto;
                  margin: 0;
                  justify-content: flex-end;
                }
                .customTabelPopup--md-picker .md-filters__groups {
                  order: 2;
                  flex: 0 0 100%;
                  flex-direction: row;
                  justify-content: center;
                  width: 100%;
                  gap: 8px;
                }
                .customTabelPopup--md-picker .md-filters__group { width: auto; }
                .customTabelPopup--md-picker .md-filters__group .md-tab { flex: 0 0 auto; }
                .customTabelPopup--md-picker .md-tab__count { display: none !important; }
                .customTabelPopup--md-picker .ctp-cols--mobile .ctp-cols-label {
                  font-size: 10px;
                  margin-right: 2px;
                }
              }
            </style>

            <script>
              (function() {
                function initCtpPicker() {
                  var picker = document.querySelector('.customTabelPopup__overlay-3 .customTabelPopup--md-picker');
                  if (!picker || picker.__ctpInit) return;
                  picker.__ctpInit = true;

                  /* Match initial cols to viewport: desktop=4, mobile=2. */
                  var isMobile = window.matchMedia && window.matchMedia('(max-width: 749px)').matches;
                  var initialCols = isMobile ? '2' : '4';
                  picker.setAttribute('data-cols', initialCols);
                  syncActive(initialCols);

                  /* Move mobile per-row control into the filter row so search +
                     cols + tabs share one flex container on mobile. Wait for
                     my-designs-panel to render .md-filters__row if it isn't
                     already in the DOM. */
                  function relocateMobile() {
                    var mobileCols = picker.querySelector('.ctp-cols--mobile');
                    var filtersRow = picker.querySelector('.md-filters__row');
                    if (mobileCols && filtersRow && !filtersRow.contains(mobileCols)) {
                      filtersRow.appendChild(mobileCols);
                      return true;
                    }
                    return false;
                  }
                  if (!relocateMobile()) {
                    var mo = new MutationObserver(function() {
                      if (relocateMobile()) mo.disconnect();
                    });
                    mo.observe(picker, { childList: true, subtree: true });
                  }

                  /* Click handler: update data-cols + active button state. */
                  picker.addEventListener('click', function(e) {
                    var btn = e.target.closest('.ctp-cols-btn');
                    if (!btn) return;
                    var cols = btn.getAttribute('data-ctp-cols');
                    if (!cols) return;
                    picker.setAttribute('data-cols', cols);
                    syncActive(cols);
                  });

                  function syncActive(cols) {
                    picker.querySelectorAll('.ctp-cols-btn').forEach(function(b) {
                      b.classList.toggle('is-active', b.getAttribute('data-ctp-cols') === cols);
                    });
                  }
                }

                if (document.readyState === 'loading') {
                  document.addEventListener('DOMContentLoaded', initCtpPicker);
                } else {
                  initCtpPicker();
                }
              })();
            </script>

            <script>
              /* Bridge: My Designs picker selection → existing upload pipeline.
                 Mirrors the logic in bySize_popular.js `.use_designes_bulk`
                 click handler but reads from the picker event instead of
                 legacy DOM checkboxes. Falls back to `multiuploadHTML`
                 (used by some product pages) if per-URL helpers are absent. */
              document.addEventListener('md-picker:use-designs', function(e) {
                var items = (e.detail && e.detail.items) || [];
                if (!items.length) return;
                /* Populate the "design re-used" attribution maps that
                   ninja-multiupload.js reads at cart-add time. Designs
                   picked from purchased orders carry an .orderName
                   (NT-…); designs sourced from user uploads don't, so
                   they skip this. The lookup side keys by full URL
                   (with and without imgix host) AND by basename for
                   resilience to URL rewrites between picker fire and
                   cart serialization. */
                try {
                  window.__designReUsedByUrl  = window.__designReUsedByUrl  || {};
                  window.__designReUsedByName = window.__designReUsedByName || {};
                  items.forEach(function(it) {
                    if (!it || !it.orderName) return;
                    var ord = String(it.orderName).trim();
                    if (!ord) return;
                    var tag = 'previously on order # ' + ord;
                    var url = it.file ? String(it.file).split('?')[0] : '';
                    if (url) {
                      window.__designReUsedByUrl[url] = tag;
                      if (typeof ninjaS3Host2 !== 'undefined' && typeof ninjaS3Host !== 'undefined') {
                        window.__designReUsedByUrl[url.split(ninjaS3Host2).join(ninjaS3Host)] = tag;
                        window.__designReUsedByUrl[url.split(ninjaS3Host).join(ninjaS3Host2)] = tag;
                      }
                    }
                    var basename = url ? url.split('/').pop() : (it.fileName || '');
                    if (basename) window.__designReUsedByName[basename] = tag;
                  });
                  /* Also set the legacy globals so the non-multiupload
                     cart-add paths (bySize_popular.js / bySize.js /
                     pdp_transferBySize.js) stamp design re-used too. */
                  var firstWithOrder = items.find(function(i) { return i && i.orderName; });
                  if (firstWithOrder) {
                    var ord1 = String(firstWithOrder.orderName).trim();
                    if (ord1) {
                      window.ordername    = ord1;
                      window.grt_photo_id = 'previously on order # ' + ord1;
                      try { designtype = 1; ordername = ord1; grt_photo_id = window.grt_photo_id; } catch (_g) {}
                    }
                  }
                } catch (_bridgeErr) { /* never block the picker */ }
                /* Suppress the brief flash of `file-progress` (blue bar)
                   that the upload pipeline triggers during a "use a
                   previous design" load — image is already on S3, no
                   progress to show. */
                document.body.classList.add('is-loading-previous-design');
                clearTimeout(window.__previousDesignFlashTimer);
                window.__previousDesignFlashTimer = setTimeout(function(){
                  document.body.classList.remove('is-loading-previous-design');
                }, 2500);

                if (typeof window.__closeMdPicker === 'function') {
                  window.__closeMdPicker();
                } else {
                  var overlay = document.querySelector('.customTabelPopup__overlay-3');
                  if (overlay) overlay.style.setProperty('display', 'none', 'important');
                }

                var urls = items.map(function(i) {
                  var u = (i && i.file) ? String(i.file) : '';
                  if (u.indexOf('?') > -1) u = u.split('?')[0];
                  if (typeof ninjaS3Host2 !== 'undefined' && typeof ninjaS3Host !== 'undefined') {
                    u = u.split(ninjaS3Host2).join(ninjaS3Host);
                  }
                  return u;
                }).filter(Boolean);
                if (!urls.length) return;

                /* Path A: bySize_popular.js pipeline (per-URL helpers).
                   Mirrors the branching in the legacy .use_designes_bulk
                   handler: 1 file routes to singleFileManageByURL unless
                   uploadType is 'multi'; 2+ files always go through
                   multiFilesManageByURL. */
                if (typeof createFileObjectFromUrl === 'function' &&
                    (typeof multiFilesManageByURL === 'function' ||
                     typeof singleFileManageByURL === 'function')) {
                  var files = urls.map(function(u) {
                    var detail = createFileObjectFromUrl(u);
                    detail.fileURL = u;
                    return detail;
                  });
                  var _uploadType = (typeof uploadType !== 'undefined') ? uploadType : '';
                  var _addToCart = function() {
                    return (typeof singleFileAddToCart === 'function')
                      ? Promise.resolve(singleFileAddToCart())
                      : Promise.resolve();
                  };
                  if (files.length === 1) {
                    if (_uploadType === 'multi' && typeof multiFilesManageByURL === 'function') {
                      multiFilesManageByURL(files);
                    } else if (_uploadType === 'single' && typeof singleFileManageByURL === 'function') {
                      _addToCart().then(function() { singleFileManageByURL(files[0]); });
                    } else if (typeof singleFileManageByURL === 'function') {
                      singleFileManageByURL(files[0]);
                    } else if (typeof multiFilesManageByURL === 'function') {
                      multiFilesManageByURL(files);
                    }
                  } else if (typeof multiFilesManageByURL === 'function') {
                    if (_uploadType === 'single') {
                      _addToCart().then(function() { multiFilesManageByURL(files); });
                    } else {
                      multiFilesManageByURL(files);
                    }
                  }
                  return;
                }

                /* Path B: legacy multiuploadHTML pipeline. */
                if (typeof multiuploadHTML === 'function') {
                  multiuploadHTML({ files: urls }, null, 'direct');
                }
              });
            </script>

