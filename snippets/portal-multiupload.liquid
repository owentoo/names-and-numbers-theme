{%- comment -%} ===== AI Edit with AI support (mirrors __blanksUploadHelper.js AI code) ===== {%- endcomment -%}
<script>
document.addEventListener('DOMContentLoaded', function() {
  /* ── constants & state ── */
  const AI_DAILY_LIMIT = 50;
  const AI_STATES = { ORIGINAL: 'original', PROCESSING: 'processing', RESULT: 'result', RESULT_ORG: 'result-org' };
  let aiJobCancelled = false;
  let aiJobAbortController = null;

  /* ── tiny helpers ── */
  function showRedToast(msg) {
    try {
      const t = document.createElement('div');
      t.textContent = msg;
      Object.assign(t.style, { position:'fixed',bottom:'24px',left:'50%',transform:'translateX(-50%)',background:'#ef4444',color:'#fff',padding:'12px 24px',borderRadius:'8px',zIndex:'999999',fontSize:'14px',fontWeight:'600',boxShadow:'0 4px 12px rgba(0,0,0,.3)' });
      document.body.appendChild(t);
      setTimeout(function(){ t.remove(); }, 4000);
    } catch(e){}
  }
  function getLocalDayKey() {
    var d = new Date();
    return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
  }
  function getAiUsage() {
    var day = getLocalDayKey(), raw = localStorage.getItem('nanoBananaUsage'), obj = {};
    try { obj = raw ? JSON.parse(raw) : {}; } catch(e){ obj = {}; }
    if (!obj || obj.day !== day) obj = { day: day, count: 0 };
    return obj;
  }
  function canUseAiRequest() { return getAiUsage().count < AI_DAILY_LIMIT; }
  function bumpAiUsage() {
    var u = getAiUsage(); u.count++; localStorage.setItem('nanoBananaUsage', JSON.stringify(u));
  }

  /* ── get current preview image ── */
  function getCurrentPreviewImageUrl() {
    try {
      if (typeof uploadType !== 'undefined' && uploadType === 'multi' && typeof selectedBlockNo !== 'undefined' && selectedBlockNo) {
        var src = $('multi-upload uploaded-files-block[block-no="' + selectedBlockNo + '"] preview-box .fileupload_hero').attr('src');
        if (src) return src;
      }
      return '';
    } catch(e){ return ''; }
  }

  /* ── updateFileDetailsFunction (not in bySize.js) ── */
  if (typeof window.updateFileDetailsFunction !== 'function') {
    window.updateFileDetailsFunction = function(fileDetails, blockNo) {
      try {
        $('multi-upload uploaded-files-block[block-no="' + blockNo + '"] preview-box file-preview file-details').text(JSON.stringify(fileDetails));
        return true;
      } catch(e){ return false; }
    };
  }

  /* ── nano-banana API ── */
  async function nanoBananaEditRequest(imageUrl, promptText) {
    aiJobCancelled = false;
    aiJobAbortController = new AbortController();
    const FAL_KEY = 'be8d6227-0af0-4f18-ac79-14111cef50cb:a8a72b50bf97f848e1144bd9c5481f0f';
    const AUTH = 'Key ' + FAL_KEY;

    var qR = await fetch('https://queue.fal.run/fal-ai/nano-banana/edit', {
      method: 'POST',
      headers: { 'Authorization': AUTH, 'Content-Type': 'application/json' },
      body: JSON.stringify({ prompt: promptText, num_images: 1, aspect_ratio: 'auto', output_format: 'png', image_urls: [imageUrl] })
    });
    if (!qR.ok) throw new Error('Failed to queue request (' + qR.status + ')');
    var job = await qR.json();
    if (!job.status_url || !job.response_url) throw new Error('Invalid nano-banana queue response');

    var statusUrl = job.status_url, resultUrl = job.response_url, attempts = 0;
    while (attempts < 40) {
      attempts++;
      var sR = await fetch(statusUrl, { method: 'GET', headers: { 'Authorization': AUTH }, signal: aiJobAbortController.signal });
      if (!sR.ok) throw new Error('Status check failed (' + sR.status + ')');
      var sJ = await sR.json();
      if (sJ.status === 'COMPLETED') break;
      if (sJ.status === 'FAILED' || sJ.status === 'CANCELLED' || sJ.status === 'ERROR') throw new Error('Request failed: ' + sJ.status);
      await new Promise(function(r){ setTimeout(r, 2000); });
    }
    if (aiJobCancelled) throw new Error('AI request cancelled');

    var rR = await fetch(resultUrl, { method: 'GET', headers: { 'Authorization': AUTH } });
    if (!rR.ok) throw new Error('Failed to get result (' + rR.status + ')');
    var rJ = await rR.json();
    var images = [];
    if (Array.isArray(rJ.images)) images = rJ.images;
    if (!images.length && rJ.response && Array.isArray(rJ.response.images)) images = rJ.response.images;
    if (!images.length && rJ.data && Array.isArray(rJ.data.images)) images = rJ.data.images;
    if (!images.length && rJ.output && Array.isArray(rJ.output.images)) images = rJ.output.images;
    if (!images.length) throw new Error('No images in response');
    var first = images[0] || {};
    var url = first.url || first.image_url || first.data_url || first.uri || '';
    if (!url) throw new Error('No image URL returned');
    return url;
  }

  /* ── AI state manager ── */
  function setAIState(state) {
    var $box = $('.ai-preview-box');
    $box.addClass('ai-fade');
    setTimeout(function(){ $box.removeClass('ai-fade'); }, 250);

    $('#customer_image_preview, #ai_image_preview, .ai-processing, .ai-prompt-box, .ai-action-box, .black-bg, .ai-action-box .button').hide();
    $('.ai-tabs, .ai-tab').removeClass('active');
    $('.ai-modal').removeClass('ai-is-processing');

    if (state === AI_STATES.ORIGINAL) {
      $('.ai-tab[data-tab="original"]').addClass('active');
      $('#customer_image_preview, .ai-prompt-box').show();
    }
    if (state === AI_STATES.PROCESSING) {
      $('.ai-processing').show();
      $('.ai-modal').addClass('ai-is-processing');
    }
    if (state === AI_STATES.RESULT) {
      $('.ai-tabs, .ai-tab[data-tab="ai"]').addClass('active');
      $('#ai_image_preview, .ai-action-box, .ai-action-box .button#use_ai_image').show();
      $('.black-bg').css({'display':'flex'});
    }
    if (state === AI_STATES.RESULT_ORG) {
      $('.ai-tabs, .ai-tab[data-tab="original"]').addClass('active');
      $('#customer_image_preview, .ai-action-box, .ai-action-box .button:not(#use_ai_image)').show();
      $('.black-bg').hide();
    }
  }

  /* ── Event Handlers ── */
  $(document)

  /* Edit with AI button click — load image & init modal */
  .on('click', '.edit-with-ai .edit-with-aiFlex', function(e) {
    try {
      e.stopImmediatePropagation();
      var $block = $(this).closest('uploaded-files-block');

      if (typeof uploadType !== 'undefined' && uploadType === 'multi') {
        selectedBlockNo = $block.attr('block-no');

        var $ci = $block.find('line-items-custom .widthHeight__custom').first();
        if ($ci.length > 0) { selectedItemNo = $ci.attr('item'); }
        else { selectedItemNo = $block.find('line-items-popular .widthHeight__custom').first().attr('item'); }

        if (!canUseAiRequest()) { showRedToast('You have reached your AI generation limit for today.'); return; }

        $('body').addClass('lock-page');
        var imgUrl = getCurrentPreviewImageUrl();
        $('#customer_image_preview').attr('src', imgUrl || '');
        $('#ai_image_preview').attr('src', '');
        $('#ai_prompt_2').val('');
        $('#ai_status_message').hide().text('');
        $('.ai_result_output').hide();
        $('.ai-container').removeClass('_success');
        var $btn = $('#ai_generate_image_2');
        $btn.prop('disabled', false).data('busy', '0');
        setAIState(AI_STATES.ORIGINAL);
      }
    } catch(err){}
  })

  /* Generate AI image */
  .on('click', '#ai_generate_image_2', async function() {
    if (!canUseAiRequest()) { showRedToast('You have reached your AI generation limit for today.'); return; }
    var $btn = $(this), $prompt = $('#ai_prompt_2'), $status = $('#ai_status_message'), isSuccess = false;
    $('.ai-container').removeClass('_success');
    setAIState(AI_STATES.PROCESSING);
    try {
      $('.customTabelPopup__overlay-ai').addClass('ai-overlay-locked processing-ai');
      var baseImageUrl = $('#customer_image_preview').attr('src');
      if (!baseImageUrl) { alert('No base image found. Please upload an image first.'); return; }
      var promptText = ($prompt.val() || '').trim();
      if (!promptText) { $status.show().text('Please enter a prompt.'); $prompt.focus(); setAIState(AI_STATES.ORIGINAL); return; }

      $btn.prop('disabled', true); $prompt.prop('disabled', true); $btn.data('busy', '1');
      $status.hide().text('');
      $('#ai_image_preview').attr('src', '');

      var newUrl = await nanoBananaEditRequest(baseImageUrl, promptText);
      bumpAiUsage();

      $('#ai_image_preview').attr('src', newUrl);
      setAIState(AI_STATES.RESULT);
      isSuccess = true;
    } catch(err) {
      $status.show().text('Error: ' + (err.message || 'Something went wrong.'));
      setAIState(AI_STATES.ORIGINAL);
    } finally {
      $('.customTabelPopup__overlay-ai').removeClass('ai-overlay-locked processing-ai');
      if (!isSuccess) { $btn.prop('disabled', false); $prompt.prop('disabled', false); $btn.data('busy', '0'); }
      else { $btn.prop('disabled', true); $prompt.prop('disabled', false); $btn.data('busy', '0'); }
    }
  })

  /* Apply AI image */
  .on('click', '#use_ai_image', async function() {
    var $btn = $(this), $status = $('#ai_status_message');
    try {
      $('.customTabelPopup__overlay-ai').addClass('ai-overlay-locked');
      var aiImageUrl = $('#ai_image_preview').attr('src');
      if (!aiImageUrl) return;

      var origText = $btn.data('original-text') || $btn.html();
      $btn.data('original-text', origText).prop('disabled', true).html('Applying...');

      if (typeof uploadType !== 'undefined' && uploadType === 'multi' && typeof selectedBlockNo !== 'undefined' && selectedBlockNo) {
        if ($('uploaded-files-block[block-no="' + selectedBlockNo + '"] toggle-options[show-bg-option="true"] .bgRemover .toggleOption').length > 0) {
          $('uploaded-files-block[block-no="' + selectedBlockNo + '"] toggle-options[show-bg-option="true"] .bgRemover .toggleOption').prop('checked', true);
          await addDelay(200);
        }
        var uploaded = await processFileOrUrl(aiImageUrl, selectedBlockNo);
        var fileDetail = {
          originalFile: uploaded.originalFile || aiImageUrl,
          imgIxFile: uploaded.imgIxFile || uploaded.originalFile || aiImageUrl,
          file_crc: uploaded.file_crc,
          fileName: uploaded.fileName || 'ai-image.png',
          fileURL: uploaded.originalFile || aiImageUrl,
          isAIEdit: true,
          aiOriginalUrl: aiImageUrl
        };
        var getFileDetail = getFileDetailsFunction(selectedBlockNo);
        var updatedObject = Object.assign({}, getFileDetail, fileDetail);
        var isUpdate = updateFileDetailsFunction(updatedObject, selectedBlockNo);
        if (isUpdate) {
          $('multi-upload uploaded-files-block[block-no="' + selectedBlockNo + '"] toggle-options .toggleOption').trigger('change');
        }
      }
    } catch(err) {
      $status.show().text('Error: ' + (err.message || 'Something went wrong.'));
    } finally {
      $('.customTabelPopup__overlay-ai').removeClass('ai-overlay-locked').hide();
      $btn.prop('disabled', false).html($btn.data('original-text') || 'Apply AI Edit');
      $('body').removeClass('lock-page');
    }
  })

  /* Tab switchers */
  .on('click', '.ai-tab[data-tab="ai"]', function() {
    if ($('#ai_image_preview').attr('src')) setAIState(AI_STATES.RESULT);
  })
  .on('click', '.ai-tab[data-tab="original"]', function() {
    if ($('#ai_image_preview').attr('src')) setAIState(AI_STATES.RESULT_ORG);
  });
});
</script>
