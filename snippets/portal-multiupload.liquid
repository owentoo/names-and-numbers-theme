<style>
  multi-upload-wrapper * { font-family: "inter" !important; }

  /* Multi-upload: let the image preview expand to the full width of its
     upload tile so the preview box and the Remove BG / Upscale / Edit AI
     bar below it share the same width. The default `file-preview` rule
     (in __blanksUploadHelper.css) caps the preview at `max-width: 415px`
     which leaves the toggle bar wider than the image. */
  multi-upload-wrapper preview-box file-preview,
  multi-upload-wrapper preview-box file-preview[show-dimensions] {
    max-width: 100% !important;
    width: 100% !important;
  }

  /* ── Portal fixes: base styles normally provided by custom-fileupload.liquid ── */

  /* 1. Qty / Price / Total grid layout */
  precut-unit-logic .precut-unit-logic__grid {
    display: grid;
    gap: 12px;
    margin-bottom: 12px;
  }
  precut-unit-logic .__title {
    font-weight: 600;
    margin-bottom: 4px;
  }
  precut-unit-logic .precut-unit-logic__grid .__originalPrice {
    font-weight: 500;
    color: gray;
    font-size: 10px;
    text-decoration: line-through;
    align-self: end;
    margin-top: 10px;
  }
  precut-unit-logic .precut-unit-logic__grid .__originalPrice.hidden {
    margin-top: 0;
  }
  precut-unit-logic .precut-unit-logic__grid .__discountedPrice {
    font-weight: 600;
    color: #000;
    font-size: 14px;
  }

  /* 2. Rebuild-tools wrapper (edit-with-ai + toggles below image) */
  .multiupload-rebuild-tools-inner {
    padding: 4px 4px 4px 15px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    flex-direction: row-reverse;
    gap: 10px;
    background-color: #F3F3F3;
    margin-top: 20px;
  }
  .multiupload-rebuild-tools-inner toggle-options {
    margin: 0 10px 0 0;
  }
  .multiupload-rebuild-tools-inner toggle-options .switch {
    background: transparent;
    padding: 20px 0;
    font-weight: 600;
    font-size: 12px;
    color: #444444;
  }
  .multiupload-rebuild-tools-inner toggle-options .switch img { display: none; }
  .multiupload-rebuild-tools-inner toggle-options .switch .toggleOption:checked + .slider {
    background-color: #73D447;
  }
  .multiupload-rebuild-tools-inner toggle-options .switch[for^="superRes"]:before {
    content: "";
    background-color: #D9D9D9;
    display: block;
    width: 1px;
    height: 40px;
    margin-right: 4px;
    margin-left: 4px;
  }
  .multiupload-rebuild-tools-inner .edit-with-ai {
    position: static;
    white-space: nowrap;
    box-shadow: unset;
    background: #fff;
    color: #666 !important;
    font-size: 12px;
    border-radius: 6px;
    font-weight: 500;
  }
  body .multiupload-rebuild-tools-inner:has(toggle-options[show-bg-option="false"][show-superres-option="false"]) .edit-with-ai {
    width: 100%;
    justify-content: center;
  }
  body .multiupload-rebuild-tools-inner:has(toggle-options[show-bg-option="false"][show-superres-option="false"]) {
    padding-left: 4px;
  }
  multi-upload-wrapper .multiupload-rebuild-tools-inner {
    flex-direction: column-reverse;
    padding: 4px;
    gap: 5px;
  }
  multi-upload-wrapper .multiupload-rebuild-tools-inner .edit-with-ai {
    justify-content: center;
    width: 100%;
  }
  multi-upload-wrapper .multiupload-rebuild-tools-inner toggle-options {
    max-width: calc(100% - 8px);
    margin-right: 0;
  }
  multi-upload-wrapper .multiupload-rebuild-tools-inner toggle-options .switch {
    padding: 14px 0;
  }

  /* 3. Toggle options — ensure flex on desktop */
  @media (min-width: 769px) {
    multi-upload toggle-options { display: flex !important; }
  }

  /* 4. Image loading overlay (spinner while image processes) */
  .easyzoom.image-loading:after,
  .easyzoom.image-loading-2:after {
    content: "";
    left: 0; right: 0; bottom: 0; top: 0;
    position: absolute;
    z-index: 1;
    background: url(https://cdn.shopify.com/s/files/1/0558/0265/8899/files/loader-2.gif?v=1723724647) rgba(0,0,0,0.5) center center no-repeat;
    background-size: 60px;
  }
  .easyzoom.image-loading .upload_tools {
    opacity: 0.5;
    pointer-events: none;
  }

  /* 5. File progress bar */
  file-progress {
    display: grid;
    grid-template-columns: 75px auto 50px;
    align-items: start;
    gap: 10px;
    position: relative;
  }
  .fileProgress .fileProgress__ninjaImg { max-width: 100%; }
  .fileProgress .fileProgress__msg {
    background-color: #cfefff;
    padding: 6px 10px;
    border-radius: 8px;
    display: flex;
    gap: 10px;
    max-width: 84%;
    margin: 0 auto;
    font-size: 10.5px;
    line-height: 1;
    align-items: center;
    color: #1480b7;
    font-weight: 500;
  }
  .fileProgress .fileProgress__msg svg { width: 30px; height: 30px; fill: #1480b7; }
  .fileProgress .fileProgress__msg p { margin-bottom: 0; }
  .fileProgress .fileProgress__loadingPercent { text-align: right; }
  .fileProgress .loadingPercent__counter { color: #c4c3c4; }
  .fileProgress .fileProgress__barWrap {
    position: absolute;
    left: 75px;
    top: 50px;
    width: calc(100% - 85px);
  }
  .fileProgress .fileProgress__barWrap::before {
    content: "";
    position: absolute;
    bottom: 5px;
    width: 100%;
    height: .7rem;
    background-color: #ebf2ff;
    border-radius: .625rem;
  }
  .fileProgress .fileProgress__bar {
    background: url(/cdn/shop/files/New_beam.png) center no-repeat;
    background-size: 100% 24px;
    bottom: 0;
    width: 0;
    height: .7rem;
    background-color: #ebf2ff;
    border-radius: .625rem;
    display: inline-block;
    position: relative;
  }
  .fileProgress .fileProgress__bar img {
    position: absolute;
    right: -14px;
    top: -8px;
    height: 28px;
  }
</style>

