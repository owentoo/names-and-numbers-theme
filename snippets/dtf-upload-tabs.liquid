{{ 'ai-chat-sandbox.js' | asset_url | script_tag }}

<script>
  /* ─── Trashcan / remove-file → page reload ──────────────────────────
     After upload the body picks up `image-uploaded`, which hides the
     H1 + price + description + iconTextBlock + buyMoreSave on the
     right column (see bySize.css / transferBySize.css). The per-product
     remove-file handlers in bySize.js / bySize_popular.js / pdp_*.js
     each strip the upload state, but reproducing the full pre-upload
     UI from JS would require chasing every flag those handlers don't
     reset. Simplest reliable fix: when the trashcan is clicked, let
     the existing handler run for a beat (so any cart-state cleanup
     fires) and then full-page-reload so the customer sees the original
     PDP exactly as it loaded.

     Only fires on the "Remove File" / "Cancel"-paired CONFIRM buttons
     inside the "Are you sure?" modal — NEVER on a trash icon that
     opens the modal. The trash icons (.fileRemoveBlock__removeFile
     on by-size products, #fileremove-2 on gang sheets) intentionally
     fire the existing per-product handlers that fade-in the modal.
     If we intercepted them we'd skip the confirmation prompt the
     customer expects.

     Selectors:
       #fileremove           confirm in `.customTabelPopup__overlay-2`
                             ("Remove File" modal — gang sheets)
       #fileremove-single    confirm in `.customTabelPopup__overlay-4`
                             ("Remove File?" modal — by-size products)
       .removeAllBlocks      multi-upload "clear all" — no modal,
                             direct action, reload immediately

     Capture phase + stopImmediatePropagation + synchronous reload so
     the per-product remove handlers (which strip the upload preview
     and re-show the native upload area in pieces) never run. With the
     bubble suppressed and the reload kicked off immediately, the page
     goes straight from the after-upload state to the fresh page load.
     Safe to skip the per-product handlers: no server-side cleanup
     happens at upload time (cart-add only fires on Add-to-Cart), so
     reload is sufficient. */
  (function () {
    if (window.__ntRemoveReloadBound) return;
    window.__ntRemoveReloadBound = true;
    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      var match = t.closest('#fileremove, #fileremove-single, .removeAllBlocks');
      if (!match) return;
      /* Only reload on a real user click. Synthetic clicks (from
         `$("#fileremove").click()` calls in the `.use_design`
         second-upload flow etc.) have `isTrusted === false` — those
         need to fall through to the original handlers so add-to-cart,
         toast, and the new image swap can complete. Without this
         guard, picking a previous design as a second upload would
         reload the page mid-flow and never finish the cart-add. */
      if (e.isTrusted === false) return;
      e.stopImmediatePropagation();
      e.preventDefault();
      try { window.location.reload(); } catch (_e) { window.location.href = window.location.pathname; }
    }, true);
  })();

  /* ─── Gang-sheet "or choose a previous design" link intercept ──────
     The link sits inside <another-upload> so it renders visually inside
     the blue Add-Another upload box. But <another-upload> has a jQuery-
     delegated bubble-phase click handler in pdp_transferBySize.js that
     opens the native file picker for ANY click that bubbles up through
     it. Inline `onclick` with stopPropagation on the link wasn't stopping
     the bubble reliably (likely because jQuery normalizes the event and
     the inline handler doesn't always win the race against the document-
     level delegate).

     Capture-phase listener on document fires before the bubble-phase
     handlers anywhere downstream. We match the link, call
     stopImmediatePropagation to kill any further listeners (capture +
     bubble), then open the legacy `.customTabelPopup__overlay-3`
     picker modal via the existing `.purchase_from_previous` anchor so
     the gang-sheet modal setup runs unchanged. */
  (function () {
    if (window.__ntGangSheetChoosePrevBound) return;
    window.__ntGangSheetChoosePrevBound = true;
    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      var link = t.closest('.anotherUploadGangSheet__choosePrev');
      if (!link) return;
      e.stopImmediatePropagation();
      e.preventDefault();
      try {
        /* Same artwork-rights gate as the file upload path — if the
           customer hasn't checked the agreement box, surface the
           inline red "Please check the box above to continue" error
           and BLOCK the picker modal from opening. Without this, the
           "or choose a previous design" link bypassed validation; the
           customer could swap in a second design before agreeing to
           terms. Mirrors the gate already enforced in
           pdp_transferBySize.js for `.anotherUploadGangSheet`. */
        if (typeof window.__gateGangSheetUpload === 'function' && window.__gateGangSheetUpload()) {
          return;
        }
        /* The "Add Another Gang Sheet" box is the SECOND-upload entry
           point — user has a design loaded already and is picking a
           previous design to ADD (not replace). The .use_design click
           handler in pdp_transferBySize.js reads
           customTabelPopup__overlay-3[data-type] to decide whether to
           run addAnotherTransfer (cart-add the first design + load the
           new one). We must set data-type='second_upload' AFTER firing
           the .purchase_from_previous trigger because that handler
           overwrites data-type from its own element's data-type attr
           (which is 'first_upload' on the original entry-point link). */
        var trigger = document.querySelector('a.purchase_from_previous');
        if (trigger) trigger.click();
        var overlay = document.querySelector('.customTabelPopup__overlay-3');
        if (overlay) {
          overlay.style.display = 'grid';
          overlay.setAttribute('data-type', 'second_upload');
        }
      } catch (_e) { /* never break the page */ }
    }, true);
  })();

  /* ─── Mirror upload preview into product gallery hero ──────────────
     When the customer uploads / picks / generates an image, the
     `#fileupload_hero` <img> src gets updated to the customer's design.
     We want the product gallery's hero image (the first
     .product-gallery-item) to reflect that design too — so the visible
     "product image" on the PDP matches what the customer just put in
     the upload preview.

     Strategy: MutationObserver on `#fileupload_hero` for `src` changes.
     Skip the initial transparent placeholder + the upload-in-progress
     loader so the gallery only updates on real designs. Clear srcset /
     data-srcset so the browser doesn't override our src with a stale
     responsive variant.

     EXCLUSION: Gang-sheet products. On gang sheets the product gallery
     is the gang-sheet template + size visualization — the customer
     uploads multiple designs to lay out within a gang sheet, so
     replacing the gallery with the upload is wrong: it makes the
     gallery look like one of the designs and hides the gang-sheet
     layout. Skip the mirror when isGangPage / template suffix
     contains 'gang'. */
  (function () {
    if (window.__ntVariantImageMirrorBound) return;
    window.__ntVariantImageMirrorBound = true;
    var _isGang = (
      (typeof isGangPage !== 'undefined' && isGangPage) ||
      /template-product-(?:dtf|uv)-gang-sheet/i.test(document.body.className) ||
      /gang/i.test(document.body.className)
    );
    if (_isGang) return;
    var _skipMirror = /template-product-(?:puff-transfers|puff-glitter|spangle-by-size|custom-magnets|custom-keychains|custom-stickers-2|bumper-stickers|truck-stickers|wall-graphics|indoor-floor-graphics|outdoor-floor-graphics)/i.test(document.body.className);
    if (_skipMirror) return;
    function isPlaceholder(src) {
      if (!src) return true;
      return /transparent\.png|loader\.gif|loader-2\.gif/i.test(src);
    }
    function mirror(src) {
      if (isPlaceholder(src)) return;
      var heroImgs = document.querySelectorAll(
        '.product-gallery .product-gallery-item[data-index="0"] .lazy-image img, ' +
        '.product-gallery .product-gallery-item[data-index="0"] img'
      );
      heroImgs.forEach(function (img) {
        img.removeAttribute('srcset');
        img.removeAttribute('data-srcset');
        img.src = src;
      });
    }
    function init() {
      var hero = document.querySelector('#fileupload_hero');
      if (!hero) return;
      /* Mirror existing src in case page loaded with `?file=` param. */
      mirror(hero.getAttribute('src'));
      var observer = new MutationObserver(function (mutations) {
        for (var i = 0; i < mutations.length; i++) {
          if (mutations[i].attributeName === 'src') {
            mirror(hero.getAttribute('src'));
            break;
          }
        }
      });
      observer.observe(hero, { attributes: true, attributeFilter: ['src'] });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();

  /* ─── Auto-scroll on upload start and upload complete ────────────────
     Watches body class changes for `file-upload-overlay-2-active` (upload
     in progress) and `image-uploaded` (upload complete).

     Desktop (width >= 768px): scrolls to page top. The ninja loader and
     the eventual upload preview are both immediately visible because
     desktop renders everything in two columns.

     Mobile (width < 768px): scrolls so the upload preview's WIDTH
     measurement (the "2.37"" label above the preview image) is just below
     the sticky header. Page-top scroll buries the preview under the
     gallery + product info on small screens; the user wants the preview
     dimensions immediately in view after upload completes.

     One-shot per state via lastUploadState to avoid scrolling on every
     class change. */
  (function () {
    if (window.__ntUploadScrollTopBound) return;
    window.__ntUploadScrollTopBound = true;
    var lastUploadState = '';
    function detectState() {
      var b = document.body;
      /* `nt-uploading-active` is set by the observer in
         mobile-preview-size-guide-tabs.liquid the moment a file input
         fires `change` — the most reliable "upload started" signal on
         these tab templates. `file-upload-overlay-2-active` covers the
         secondary-drop-zone path. */
      if (b.classList.contains('nt-uploading-active')) return 'uploading';
      if (b.classList.contains('file-upload-overlay-2-active')) return 'uploading';
      if (b.classList.contains('image-uploaded')) return 'uploaded';
      return '';
    }
    function isMobile() { return window.innerWidth < 768; }
    function findPreviewAnchor() {
      /* Walk a list of candidates and return the first one that's both
         present and visible. On the three tab templates (by-size-tabs,
         by-size-bg-options, uv-dtf-by-size) the mobile "Your Image /
         Size Guide" pill bar (.nt-mptabs) is the topmost UI after upload
         — prefer it so the tabs sit at the top of the viewport and the
         image preview is visible just below. Falls through to the
         file-preview wrapper on templates without the tab bar. */
      var sels = [
        '.nt-mptabs',
        '.split_design.newFilePreview',
        'file-preview',
        '.easyzoom',
        '.preview-block',
        '.fileupload_preview'
      ];
      for (var i = 0; i < sels.length; i++) {
        var el = document.querySelector(sels[i]);
        if (el && el.offsetParent !== null) return el;
      }
      return null;
    }
    function stickyHeaderOffset() {
      /* Compensate for any sticky header so the preview top isn't hidden
         behind it. Falls back to 0 if no obvious sticky header. */
      var hdr = document.querySelector('header.sticky, [class*="header-loaded"] header, .header-section');
      if (!hdr) return 0;
      var h = hdr.getBoundingClientRect().height;
      return h > 0 && h < 200 ? h : 0;
    }
    function maybeScroll() {
      var state = detectState();
      if (!state || state === lastUploadState) return;
      lastUploadState = state;
      if (isMobile() && state === 'uploaded') {
        var anchor = findPreviewAnchor();
        if (anchor) {
          var top = anchor.getBoundingClientRect().top + window.scrollY - stickyHeaderOffset() - 8;
          try { window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' }); }
          catch (_e) { window.scrollTo(0, Math.max(0, top)); }
          return;
        }
      }
      try { window.scrollTo({ top: 0, behavior: 'smooth' }); }
      catch (_e) { window.scrollTo(0, 0); }
    }
    var obs = new MutationObserver(maybeScroll);
    obs.observe(document.body, { attributes: true, attributeFilter: ['class'] });
    /* Reset the tracker when both upload classes go away so a subsequent
       upload re-triggers the scroll. */
    new MutationObserver(function () {
      var s = detectState();
      if (!s) lastUploadState = '';
    }).observe(document.body, { attributes: true, attributeFilter: ['class'] });
  })();
</script>

