<script>
  (function () {
    if (window.__ntAIToolbarBound) return;
    window.__ntAIToolbarBound = true;

    var BADGE_SVG =
      '<svg viewBox="0 0 24 24" aria-hidden="true">' +
        '<path d="M12 2 13.6 9.1 20.5 11 13.6 12.9 12 20 10.4 12.9 3.5 11 10.4 9.1 12 2Z" />' +
        '<path d="M19 3 19.7 5.3 22 6 19.7 6.7 19 9 18.3 6.7 16 6 18.3 5.3 19 3Z" opacity=".75" />' +
        '<path d="M5 14 5.6 15.7 7.3 16.3 5.6 16.9 5 18.6 4.4 16.9 2.7 16.3 4.4 15.7 5 14Z" opacity=".55" />' +
      '</svg>';

    function wrapOne(inner) {
      if (!inner || inner.closest('.ai-ring')) return;
      var parent = inner.parentNode;
      if (!parent) return;
      var wrap = document.createElement('div');
      wrap.className = 'ai-wrap';
      var ring = document.createElement('div');
      ring.className = 'ai-ring';
      parent.insertBefore(wrap, inner);
      wrap.appendChild(ring);
      ring.appendChild(inner);
      /* Badge goes INSIDE the toolbar (position: absolute via CSS) so it
         stays anchored to the toolbar itself — even when downstream
         scripts like bg-removal-multi.js inject extra panels inside
         .ai-ring as siblings of the toolbar. */
      var badge = document.createElement('div');
      badge.className = 'ai-badge';
      badge.innerHTML = BADGE_SVG + '<span>Powered by AI</span>';
      inner.appendChild(badge);
    }

    function wrapAll() {
      document.querySelectorAll('.multiupload-rebuild-tools-inner').forEach(wrapOne);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', wrapAll);
    } else {
      wrapAll();
    }

    /* Re-wrap toolbars added dynamically (multi-upload tiles cloned from
       templates). childList only — no attribute observation to avoid the
       infinite-loop class of bugs from the upload-state observer. */
    new MutationObserver(function (muts) {
      for (var i = 0; i < muts.length; i++) {
        var added = muts[i].addedNodes;
        if (!added) continue;
        for (var j = 0; j < added.length; j++) {
          var n = added[j];
          if (n.nodeType !== 1) continue;
          if (n.matches && n.matches('.multiupload-rebuild-tools-inner')) {
            wrapOne(n);
          }
          if (n.querySelectorAll) {
            n.querySelectorAll('.multiupload-rebuild-tools-inner').forEach(wrapOne);
          }
        }
      }
    }).observe(document.documentElement, { subtree: true, childList: true });
  })();
</script>
