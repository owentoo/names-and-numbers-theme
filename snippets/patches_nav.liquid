<link rel="stylesheet" href="{{ 'patchesMenu.css' | asset_url }}">
<div class="patchesMenu" style="border-bottom-color: {{ color }};">

  <div class="patchesMenu-body">

    {% comment %} ── Left: marketing text ── {% endcomment %}
    <div class="patchesMenu-left">
      {%- if heading != blank -%}
        <p class="patchesMenu-heading" style="font-size: {{ headline_size | default: 19 }}px;">{{ heading | escape }}</p>
      {%- endif -%}
      {%- if desc != blank -%}
        <p class="patchesMenu-desc">{{ desc | escape }}</p>
      {%- endif -%}
    </div>

    {% comment %} ── Right: 5 product cards in a single row ── {% endcomment %}
    <div class="patchesMenu-cards">

      {%- if card_img_1 != blank or card_url_1 != blank -%}
        <a href="{{ card_url_1 | default: '#' }}" class="patchesMenu-card">
          <div class="patchesMenu-card-img{% unless card_img_1 %} patchesMenu-card-img--empty{% endunless %}">
            {%- if card_img_1 -%}
              <img src="{{ card_img_1 | image_url: width: 176 }}" alt="{{ card_label_1 | escape }}" width="76" height="76" loading="lazy">
            {%- endif -%}
          </div>
          {%- if card_label_1 != blank -%}
            <span class="patchesMenu-card-label">{{ card_label_1 | escape }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- if card_img_2 != blank or card_url_2 != blank -%}
        <a href="{{ card_url_2 | default: '#' }}" class="patchesMenu-card">
          <div class="patchesMenu-card-img{% unless card_img_2 %} patchesMenu-card-img--empty{% endunless %}">
            {%- if card_img_2 -%}
              <img src="{{ card_img_2 | image_url: width: 176 }}" alt="{{ card_label_2 | escape }}" width="76" height="76" loading="lazy">
            {%- endif -%}
          </div>
          {%- if card_label_2 != blank -%}
            <span class="patchesMenu-card-label">{{ card_label_2 | escape }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- if card_img_3 != blank or card_url_3 != blank -%}
        <a href="{{ card_url_3 | default: '#' }}" class="patchesMenu-card">
          <div class="patchesMenu-card-img{% unless card_img_3 %} patchesMenu-card-img--empty{% endunless %}">
            {%- if card_img_3 -%}
              <img src="{{ card_img_3 | image_url: width: 176 }}" alt="{{ card_label_3 | escape }}" width="76" height="76" loading="lazy">
            {%- endif -%}
          </div>
          {%- if card_label_3 != blank -%}
            <span class="patchesMenu-card-label">{{ card_label_3 | escape }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- if card_img_4 != blank or card_url_4 != blank -%}
        <a href="{{ card_url_4 | default: '#' }}" class="patchesMenu-card">
          <div class="patchesMenu-card-img{% unless card_img_4 %} patchesMenu-card-img--empty{% endunless %}">
            {%- if card_img_4 -%}
              <img src="{{ card_img_4 | image_url: width: 176 }}" alt="{{ card_label_4 | escape }}" width="76" height="76" loading="lazy">
            {%- endif -%}
          </div>
          {%- if card_label_4 != blank -%}
            <span class="patchesMenu-card-label">{{ card_label_4 | escape }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- if card_img_5 != blank or card_url_5 != blank -%}
        <a href="{{ card_url_5 | default: '#' }}" class="patchesMenu-card">
          <div class="patchesMenu-card-img{% unless card_img_5 %} patchesMenu-card-img--empty{% endunless %}">
            {%- if card_img_5 -%}
              <img src="{{ card_img_5 | image_url: width: 176 }}" alt="{{ card_label_5 | escape }}" width="76" height="76" loading="lazy">
            {%- endif -%}
          </div>
          {%- if card_label_5 != blank -%}
            <span class="patchesMenu-card-label">{{ card_label_5 | escape }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}

    </div>
  </div>

  {% comment %} ── Footer bar ── {% endcomment %}
  <div class="patchesMenu-footer">
    <div class="patchesMenu-footer-shipping">
      {%- if footer_bold != blank -%}
        <span class="patchesMenu-footer-title">{{ footer_bold | escape }}</span>
      {%- endif -%}
      {%- if footer_sub != blank -%}
        <span class="patchesMenu-footer-sub">{{ footer_sub | escape }}</span>
      {%- endif -%}
    </div>
    {%- if url != blank -%}
      <a href="{{ url }}" class="patchesMenu-footer-cta" style="background: {{ color }};">
        {{ cta | default: 'Shop All' | escape }}&nbsp;&rarr;
      </a>
    {%- endif -%}
  </div>

</div>
