{{ 'names-and-numbers.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Cart design-group renderer for Names & Numbers items. Detected at the
  cart-form / cart-form-page level by the group's first child having
  Style == "Names & Numbers".

  Layout mirrors bySize's flat cart-form-item--layout grid
  (assets/section-main-cart.css:60-83):
    desktop:   6.25rem 18.75rem 1fr 6.25rem  (thumb | info | qty | total)
    ≤1100px:   6.25rem 12.5rem  1fr 6.25rem
  No thumbnail (each entry has its own art so a single group thumb
  isn't meaningful) — thumbnail column is reserved blank to keep
  alignment with bySize rows above.

  Params:
    group_key       — string, data-group-key
    first_item      — representative child line item (read shared props)
    first_key       — first child's key (group Edit link's edit_line)
    group_final     — sum children final_line_price (cents)
    group_original  — sum children original_line_price (cents)
    disc_title      — discount allocation title (or blank)
    child_count     — number of children in the group
{%- endcomment -%}

{%- assign _nn_name_height   = first_item.properties["Name Height"]   | default: '' -%}
{%- assign _nn_number_height = first_item.properties["Number Height"] | default: '' -%}
{%- assign _nn_scope         = first_item.properties["Scope"]         | default: '' -%}

{%- capture _nn_state -%}{"scope":{{ _nn_scope | json }},"font":{{ first_item.properties["Font"] | default: '' | json }},"color":{{ first_item.properties["Color"] | default: '' | json }},"nameHeight":{{ _nn_name_height | json }},"numberHeight":{{ _nn_number_height | json }},"entries":{{ first_item.properties["Entries"] | default: '' | json }}}{%- endcapture -%}
{%- assign _nn_state_b64 = _nn_state | base64_encode -%}

{%- assign _nn_name_in = _nn_name_height | split: ' in' | first -%}
{%- assign _nn_num_in  = _nn_number_height | split: ' in' | first -%}
{%- if _nn_scope == 'Names only' -%}
  {%- assign _nn_size_summary = _nn_name_in | append: '" Names' -%}
{%- elsif _nn_scope == 'Numbers only' -%}
  {%- assign _nn_size_summary = _nn_num_in | append: '" Numbers' -%}
{%- else -%}
  {%- assign _nn_size_summary = _nn_name_in | append: '" Names + ' | append: _nn_num_in | append: '" Numbers' -%}
{%- endif -%}

{%- comment -%} Collect every child line key so the × button can zero them all in one /cart/update.js call. {%- endcomment -%}
{%- assign _nn_child_keys = "" -%}
{%- for item in cart.items -%}
  {%- assign _gn = "" -%}
  {%- for p in item.properties -%}
    {%- if p.first == '_design name' and p.last != blank -%}
      {%- assign _gn = p.last | handleize -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if _gn != blank -%}{%- assign _gn = item.product.id | append: '_' | append: _gn -%}{%- endif -%}
  {%- if _gn == group_key -%}
    {%- assign _nn_child_keys = _nn_child_keys | append: item.key | append: "," -%}
  {%- endif -%}
{%- endfor -%}

<div class="cart-form-item nt-nn-group" data-group-key="{{ group_key | escape }}" data-nn-expanded="false">
  <div class="cart-item__product-info cart-form-item--layout nt-nn-group__row">

    {%- comment -%} Empty thumbnail slot — reserves the 6.25rem column so info/qty/total align with bySize rows above. {%- endcomment -%}
    <div class="cart-item__thumbnail nt-nn-group__thumb" aria-hidden="true"></div>

    <div class="cart-form-item__price-title-variants nt-nn-group__info">
      <strong class="cart-item__title">DTF Names and Numbers</strong>
      <span class="cart-item__property">{{ _nn_size_summary }}&nbsp;<a class="nn-cart-edit__link" href="/products/{{ first_item.product.handle }}?view=names-and-numbers&amp;nn={{ _nn_state_b64 }}&amp;edit_line={{ first_key | url_encode }}">Edit</a></span>
      {%- if disc_title != blank -%}
        <span class="cart-item__property nt-dg-discount">{{ 'cart.discount' | t }}: <strong class="seccolor">{{ disc_title }}</strong></span>
      {%- endif -%}
    </div>

    {%- comment -%} Qty slot — static "1" for now. Each child line carries its own quantity from the configurator. {%- endcomment -%}
    <div class="cart-item__actions cart__quantity nt-nn-group__qty">
      <div class="nt-nn-group__qty-static">
        <span class="qty-button" aria-hidden="true">&minus;</span>
        <span class="nt-nn-group__qty-value">1</span>
        <span class="qty-button" aria-hidden="true">+</span>
      </div>
    </div>

    <div class="cart-item__total nt-nn-group__total">
      <div class="cart-item__price discounted-line-item-price">
        {%- if group_final < group_original -%}
          <div><span><del><strong>{{ group_original | money }}</strong></del></span></div>
          <div><strong>{{ group_final | money }}</strong></div>
        {%- else -%}
          <div><strong>{{ group_final | money }}</strong></div>
        {%- endif -%}
      </div>
      <button type="button" class="remove nt-nn-group__remove" data-nn-remove-group data-nn-keys="{{ _nn_child_keys }}" aria-label="Remove design">
        <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 1l8 8M9 1l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>

  </div>

  <button type="button" class="nt-nn-group__toggle" data-nn-toggle-entries data-group-key="{{ group_key | escape }}">
    <span class="nn-cart-edit__link" data-nn-show-text>Show all {{ child_count }} {% if child_count == 1 %}entry{% else %}entries{% endif %}</span>
    <span class="nn-cart-edit__link" data-nn-hide-text hidden>Hide all {{ child_count }} {% if child_count == 1 %}entry{% else %}entries{% endif %}</span>
  </button>

  <div class="nt-nn-group__entries" data-nn-entries hidden>
    {%- for item in cart.items -%}
      {%- assign _gn = "" -%}
      {%- for p in item.properties -%}
        {%- if p.first == '_design name' and p.last != blank -%}
          {%- assign _gn = p.last | handleize -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if _gn != blank -%}{%- assign _gn = item.product.id | append: '_' | append: _gn -%}{%- endif -%}
      {%- if _gn == group_key -%}
        <div class="nt-nn-entry">
          <div class="nt-nn-entry__main">
            <div class="nt-nn-entry__label">
              <strong>{{ item.properties["Name"] | default: '—' }}</strong>
              <span>{{ item.properties["Number"] }}</span>
            </div>
            <div class="cart-item__price discounted-line-item-price nt-nn-entry__unit">
              {%- if item.final_line_price < item.original_line_price -%}
                <div><span><del><strong>{{ item.original_line_price | divided_by: item.quantity | money }}</strong> ea</del></span></div>
                <div class="seccolor"><strong>{{ item.final_line_price | divided_by: item.quantity | money }}</strong> ea</div>
              {%- else -%}
                <div><strong>{{ item.final_line_price | divided_by: item.quantity | money }}</strong> ea</div>
              {%- endif -%}
            </div>
          </div>
          <div class="cart-item__price discounted-line-item-price nt-nn-entry__line">
            {%- if item.final_line_price < item.original_line_price -%}
              <div><span><del><strong>{{ item.original_line_price | money }}</strong></del></span></div>
              <div><strong>{{ item.final_line_price | money }}</strong></div>
            {%- else -%}
              <div><strong>{{ item.final_line_price | money }}</strong></div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<script data-nn-cart-toggle>
  (function () {
    if (window.__nnCartToggleBound) return;
    window.__nnCartToggleBound = true;
    document.addEventListener('click', function (e) {
      var toggle = e.target.closest('[data-nn-toggle-entries]');
      if (toggle) {
        var group = toggle.closest('.nt-nn-group');
        if (!group) return;
        var expanded = group.getAttribute('data-nn-expanded') === 'true';
        group.setAttribute('data-nn-expanded', expanded ? 'false' : 'true');
        var entries = group.querySelector('[data-nn-entries]');
        if (entries) entries.hidden = expanded;
        var showT = toggle.querySelector('[data-nn-show-text]');
        var hideT = toggle.querySelector('[data-nn-hide-text]');
        if (showT) showT.hidden = !expanded ? true : false;
        if (hideT) hideT.hidden = !expanded ? false : true;
        return;
      }
      var remove = e.target.closest('[data-nn-remove-group]');
      if (remove) {
        e.preventDefault();
        var raw = (remove.getAttribute('data-nn-keys') || '').split(',');
        var keys = raw.map(function (k) { return k.trim(); }).filter(Boolean);
        if (keys.length === 0) return;
        var updates = {};
        keys.forEach(function (k) { updates[k] = 0; });
        remove.disabled = true;
        fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ updates: updates })
        }).then(function () {
          window.location.reload();
        }).catch(function () {
          remove.disabled = false;
        });
      }
    });
  })();
</script>
