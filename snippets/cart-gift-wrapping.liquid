{%- unless settings.gift_wrap_product == blank -%}
  <style>.jtl-sub{display:none}.nt-jtl-card .jtl-sub{display:block;color:#5A5B60;font-size:12px;line-height:1.35}</style>
  {%- assign _jtl_sfx = '' -%}
  {%- if id_suffix != blank -%}{%- assign _jtl_sfx = '-' | append: id_suffix -%}{%- endif -%}
  <div id="cart-wrapping{{ _jtl_sfx }}" class="cart-wrapping cart-gift-widget {{ class }}">

    {%- liquid
      for item in cart.items
        if item.product_id == settings.gift_wrap_product.id
          assign checked = 'checked'
        endif
      endfor
    -%}

    <input data-js-cart-wrapping-checkbox type="checkbox" {{ checked }} class="styled-checkbox nodisplay" id="cart-gift-wrapping{{ _jtl_sfx }}" />
    <label class="checkbox-switch-design jtl-bar" for="cart-gift-wrapping{{ _jtl_sfx }}">
      <span class="jtl-icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><polygon class="nocolor" points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span>
      <span class="jtl-text">{{ settings.gift_wrap_heading }}</span>
      <span class="jtl-sub jtl-sub--off">+$19.99</span>
      <span class="jtl-sub jtl-sub--on">Added</span>
      <span class="jtl-sub jtl-sub--in-cart">$19.99</span>
      <i></i>
    </label>
    {% if hideQuickBuy != true %}
      <div style="display:none !important">{%- render 'quick-buy', product: settings.gift_wrap_product, default_to_first_variant: true -%}</div>
    {% else %}
      {%- assign product = settings.gift_wrap_product -%}
      <div id="add-to-cart-" class="hidden">
        {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ settings.gift_wrap_product.selected_or_first_available_variant.id }}">
        {%- endform -%}
      </div>
    {% endif %}
  </div>
{%- endunless -%}