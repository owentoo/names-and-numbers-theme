<link rel="stylesheet" href="{{ 'transfersMenu.css' | asset_url }}">
<div class="transfersMenu">

  <div class="transfersMenu-body">

    {% comment %} ── Left: marketing text ── {% endcomment %}
    <div class="transfersMenu-left">
      {%- if heading != blank -%}
        <p class="transfersMenu-heading" style="font-size: {{ headline_size | default: 19 }}px; font-weight: {{ headline_weight | default: 700 }};">{{ heading | escape }}</p>
      {%- endif -%}
      {%- if desc != blank -%}
        <p class="transfersMenu-desc">{{ desc | escape }}</p>
      {%- endif -%}
    </div>

    {% comment %} ── Right: 3 product cards ── {% endcomment %}
    <div class="transfersMenu-cards">

      {%- if card_img_1 != blank or card_url_1 != blank -%}
        <a href="{{ card_url_1 | default: '#' }}" class="transfersMenu-card">
          <div class="transfersMenu-card-img{% unless card_img_1 %} transfersMenu-card-img--empty{% endunless %}">
            {%- if card_img_1 -%}
              <img src="{{ card_img_1 | image_url: width: 260 }}" alt="{{ card_label_1 | escape }}" width="130" height="130" loading="lazy">
            {%- endif -%}
          </div>
          {%- if card_label_1 != blank -%}
            <p class="transfersMenu-card-label">{{ card_label_1 | escape }}</p>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- if card_img_2 != blank or card_url_2 != blank -%}
        <a href="{{ card_url_2 | default: '#' }}" class="transfersMenu-card">
          <div class="transfersMenu-card-img{% unless card_img_2 %} transfersMenu-card-img--empty{% endunless %}">
            {%- if card_img_2 -%}
              <img src="{{ card_img_2 | image_url: width: 260 }}" alt="{{ card_label_2 | escape }}" width="130" height="130" loading="lazy">
            {%- endif -%}
          </div>
          {%- if card_label_2 != blank -%}
            <p class="transfersMenu-card-label">{{ card_label_2 | escape }}</p>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- if card_img_3 != blank or card_url_3 != blank -%}
        <a href="{{ card_url_3 | default: '#' }}" class="transfersMenu-card">
          <div class="transfersMenu-card-img{% unless card_img_3 %} transfersMenu-card-img--empty{% endunless %}">
            {%- if card_img_3 -%}
              <img src="{{ card_img_3 | image_url: width: 260 }}" alt="{{ card_label_3 | escape }}" width="130" height="130" loading="lazy">
            {%- endif -%}
          </div>
          {%- if card_label_3 != blank -%}
            <p class="transfersMenu-card-label">{{ card_label_3 | escape }}</p>
          {%- endif -%}
        </a>
      {%- endif -%}

    </div>
  </div>

  {% comment %} ── Footer bar ── {% endcomment %}
  <div class="transfersMenu-footer">
    <div class="transfersMenu-footer-shipping">
      {%- if footer_bold != blank -%}
        <span class="transfersMenu-footer-title">{{ footer_bold | escape }}</span>
      {%- endif -%}
      {%- if footer_sub != blank -%}
        <span class="transfersMenu-footer-sub">{{ footer_sub | escape }}</span>
      {%- endif -%}
    </div>
    {%- if cta_url != blank -%}
      <a href="{{ cta_url }}" class="transfersMenu-footer-cta" style="background: {{ color }};">
        {{ cta_text | default: 'Shop Ninja Transfers' | escape }}&nbsp;&rarr;
      </a>
    {%- endif -%}
  </div>

  {% comment %} ── Bottom accent ── {% endcomment %}
  <div class="transfersMenu-accent" style="background: {{ color }};"></div>

</div>
