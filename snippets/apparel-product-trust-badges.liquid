{%liquid
  assign localzone = localization.country.iso_code
  case localzone
    when "CA"
      assign b___ship = settings.blanks_freeShipping_amount_CA
      assign b___nwprice = b___ship | prepend: "$"
    else
      assign b___ship = settings.blanks_freeShipping_amount
      assign b___nwprice = b___ship | prepend: "$"
  endcase
%}
<div style="text-align:left;margin-top:-10px;margin-bottom:10px;font-weight:bold;color:#3E6166;">
  <div style="display:inline-block;">
    <span class="material-symbols-outlined" style="vertical-align: bottom; line-height: 28px;">local_shipping</span>
    <span style="margin-right:20px;vertical-align: bottom; line-height: 28px;">Free Shipping on {{ b___nwprice }}+</span>
  </div>
  <div style="display:inline-block;">
    <span class="material-symbols-outlined" style="vertical-align: bottom; line-height: 28px;">check_circle</span>
    <span style="margin-right:20px;vertical-align: bottom; line-height: 28px;">No Minimums</span>
  </div>
  <div style="display:inline-block;">
    <span class="material-symbols-outlined" style="vertical-align: bottom; line-height: 28px;">replay</span>
    <span style="vertical-align: bottom; line-height: 28px;">Free 45-Day Returns</span>
  </div>
</div>
