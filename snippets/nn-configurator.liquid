<!-- Google Fonts for the configurator -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Oswald:wght@700&family=Russo+One&family=Black+Ops+One&family=Staatliches&family=Rye&family=Playfair+Display:wght@900&display=swap">

{%- assign nn_form_id = 'product-form-' | append: section.id -%}

<div
  class="nn-page nn-page--embedded"
  id="nn-configurator-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-sheet-width-in="22"
  data-side-margin-in="0.25"
  data-horiz-gap-in="0.25"
  data-vert-gap-in="0.25"
  data-default-name-height-in="2"
  data-default-number-height-in="8"
  data-max-entries="200"
  data-max-item-width-in="12"
  data-api-url="https://hpz51rjda5.execute-api.us-east-1.amazonaws.com/production"
  data-imgix-host="ninjauploads-production.imgix.net"
>
  <!-- Step 1: scope -->
  <section class="nn-step">
    <header class="nn-step__head">
      <span class="nn-step__num">1</span>
      <h2 class="nn-step__title">What are you printing?</h2>
    </header>
    <div class="nn-toggle" data-nn-control="scope" role="radiogroup">
      <button type="button" class="nn-toggle__btn" data-value="names"   role="radio" aria-checked="false">Names</button>
      <button type="button" class="nn-toggle__btn" data-value="numbers" role="radio" aria-checked="false"># Numbers</button>
      <button type="button" class="nn-toggle__btn is-selected" data-value="both" role="radio" aria-checked="true">Both</button>
    </div>
  </section>

  <!-- Step 2: font -->
  <section class="nn-step">
    <header class="nn-step__head">
      <span class="nn-step__num">2</span>
      <h2 class="nn-step__title">Font style</h2>
      <span class="nn-step__current" data-nn-current-font>—</span>
    </header>
    <div class="nn-font-grid" data-nn-control="font"></div>
  </section>

  <!-- Step 3: color -->
  <section class="nn-step">
    <header class="nn-step__head">
      <span class="nn-step__num">3</span>
      <h2 class="nn-step__title">Color</h2>
      <span class="nn-step__current" data-nn-current-color>—</span>
    </header>
    <div class="nn-swatch-grid" data-nn-control="color"></div>
  </section>

  <!-- Step 4: heights -->
  <section class="nn-step" data-nn-step="heights">
    <header class="nn-step__head">
      <span class="nn-step__num">4</span>
      <h2 class="nn-step__title">Letter &amp; number height</h2>
    </header>
    <div class="nn-height-group" data-nn-height-for="name">
      <span class="nn-height-group__label">Name height</span>
      <div class="nn-height-pills" data-nn-control="height-name"></div>
    </div>
    <div class="nn-height-group" data-nn-height-for="number">
      <span class="nn-height-group__label">Number height</span>
      <div class="nn-height-pills" data-nn-control="height-number"></div>
    </div>
  </section>

  <!-- Step 5: roster -->
  <section class="nn-step nn-step--roster">
    <header class="nn-step__head">
      <span class="nn-step__num">5</span>
      <h2 class="nn-step__title">Your roster</h2>
    </header>
    <p class="nn-step__hint">Add as many entries as you like. Sizes apply to every row.</p>

    <div class="nn-tabs" data-nn-tabs>
      <button type="button" class="nn-tab is-active" data-tab="grid">Grid table</button>
      <button type="button" class="nn-tab" data-tab="paste">Bulk paste</button>
      <button type="button" class="nn-tab" data-tab="csv">Upload CSV</button>
    </div>

    <div class="nn-tab-pane" data-pane="grid">
      <div class="nn-roster-wrap">
        <table class="nn-roster">
          <thead>
            <tr>
              <th class="nn-roster__th--num">#</th>
              <th class="nn-roster__th--name">Name</th>
              <th class="nn-roster__th--number">Number</th>
              <th class="nn-roster__th--qty">Qty</th>
              <th class="nn-roster__th--price">Price</th>
              <th class="nn-roster__th--rm"></th>
            </tr>
          </thead>
          <tbody data-nn-entries></tbody>
        </table>
      </div>
      <div class="nn-roster__after">
        <button type="button" class="nn-btn nn-btn--ghost nn-btn--small" data-nn-add-entry>+ Add row</button>
        <p class="nn-roster__count"><span data-nn-entries-count>0</span> entries</p>
      </div>
    </div>

    <div class="nn-tab-pane" data-pane="paste" hidden>
      <label class="nn-paste-label" for="nn-bulk-textarea">PASTE YOUR ROSTER</label>
      <textarea
        id="nn-bulk-textarea"
        class="nn-bulk-textarea"
        data-nn-bulk-text
        placeholder="One per line — formats accepted:&#10;Rivera, 23&#10;Chen 7&#10;Okafor&#9;11"
        rows="6"
      ></textarea>
      <p class="nn-paste-hint">
        One per line. Use a comma between name and number: <code>Rivera, 23</code>. Spaces also work.
      </p>

      <div class="nn-paste-preview" data-nn-paste-preview hidden>
        <h4 class="nn-paste-preview__title"><span data-nn-paste-count>0</span> PARSED ROWS</h4>
        <div class="nn-roster-wrap">
          <table class="nn-roster nn-roster--preview">
            <thead>
              <tr>
                <th class="nn-roster__th--num">#</th>
                <th class="nn-roster__th--name">Name</th>
                <th class="nn-roster__th--number">Number</th>
                <th class="nn-roster__th--qty">Qty</th>
              </tr>
            </thead>
            <tbody data-nn-paste-preview-rows></tbody>
          </table>
        </div>
        <p class="nn-paste-tip">Click <strong>Apply to roster</strong> to replace your current list with this parsed set.</p>
        <div class="nn-bulk-actions">
          <button type="button" class="nn-btn nn-btn--primary" data-nn-paste-apply disabled>
            <span data-nn-paste-apply-label>Apply 0 rows to roster</span>
          </button>
          <span class="nn-bulk-actions__tip">Tip: pasting overwrites the current roster.</span>
        </div>
      </div>
    </div>

    <div class="nn-tab-pane" data-pane="csv" hidden>
      <label class="nn-csv-drop" data-nn-csv-drop>
        <input type="file" accept=".csv,text/csv,text/plain" data-nn-csv-input hidden>
        <span class="nn-csv-drop__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" x2="12" y1="3" y2="15"/>
          </svg>
        </span>
        <strong class="nn-csv-drop__title">Drop your CSV or click to upload</strong>
        <span class="nn-csv-drop__sub">One row per transfer · columns: <code>name, number, qty</code></span>
        <button type="button" class="nn-btn nn-btn--ghost nn-csv-drop__template" data-nn-csv-template>
          ⬇ Download template
        </button>
      </label>
      <p class="nn-csv-footer">Excel, Google Sheets, or any spreadsheet exports to CSV.</p>
      <div class="nn-csv-result" data-nn-csv-result hidden></div>
    </div>
  </section>

  <!-- Inline checkout summary + hidden inputs that submit through bySizeNew's product form -->
  <div class="nn-checkout">
    <div class="nn-checkout__rows">
      <div class="nn-checkout__row">
        <span>Print area</span>
        <strong data-nn-sqin>—</strong>
      </div>
      <div class="nn-checkout__row nn-checkout__row--muted">
        <span>Sheet size</span>
        <strong data-nn-dimensions>—</strong>
      </div>
      <div class="nn-checkout__row nn-checkout__row--total">
        <span>Subtotal</span>
        <strong data-nn-price>—</strong>
      </div>
    </div>

    <div class="nn-warning" data-nn-warning hidden></div>

    {%- comment -%}
      These inputs live outside the product form but submit with it via the
      `form` attribute — that lets us drop the configurator anywhere on the
      page without nesting forms.
    {%- endcomment -%}
    <input type="hidden" form="{{ nn_form_id }}" name="id" value="" data-nn-variant-id>
    <input type="hidden" form="{{ nn_form_id }}" name="properties[Style]" value="Names & Numbers">
    <input type="hidden" form="{{ nn_form_id }}" name="properties[Scope]" value="" data-nn-prop="scope">
    <input type="hidden" form="{{ nn_form_id }}" name="properties[Font]" value="" data-nn-prop="font">
    <input type="hidden" form="{{ nn_form_id }}" name="properties[Color]" value="" data-nn-prop="color">
    <input type="hidden" form="{{ nn_form_id }}" name="properties[Name Height]" value="" data-nn-prop="name-height">
    <input type="hidden" form="{{ nn_form_id }}" name="properties[Number Height]" value="" data-nn-prop="number-height">
    <input type="hidden" form="{{ nn_form_id }}" name="properties[Entries Count]" value="" data-nn-prop="entries-count">
    <input type="hidden" form="{{ nn_form_id }}" name="properties[Entries]" value="" data-nn-prop="entries">
    <input type="hidden" form="{{ nn_form_id }}" name="properties[_width]" value="22" data-nn-prop="width">
    <input type="hidden" form="{{ nn_form_id }}" name="properties[_height]" value="" data-nn-prop="height">
    <input type="hidden" form="{{ nn_form_id }}" name="properties[_render_version]" value="client-v2">
    <input type="hidden" form="{{ nn_form_id }}" name="properties[Upload (Vector Files Preferred)]" value="" data-nn-prop="upload-imgix">
    <input type="hidden" form="{{ nn_form_id }}" name="properties[_Original Image]" value="" data-nn-prop="upload-s3">

    {%- comment -%}
      The submit button submits through the same form. We don't render
      Add to Cart here — bySizeNew's `buy_buttons` block renders the
      real Add to Cart button further down the page, and the JS picks
      it up via [data-nn-submit] which we set on it from the JS init.
    {%- endcomment -%}
    <button
      type="button"
      class="nn-btn nn-btn--primary nn-btn--block nn-checkout__cta"
      data-nn-submit
      disabled
    >
      <span data-nn-submit-label>Add a name or number to start</span>
      <span class="nn-checkout__cta-price" data-nn-cta-price></span>
    </button>
  </div>

  <script type="application/json" data-nn-fonts>{{ nn_fonts_json }}</script>
  <script type="application/json" data-nn-colors>{{ nn_colors_json }}</script>
  <script type="application/json" data-nn-name-heights>{{ nn_name_heights_json }}</script>
  <script type="application/json" data-nn-number-heights>{{ nn_number_heights_json }}</script>
  <script type="application/json" data-nn-variants>{{ nn_variants_json }}</script>
</div>

<script src="{{ 'names-and-numbers.js' | asset_url }}" defer></script>
