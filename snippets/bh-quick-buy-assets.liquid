    else { mask = 'linear-gradient(to right, transparent ' + MASK_SIZE + 'px, black ' + MASK_SIZE + 'px, black calc(100% - ' + MASK_SIZE + 'px), transparent calc(100% - ' + MASK_SIZE + 'px))'; }
