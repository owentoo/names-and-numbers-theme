  function renderPdpColorSizes($block, payload) {
    var $dlg = $block.closest("dialog.grt-product-modal");
    if (!$dlg.length) return;
    var $form = $block.closest("form.grt-product-modal__form");
    var $sizeParentLabel = $dlg.find("[data-size-qty-parent-label]").first();
    var $sizeGrid = $dlg.find("[data-size-qty-grid]").first();
    var $pdpGrid = $dlg.find("[data-pdp-size-grid]").first();
    var $qtyWrap = $dlg.find("[data-qty-wrap]").first();
    var sizeOptionIndex = parseInt($block.attr("data-size-option-index") || "", 10);
    var $sizeOption = $();
    if (!isNaN(sizeOptionIndex) && sizeOptionIndex >= 0) {
      $sizeOption = $block.find('.grt-opt__pills[data-option-index="' + sizeOptionIndex + '"]').closest(".grt-opt");
    }
    if ($sizeGrid.length) $sizeGrid.empty().hide();
    if ($qtyWrap.length) $qtyWrap.hide();
    if ($sizeOption.length) $sizeOption.hide();
    if ($sizeParentLabel.length) $sizeParentLabel.text("Choose Size(s)").show();
    if (!$pdpGrid.length) return;

    var sizesHtml = payload && payload.sizes ? String(payload.sizes) : "";
    var $parsed = $("<div>" + sizesHtml + "</div>");
    var rows = [], seenRowKeys = {};

    $parsed.find(".flex-item > .variant-price-2").each(function () {
      var $card = $(this);
      var sizeLabel = $.trim($card.find("label").first().text());
      var $inp = $card.find(".itemQuantity").first();
      var itemId = "", max = 0, basePrice = 0, tierPricing = "", isOut = false, rowKey = "";
