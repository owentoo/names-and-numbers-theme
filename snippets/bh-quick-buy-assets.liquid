        itemId = String($inp.attr("data-id") || "").trim();
        max = parseInt($inp.attr("data-max") || "0", 10); if (isNaN(max)) max = 0;
        basePrice = parseInt($inp.attr("data-price") || "0", 10); if (isNaN(basePrice) || basePrice < 0) basePrice = 0;
        tierPricing = String($inp.attr("data-tiers") || "").trim();
        if (!sizeLabel) { var inputLabel = String($inp.attr("data-label") || "").trim(); if (inputLabel) { var parts = inputLabel.split("/"); sizeLabel = $.trim(parts[parts.length - 1] || inputLabel); } }
