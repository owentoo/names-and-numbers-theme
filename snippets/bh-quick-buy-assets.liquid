    });

    if (!rows.length) {
      $parsed.find(".itemQuantity").each(function () {
        var $inp = $(this);
        var itemId = String($inp.attr("data-id") || "").trim();
        if (!itemId || seenRowKeys["id:" + itemId]) return;
        seenRowKeys["id:" + itemId] = true;
        var max = parseInt($inp.attr("data-max") || "0", 10); if (isNaN(max)) max = 0;
        var basePrice = parseInt($inp.attr("data-price") || "0", 10); if (isNaN(basePrice) || basePrice < 0) basePrice = 0;
        var tierPricing = String($inp.attr("data-tiers") || "").trim();
