    var $toast = $("#" + toastId);
    if ($toast.length) return $toast;
    $toast = $('<div id="' + toastId + '" class="grt-upsell-toast" role="status" aria-live="polite" aria-atomic="true"><span class="grt-upsell-toast__icon" aria-hidden="true">✓</span><span class="grt-upsell-toast__message"></span><button type="button" class="grt-upsell-toast__close" aria-label="Close notification">×</button></div>');
    $("body").append($toast);
    return $toast;
  }

  function showUpsellToast(message, isError) {
    var $toast = getUpsellToastEl();
    $toast.find(".grt-upsell-toast__message").text(message || "Product successfully added to your cart");
    $toast.toggleClass("is-error", !!isError).addClass("is-visible");
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { $toast.removeClass("is-visible"); }, 2000);
  }

  function finalizeUpsellModalOpen($dlg, $btn, options) {
    var dlg = $dlg[0];
    if (!dlg || !dlg.showModal) return;
    options = options || {};
    bindDialogClose(dlg);
    lockPageScroll();
    dlg.showModal();
    if (!options.keepOpeningState) $dlg.removeClass("is-opening");

    var $qty = $dlg.find("[data-qty-input]").first();
    if ($qty.length) $qty.val(1);

    var $variantBlock = $dlg.find("[data-variant-options]").first();
    if ($variantBlock.length) {
      if ($variantBlock.attr("data-use-pdp-color-flow") === "1") {
        if (!options.parentChildReady && !options.deferParentChildInit) {
          resetInitialPdpColorSelection($variantBlock);
          initPdpColorFlow($variantBlock).then(function () {
            updateSelectedColorName($variantBlock);
            setTimeout(function () { $dlg.find(".grt-swatch-pills, .grt-opt__pills--pdp-colors").each(function () { initSwatchMask(this); }); }, 60);
          });
        }
        if (!options.deferParentChildInit) {
          buildSizeQtyGrid($dlg);
        }
      } else {
        applyColorSwatches($variantBlock);
        buildSizeQtyGrid($dlg);
        setTimeout(function () { $dlg.find(".grt-swatch-pills, .grt-opt__pills--pdp-colors").each(function () { initSwatchMask(this); }); }, 60);
      }
    }

    setTimeout(function () {
      var $f = $dlg.find(".grt-product-modal__form");
      if ($f.find("#bcpo").length) $f.find("#bcpo").remove();
    }, 250);

    setTimeout(function () {
      var $form = $dlg.find("form.grt-product-modal__form").first();
      var startVid = ($btn.attr("data-vid") || "").trim() || ($dlg.attr("data-default-vid") || "").trim() || ($form.attr("data-initial-variant") || "").trim();
      var $block = $dlg.find("[data-variant-options]").first();
      if (!$block.length) return;
      if ($block.attr("data-use-pdp-color-flow") === "1") {
        if ($form.length) $form.removeAttr("data-variant-id");
      } else {
        if ($form.length && startVid) $form.attr("data-variant-id", String(startVid));
        if (startVid) applyVariantIdToModal($dlg, startVid);
        else syncVariantFromSelection($block);
      }
    }, 0);

    // Populate color count badge
    setTimeout(function() {
      var $badge = $dlg.find("[data-color-count-badge]").first();
      if (!$badge.length) return;
      var seen = {}, count = 0;
      $dlg.find("[data-pdp-color-name]").each(function() {
        var k = String($(this).attr("data-pdp-color-name") || "").trim().toLowerCase();
        if (k && !seen[k]) { seen[k] = true; count++; }
      });
      if (count > 1) $badge.text(count + " colors").show();
      else $badge.hide();
    }, 300);
  }

  // ---------------------------
  // Swatch touch carousel
  // ---------------------------
  document.addEventListener("touchstart", function (e) {
    var target = e.target;
    var pills = target.closest ? target.closest(".grt-swatch-pills, .grt-opt__pills--pdp-colors") : null;
    if (!pills) return;
    initSwatchMask(pills);
    if (pills.__grtRaf) { cancelAnimationFrame(pills.__grtRaf); pills.__grtRaf = null; }
    var startX = e.touches[0].clientX, startY = e.touches[0].clientY, startScroll = pills.scrollLeft;
    var direction = null, prevX = startX, prevTime = Date.now(), velX = 0;
    function onMove(e2) {
      var cx = e2.touches[0].clientX, cy = e2.touches[0].clientY;
      var dx = cx - startX, dy = cy - startY;
      if (!direction && (Math.abs(dx) > 4 || Math.abs(dy) > 4)) direction = Math.abs(dx) >= Math.abs(dy) ? "h" : "v";
      if (direction === "h") {
        e2.preventDefault();
        var maxScroll = pills.scrollWidth - pills.clientWidth;
        pills.scrollLeft = Math.max(0, Math.min(maxScroll, startScroll - dx));
        var now = Date.now(), dt = now - prevTime;
        if (dt > 0) velX = (prevX - cx) / dt;
        prevX = cx; prevTime = now;
      }
    }
    function onEnd() {
      pills.removeEventListener("touchmove", onMove);
      pills.removeEventListener("touchend", onEnd);
      pills.removeEventListener("touchcancel", onEnd);
      if (direction !== "h") return;
      var v = velX * 16, friction = 0.92;
      function step() {
        v *= friction;
        if (Math.abs(v) < 0.5) { pills.__grtRaf = null; return; }
        var maxScroll = pills.scrollWidth - pills.clientWidth;
        var next = pills.scrollLeft + v;
        if (next <= 0 || next >= maxScroll) { pills.scrollLeft = Math.max(0, Math.min(maxScroll, next)); pills.__grtRaf = null; return; }
        pills.scrollLeft = next; pills.__grtRaf = requestAnimationFrame(step);
      }
      if (Math.abs(v) > 1) pills.__grtRaf = requestAnimationFrame(step);
    }
    pills.addEventListener("touchmove", onMove, { passive: false });
    pills.addEventListener("touchend", onEnd, { passive: true });
    pills.addEventListener("touchcancel", onEnd, { passive: true });
  }, { passive: true });

  // ---------------------------
  // Event handlers
  // ---------------------------
  $(document).on("click", ".grt-upsell-toast__close", function (e) {
    e.preventDefault(); e.stopPropagation();
    if (toastTimer) clearTimeout(toastTimer);
    $(this).closest(".grt-upsell-toast").removeClass("is-visible");
  });

  // OPEN modal (.grt-qv-btn)
  $(document).on("click", ".grt-qv-btn", function (e) {
    e.preventDefault(); e.stopPropagation();
    var $btn = $(this);
    var openId = $btn.attr("data-open-modal");
    if (!openId) return;
    var $dlg = $("#" + openId);
    var dlg = $dlg[0];
    if (!dlg || !dlg.showModal) return;
    $dlg.addClass("is-opening");

    var $variantBlock = $dlg.find("[data-variant-options]").first();
    if ($variantBlock.length && $variantBlock.attr("data-use-pdp-color-flow") === "1") {
      resetInitialPdpColorSelection($variantBlock);
      finalizeUpsellModalOpen($dlg, $btn, { deferParentChildInit: true, keepOpeningState: true });
      $btn.prop("disabled", true).attr("is-loading", "true");
      initPdpColorFlow($variantBlock)
        .then(function () {
          buildSizeQtyGrid($dlg);
          $dlg.removeClass("is-opening");
        })
        .catch(function () {
          $dlg.removeClass("is-opening");
          var dlgNode = $dlg[0];
          if (dlgNode && dlgNode.close) dlgNode.close();
          syncPageScrollLock();
          showUpsellToast("Unable to load options", true);
        })
        .finally(function () { $btn.prop("disabled", false).attr("is-loading", "false"); });
      return;
    }

    finalizeUpsellModalOpen($dlg, $btn);
  });

  // CLOSE modal
  $(document).on("click", "[data-close-modal]", function (e) {
    e.preventDefault(); e.stopPropagation();
    var dlg = $(this).closest("dialog.grt-product-modal")[0];
    if (dlg && dlg.close) dlg.close();
    syncPageScrollLock();
  });

  // Click backdrop
  $(document).on("click", "dialog.grt-product-modal", function (e) {
    if (e.target !== this) return;
    if (this.close) this.close();
    syncPageScrollLock();
  });

  // Escape key
  $(document).on("keydown", function (e) {
    if (e.key === "Escape") {
      var $open = $("dialog.grt-product-modal[open]").first();
      if ($open.length && $open[0].close) { $open[0].close(); syncPageScrollLock(); }
    }
  });

  // Variant pill clicks (inside modal)
  $(document).on("click", ".grt-variant-pill", function (e) {
    var $btn = $(this);
    var $dlg = $btn.closest("dialog.grt-product-modal");
    if (!$dlg.length) return;
    var $block = $btn.closest("[data-variant-options]");
    if (!$block.length || $btn.prop("disabled")) return;
    e.preventDefault(); e.stopPropagation();
    setActivePill($block, $btn.attr("data-option-index"), $btn.attr("data-option-value"));
    syncVariantFromSelection($block);
    buildSizeQtyGrid($dlg);
    updateSelectedColorName($block);
  });

  // PDP color pill clicks
  $(document).on("click", "[data-pdp-color-key]", function (e) {
    var $pill = $(this);
    var $dlg = $pill.closest("dialog.grt-product-modal");
    if (!$dlg.length) return;
    var $block = $pill.closest("[data-variant-options]");
    if (!$block.length) return;
    e.preventDefault(); e.stopPropagation();
    applyPdpColorSelection($block, $pill);
    updateSelectedColorName($block);
  });

  $(document).on("mouseenter", "[data-pdp-color-key]", function () {
    var $pill = $(this);
    var $block = $pill.closest("[data-variant-options]");
    if (!$block.length || $block.attr("data-use-pdp-color-flow") !== "1") return;
    var colorName = String($pill.attr("data-pdp-color-name") || "").trim();
    var chipValue = String($pill[0].style.getPropertyValue("--grt-pdp-color-chip") || "").trim();
    if (!colorName) return;
    setPdpSelectedColorLabel($block, colorName, chipValue);
  });

  $(document).on("mouseleave", "[data-pdp-color-key]", function () {
    var $pill = $(this);
    if ($pill.hasClass("is-active")) return;
    var $block = $pill.closest("[data-variant-options]");
    if (!$block.length || $block.attr("data-use-pdp-color-flow") !== "1") return;
    restorePdpSelectedColorLabel($block);
  });

  $(document).on("click", "[data-mobile-cp-close]", function (e) {
    e.preventDefault(); e.stopPropagation();
    var $block = $(this).closest("[data-variant-options]");
    $block.find("[data-mobile-cp-list]").removeClass("is-open");
    $block.find("[data-mobile-cp-trigger]").removeClass("is-open");
  });
  $(document).on("click", "[data-mobile-cp-trigger]", function (e) {
    e.preventDefault(); e.stopPropagation();
    var $trigger = $(this), $block = $trigger.closest("[data-variant-options]");
    var $list = $block.find("[data-mobile-cp-list]").first();
    var isOpen = $list.hasClass("is-open");
    $list.toggleClass("is-open", !isOpen);
    $trigger.toggleClass("is-open", !isOpen);
  });
  $(document).on("click", "[data-mobile-cp-item-key]", function (e) {
    e.preventDefault(); e.stopPropagation();
    var $item = $(this), $block = $item.closest("[data-variant-options]");
    var $dlg = $block.closest("dialog.grt-product-modal");
    var $pill = $block.find('[data-pdp-color-key="' + $item.attr("data-mobile-cp-item-key") + '"]').first();
    if ($pill.length) { applyPdpColorSelection($block, $pill); if ($dlg.length) buildSizeQtyGrid($dlg); updateSelectedColorName($block); }
    $block.find("[data-mobile-cp-list]").removeClass("is-open");
    $block.find("[data-mobile-cp-trigger]").removeClass("is-open");
  });
  $(document).on("click.bhColorPicker", function (e) {
    if (!$(e.target).closest("[data-mobile-cp-trigger], [data-mobile-cp-list], [data-mobile-cp-close]").length) {
      $("dialog.grt-product-modal [data-mobile-cp-list].is-open").each(function () {
        var $block = $(this).closest("[data-variant-options]");
        $(this).removeClass("is-open");
        $block.find("[data-mobile-cp-trigger]").removeClass("is-open");
      });
    }
  });

  // Spinner buttons for size qty
  $(document).on("click", ".grt-size-qty-spin--up", function () {
    var $input = $(this).closest(".grt-size-qty-wrap").find(".grt-size-qty-input");
    var max = parseInt($input.attr("data-max") || "9999", 10);
    var val = parseInt($input.val() || "0", 10); if (isNaN(val)) val = 0;
    if (val < max) $input.val(val + 1).trigger("input");
  });
  $(document).on("click", ".grt-size-qty-spin--dn", function () {
    var $input = $(this).closest(".grt-size-qty-wrap").find(".grt-size-qty-input");
    var val = parseInt($input.val() || "0", 10); if (isNaN(val) || val <= 0) return;
    $input.val(val - 1).trigger("input");
  });

  // Size qty input
  $(document).on("input", "[data-size-qty-input]", function () {
    var $inp = $(this);
    var max = parseInt($inp.attr("data-max") || "0", 10);
    var value = $inp.val();
    if (value === "") { scheduleSizeGridPriceRefresh($inp.closest("dialog.grt-product-modal")); return; }
    var qty = parseInt(value, 10); if (isNaN(qty) || qty < 0) qty = 0;
    if (!isNaN(max) && max > 0 && qty > max) qty = max;
    $inp.val(qty);
    scheduleSizeGridPriceRefresh($inp.closest("dialog.grt-product-modal"));
  });

  $(document).on("input", "[data-pdp-size-grid] [data-pdp-size-qty-input]", function () {
    var $inp = $(this);
    var value = String($inp.val() || "").trim();
    if (value === "") { schedulePdpSizeGridPriceRefresh($inp.closest("dialog.grt-product-modal")); return; }
    var qty = parseInt(value, 10); if (isNaN(qty) || qty < 0) qty = 0;
    var max = parseInt($inp.attr("data-max") || "0", 10); if (!isNaN(max) && max > 0 && qty > max) qty = max;
    $inp.val(qty);
    schedulePdpSizeGridPriceRefresh($inp.closest("dialog.grt-product-modal"));
  });

  // Qty +/- (simple qty, inside modal)
  $(document).on("click", "[data-qty-plus],[data-qty-minus]", function (e) {
    var $t = $(e.target);
    var $dlg = $t.closest("dialog.grt-product-modal");
    if (!$dlg.length) return;
    e.preventDefault(); e.stopPropagation();
    var $wrap = $t.closest(".grt-qty");
    if (!$wrap.length) return;
    var $input = $wrap.find("[data-qty-input]").first();
    if (!$input.length) return;
    var qty = parseInt($input.val() || "1", 10); if (isNaN(qty) || qty < 1) qty = 1;
    if ($t.closest("[data-qty-plus]").length) qty = qty + 1;
    if ($t.closest("[data-qty-minus]").length) qty = Math.max(1, qty - 1);
    $input.val(qty);
  });

  $(document).on("input", "[data-qty-input]", function () {
    var $inp = $(this);
    var $dlg = $inp.closest("dialog.grt-product-modal");
    if (!$dlg.length) return;
    var qty = parseInt($inp.val() || "1", 10); if (isNaN(qty) || qty < 1) qty = 1;
    $inp.val(qty);
  });

  // See more / less description
  $(document).on("click", ".showfullcta", function () { $(this).parents(".grt-modal__description-wrapper").addClass("showfull"); });
  $(document).on("click", ".hidefullcta", function () { $(this).parents(".grt-modal__description-wrapper").removeClass("showfull"); });

  // ---------------------------
  // AJAX Add to cart
  // ---------------------------
  $(document).on("click", ".grt-product-modal__add-button", function (e) {
    var $btn = $(this);
    var $dlg = $btn.closest("dialog.grt-product-modal");
    if (!$dlg.length) return;
    var $form = $dlg.find("form.grt-product-modal__form").first();
    if (!$form.length) return;
    e.preventDefault(); e.stopPropagation();
    if ($btn.prop("disabled")) return;

    var originalHtml = $btn.html();
    var $sizeGrid = $form.find("[data-size-qty-grid]:visible").first();
    var $variantBlock = $form.find("[data-variant-options]").first();
    var isPdpServerFlow = $variantBlock.length && $variantBlock.attr("data-use-pdp-color-flow") === "1";
    var $pdpSizeGrid = $form.find("[data-pdp-size-grid]:visible").first();
    var itemsToAdd = [], selectedColor = "";

    if ($variantBlock.length) {
      var colorOptionIndex = parseInt(($variantBlock.attr("data-color-option-index") || $variantBlock.attr("data-swatch-option-index") || ""), 10);
      if (!isNaN(colorOptionIndex) && colorOptionIndex >= 0) selectedColor = getSelectedOptionValue($variantBlock, colorOptionIndex);
      if (!selectedColor) selectedColor = String($variantBlock.attr("data-selected-pdp-color") || "").trim();
    }
    if (!selectedColor) selectedColor = String($form.attr("data-selected-color") || "").trim();

    if (isPdpServerFlow) {
      if (!$pdpSizeGrid.length) { $btn.html("Choose color"); setTimeout(function () { $btn.html(originalHtml); }, 1200); return; }
      var $pdpInputs = $pdpSizeGrid.find("[data-pdp-size-qty-input]");
      if ($pdpInputs.length) {
        $pdpInputs.each(function () {
          var $inp = $(this); var qty = parseInt($inp.val() || "0", 10); if (isNaN(qty) || qty < 1) return;
          var max = parseInt($inp.attr("data-max") || "0", 10); if (!isNaN(max) && max > 0 && qty > max) { qty = max; $inp.val(max); }
          var itemId = String($inp.attr("data-id") || "").trim(); if (!itemId) return;
          var item = { id: itemId, quantity: qty };
          var properties = {}; if (selectedColor) properties.Color = selectedColor;
          if (Object.keys(properties).length) item.properties = properties;
          itemsToAdd.push(item);
        });
      } else {
        $pdpSizeGrid.find(".itemQuantity").each(function () {
          var $inp = $(this); var qty = parseInt($inp.val() || "0", 10); if (isNaN(qty) || qty < 1) return;
          var max = parseInt($inp.attr("data-max") || "0", 10); if (!isNaN(max) && max > 0 && qty > max) { qty = max; $inp.val(max); }
          var itemId = String($inp.attr("data-id") || "").trim(); if (!itemId) return;
          var item = { id: itemId, quantity: qty };
          var properties = {}; if (selectedColor) properties.Color = selectedColor;
          if (Object.keys(properties).length) item.properties = properties;
          itemsToAdd.push(item);
        });
      }
      if (!itemsToAdd.length) { $btn.html("Choose qty"); setTimeout(function () { $btn.html(originalHtml); }, 1200); return; }
    } else if ($sizeGrid.length) {
      $sizeGrid.find("[data-size-qty-input]").each(function () {
        var $inp = $(this); var qty = parseInt($inp.val() || "0", 10); if (isNaN(qty) || qty < 1) return;
        var max = parseInt($inp.attr("data-max") || "0", 10); if (!isNaN(max) && max > 0 && qty > max) { qty = max; $inp.val(max); }
        var itemId = String($inp.attr("data-id") || "").trim(); if (!itemId) return;
        var item = { id: itemId, quantity: qty };
        var properties = {}; if (selectedColor) properties.Color = selectedColor;
        if (Object.keys(properties).length) item.properties = properties;
        itemsToAdd.push(item);
      });
      if (!itemsToAdd.length) { $btn.html("Choose qty"); setTimeout(function () { $btn.html(originalHtml); }, 1200); return; }
    } else {
      var $qtyEl = $form.find('[name="quantity"],[data-qty-input]').first();
      var qty = $qtyEl.length ? parseInt($qtyEl.val() || "1", 10) : 1;
      if (isNaN(qty) || qty < 1) qty = 1;
      var variantId = ($form.attr("data-variant-id") || "").trim();
      if (!variantId) { var $idEl = $form.find('[data-variant-input],[name="id"]').first(); variantId = ($idEl.val() || "").toString().trim(); }
      if (!variantId) return;
      itemsToAdd.push({ id: variantId, quantity: qty });
    }

    var totalQtyAdded = 0;
    for (var _ai = 0; _ai < itemsToAdd.length; _ai++) totalQtyAdded += (itemsToAdd[_ai].quantity || 0);
    if (totalQtyAdded < 1) totalQtyAdded = 1;

    $btn.prop("disabled", true).html('<span class="grt-btn-spinner"></span>');

    $.ajax({
      url: "/cart/add.js", method: "POST", dataType: "json",
      contentType: "application/json; charset=utf-8",
      data: JSON.stringify({ items: itemsToAdd })
    }).done(function () {
      var successLabel = totalQtyAdded + (totalQtyAdded === 1 ? " Item Added to Cart!" : " Items Added to Cart!");
      $btn.addClass("grt-btn--success").html(successLabel);
      if (isPdpServerFlow && $pdpSizeGrid.length) {
        if ($pdpSizeGrid.find("[data-pdp-size-qty-input]").length) { $pdpSizeGrid.find("[data-pdp-size-qty-input]").val(""); schedulePdpSizeGridPriceRefresh($dlg); }
        else { $pdpSizeGrid.find(".itemQuantity").val(""); }
      } else if ($sizeGrid.length) { $sizeGrid.find("[data-size-qty-input]").val(""); scheduleSizeGridPriceRefresh($dlg); }
      else { var $qtyInput = $form.find("[data-qty-input]").first(); if ($qtyInput.length) $qtyInput.val(1); }
      showUpsellToast("Product successfully added to your cart");
      if (typeof window.refreshCart === "function") window.refreshCart("notOpen");
      else document.dispatchEvent(new Event("cart:updated"));
      document.dispatchEvent(new CustomEvent("grt-upsell:added", { detail: { source: "bh-quick-buy" } }));
      // Refresh upsell blocks but do NOT trigger the upsell overlay —
      // the user is already inside the quick-buy modal
      setTimeout(function() {
        if (typeof window.refreshGRTUpsellBlocks === "function") window.refreshGRTUpsellBlocks();
      }, 200);
      setTimeout(function () { $btn.prop("disabled", false).removeClass("grt-btn--success").html("Add to cart"); }, 3000);
    }).fail(function (xhr) {
      showUpsellToast("Unable to add to cart", true);
      $btn.prop("disabled", false).html(originalHtml);
    });
  });

  // ---------------------------
  // Card swatch click → navigate to PDP with variant
  // ---------------------------
  $(document).on("click", ".bh-sw[data-url]", function (e) {
    e.preventDefault();
    e.stopPropagation();
    window.location.href = $(this).attr("data-url");
  });

})();
</script>
