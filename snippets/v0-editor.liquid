   <div class="customTabelPopup__overlay-editor nj-popup pricing-table w3_bg {% if page.id != 105050734675 and page.id != 113190830163 %} outside-studio {% endif %} studio-embedded {% if template.suffix == 'multiupload_vividpopular' or template.suffix == 'custom-stickers-2' %}studio-overlay-only{% endif %}" style="display:none;">
  <div class="customTabelPopup">
    <div class="editor-container">
        <!-- Top Toolbar -->
        <div class="toolbar" style="gap: 10px;">  
            <div class="toolbar-left">
                  {% if page.id == 105050734675 or page.id == 113190830163 %}
                 <a href="{{ routes.root_url }}" class="studio-logo">
                    <img src="https://cdn.shopify.com/s/files/1/0558/0265/8899/files/Ninja_Transfers_Head.svg?v=1756405327" height="70" style="height: 38px;   margin-right: 0px;">
                 </a>
                {% endif %}
                <!-- Fullscreen toggle moved to the front of toolbar-left so it sits at
                     the far left of the studio toolbar (matches Ghost Light handoff
                     spec). Each icon is wrapped with its label in a span; the existing
                     toggle JS (`$btn.find('.icon-expand').toggle(...)`) still finds those
                     spans by class, so the icon+label hide/show in lockstep without any
                     JS changes. -->
                <button id="fullscreen-toggle-btn" class="btn btn-outline btn-transparent fs-toggle" aria-label="Toggle fullscreen">
                    <span class="icon-expand fs-state">
                        <span class="tb-icon-img tb-icon-img--enter-fs fs-icon-bracket" aria-hidden="true"></span>
                        <span class="fs-label">Fullscreen</span>
                    </span>
                    <span class="icon-collapse fs-state" style="display:none">
                        <span class="tb-icon-img tb-icon-img--exit-fs fs-icon-bracket" aria-hidden="true"></span>
                        <span class="fs-label">Exit Fullscreen</span>
                        {%- comment -%}
                          Mobile-only Close glyph + short "Exit" label. CSS
                          in v0-styles.css hides .fs-icon-bracket + .fs-label
                          and shows .fs-icon-x + .fs-label-mobile inside
                          :not(.studio-inline):not(.studio-embedded) on
                          viewports ≤ 749px so mobile fullscreen reads as
                          "× Exit" instead of "Exit Fullscreen".
                        {%- endcomment -%}
                        <span class="tb-icon-img tb-icon-img--close fs-icon-x" aria-hidden="true"></span>
                        <span class="fs-label-mobile">Exit</span>
                    </span>
                </button>
            </div>
				 <div class="toolbar-center toolbar-actions">
                <!-- Primary actions — white pill with a colored icon chip on the left.
                     Each chip carries its own stroke color so the button itself can stay
                     a uniform white/grey-outline (see .editor-container .toolbar .btn rules
                     in v0-styles.css). Centered between the fullscreen toggle (left) and
                     Use Design (right) via .toolbar-actions flex rules. -->
                <button id="add-text-btn" class="btn btn-outline tb-action">
                    <span class="tb-icon-chip tb-icon-chip--text" aria-hidden="true">
                        <span class="tb-icon-img tb-icon-img--text" aria-hidden="true"></span>
                    </span>
                    Text
