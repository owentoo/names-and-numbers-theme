      <style>
        /* Editable zoom display — visible affordance so users know
           the percentage is clickable. Available everywhere v0-editor
           renders (standalone DS, by-size-v2 design-studio tab,
           dtf-transfers Design with Studio overlay). */
        #zoom-display {
          cursor: pointer;
          padding: 2px 6px;
          border-radius: 6px;
          transition: background 0.15s ease;
          user-select: none;
          min-width: 44px;
          text-align: center;
          display: inline-block;
        }
        #zoom-display:hover {
          background: #f3f4f6;
        }
        #zoom-display[contenteditable="true"] {
          background: #f3f4f6;
          outline: 2px solid #019aff;
          outline-offset: -2px;
          cursor: text;
          user-select: text;
        }
        /* Suppress the v0-styles.css click-shield overlay (the grey dim
           layer that covers the prompt + composer when Recently Generated
           is open). In the design-studio panel the history sits inline
           with the rest of the panel, so the dim makes the top half look
           disabled. Same pattern used in sections/ai-image-creator.liquid. */
        #ai-panel.ai-chat .ai-chat-history-overlay {
          display: none !important;
        }
      </style>

      {%- comment -%}
        Click-to-edit zoom percentage. Document-level delegated
        listeners so this works for every #zoom-display instance
        across studio entry points and survives any DOM moves
        (e.g. dtf-upload-tabs.js lifting .floating_tools into the
        toolbar on by-size-v2). Validation:
          - Strip "%" if typed.
          - Parse as int, clamp 1-200 (matches setStudioZoom).
          - Non-numeric → reset to the value captured on click.
      {%- endcomment -%}
      <script>
        (function () {
          if (window.__zoomEditableInit) return;
          window.__zoomEditableInit = true;
          var prevValue = '100';

          function readDisplayValue(el) {
            return (el && el.textContent || '').replace(/[^0-9]/g, '') || '100';
          }

          document.addEventListener('click', function (e) {
            var el = e.target && e.target.closest && e.target.closest('#zoom-display');
            if (!el) return;
            prevValue = readDisplayValue(el);
            el.contentEditable = 'true';
            el.textContent = prevValue;
            el.focus();
            try {
              var range = document.createRange();
              range.selectNodeContents(el);
              var sel = window.getSelection();
              sel.removeAllRanges();
              sel.addRange(range);
            } catch (_) {}
          });

          document.addEventListener('keydown', function (e) {
            if (!e.target || e.target.id !== 'zoom-display') return;
            if (e.key === 'Enter') {
              e.preventDefault();
              e.target.blur();
            } else if (e.key === 'Escape') {
              e.target.textContent = prevValue + '%';
              e.target.contentEditable = 'false';
              e.target.blur();
            }
          });

          document.addEventListener('blur', function (e) {
            if (!e.target || e.target.id !== 'zoom-display') return;
            var el = e.target;
            el.contentEditable = 'false';
            var raw = (el.textContent || '').trim().replace(/%/g, '');
            var val = parseInt(raw, 10);
            if (isNaN(val) || val <= 0 || val > 200 || /[^0-9]/.test(raw)) {
              el.textContent = prevValue + '%';
              return;
            }
            if (typeof window.setStudioZoom === 'function') {
              try { window.setStudioZoom(val); } catch (_) {}
            }
            el.textContent = val + '%';
          }, true);
        })();
      </script>
      <script>
        /* Mobile pinch-to-zoom for the design studio canvas.
           Replaces the -/+ buttons (hidden via CSS on mobile fullscreen).
           Uses two-finger touch distance ratio relative to the zoom value
           captured at touchstart, then drives `window.setStudioZoom` which
           clamps 10–200 and re-renders fabric. Listener is attached to
           `.canvas-area` so Fabric's own object selection logic still owns
           single-finger touches. */
        (function () {
          if (window.__dtfStudioPinchInit) return;
          window.__dtfStudioPinchInit = true;

          function dist(t0, t1) {
            var dx = t0.clientX - t1.clientX;
            var dy = t0.clientY - t1.clientY;
            return Math.sqrt(dx * dx + dy * dy);
          }

          function attach() {
            var area = document.querySelector('.customTabelPopup__overlay-editor .canvas-area');
            if (!area) return setTimeout(attach, 250);
            if (area.__pinchAttached) return;
            area.__pinchAttached = true;

            var startDist = 0;
            var startZoom = 100;

            area.addEventListener('touchstart', function (e) {
              if (e.touches.length !== 2) return;
              startDist = dist(e.touches[0], e.touches[1]);
              var disp = document.getElementById('zoom-display');
              startZoom = disp ? parseInt((disp.textContent || '100').replace('%', ''), 10) : 100;
              if (!startZoom || isNaN(startZoom)) startZoom = 100;
            }, { passive: true });

            area.addEventListener('touchmove', function (e) {
              if (e.touches.length !== 2 || !startDist) return;
              e.preventDefault();
              var d = dist(e.touches[0], e.touches[1]);
              var ratio = d / startDist;
              var next = Math.round(startZoom * ratio);
              if (typeof window.setStudioZoom === 'function') {
                window.setStudioZoom(next);
              }
              /* Reset pan on every zoom step so the canvas stays centered
                 in the canvas-area. setStudioZoom already calls
                 __studio_resetPan internally, but we re-assert here in
                 case any drag offsets accumulated mid-pinch. */
              if (typeof window.__studio_resetPan === 'function') {
                window.__studio_resetPan();
              }
            }, { passive: false });

            area.addEventListener('touchend', function (e) {
              if (e.touches.length < 2) startDist = 0;
            }, { passive: true });
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', attach);
          } else {
            attach();
          }
        })();
      </script>
      <script>
        /* When the studio is in `.studio-overlay-only` mode (rendered from
           /products/dtf-transfers via the multiupload_vividpopular template),
           the fullscreen toggle's "Exit" button should CLOSE the overlay
           rather than fall through to v0-script.js's inline ↔ fullscreen
           toggle (which has no inline target on this template).
           Capture-phase listener so it runs before the jQuery click handler
           in v0-script.js. */
        (function () {
          if (window.__dtfOverlayOnlyExitInit) return;
          window.__dtfOverlayOnlyExitInit = true;
          document.addEventListener('click', function (e) {
            if (!e.target || !e.target.closest) return;
            var btn = e.target.closest('#fullscreen-toggle-btn');
            if (!btn) return;
            var overlay = document.querySelector('.customTabelPopup__overlay-editor.studio-overlay-only');
