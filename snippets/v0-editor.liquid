<style>
  /* While the Studio export/upload is in flight (.is-processing toggled by
     v0-script.js' #save-aws-btn click handler), disable every interactive
     control inside the editor so the user can't mutate the canvas — adding
     text, uploading an image, swapping a color, etc. — mid-export. Excludes
     #save-aws-btn so its own loader/disabled state still renders. */
  .editor-container.is-processing button:not(#save-aws-btn),
  .editor-container.is-processing input,
  .editor-container.is-processing select,
  .editor-container.is-processing textarea,
  .editor-container.is-processing label,
  .editor-container.is-processing a,
  .editor-container.is-processing [role="button"],
  .editor-container.is-processing [contenteditable] {
    pointer-events: none !important;
    opacity: 0.55 !important;
  }
  /* Disable Fabric canvas interactions too — clicks would otherwise still hit
     the canvas element and modify the design while the export is running. */
  .editor-container.is-processing canvas {
    pointer-events: none !important;
  }
  /* Re-enable the "Choose The Product" chooser overlays that appear AFTER
     the upload completes. They live inside .editor-container so the rule
     above would otherwise keep them disabled and the user can't pick a
     destination product. Higher specificity wins over the disable rule. */
  .editor-container.is-processing .design-transfer-overlay-container,
  .editor-container.is-processing .design-transfer-overlay-container *,
  .editor-container.is-processing .design-transfer-overlay-container-2,
  .editor-container.is-processing .design-transfer-overlay-container-2 * {
    pointer-events: auto !important;
    opacity: 1 !important;
  }
</style>

