{% if customer %}
  {% assign customer_phone = customer.phone | default: customer.default_address.phone | default: '' %}
  <dialog id="nt-profile-modal" class="nt-profile-modal" data-profile-modal>
    <div class="nt-profile-modal__inner">

      <div class="nt-profile-modal__header">
        <h2 class="nt-profile-modal__title">Edit Profile</h2>
        <button
          class="profile-addr-icon-btn"
          data-profile-modal-close
          aria-label="Close"
          type="button"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <form
        id="nt-customer-profile-form"
        class="profile-addr-form-grid"
        data-profile-form
        novalidate
      >
        <div class="profile-addr-msg" data-form-status aria-live="polite" hidden></div>
        <div class="profile-addr-form__row--half">
          <div>
            <label class="profile-addr-form__label" for="nt-first-name">First name</label>
            <input
              id="nt-first-name"
              name="first_name"
              type="text"
              class="profile-addr-form__input"
              value="{{ customer.first_name | escape }}"
              autocomplete="given-name"
              required
            >
            <small class="nt-profile-form__error" data-error-for="first_name"></small>
          </div>
          <div>
            <label class="profile-addr-form__label" for="nt-last-name">Last name</label>
            <input
              id="nt-last-name"
              name="last_name"
              type="text"
              class="profile-addr-form__input"
              value="{{ customer.last_name | escape }}"
              autocomplete="family-name"
              required
            >
            <small class="nt-profile-form__error" data-error-for="last_name"></small>
          </div>
        </div>

        <div>
          <label class="profile-addr-form__label" for="nt-email">Email</label>
          <input
            id="nt-email"
            name="email"
            type="email"
            class="profile-addr-form__input"
            value="{{ customer.email | escape }}"
            autocomplete="email"
            required
          >
          <small class="nt-profile-form__error" data-error-for="email"></small>
        </div>

        <div>
          <label class="profile-addr-form__label" for="nt-phone">Phone</label>
          <input
            id="nt-phone"
            name="phone"
            type="tel"
            class="profile-addr-form__input"
            value="{{ customer_phone | escape }}"
            autocomplete="tel"
          >
          <small class="nt-profile-form__error" data-error-for="phone"></small>
        </div>

        <div class="profile-addr-form__actions">
          <button type="submit" class="profile-addr-save-btn" data-submit-button>
            <span class="nt-profile-save-btn__spinner" aria-hidden="true">
              <svg viewBox="0 0 20 20" focusable="false">
                <path d="M7.229 1.173a9.25 9.25 0 1 0 11.655 11.412 1.25 1.25 0 1 0-2.4-.698 6.75 6.75 0 1 1-8.506-8.329 1.25 1.25 0 1 0-.75-2.385z" fill="currentColor"></path>
              </svg>
            </span>
            <span data-submit-button-text>Save Profile</span>
          </button>
          <button type="button" class="profile-addr-cancel-btn" data-profile-modal-close>
            Cancel
          </button>
        </div>

      </form>

    </div>
  </dialog>

  <dialog class="nt-profile-page-blocker" data-profile-page-blocker>
    <div class="nt-profile-page-blocker__card" role="status" aria-live="polite" aria-atomic="true">
      <span class="nt-profile-page-blocker__spinner" data-blocker-spinner>
        <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">
          <path d="M7.229 1.173a9.25 9.25 0 1 0 11.655 11.412 1.25 1.25 0 1 0-2.4-.698 6.75 6.75 0 1 1-8.506-8.329 1.25 1.25 0 1 0-.75-2.385z" fill="currentColor"></path>
        </svg>
      </span>
      <div class="nt-profile-page-blocker__message" data-blocker-status></div>
    </div>
  </dialog>

  <style>
    .nt-profile-modal {
      border: none;
      border-radius: 12px;
      padding: 0;
      width: min(92vw, 540px);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
      background: #fff;
    }

    .nt-profile-modal::backdrop {
      background: rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(2px);
    }

    .nt-profile-modal__inner {
      padding: 20px;
    }

    .nt-profile-modal__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
    }

    .nt-profile-modal__title {
      margin: 0;
      font-size: 18px;
      font-weight: 700;
      color: #111;
    }

    .nt-profile-form__error {
      color: #b42318;
      display: block;
      min-height: 1.1rem;
      margin-top: 3px;
      font-size: 12px;
    }

    .profile-addr-success-wrap {
      margin-bottom: 14px;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid #a6f4c5;
      background: #ecfdf3;
      color: #067647;
      font-size: 14px;
      line-height: 1.45;
    }

    .profile-addr-msg {
      margin-top: 10px;
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 14px;
      line-height: 1.45;
      border: 1px solid transparent;
      background: #f8fafc;
    }

    .profile-addr-msg.is-success {
      color: #067647;
      border-color: #a6f4c5;
      background: #ecfdf3;
    }

    .profile-addr-msg.is-error {
      color: #b42318;
      border-color: #fecdca;
      background: #fef3f2;
    }

    .nt-profile-page-blocker {
      border: none;
      margin: 0;
      width: 100vw;
      max-width: none;
      height: 100vh;
      max-height: none;
      padding: 20px;
      padding: 0;
      background: transparent;
    }

    .nt-profile-page-blocker::backdrop {
      background: rgba(17, 24, 39, 0.55);
    }

    .nt-profile-page-blocker__card {
      width: min(100%, 440px);
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      padding: 24px 20px;
      border-radius: 14px;
      background: #fff;
      color: #111827;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.22);
    }

    .nt-profile-page-blocker__spinner {
      display: inline-flex;
      height: 28px;
      width: 28px;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
      color: #111827;
    }

    .nt-profile-page-blocker__spinner svg {
      display: block;
      width: 28px;
      height: 28px;
      animation: nt-profile-spin 0.65s linear infinite;
    }

    .nt-profile-page-blocker__message {
      font-size: 15px;
      line-height: 1.5;
      font-weight: 600;
    }

    .nt-profile-page-blocker.is-success .nt-profile-page-blocker__message {
      color: #067647;
    }

    .nt-profile-page-blocker.is-error .nt-profile-page-blocker__message {
      color: #b42318;
    }

    @keyframes nt-profile-spin {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }

    @media (max-width: 749px) {
      .nt-profile-modal__inner {
        padding: 16px;
      }

      .nt-profile-page-blocker__card {
        width: calc(100vw - 32px);
      }
    }
  </style>

  <script>
    (function () {
      var modal = document.getElementById('nt-profile-modal');
      var triggers = document.querySelectorAll('[data-edit-profile-trigger]');
      var closeBtns = modal.querySelectorAll('[data-profile-modal-close]');

      triggers.forEach(function (trigger) {
        trigger.addEventListener('click', function () {
          modal.showModal();
        });
      });

      closeBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          modal.close();
        });
      });

      modal.addEventListener('click', function (e) {
        if (e.target === modal) {
          modal.close();
        }
      });
    })();
  </script>

  {{ 'customer-profile.js' | asset_url | script_tag }}
{% else %}
{% comment %}   <p>Please log in to update your profile.</p> {% endcomment %}
{% endif %}
