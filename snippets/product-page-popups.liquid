              <style>
                .customTabelPopup__overlay-5 .preview-zoom-loader {
                  position: absolute;
                  top: 50%;
                  left: 50%;
                  transform: translate(-50%, -50%);
                  z-index: 2;
                  pointer-events: none;
                  opacity: 0;
                  visibility: hidden;
                  transition: opacity 120ms linear;
                }
                .customTabelPopup__overlay-5.is-loading .preview-zoom-loader {
                  opacity: 1;
                  visibility: visible;
                }
                .customTabelPopup__overlay-5.is-loading .zoomed-in-image {
                  opacity: 0;
                }
                .customTabelPopup__overlay-5 .zoomed-in-image {
                  transition: opacity 120ms linear;
                }
                .customTabelPopup__overlay-5 .preview-zoom-spinner {
                  width: 48px;
                  height: 48px;
                  border: 4px solid rgba(0, 0, 0, 0.1);
                  border-top-color: #03a3f7;
                  border-radius: 50%;
                  animation: preview-zoom-spin 0.8s linear infinite;
                }
                @keyframes preview-zoom-spin {
                  to { transform: rotate(360deg); }
                }
              </style>
            </div>
            
