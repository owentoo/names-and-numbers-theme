{%- comment -%}
  ai-image-creator — Standalone page version of the Create-with-AI experience.

  Used by /pages/ai-image-creator (template: page.ai-image-creator.json).
  Renders the same hero + history UI that lives inside the tabs / modal,
  but inline as a page — no modal shell, no tab system. Works on desktop
  and mobile out of the box (the underlying styles are responsive).

  The native generative AI dialog markup is rendered hidden so the
  generation pipeline (#AISearchInput → submit → #generative-ai-images)
  keeps working unchanged. Our hero programmatically drives that form
  via dtf-upload-tabs.js / wireAiHero. dtf-ai-history.js manages the
  recent-creations grid via MutationObserver on #generative-ai-images.

  Order-as-DTF: when the user multi-selects history tiles and clicks
  the black bar, we don't have a local upload pipeline (this is a
  page, not a product). dtf-ai-page.js intercepts the dispatched
  `md-picker:use-designs` event, stashes the chosen images in
  sessionStorage, and navigates to /products/dtf-transfers, where
  dtf-upload-tabs.js consumes the stash and re-dispatches the event
  into the real upload pipeline.
{%- endcomment -%}

{{ 'ai-create.css' | asset_url | stylesheet_tag }}

<section class="dtf-ai-page">
  <div class="dtf-ai-page__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="dtf-ai-page__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="dtf-ai-page__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.sub != blank -%}
      <p class="dtf-ai-page__sub">{{ section.settings.sub }}</p>
    {%- endif -%}

    {%- comment -%}
      Native generative AI dialog + asset CSS.
      Wrapped in .dtf-ai-page__legacy so dtf-ai-page.css can hide the
      pink "Create with AI" box (the dialog itself stays usable as a
      programmatic form). This block is functionally identical to the
      contentFor 'aiImageGenerator' branch in __multipleSnippets, but
      we inline it so we don't need product/section/block context.
    {%- endcomment -%}
    <div class="dtf-ai-page__legacy" aria-hidden="true">
      {{ 'generative-ai-image.css' | asset_url | stylesheet_tag }}
      <div style="display: none;"><button id="generativeAiStart" type="button">CLICK ME</button></div>
      <div class="generative-ai-area">
        <div class="ai__wrapper">
          <div class="ai__title">Create a design with Ninja AI</div>
          <div class="ai__subtitle">Unleash your creativity and design your vision effortlessly with Ninja AI</div>
          <div class="ai__btn">Create an Image</div>
        </div>
      </div>

      <dialog id="generative-ai-dialog">
        <header>
          <div>
            <img src="{{ 'ai-generation-icon.png' | asset_url }}" width="48" height="48" alt="an icon of the ninja mascot on a colorful background">
            <span>Ninja AI Image Creator</span>
          </div>
          <button><img src="{{ 'AI__ic_close.svg' | asset_url }}" alt="" width="12" height="12"></button>
        </header>

        <form>
          <input type="search" name="prompt" id="AISearchInput" placeholder="Describe your design..." value="" required autocomplete="off">
          <img src="{{ 'AI__ic_close.svg' | asset_url }}" class="searchCross" width="12" height="12">
          <button type="submit">Generate <img src="{{ 'ai-magic.png' | asset_url }}" alt="" width="20"></button>
          <div class="AISearchMenu" id="AISearchMenu"></div>
        </form>

        <p id="generative-ai-remaining-searches"></p>
        <p id="generative-ai-generating"></p>

        <div id="generative-ai-dialog-loader"><img src="//cdn.shopify.com/s/files/1/0558/0265/8899/files/loader-2.gif?v=1723724647" alt="loading animation"></div>

        <section id="generative-ai-tips" class="generativeAItips">
          <header>Example Prompt</header>
          <div class="examplePrompt">
            <img src="https://cdn.shopify.com/s/files/1/0558/0265/8899/files/example.jpg?v=1747861546" class="examplePrompt__desktop">
            <img src="https://cdn.shopify.com/s/files/1/0558/0265/8899/files/Group_10.png?v=1747925994" class="examplePrompt__mobile">
          </div>
          <hr>
          <header>Example Output</header>
          <div class="exampleOutput">
            <div class="exampleOutput__item" item="1"><img src="https://cdn.shopify.com/s/files/1/0558/0265/8899/files/a-clean-and-modern-logo-illustration-fea_aFuultKgQh-HNvXcKTMAZw_hGGDDkT3QsqQ5SxEV74Nug_0003_Layer_1.jpg?v=1747861649"></div>
            <div class="exampleOutput__item" item="2"><img src="https://cdn.shopify.com/s/files/1/0558/0265/8899/files/a-clean-and-modern-logo-illustration-fea_aFuultKgQh-HNvXcKTMAZw_hGGDDkT3QsqQ5SxEV74Nug_0001_a-logo-illustration-of-a-cha.jpg?v=1747861649"></div>
            <div class="exampleOutput__item" item="3"><img src="https://cdn.shopify.com/s/files/1/0558/0265/8899/files/a-clean-and-modern-logo-illustration-fea_aFuultKgQh-HNvXcKTMAZw_hGGDDkT3QsqQ5SxEV74Nug_0004_Background.jpg?v=1747861649"></div>
          </div>
        </section>

        <section id="generative-ai-images"></section>
