{{ 'section-spangle-art-recs.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

<div class="sar-section" style="
  background-color: {{ s.bg_color }};
  padding-top: {{ s.padding_top }}px;
  padding-bottom: {{ s.padding_bottom }}px;
">
  <div class="sar-container" style="max-width: {{ s.max_width }}px;">

    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="sar-header" style="margin-bottom: {{ s.header_spacing }}px;">
        {%- if s.heading != blank -%}
          <h2 style="font-size: {{ s.heading_size }}px; font-weight: {{ s.heading_weight }}; color: {{ s.heading_color }};">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.subheading != blank -%}
          <p style="font-size: {{ s.subheading_size }}px; color: {{ s.subheading_color }}; max-width: {{ s.subheading_max_width }}px;">{{ s.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sar-columns" style="gap: {{ s.card_gap }}px;">

      {%- comment -%} BEST RESULTS CARD {%- endcomment -%}
      <div class="sar-card" style="border-radius: {{ s.card_radius }}px; border-color: {{ s.card_border_color }}; background: {{ s.card_bg }};">
        <div class="sar-card__header" style="background: {{ s.good_header_bg }}; border-bottom-color: {{ s.good_header_border }}; padding: {{ s.card_header_padding }}px {{ s.card_body_padding }}px;">
          <div class="sar-card__header-icon" style="background: {{ s.good_accent }};">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 style="font-size: {{ s.card_heading_size }}px; font-weight: {{ s.card_heading_weight }}; color: {{ s.good_accent }};">{{ s.good_title }}</h3>
        </div>
        <div class="sar-card__body" style="padding: {{ s.card_body_padding }}px;">

          {%- if s.show_art_examples -%}
            <div class="sar-art-example" style="background: {{ s.good_example_bg }}; border-color: {{ s.good_example_border }}; padding: {{ s.example_padding }}px; margin-bottom: {{ s.example_spacing }}px; border-radius: {{ s.example_radius }}px;">
              {%- if s.good_example_1_image != blank -%}
                <div class="sar-art-sample">
                  <img src="{{ s.good_example_1_image | image_url: width: 160 }}" alt="{{ s.good_example_1_label | escape }}" width="80" height="80" loading="lazy">
                  <span style="font-size: {{ s.example_label_size }}px; color: {{ s.example_label_color }};">{{ s.good_example_1_label }}</span>
                </div>
              {%- endif -%}
              {%- if s.good_example_2_image != blank -%}
                <div class="sar-art-sample">
                  <img src="{{ s.good_example_2_image | image_url: width: 200 }}" alt="{{ s.good_example_2_label | escape }}" width="100" height="80" loading="lazy">
                  <span style="font-size: {{ s.example_label_size }}px; color: {{ s.example_label_color }};">{{ s.good_example_2_label }}</span>
                </div>
              {%- endif -%}
              {%- if s.good_example_3_image != blank -%}
                <div class="sar-art-sample">
                  <img src="{{ s.good_example_3_image | image_url: width: 160 }}" alt="{{ s.good_example_3_label | escape }}" width="80" height="80" loading="lazy">
                  <span style="font-size: {{ s.example_label_size }}px; color: {{ s.example_label_color }};">{{ s.good_example_3_label }}</span>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          <ul class="sar-checklist">
            {%- for block in section.blocks -%}
              {%- if block.type == 'good_item' -%}
                <li style="font-size: {{ s.checklist_size }}px; color: {{ s.checklist_color }}; gap: {{ s.checklist_icon_gap }}px;" {{ block.shopify_attributes }}>
                  <span class="sar-icon">
                    <svg width="{{ s.checklist_icon_size }}" height="{{ s.checklist_icon_size }}" fill="none" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke="{{ s.good_accent }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>

      {%- comment -%} DOESN'T WORK CARD {%- endcomment -%}
      <div class="sar-card" style="border-radius: {{ s.card_radius }}px; border-color: {{ s.card_border_color }}; background: {{ s.card_bg }};">
        <div class="sar-card__header" style="background: {{ s.bad_header_bg }}; border-bottom-color: {{ s.bad_header_border }}; padding: {{ s.card_header_padding }}px {{ s.card_body_padding }}px;">
          <div class="sar-card__header-icon" style="background: {{ s.bad_accent }};">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 style="font-size: {{ s.card_heading_size }}px; font-weight: {{ s.card_heading_weight }}; color: {{ s.bad_accent }};">{{ s.bad_title }}</h3>
        </div>
        <div class="sar-card__body" style="padding: {{ s.card_body_padding }}px;">

          {%- if s.show_art_examples -%}
            <div class="sar-art-example" style="background: {{ s.bad_example_bg }}; border-color: {{ s.bad_example_border }}; padding: {{ s.example_padding }}px; margin-bottom: {{ s.example_spacing }}px; border-radius: {{ s.example_radius }}px;">
              {%- if s.bad_example_1_image != blank -%}
                <div class="sar-art-sample">
                  <img src="{{ s.bad_example_1_image | image_url: width: 160 }}" alt="{{ s.bad_example_1_label | escape }}" width="80" height="80" loading="lazy">
                  <span style="font-size: {{ s.example_label_size }}px; color: {{ s.example_label_color }};">{{ s.bad_example_1_label }}</span>
                </div>
              {%- endif -%}
              {%- if s.bad_example_2_image != blank -%}
                <div class="sar-art-sample">
                  <img src="{{ s.bad_example_2_image | image_url: width: 160 }}" alt="{{ s.bad_example_2_label | escape }}" width="80" height="80" loading="lazy">
                  <span style="font-size: {{ s.example_label_size }}px; color: {{ s.example_label_color }};">{{ s.bad_example_2_label }}</span>
                </div>
              {%- endif -%}
              {%- if s.bad_example_3_image != blank -%}
                <div class="sar-art-sample">
                  <img src="{{ s.bad_example_3_image | image_url: width: 160 }}" alt="{{ s.bad_example_3_label | escape }}" width="80" height="80" loading="lazy">
                  <span style="font-size: {{ s.example_label_size }}px; color: {{ s.example_label_color }};">{{ s.bad_example_3_label }}</span>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          <ul class="sar-checklist">
            {%- for block in section.blocks -%}
              {%- if block.type == 'bad_item' -%}
                <li style="font-size: {{ s.checklist_size }}px; color: {{ s.checklist_color }}; gap: {{ s.checklist_icon_gap }}px;" {{ block.shopify_attributes }}>
                  <span class="sar-icon">
                    <svg width="{{ s.checklist_icon_size }}" height="{{ s.checklist_icon_size }}" fill="none" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12" stroke="{{ s.bad_accent }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>

    </div>

    {%- if s.show_cta -%}
      <div class="sar-cta" style="
        margin-top: {{ s.cta_spacing }}px;
        background: {{ s.cta_bg }};
        border-color: {{ s.cta_border_color }};
        border-radius: {{ s.cta_radius }}px;
        padding: {{ s.cta_padding }}px;
      ">
        <p style="font-size: {{ s.cta_text_size }}px; color: {{ s.cta_text_color }};">
          {%- if s.cta_bold_text != blank -%}<strong>{{ s.cta_bold_text }}</strong> {%- endif -%}
          {%- if s.cta_link_text != blank and s.cta_link_url != blank -%}
            <a href="{{ s.cta_link_url }}" style="color: {{ s.cta_link_color }}; font-weight: 600;">{{ s.cta_link_text }}</a>
          {%- endif -%}
          {%- if s.cta_after_text != blank %} {{ s.cta_after_text }}{%- endif -%}
        </p>
      </div>
    {%- endif -%}

  </div>
</div>

