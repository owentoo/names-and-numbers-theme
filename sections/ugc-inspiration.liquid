<div class="ugc-section" id="ugc-section">

<style>
  .ugc-section {
    --ugc-bg: #ffffff;
    --ugc-surface: #ffffff;
    --ugc-surface-alt: #f2f2f2;
    --ugc-ink: #000000;
    --ugc-muted: rgba(0,0,0,0.6);
    --ugc-line: rgba(0,0,0,0.1);
    --ugc-primary: #019aff;
    --ugc-primary-ink: #ffffff;
    --ugc-shadow: 0 4px 18px rgba(0,0,0,0.05);
    --ugc-radius-card: 12px;
    --ugc-radius-button: 7px;
    --ugc-gap: 12px;
    box-sizing: border-box;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    color: var(--ugc-ink);
    font-size: 15px;
    line-height: 1.4;
  }
  .ugc-section *, .ugc-section *::before, .ugc-section *::after { box-sizing: border-box; }

  /* Hero */
  .ugc-hero {
    padding: 56px 32px 24px;
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
  }
  .ugc-eyebrow {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ugc-ink);
    font-weight: 600;
    padding: 6px 12px;
    border: 1px solid var(--ugc-line);
    background: var(--ugc-surface-alt);
    border-radius: 999px;
    margin: 0 0 18px;
  }
  .ugc-eyebrow::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ugc-primary);
    margin-right: 8px;
  }
  .ugc-hero h1 {
    font-size: clamp(34px, 5.5vw, 60px);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
    margin: 0 0 14px;
    max-width: 16ch;
    text-wrap: balance;
    color: var(--ugc-ink);
  }
  .ugc-lede {
    color: var(--ugc-muted);
    font-size: 16px;
    line-height: 1.5;
    max-width: 82ch;
    margin: 0;
    text-wrap: balance;
  }

  /* Filters */
  .ugc-filters {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--ugc-bg);
    border-bottom: 1px solid var(--ugc-line);
    border-top: 1px solid var(--ugc-line);
    padding: 16px 0;
    margin-top: 16px;
  }
  .ugc-filters-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 32px;
    align-items: center;
  }
  .ugc-filter-group {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .ugc-filter-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ugc-muted);
    font-weight: 600;
    margin-right: 4px;
  }
  .ugc-chip {
    appearance: none;
    border: 1px solid var(--ugc-line);
    background: var(--ugc-surface);
    color: var(--ugc-ink);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    padding: 7px 14px;
    border-radius: var(--ugc-radius-button);
    cursor: pointer;
    transition: background 120ms, color 120ms, border-color 120ms, transform 120ms;
  }
  .ugc-chip:hover { background: var(--ugc-surface-alt); }
  .ugc-chip[aria-pressed="true"] {
    background: rgba(1,154,255,0.10);
    color: #0070cc;
    border-color: rgba(1,154,255,0.40);
    transform: scale(1.04);
  }
  .ugc-chip:active { transform: scale(0.96); }
  .ugc-meta {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 13px;
    color: var(--ugc-muted);
  }
  .ugc-clear {
    background: none;
    border: 0;
    font: inherit;
    color: var(--ugc-ink);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 13px;
  }
  .ugc-clear[disabled] { opacity: 0.35; cursor: default; text-decoration: none; }

  /* Analysis toggle */
  .ugc-analysis-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: 1px solid var(--ugc-line);
    border-radius: 999px;
    padding: 6px 12px 6px 10px;
    cursor: pointer;
    font: 600 11px/1 inherit;
    letter-spacing: 0.09em;
    color: var(--ugc-muted);
    transition: border-color 160ms, color 160ms;
    user-select: none;
  }
  .ugc-analysis-toggle:hover { border-color: rgba(0,0,0,0.22); color: var(--ugc-ink); }
  .ugc-toggle-track {
    width: 28px;
    height: 16px;
    border-radius: 999px;
    background: var(--ugc-surface-alt);
    border: 1px solid var(--ugc-line);
    position: relative;
    transition: background 180ms, border-color 180ms;
    flex-shrink: 0;
  }
  .ugc-toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(0,0,0,0.3);
    transition: transform 180ms cubic-bezier(.4,0,.2,1), background 180ms;
  }
  .ugc-section.analysis-on .ugc-toggle-track { background: rgba(1,154,255,0.15); border-color: rgba(1,154,255,0.4); }
  .ugc-section.analysis-on .ugc-toggle-thumb { transform: translateX(12px); background: #019aff; }
  .ugc-section.analysis-on .ugc-analysis-toggle { color: #0070cc; }

  /* Mosaic */
  .ugc-mosaic {
    padding: 24px 32px 80px;
    /*max-width: 1400px;*/
    margin: 0 auto;
  }
  .ugc-columns {
    column-count: 5;
    column-gap: var(--ugc-gap);
  }
  @media (max-width: 1100px) { .ugc-columns { column-count: 3; } }
  @media (max-width: 760px) {
    .ugc-columns { column-count: 2; }
    .ugc-hero { padding: 32px 20px 16px; }
    .ugc-filters-inner, .ugc-mosaic { padding-left: 20px; padding-right: 20px; }
  }
  @media (max-width: 420px) { .ugc-columns { column-count: 1; } }

  /* Tiles */
  .ugc-tile {
    break-inside: avoid;
    margin-bottom: var(--ugc-gap);
    position: relative;
    border-radius: var(--ugc-radius-card);
    overflow: hidden;
    background: var(--ugc-surface);
    box-shadow: var(--ugc-shadow);
    cursor: zoom-in;
    display: block;
    border: 0;
    padding: 0;
    width: 100%;
    text-align: left;
    font: inherit;
    color: inherit;
    transition: box-shadow 180ms ease;
    will-change: transform;
  }
  .ugc-tile:hover { box-shadow: 0 10px 28px rgba(10,10,10,0.10); }
  .ugc-tile.appearing {
    opacity: 0;
    animation: ugcTileIn 420ms cubic-bezier(.2,.7,.2,1) forwards;
  }
  .ugc-tile.leaving { pointer-events: none; opacity: 0; transition: opacity 220ms ease; }
  @keyframes ugcTileIn {
    from { opacity: 0; transform: translateY(8px) scale(0.985); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .ugc-tile img { width: 100%; height: auto; display: block; opacity: 0; transition: opacity 320ms ease; }
  .ugc-tile img.loaded { opacity: 1; }
  .ugc-tile-photo { position: relative; display: block; line-height: 0; }
  .ugc-tile-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 18px 16px 14px;
    background: linear-gradient(to top, rgba(10,10,10,0.82) 0%, rgba(10,10,10,0.0) 100%);
    color: #fff;
    opacity: 0;
    transition: opacity 180ms ease;
    pointer-events: none;
  }
  .ugc-tile:hover .ugc-tile-overlay { opacity: 1; }
  .ugc-tile-meta { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; }
  .ugc-tile-tags { font-size: 14px; font-weight: 500; color: rgba(255,255,255,0.94); margin: 0; }
  .ugc-tile-attr { font-size: 14px; color: rgba(255,255,255,0.82); margin: 0; text-align: right; white-space: nowrap; }

  /* Tile footer / badges */
  .ugc-tile-footer { display: none; padding: 10px 12px 12px; background: var(--ugc-surface); color: var(--ugc-ink); border-top: 1px solid var(--ugc-line); line-height: 1.45; }  .ugc-section.analysis-on .ugc-tile-footer { visibility: visible; opacity: 1; }
  .ugc-section.analysis-on .ugc-tile-footer { display: block; }
  .ugc-tile-badges + .ugc-tile-badges { margin-top: 5px; }
  .ugc-tile-badges + .ugc-tile-desc { margin-top: 9px; }
  .ugc-tile-badge {
    font-size: 11px; font-weight: 500; padding: 3px 9px; border-radius: 999px;
    background: var(--ugc-surface-alt); color: var(--ugc-ink); white-space: nowrap;
    border: 1px solid var(--ugc-line);
  }
  .ugc-tile-badge--transfer { background: rgba(1,154,255,0.08); color: #0070cc; border-color: rgba(1,154,255,0.28); font-weight: 600; }
  .ugc-tile-badge--creator  { background: rgba(0,168,100,0.08); color: #007a40; border-color: rgba(0,168,100,0.28); }
  .ugc-tile-badge--category { background: rgba(120,60,220,0.08); color: #6b30c4; border-color: rgba(120,60,220,0.25); }
  .ugc-tile-badge--product-type { background: var(--ugc-surface-alt); color: var(--ugc-ink); border-color: var(--ugc-line); }
  .ugc-tile-desc { display: block; font-size: 13px; color: rgba(0,0,0,0.72); margin: 0; }

  .ugc-empty { text-align: center; padding: 80px 0; color: var(--ugc-muted); }

  /* Lightbox */
  dialog.ugc-lightbox {
    border: 0; padding: 0; background: transparent;
    width: fit-content; max-width: min(1200px, 96vw); max-height: 92vh; overflow: visible;
  }
  dialog.ugc-lightbox::backdrop { background: rgba(8,8,8,0.78); backdrop-filter: blur(2px); }
  .ugc-lb-card {
    background: var(--ugc-surface); border-radius: var(--ugc-radius-card);
    overflow: hidden; display: flex; flex-direction: column; max-height: 92vh;
  }
  .ugc-lb-img { display: flex; justify-content: center; align-items: center; line-height: 0; }
  .ugc-lb-img img { display: block; width: auto; height: auto; max-width: min(1200px, 96vw); max-height: calc(92vh - 170px); }
  .ugc-lb-info {
    flex: 0 0 auto; padding: 24px 28px 32px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 28px; border-top: 1px solid var(--ugc-line); background: var(--ugc-surface);
  }
  .ugc-lb-info-left { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .ugc-lb-tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; }
  .ugc-lb-tag { font-size: 12px; padding: 5px 12px; border-radius: var(--ugc-radius-button); background: var(--ugc-surface-alt); color: var(--ugc-ink); font-weight: 500; }
  .ugc-lb-reviewer { color: var(--ugc-ink); font-size: 14px; font-weight: 500; margin: 0; }
  .ugc-lb-cta {
    flex: 0 0 auto; background: var(--ugc-primary); color: var(--ugc-primary-ink);
    padding: 12px 24px; border-radius: var(--ugc-radius-button); text-decoration: none;
    font-weight: 500; font-size: 15px; white-space: nowrap; transition: opacity 120ms;
  }
  .ugc-lb-cta:hover { opacity: 0.86; }
  .ugc-lb-close {
    position: absolute; top: 14px; right: 14px; appearance: none; border: 0;
    background: rgba(255,255,255,0.92); width: 36px; height: 36px; border-radius: 50%;
    cursor: pointer; font-size: 18px; line-height: 1; display: grid; place-items: center; z-index: 3;
  }
  .ugc-lb-nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 36px; height: 36px; border-radius: 50%; background: transparent;
    color: rgba(255,255,255,0.7); border: 0; cursor: pointer; font-size: 28px;
    font-weight: 300; line-height: 1; display: grid; place-items: center; z-index: 2;
    opacity: 0.7; transition: opacity 140ms, background 140ms, color 140ms, transform 140ms;
  }
  .ugc-lb-nav:hover { opacity: 1; color: #fff; background: rgba(255,255,255,0.12); }
  .ugc-lb-nav:active { transform: translateY(-50%) scale(0.94); }
  .ugc-lb-nav-prev { left: -56px; }
  .ugc-lb-nav-next { right: -56px; }
  @media (max-width: 1000px) {
    .ugc-lb-nav-prev { left: 8px; }
    .ugc-lb-nav-next { right: 8px; }
    .ugc-lb-nav { background: rgba(0,0,0,0.32); color: rgba(255,255,255,0.9); }
    .ugc-lb-nav:hover { background: rgba(0,0,0,0.5); }
  }
  @media (max-width: 640px) {
    .ugc-lb-info { flex-direction: column; align-items: stretch; gap: 16px; padding: 20px 20px 28px; }
    .ugc-lb-cta { align-self: stretch; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ugc-tile, .ugc-tile img { animation: none !important; transition: none !important; opacity: 1 !important; }
  }
</style>

<header class="ugc-hero">
  <div style="display:flex;justify-content:flex-end;margin-bottom:16px;">
    <button class="ugc-analysis-toggle" id="ugc-analysis-toggle" aria-pressed="false">
      <span class="ugc-toggle-track"><span class="ugc-toggle-thumb"></span></span>
      Analysis
    </button>
  </div>
  <p class="ugc-eyebrow">Made with Ninja Transfers</p>
  <h1>See what's possible.</h1>
  <p class="ugc-lede">Real prints from real customers. See how others are using DTF and UV transfers, and find your next idea. Whether you're a business, a side hustle, or a hobbyist, there's an idea here for you.</p>
</header>

<section class="ugc-filters" aria-label="Filters">
  <div class="ugc-filters-inner">
    <div class="ugc-filter-group" id="ugc-transfer-group">
      <span class="ugc-filter-label">Transfer</span>
    </div>
    <div class="ugc-filter-group" id="ugc-product-group">
      <span class="ugc-filter-label">Product</span>
    </div>
    <div class="ugc-meta">
      <button class="ugc-clear" id="ugc-clear-btn" disabled>Clear filters</button>
    </div>
  </div>
</section>

<main class="ugc-mosaic">
  <div class="ugc-columns" id="ugc-mosaic"></div>
  <div class="ugc-empty" id="ugc-empty" hidden>No matches. Try removing a filter.</div>
</main>

<dialog class="ugc-lightbox" id="ugc-lightbox" aria-label="Image detail">
  <button class="ugc-lb-nav ugc-lb-nav-prev" id="ugc-lb-prev" aria-label="Previous image">&#8249;</button>
  <button class="ugc-lb-nav ugc-lb-nav-next" id="ugc-lb-next" aria-label="Next image">&#8250;</button>
  <button class="ugc-lb-close" id="ugc-lb-close" aria-label="Close">&times;</button>
  <div class="ugc-lb-card">
    <div class="ugc-lb-img"><img id="ugc-lb-image" alt="" /></div>
    <div class="ugc-lb-info">
      <div class="ugc-lb-info-left">
        <div class="ugc-lb-tags" id="ugc-lb-tags"></div>
        <p class="ugc-lb-reviewer" id="ugc-lb-reviewer"></p>
      </div>
      <a class="ugc-lb-cta" id="ugc-lb-cta" href="#">Shop this style</a>
    </div>
  </div>
</dialog>

<script>
(function() {
  const MANIFEST_URL = {{ 'ugc-manifest.json' | asset_url | json }};
  const TRANSFER_TYPES = ['DTF','UV'];
  const PRODUCT_TYPES = ['T-Shirts','Sweatshirts','Bags','Drinkware'];  
  const section = document.getElementById('ugc-section');

  const state = { data: [], transfer: new Set(), product: new Set() };

  function firstName(name) {                                                                                                                                                                             
    if (!name) return '';                                                                                                                                                                                      
    const first = name.trim().split(/\s+/)[0];                                                                                                                                                           
    return first.charAt(0).toUpperCase() + first.slice(1).toLowerCase();
  }

  function buildChips(containerId, values, group) {
    const c = document.getElementById(containerId);
    values.forEach(v => {
      const b = document.createElement('button');
      b.className = 'ugc-chip'; b.type = 'button'; b.textContent = v;
      b.setAttribute('aria-pressed','false');
      b.addEventListener('click', () => toggleFilter(group, v, b));
      c.appendChild(b);
    });
  }

  function toggleFilter(group, value, button) {
    const set = state[group];
    set.has(value) ? set.delete(value) : set.add(value);
    button.setAttribute('aria-pressed', set.has(value) ? 'true' : 'false');
    render();
  }

  function clearAll() {
    state.transfer.clear(); state.product.clear();
    section.querySelectorAll('.ugc-chip[aria-pressed="true"]').forEach(b => b.setAttribute('aria-pressed','false'));
    render();
  }

  function matches(e) {
    if (state.transfer.size > 0 && !state.transfer.has(e.transfer_type)) return false;
    if (state.product.size > 0 && !(e.product_types || []).some(p => state.product.has(p))) return false;
    return true;
  }

  const FLIP_MS = 520, FLIP_EASE = 'cubic-bezier(.2,.7,.2,1)';

  function makeTile(e, i) {
    const tile = document.createElement('button');
    tile.className = 'ugc-tile appearing'; tile.type = 'button';
    tile.dataset.id = String(e.yotpo_image_id);
    tile.style.animationDelay = Math.min(i * 22, 480) + 'ms';
    tile.addEventListener('click', () => openLightbox(e));

    const photo = document.createElement('div');
    photo.className = 'ugc-tile-photo';
    const img = document.createElement('img');
    img.src = e.local_file; img.alt = e.review_title || 'Customer photo'; img.loading = 'lazy';
    img.addEventListener('load', () => img.classList.add('loaded'), { once: true });
    if (img.complete) img.classList.add('loaded');
    const overlay = document.createElement('div');
    overlay.className = 'ugc-tile-overlay';
    const attr = e.reviewer_display_name ? `<p class="ugc-tile-attr">- ${firstName(e.reviewer_display_name)}</p>` : '<span></span>';
    overlay.innerHTML = `<div class="ugc-tile-meta"><p class="ugc-tile-tags">${e.transfer_type} · ${(e.product_types||[]).join(', ')}</p>${attr}</div>`;
    photo.appendChild(img); photo.appendChild(overlay);
    tile.appendChild(photo);

    const footer = document.createElement('div');
    footer.className = 'ugc-tile-footer';
    const row1 = document.createElement('div');
    row1.className = 'ugc-tile-badges';
    const tb = document.createElement('span');
    tb.className = 'ugc-tile-badge ugc-tile-badge--transfer'; tb.textContent = e.transfer_type;
    row1.appendChild(tb);
    (e.product_types || []).forEach(pt => {
      const b = document.createElement('span');
      b.className = 'ugc-tile-badge ugc-tile-badge--product-type'; b.textContent = pt;
      row1.appendChild(b);
    });
    footer.appendChild(row1);
    if (e.creator_type || e.design_category) {
      const row2 = document.createElement('div');
      row2.className = 'ugc-tile-badges';
      if (e.creator_type) { const b = document.createElement('span'); b.className = 'ugc-tile-badge ugc-tile-badge--creator'; b.textContent = e.creator_type; row2.appendChild(b); }
      if (e.design_category) { const b = document.createElement('span'); b.className = 'ugc-tile-badge ugc-tile-badge--category'; b.textContent = e.design_category; row2.appendChild(b); }
      footer.appendChild(row2);
    }
    if (e.description) { const d = document.createElement('p'); d.className = 'ugc-tile-desc'; d.textContent = e.description; footer.appendChild(d); }
    tile.appendChild(footer);
    setTimeout(() => tile.classList.remove('appearing'), 900);
    return tile;
  }

  function buildAll() {
    const mosaic = document.getElementById('ugc-mosaic');
    state.data.forEach((e, i) => mosaic.appendChild(makeTile(e, i)));
    updateMeta(state.data.length);
  }

  function updateMeta(n) {
    document.getElementById('ugc-empty').hidden = n > 0;
    document.getElementById('ugc-clear-btn').disabled = (state.transfer.size + state.product.size) === 0;
  }

  function render() {
    const mosaic = document.getElementById('ugc-mosaic');
    const tiles = Array.from(mosaic.querySelectorAll('.ugc-tile'));
    const matchSet = new Set(state.data.filter(matches).map(e => String(e.yotpo_image_id)));
    const firstRects = new Map();
    tiles.forEach(t => { if (t.style.display !== 'none') firstRects.set(t.dataset.id, t.getBoundingClientRect()); });
    const toHide = [];
    tiles.forEach(t => {
      const was = firstRects.has(t.dataset.id), will = matchSet.has(t.dataset.id);
      if (was && !will) { t.classList.add('leaving'); toHide.push(t); }
      else if (!was && will) { t.style.display = ''; t.classList.remove('leaving'); t.classList.add('appearing'); t.style.animationDelay = '0ms'; setTimeout(() => t.classList.remove('appearing'), 500); }
    });
    requestAnimationFrame(() => {
      toHide.forEach(t => { t.style.display = 'none'; });
      const lastRects = new Map();
      tiles.forEach(t => { if (t.style.display !== 'none' && firstRects.has(t.dataset.id)) lastRects.set(t.dataset.id, t.getBoundingClientRect()); });
      tiles.forEach(t => {
        const f = firstRects.get(t.dataset.id), l = lastRects.get(t.dataset.id);
        if (!f || !l) return;
        const dx = f.left - l.left, dy = f.top - l.top;
        if (Math.abs(dx) < 1 && Math.abs(dy) < 1) return;
        t.style.transition = 'none'; t.style.transform = `translate(${dx}px,${dy}px)`;
        requestAnimationFrame(() => { t.style.transition = `transform ${FLIP_MS}ms ${FLIP_EASE}`; t.style.transform = ''; setTimeout(() => { t.style.transition = ''; }, FLIP_MS + 40); });
      });
      setTimeout(() => toHide.forEach(t => t.classList.remove('leaving')), 260);
    });
    updateMeta(matchSet.size);
  }

  let carouselList = [], carouselIndex = 0, carouselBusy = false;
  const OUT_MS = 180, IN_MS = 240, SLIDE = 28;

  function renderLightboxEntry() {
    const e = carouselList[carouselIndex];
    document.getElementById('ugc-lb-image').src = e.local_file;
    document.getElementById('ugc-lb-image').alt = e.review_title || '';
    document.getElementById('ugc-lb-reviewer').textContent = e.reviewer_display_name ? `- ${firstName(e.reviewer_display_name)}` : '';
    const tagWrap = document.getElementById('ugc-lb-tags');
    tagWrap.innerHTML = '';
    [e.transfer_type, ...(e.product_types||[])].forEach(t => { const s = document.createElement('span'); s.className = 'ugc-lb-tag'; s.textContent = t; tagWrap.appendChild(s); });
    const cta = document.getElementById('ugc-lb-cta');
    cta.href = (e.cta && e.cta.url) || '#';
    cta.textContent = e.transfer_type === 'UV' ? 'Shop UV Transfers' : 'Shop DTF Transfers';
  }

  function resetCarousel() {
    const img = document.getElementById('ugc-lb-image');
    const info = document.querySelector('.ugc-lb-info-left');
    img.style.cssText = ''; if (info) info.style.cssText = '';
  }

  function openLightbox(entry) {
    carouselList = state.data.filter(matches);
    carouselIndex = carouselList.findIndex(x => x.yotpo_image_id === entry.yotpo_image_id);
    if (carouselIndex < 0) carouselIndex = 0;
    resetCarousel(); renderLightboxEntry();
    document.getElementById('ugc-lightbox').showModal();
  }

  function carouselGo(dir) {
    if (carouselBusy || carouselList.length < 2) return;
    carouselBusy = true;
    const img = document.getElementById('ugc-lb-image');
    const info = document.querySelector('.ugc-lb-info-left');
    const exitX = dir === 'next' ? -SLIDE : SLIDE, enterX = dir === 'next' ? SLIDE : -SLIDE;
    img.style.transition = `transform ${OUT_MS}ms ease, opacity ${OUT_MS}ms ease`;
    img.style.transform = `translateX(${exitX}px)`; img.style.opacity = '0';
    info.style.transition = `opacity ${OUT_MS}ms ease`; info.style.opacity = '0';
    setTimeout(() => {
      carouselIndex = dir === 'next' ? (carouselIndex + 1) % carouselList.length : (carouselIndex - 1 + carouselList.length) % carouselList.length;
      renderLightboxEntry();
      img.style.transition = 'none'; img.style.transform = `translateX(${enterX}px)`; img.style.opacity = '0';
      info.style.transition = 'none'; info.style.opacity = '0';
      void img.offsetWidth;
      requestAnimationFrame(() => {
        img.style.transition = `transform ${IN_MS}ms cubic-bezier(.2,.7,.2,1), opacity ${IN_MS}ms ease`;
        img.style.transform = 'translateX(0)'; img.style.opacity = '1';
        info.style.transition = `opacity ${IN_MS}ms ease`; info.style.opacity = '1';
      });
      setTimeout(() => { carouselBusy = false; }, IN_MS);
    }, OUT_MS);
  }

  function interleave(items) {
    const cap = items.filter(e => e.description), uncap = items.filter(e => !e.description);
    if (!cap.length) return items;
    const total = items.length, step = total / cap.length, result = new Array(total);
    cap.forEach((e, i) => { let idx = Math.min(Math.round(i * step), total - 1); while (result[idx] !== undefined) idx = (idx + 1) % total; result[idx] = e; });
    let u = 0; for (let i = 0; i < total; i++) if (!result[i]) result[i] = uncap[u++];
    return result;
  }

  document.getElementById('ugc-lb-close').addEventListener('click', () => document.getElementById('ugc-lightbox').close());
  document.getElementById('ugc-lightbox').addEventListener('close', resetCarousel);
  document.getElementById('ugc-lb-prev').addEventListener('click', ev => { ev.stopPropagation(); carouselGo('prev'); });
  document.getElementById('ugc-lb-next').addEventListener('click', ev => { ev.stopPropagation(); carouselGo('next'); });
  document.getElementById('ugc-lightbox').addEventListener('click', ev => { if (ev.target.id === 'ugc-lightbox') ev.target.close(); });
  document.addEventListener('keydown', ev => {
    const lb = document.getElementById('ugc-lightbox');
    if (!lb.open) return;
    if (ev.key === 'ArrowLeft') { ev.preventDefault(); carouselGo('prev'); }
    if (ev.key === 'ArrowRight') { ev.preventDefault(); carouselGo('next'); }
  });
  document.getElementById('ugc-clear-btn').addEventListener('click', clearAll);
  document.getElementById('ugc-analysis-toggle').addEventListener('click', function() {
    const on = section.classList.toggle('analysis-on');
    this.setAttribute('aria-pressed', String(on));
  });

  (async function init() {
    buildChips('ugc-transfer-group', TRANSFER_TYPES, 'transfer');
    buildChips('ugc-product-group', PRODUCT_TYPES, 'product');
    const res = await fetch(MANIFEST_URL + '?v={{ 'ugc-manifest.json' | asset_url | split: '?' | last }}');
    const raw = await res.json();
    state.data = raw.filter(e => e.visible !== false).sort((a, b) => b.yotpo_image_id - a.yotpo_image_id);
    buildAll();
  })();
})();
</script>

</div>

