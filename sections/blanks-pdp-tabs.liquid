{%- comment -%}
  Blanks PDP Tabs — section/blanks-pdp-tabs.liquid
  Full-width tab bar with 6 content panels for the blanks product detail page.
{%- endcomment -%}

{%- comment -%}Determine the first visible tab so it opens by default{%- endcomment -%}
{%- assign _first_tab = '' -%}
{%- if section.settings.show_description -%}
  {%- assign _first_tab = 'description' -%}
{%- endif -%}
{%- if _first_tab == '' -%}
  {%- if section.settings.show_breakdown -%}
    {%- if product.metafields.specs.customer_metrics -%}
      {%- assign _first_tab = 'breakdown' -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- if _first_tab == '' -%}
  {%- if section.settings.show_features -%}
    {%- assign _first_tab = 'features' -%}
  {%- endif -%}
{%- endif -%}
{%- if _first_tab == '' -%}
  {%- if section.settings.show_sizechart -%}
    {%- assign _first_tab = 'sizechart' -%}
  {%- endif -%}
{%- endif -%}
{%- if _first_tab == '' -%}
  {%- if section.settings.show_shipping -%}
    {%- assign _first_tab = 'shipping' -%}
  {%- endif -%}
{%- endif -%}
{%- if _first_tab == '' -%}
  {%- if section.settings.show_reviews -%}
    {%- assign _first_tab = 'reviews' -%}
  {%- endif -%}
{%- endif -%}

{%- assign _sid = section.id -%}

{% style %}
  #blanks-pdp-tabs-{{ _sid }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div id="blanks-pdp-tabs-{{ _sid }}">
  <div style="max-width:1400px; margin:0 auto; padding:0 20px;">

    {%- if section.settings.heading != blank -%}
      <h2 style="font-size:22px; font-weight:700; margin-bottom:24px;">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- comment -%}── Tab bar ──────────────────────────────────────────{%- endcomment -%}
    <div style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
      <div id="btab-bar-{{ _sid }}" style="display:flex; border-bottom:2px solid #e0e0e0; position:relative; min-width:max-content;">

        {%- if section.settings.show_description -%}
          <button data-btab="description"
            style="padding:12px 20px; font-size:14px; font-weight:600; border:none; border-bottom:3px solid {% if _first_tab == 'description' %}#2d2d2d{% else %}transparent{% endif %}; background:none; cursor:pointer; color:{% if _first_tab == 'description' %}#2d2d2d{% else %}#888{% endif %}; white-space:nowrap; margin-bottom:-2px; position:relative;">
            {{ section.settings.label_description }}
          </button>
        {%- endif -%}

        {%- if section.settings.show_breakdown -%}
          {%- if product.metafields.specs.customer_metrics -%}
            <button data-btab="breakdown"
              style="padding:12px 20px; font-size:14px; font-weight:600; border:none; border-bottom:3px solid {% if _first_tab == 'breakdown' %}#2d2d2d{% else %}transparent{% endif %}; background:none; cursor:pointer; color:{% if _first_tab == 'breakdown' %}#2d2d2d{% else %}#888{% endif %}; white-space:nowrap; margin-bottom:-2px; position:relative;">
              {{ section.settings.label_breakdown }}
            </button>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.show_features -%}
          <button data-btab="features"
            style="padding:12px 20px; font-size:14px; font-weight:600; border:none; border-bottom:3px solid {% if _first_tab == 'features' %}#2d2d2d{% else %}transparent{% endif %}; background:none; cursor:pointer; color:{% if _first_tab == 'features' %}#2d2d2d{% else %}#888{% endif %}; white-space:nowrap; margin-bottom:-2px; position:relative;">
            {{ section.settings.label_features }}
          </button>
        {%- endif -%}

        {%- if section.settings.show_sizechart -%}
          <button data-btab="sizechart"
            style="padding:12px 20px; font-size:14px; font-weight:600; border:none; border-bottom:3px solid {% if _first_tab == 'sizechart' %}#2d2d2d{% else %}transparent{% endif %}; background:none; cursor:pointer; color:{% if _first_tab == 'sizechart' %}#2d2d2d{% else %}#888{% endif %}; white-space:nowrap; margin-bottom:-2px; position:relative;">
            {{ section.settings.label_sizechart }}
          </button>
        {%- endif -%}

        {%- if section.settings.show_shipping -%}
          <button data-btab="shipping"
            style="padding:12px 20px; font-size:14px; font-weight:600; border:none; border-bottom:3px solid {% if _first_tab == 'shipping' %}#2d2d2d{% else %}transparent{% endif %}; background:none; cursor:pointer; color:{% if _first_tab == 'shipping' %}#2d2d2d{% else %}#888{% endif %}; white-space:nowrap; margin-bottom:-2px; position:relative;">
            {{ section.settings.label_shipping }}
          </button>
        {%- endif -%}

        {%- if section.settings.show_reviews -%}
          <button data-btab="reviews"
            style="padding:12px 20px; font-size:14px; font-weight:600; border:none; border-bottom:3px solid {% if _first_tab == 'reviews' %}#2d2d2d{% else %}transparent{% endif %}; background:none; cursor:pointer; color:{% if _first_tab == 'reviews' %}#2d2d2d{% else %}#888{% endif %}; white-space:nowrap; margin-bottom:-2px; position:relative;">
            {{ section.settings.label_reviews }}
          </button>
        {%- endif -%}

      </div>
    </div>

    {%- comment -%}── Content panels ───────────────────────────────────{%- endcomment -%}

    {%- if section.settings.show_description -%}
      <div id="btab-panel-description-{{ _sid }}" class="rte" style="padding:30px 0;{% if _first_tab != 'description' %} display:none;{% endif %}">
        {{ product.description }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_breakdown -%}
      {%- if product.metafields.specs.customer_metrics -%}
        <div id="btab-panel-breakdown-{{ _sid }}" style="padding:30px 0;{% if _first_tab != 'breakdown' %} display:none;{% endif %}">
          {%- render 'apparel-product-breakdown' -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.show_features -%}
      <div id="btab-panel-features-{{ _sid }}" class="rte" style="padding:30px 0;{% if _first_tab != 'features' %} display:none;{% endif %}">
        {{ product.metafields.custom.specs_features | metafield_tag }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_sizechart -%}
      <div id="btab-panel-sizechart-{{ _sid }}" style="padding:30px 0;{% if _first_tab != 'sizechart' %} display:none;{% endif %}">
        <div style="font-size:0.85em; overflow-x:auto;">
          {{ product.metafields.specs.sizechart | replace: '"', '' }}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.show_shipping -%}
      <div id="btab-panel-shipping-{{ _sid }}" class="rte" style="padding:30px 0;{% if _first_tab != 'shipping' %} display:none;{% endif %}">
        {{ shop.metaobjects['global_text']['global-text-Ninja'].blanks_shipping_returns | metafield_tag }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_reviews -%}
      <div id="btab-panel-reviews-{{ _sid }}" style="padding:30px 0;{% if _first_tab != 'reviews' %} display:none;{% endif %}">
        <h2 style="font-size:22px; text-align:center; margin-bottom:24px;">Ninja Transfers Customer Feedback</h2>
        <div class="yotpo yotpo-pictures-widget"
          data-gallery-id="6650b7e621416c002489edda"
          data-product-id="{{ product.id }}">
        </div>
        <div style="border-top:2px solid #eaeaea; padding-top:30px; margin-top:30px;">
          <div class="yotpo-widget-instance"
            data-yotpo-instance-id="559369"
            data-yotpo-product-id="{{ product.id }}"
            data-yotpo-name="{{ product.title | escape }}"
            data-yotpo-url="{{ shop.url }}{{ product.url }}"
            data-yotpo-image-url="{{ product.featured_image | product_img_url: 'large' | replace: '?', '%3F' | replace: '&', '%26' }}"
            data-yotpo-description="{{ product.description | escape }}">
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%}── Tab switching JS ─────────────────────────────────{%- endcomment -%}
    <script>
    (function () {
      var sid        = {{ _sid | json }};
      var barId      = 'btab-bar-' + sid;
      var ACTIVE_CLR = '#2d2d2d';
      var INACT_CLR  = '#888';

      function switchTab(tabId) {
        document.querySelectorAll('#' + barId + ' [data-btab]').forEach(function (btn) {
          btn.style.borderBottomColor = 'transparent';
          btn.style.color = INACT_CLR;
        });
        document.querySelectorAll('[id^="btab-panel-"][id$="-' + sid + '"]').forEach(function (panel) {
          panel.style.display = 'none';
        });
        var activeBtn = document.querySelector('#' + barId + ' [data-btab="' + tabId + '"]');
        if (activeBtn) {
          activeBtn.style.borderBottomColor = ACTIVE_CLR;
          activeBtn.style.color = ACTIVE_CLR;
        }
        var panel = document.getElementById('btab-panel-' + tabId + '-' + sid);
        if (panel) panel.style.display = 'block';
      }

      document.querySelectorAll('#' + barId + ' [data-btab]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          switchTab(this.getAttribute('data-btab'));
        });
      });
    }());
    </script>

  </div>
</div>

{% schema %}
{
  "name": "Blanks PDP Tabs",
  "tag": "section",
  "class": "blanks-pdp-tabs-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Description tab"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show tab",
      "default": true
    },
    {
      "type": "text",
      "id": "label_description",
      "label": "Tab label",
      "default": "Description"
    },
    {
      "type": "header",
      "content": "Breakdown tab"
    },
    {
      "type": "checkbox",
      "id": "show_breakdown",
      "label": "Show tab",
      "default": true
    },
    {
      "type": "text",
      "id": "label_breakdown",
      "label": "Tab label",
      "default": "Breakdown"
    },
    {
      "type": "header",
      "content": "Features tab"
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Show tab",
      "default": true
    },
    {
      "type": "text",
      "id": "label_features",
      "label": "Tab label",
      "default": "Features"
    },
    {
      "type": "header",
      "content": "Size Chart tab"
    },
    {
      "type": "checkbox",
      "id": "show_sizechart",
      "label": "Show tab",
      "default": true
    },
    {
      "type": "text",
      "id": "label_sizechart",
      "label": "Tab label",
      "default": "Size Chart"
    },
    {
      "type": "header",
      "content": "Shipping & Returns tab"
    },
    {
      "type": "checkbox",
      "id": "show_shipping",
      "label": "Show tab",
      "default": true
    },
    {
      "type": "text",
      "id": "label_shipping",
      "label": "Tab label",
      "default": "Shipping & Returns"
    },
    {
      "type": "header",
      "content": "Reviews tab"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show tab",
      "default": true
    },
    {
      "type": "text",
      "id": "label_reviews",
      "label": "Tab label",
      "default": "Reviews"
    }
  ],
  "presets": [
    {
      "name": "Blanks PDP Tabs"
    }
  ]
}
{% endschema %}
