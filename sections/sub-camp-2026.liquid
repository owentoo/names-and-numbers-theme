        <script>
          (function () {
            var form = document.getElementById('sc26-giveaway-form');
            if (!form) return;
            var success = form.querySelector('.sc26-form-success');
            var errorMsg = form.querySelector('.sc26-form-error');
            form.addEventListener('submit', function (e) {
              var action = form.getAttribute('action') || '';
              if (!action || action === '#' || action.slice(-1) === '#') return;
              e.preventDefault();
              var btn = form.querySelector('button[type="submit"]');
              if (btn) { btn.disabled = true; btn.textContent = 'Entering…'; }
              if (errorMsg) errorMsg.hidden = true;
              fetch(action, { method: 'POST', mode: 'no-cors', body: new FormData(form) })
                .then(function () {
                  Array.prototype.forEach.call(
                    form.querySelectorAll('label, input, button'),
                    function (el) { el.style.display = 'none'; }
                  );
                  if (success) success.hidden = false;
                })
                .catch(function () {
                  if (btn) { btn.disabled = false; btn.textContent = 'Enter the giveaway →'; }
                  if (errorMsg) errorMsg.hidden = false;
                });
