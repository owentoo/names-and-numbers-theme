{% comment %}
  Sub Camp 2026: Sublimation + Beyond Camp landing page section.
  Light-mode rebuild matching ninjatransfers.com chrome (Inter, light-gray body, white cards),
  with real Ninja product imagery pulled from the live store.
{% endcomment %}

<style>
  .sc26 {
    --sc-bg: #f3f4f6;
    --sc-card: #ffffff;
    --sc-card-2: #f9fafb;
    --sc-line: #e5e7eb;
    --sc-line-strong: #d1d5db;
    --sc-text: #0b0d10;
    --sc-text-dim: #4b5563;
    --sc-text-mute: #6b7280;
    --sc-link: #0ea5e9;
    --sc-coral: #ff5e7e;
    --sc-purple: #b667ff;
    --sc-teal: #0bb6d6;
    --sc-yellow: #f5c518;
    --sc-green: #10b981;
    --sc-dark: #0b0d10;

    background: var(--sc-bg);
    color: var(--sc-text);
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .sc26 * { box-sizing: border-box; }
  .sc26 a { color: var(--sc-link); text-decoration: none; }
  .sc26 a:hover { text-decoration: underline; }
  .sc26 .wrap { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  @media (min-width: 768px) { .sc26 .wrap { padding: 0 32px; } }

  /* Top ribbon */
  .sc26 .ribbon {
    background: linear-gradient(90deg, var(--sc-coral), var(--sc-purple), var(--sc-teal), var(--sc-yellow));
    color: var(--sc-dark);
    text-align: center;
    padding: 10px 16px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Hero: white card on light gray */
  .sc26 .hero { padding: 24px 0 28px; }
  @media (min-width: 768px) { .sc26 .hero { padding: 36px 0 36px; } }
  .sc26 .hero-card {
    background: var(--sc-card);
    border: 1px solid var(--sc-line);
    border-radius: 20px;
    padding: 32px 24px;
    position: relative;
    overflow: hidden;
  }
  @media (min-width: 768px) { .sc26 .hero-card { padding: 56px 48px; } }
  .sc26 .hero-card::before {
    content: "";
    position: absolute; top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--sc-coral), var(--sc-yellow), var(--sc-green), var(--sc-teal), var(--sc-purple));
  }
  .sc26 .hero-grid { display: grid; grid-template-columns: 1fr; gap: 24px; align-items: center; }
  @media (min-width: 800px) { .sc26 .hero-grid { grid-template-columns: 1.4fr 1fr; gap: 48px; } }

  /* Logo badge: dark backdrop so the white logo wordmark reads on the white page */
  .sc26 .hero-logo-badge {
    background: radial-gradient(circle at 30% 20%, #1a1f2b, var(--sc-dark) 70%);
    border-radius: 24px;
    padding: 28px;
    display: grid; place-items: center;
    box-shadow: 0 12px 36px rgba(11,13,16,0.18);
    position: relative;
    overflow: hidden;
  }
  .sc26 .hero-logo-badge::after {
    content: "";
    position: absolute; inset: 0;
    background:
      radial-gradient(circle at 80% 90%, rgba(255,94,126,0.16), transparent 50%),
      radial-gradient(circle at 10% 10%, rgba(11,182,214,0.14), transparent 50%);
    pointer-events: none;
  }
  .sc26 .hero-logo {
    display: block; max-width: 280px; width: 100%; height: auto;
    position: relative; z-index: 1;
  }

  .sc26 .badges { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
  .sc26 .badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: 999px;
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
  }
  .sc26 .badge.ninja { background: rgba(11,182,214,0.10); color: var(--sc-teal); border: 1px solid rgba(11,182,214,0.3); }
  .sc26 .badge.camp { background: rgba(255,94,126,0.10); color: var(--sc-coral); border: 1px solid rgba(255,94,126,0.3); }

  .sc26 h1 {
    font-size: clamp(34px, 6.4vw, 64px);
    line-height: 0.98;
    margin: 0 0 18px;
    font-weight: 900;
    letter-spacing: -0.035em;
    color: var(--sc-text);
  }
  .sc26 h1 .pop { background: linear-gradient(90deg, var(--sc-teal), var(--sc-green)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .sc26 h1 .pop2 { background: linear-gradient(90deg, var(--sc-coral), var(--sc-purple)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .sc26 .lede { font-size: 17px; max-width: 56ch; color: var(--sc-text-dim); margin: 0 0 22px; line-height: 1.55; }
  .sc26 .hero-perk {
    display: inline-grid; grid-template-columns: auto 1fr; align-items: center; gap: 12px;
    background: white;
    border: 1.5px solid rgba(11,13,16,0.12);
    border-radius: 12px;
    padding: 10px 14px 10px 10px;
    margin: 0 0 20px;
    max-width: 520px;
  }
  .sc26 .hero-perk .hp-code {
    font-family: "SF Mono", "Menlo", "Consolas", monospace;
    font-size: 14px; font-weight: 800; letter-spacing: 0.04em;
    background: linear-gradient(135deg, var(--sc-coral), var(--sc-purple));
    color: white;
    padding: 7px 12px; border-radius: 8px;
    white-space: nowrap;
  }
  .sc26 .hero-perk.hero-perk-aap .hp-code {
    background: linear-gradient(135deg, var(--sc-purple), var(--sc-teal));
    font-family: -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
    letter-spacing: 0.08em;
  }
  .sc26 .hero-perk .hp-body small a {
    color: var(--sc-coral); font-weight: 700;
    border-bottom: 1.5px solid currentColor; padding-bottom: 1px;
  }
  .sc26 .hero-perk .hp-body small a:hover { opacity: 0.75; text-decoration: none; }
  .sc26 .hero-perk .hp-body {
    font-size: 13px; line-height: 1.35; color: var(--sc-text);
  }
  .sc26 .hero-perk .hp-body strong { font-weight: 800; }
  .sc26 .hero-perk .hp-body small { display: block; color: var(--sc-text-mute); font-size: 11px; margin-top: 2px; }
  @media (max-width: 540px) {
    .sc26 .hero-perk { grid-template-columns: auto 1fr; padding: 10px 12px; }
  }
  .sc26 .cta-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .sc26 .btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 13px 22px; border-radius: 10px;
    font-weight: 700; font-size: 15px;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
    border: 0; cursor: pointer;
  }
  .sc26 .btn:hover { transform: translateY(-1px); text-decoration: none; }
  .sc26 .btn-primary { background: var(--sc-dark); color: #ffffff; }
  .sc26 .btn-primary:hover { background: #1f2937; }
  .sc26 .btn-secondary { background: #ffffff; color: var(--sc-text); border: 1.5px solid var(--sc-line-strong); }
  .sc26 .btn-secondary:hover { border-color: var(--sc-text); }
  .sc26 .btn-coral {
    background: linear-gradient(135deg, var(--sc-coral), var(--sc-purple));
    color: white;
    box-shadow: 0 4px 16px rgba(255,94,126,0.25);
  }

  /* Single coupon (SUBCAMP15): slim full-width strip, clearly a coupon */
  .sc26 .coupon-strip {
    background: var(--sc-card);
    border: 1px solid var(--sc-line);
    border-radius: 14px;
    padding: 18px 22px;
    display: grid; grid-template-columns: auto 1fr; gap: 18px; align-items: center;
    position: relative; overflow: hidden;
    margin: 0 0 28px;
  }
  .sc26 .coupon-strip::before {
    content: ""; position: absolute; top: 0; left: 0; bottom: 0; width: 4px;
    background: linear-gradient(180deg, var(--sc-teal), var(--sc-green));
  }
  .sc26 .coupon-strip .code {
    font-family: "SF Mono", "Menlo", "Consolas", monospace;
    font-size: clamp(18px, 2.4vw, 24px); font-weight: 800;
    letter-spacing: 0.04em; color: var(--sc-text);
    background: rgba(11,182,214,0.10); border: 1px solid rgba(11,182,214,0.25);
    padding: 8px 14px; border-radius: 8px;
  }
  .sc26 .coupon-strip .body strong { color: var(--sc-text); }
  .sc26 .coupon-strip .body { color: var(--sc-text-dim); font-size: 14px; line-height: 1.4; }
  @media (max-width: 580px) {
    .sc26 .coupon-strip { grid-template-columns: 1fr; padding: 18px 20px; }
  }

  /* Giveaway block: directly under hero, prominent */
  .sc26 .giveaway-card {
    background: linear-gradient(135deg, #fff5f7 0%, #f7eeff 50%, #eef9ff 100%);
    border: 1px solid rgba(255,94,126,0.3);
    border-radius: 20px;
    padding: 32px;
    position: relative; overflow: hidden;
    margin: 0 0 36px;
  }
  @media (max-width: 720px) { .sc26 .giveaway-card { padding: 28px 22px; } }
  .sc26 .giveaway-card::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: linear-gradient(90deg, var(--sc-coral), var(--sc-purple), var(--sc-teal), var(--sc-yellow));
  }
  .sc26 .giveaway-grid {
    display: grid; grid-template-columns: 1fr; gap: 24px; align-items: center;
  }
  @media (min-width: 800px) {
    .sc26 .giveaway-grid { grid-template-columns: 1.3fr 1fr; gap: 32px; }
  }
  .sc26 .giveaway-card .eyebrow {
    font-size: 11px; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--sc-coral); margin: 0 0 8px;
  }
  .sc26 .giveaway-card h2 { margin: 0 0 10px; font-size: clamp(22px, 3vw, 30px); font-weight: 800; letter-spacing: -0.01em; }
  .sc26 .bundle-exhibit {
    margin: 0 0 14px; padding: 0;
    background: white;
    border: 1px solid rgba(11,13,16,0.08);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(11,13,16,0.04);
    position: relative;
  }
  .sc26 .bundle-bonus {
    position: absolute; top: 14px; right: 14px;
    background: linear-gradient(135deg, #0bb6d6, #0b8ad6);
    color: white;
    padding: 8px 14px; border-radius: 999px;
    font-size: 12px; font-weight: 800; letter-spacing: 0.04em;
    box-shadow: 0 4px 14px rgba(11,138,214,0.35);
    z-index: 2;
  }
  .sc26 .bundle-exhibit img {
    display: block; width: 100%; height: auto;
    aspect-ratio: 1 / 1; object-fit: cover;
  }
  .sc26 .bundle-exhibit figcaption {
    padding: 10px 14px;
    font-size: 12px; font-weight: 600; line-height: 1.45; color: var(--sc-text-mute);
    border-top: 1px solid rgba(11,13,16,0.06);
    background: rgba(255,255,255,0.85);
  }
  .sc26 .bundle-links {
    margin: 0 0 14px; padding: 0; list-style: none;
    display: flex; flex-wrap: wrap; gap: 6px;
  }
  .sc26 .bundle-links li { margin: 0; padding: 0; }
  .sc26 .bundle-links a {
    display: inline-flex; align-items: center;
    background: rgba(255,255,255,0.85);
    border: 1px solid rgba(11,13,16,0.1);
    border-radius: 999px;
    padding: 5px 10px;
    font-size: 11px; font-weight: 700; color: var(--sc-text);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .sc26 .bundle-links a:hover { border-color: rgba(11,13,16,0.3); transform: translateY(-1px); text-decoration: none; }
  .sc26 .giveaway-form {
    background: white;
    border: 1px solid var(--sc-line);
    border-radius: 14px;
    padding: 20px;
  }
  .sc26 .giveaway-form label {
    display: block; font-size: 12px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--sc-text-mute); margin-bottom: 6px;
  }
  .sc26 .giveaway-form input[type="email"],
  .sc26 .giveaway-form input[type="text"] {
    width: 100%; padding: 12px 14px;
    border: 1px solid var(--sc-line-strong); border-radius: 8px;
    font-size: 15px; font-family: inherit; color: var(--sc-text);
    margin-bottom: 12px; background: white;
  }
  .sc26 .giveaway-form input:focus { outline: 2px solid var(--sc-teal); outline-offset: 1px; border-color: var(--sc-teal); }
  .sc26 .giveaway-form button {
    width: 100%;
    background: linear-gradient(135deg, var(--sc-coral), var(--sc-purple));
    color: white; border: 0;
    padding: 13px; border-radius: 8px;
    font-weight: 800; font-size: 15px;
    cursor: pointer; transition: transform 0.12s ease, box-shadow 0.12s ease;
    box-shadow: 0 4px 16px rgba(255,94,126,0.25);
  }
  .sc26 .giveaway-form button:hover { transform: translateY(-1px); }
  .sc26 .giveaway-form .fine {
    font-size: 11px; color: var(--sc-text-mute); margin: 10px 0 0;
    text-align: center; line-height: 1.4;
  }

  /* AAP info card: small, polite, points to camp */
  /* AAP paths: two ways to get the bundle, side-by-side comparison */
  .sc26 .aap-paths {
    background: linear-gradient(135deg, rgba(255,255,255,0.55) 0%, rgba(255,255,255,0.35) 100%);
    border: 1px solid rgba(11,13,16,0.08);
    border-radius: 14px;
    padding: 24px;
    margin: 24px 0 0;
    display: grid; grid-template-columns: 1fr auto 1fr; gap: 24px; align-items: center;
  }
  @media (max-width: 720px) {
    .sc26 .aap-paths { grid-template-columns: 1fr; gap: 16px; padding: 22px; }
  }
  .sc26 .aap-path { display: flex; flex-direction: column; gap: 6px; }
  .sc26 .aap-path .aap-eyebrow {
    font-size: 11px; font-weight: 800; letter-spacing: 0.14em;
    text-transform: uppercase; margin: 0;
  }
  .sc26 .aap-path.aap-luck .aap-eyebrow { color: var(--sc-coral); }
  .sc26 .aap-path.aap-pass .aap-eyebrow { color: var(--sc-purple); }
  .sc26 .aap-path .aap-headline { margin: 0; font-size: 18px; font-weight: 800; color: var(--sc-text); letter-spacing: -0.01em; line-height: 1.2; }
  .sc26 .aap-path .aap-sub { margin: 0; font-size: 13px; line-height: 1.5; color: var(--sc-text-dim); }
  .sc26 .aap-path .aap-cta {
    margin-top: 6px;
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 13px; font-weight: 800; color: var(--sc-text);
    text-decoration: none; align-self: flex-start;
    border-bottom: 2px solid var(--sc-purple);
    padding-bottom: 2px;
  }
  .sc26 .aap-path .aap-cta:hover { color: var(--sc-purple); }
  .sc26 .aap-path .aap-perks {
    list-style: none; padding: 0; margin: 4px 0 4px;
    display: flex; flex-direction: column; gap: 4px;
  }
  .sc26 .aap-path .aap-perks li {
    position: relative; padding-left: 20px;
    font-size: 13px; line-height: 1.45; color: var(--sc-text-dim);
  }
  .sc26 .aap-path .aap-perks li::before {
    content: "✓"; position: absolute; left: 0; top: 0;
    color: var(--sc-purple); font-weight: 900; font-size: 13px;
  }
  .sc26 .aap-path .aap-perks li strong { color: var(--sc-text); font-weight: 800; }
  .sc26 .aap-path .aap-cross {
    margin: 8px 0 0; font-size: 12px; color: var(--sc-text-mute); line-height: 1.4;
  }
  .sc26 .aap-path .aap-cross a {
    color: var(--sc-coral); font-weight: 700; text-decoration: none;
    border-bottom: 1.5px solid currentColor; padding-bottom: 1px;
  }
  .sc26 .aap-path .aap-cross a:hover { opacity: 0.75; }
  .sc26 .aap-or {
    width: 44px; height: 44px; border-radius: 50%;
    background: white; border: 1px solid rgba(11,13,16,0.08);
    display: grid; place-items: center;
    font-size: 11px; font-weight: 900; letter-spacing: 0.08em;
    color: var(--sc-text-mute);
    box-shadow: 0 4px 12px rgba(11,13,16,0.04);
    justify-self: center;
  }

  /* Sections */
  .sc26 section { padding: 44px 0; }
  .sc26 section + section { border-top: 1px solid var(--sc-line); }
  .sc26 .section-eyebrow {
    font-size: 11px; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--sc-coral); margin: 0 0 8px;
  }
  .sc26 h2 {
    font-size: clamp(24px, 3.5vw, 36px); margin: 0 0 12px;
    font-weight: 800; letter-spacing: -0.02em; color: var(--sc-text);
  }
  .sc26 .section-lede { color: var(--sc-text-dim); font-size: 16px; max-width: 720px; margin: 0 0 28px; }

  /* PRODUCT CARDS: used in supply tiers, specialty, free-stuff */
  .sc26 .product-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px;
  }
  .sc26 .product-card {
    background: var(--sc-card);
    border: 1px solid var(--sc-line);
    border-radius: 14px;
    padding: 14px;
    display: flex; flex-direction: column;
    color: var(--sc-text);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    position: relative;
  }
  .sc26 .product-card:hover {
    border-color: var(--sc-line-strong);
    transform: translateY(-2px);
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(11,13,16,0.06);
  }
  .sc26 .product-card .pc-img {
    width: 100%; aspect-ratio: 1 / 1; border-radius: 10px;
    background: var(--sc-card-2); border: 1px solid var(--sc-line);
    display: block; object-fit: contain;
    margin-bottom: 12px;
  }
  .sc26 .product-card .pc-img-tool {
    width: 100%; aspect-ratio: 16 / 9; border-radius: 10px;
    background: #f3f4f6; border: 1px solid var(--sc-line);
    display: block; object-fit: cover; object-position: center top;
    margin-bottom: 12px;
  }
  .sc26 .product-card .pc-name {
    font-weight: 700; font-size: 14px; line-height: 1.35; color: var(--sc-text);
    margin: 0 0 4px;
  }
  .sc26 .product-card .pc-desc {
    font-size: 12px; color: var(--sc-text-dim); line-height: 1.4; margin: 0 0 10px;
    flex: 1;
  }
  .sc26 .product-card .pc-cta {
    font-size: 13px; font-weight: 700; color: var(--sc-link);
    margin-top: auto;
  }
  .sc26 .product-card .pc-tag {
    position: absolute; top: 10px; right: 10px;
    font-size: 10px; font-weight: 800; letter-spacing: 0.04em;
    color: var(--sc-dark); background: var(--sc-yellow);
    padding: 3px 8px; border-radius: 6px;
  }

  /* Tier wrapper */
  .sc26 .tier {
    background: var(--sc-card);
    border: 1px solid var(--sc-line);
    border-radius: 16px;
    padding: 24px;
    position: relative; overflow: hidden;
    margin-bottom: 16px;
  }
  .sc26 .tier::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  }
  .sc26 .tier.t1::before { background: var(--sc-green); }
  .sc26 .tier.t2::before { background: var(--sc-teal); }
  .sc26 .tier.t3::before { background: var(--sc-purple); }
  .sc26 .tier-head {
    display: flex; align-items: baseline; justify-content: space-between;
    flex-wrap: wrap; gap: 8px; margin-bottom: 16px;
  }
  .sc26 .tier-head h3 { margin: 0; font-size: 20px; font-weight: 800; color: var(--sc-text); }
  .sc26 .tier-tag {
    font-size: 10px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.08em;
    padding: 4px 10px; border-radius: 999px;
  }
  .sc26 .tier.t1 .tier-tag { background: rgba(16,185,129,0.10); color: var(--sc-green); }
  .sc26 .tier.t2 .tier-tag { background: rgba(11,182,214,0.10); color: var(--sc-teal); }
  .sc26 .tier.t3 .tier-tag { background: rgba(182,103,255,0.10); color: var(--sc-purple); }

  /* Per-tier "view all" link below the product grid */
  .sc26 .tier-cta { margin: 16px 0 0; }
  .sc26 .tier-cta a {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 14px; font-weight: 700;
    border-bottom: 1.5px solid currentColor;
    padding-bottom: 1px;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .sc26 .tier-cta a:hover { opacity: 0.75; text-decoration: none; }
  .sc26 .tier.t1 .tier-cta a { color: var(--sc-green); }
  .sc26 .tier.t2 .tier-cta a { color: var(--sc-teal); }
  .sc26 .tier.t3 .tier-cta a { color: var(--sc-purple); }

  /* Ninja Blanks: full-bleed editorial slice */
  .sc26 .blanks-slice { background: #faf6f0; padding: 0; margin: 32px 0; border-top: 1px solid rgba(11,13,16,0.06); border-bottom: 1px solid rgba(11,13,16,0.06); }
  .sc26 .blanks-slice-grid {
    display: grid; grid-template-columns: 1fr; gap: 0;
    max-width: none;
  }
  @media (min-width: 880px) {
    .sc26 .blanks-slice-grid { grid-template-columns: 1.15fr 1fr; }
  }
  .sc26 .blanks-hero-figure {
    margin: 0; padding: 0; position: relative; overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 880px) { .sc26 .blanks-hero-figure { aspect-ratio: auto; min-height: 540px; } }
  .sc26 .blanks-hero-figure img {
    width: 100%; height: 100%; object-fit: cover; object-position: center; display: block;
  }
  .sc26 .blanks-content {
    padding: 38px 28px;
    display: flex; flex-direction: column; justify-content: center; gap: 20px;
  }
  @media (min-width: 880px) { .sc26 .blanks-content { padding: 56px 56px 56px 48px; gap: 24px; } }
