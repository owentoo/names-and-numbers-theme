{%-liquid
  assign ss = section.settings
  assign sb = section.blocks
-%}
{{ 'hp-global.css' | asset_url | stylesheet_tag }}
{{ 'hp-features.css' | asset_url | stylesheet_tag }}

<div class="container--large">
  <div class="hpFeatures">
    <div class="hpFeatures__header">
      {% if ss.kicker != blank %}
        <div class="hpFeatures__kicker">{{ ss.kicker }}</div>
      {% endif %}
      {% if ss.heading != blank %}
        <h2 class="hpFeatures__heading">{{ ss.heading }}</h2>
      {% endif %}
    </div>

    {% if sb.size > 0 %}
      <div class="hpFeatures__grid">
        {%- for block in sb -%}
          {%- assign b = block.settings -%}
          <div class="hpFeatures__card" {{ block.shopify_attributes }}>
            <div class="hpFeatures__icon">
              {% if b.icon_image != blank %}
                <img src="{{ b.icon_image | image_url: width: 56 }}" alt="" loading="lazy">
              {% else %}
                {{ b.icon }}
              {% endif %}
            </div>
            <div class="hpFeatures__card-title">{{ b.title }}</div>
            <div class="hpFeatures__card-desc">{{ b.description }}</div>
          </div>
        {%- endfor -%}
      </div>
    {% endif %}
  </div>
</div>

{%- capture getStyles -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ ss.bgColor }};
    margin-top: {{ ss.secMarginTop_desktop | append: 'px' }};
    margin-bottom: {{ ss.secMarginBottom_desktop | append: 'px' }};
  }
  #shopify-section-{{ section.id }} .hpFeatures {
    padding-top: {{ ss.secPaddingTop_desktop | append: 'px' }};
    padding-bottom: {{ ss.secPaddingBottom_desktop | append: 'px' }};
  }
  #shopify-section-{{ section.id }} .hpFeatures__kicker { color: {{ ss.kickerColor }}; }
  #shopify-section-{{ section.id }} .hpFeatures__card { background: {{ ss.cardBg }}; }
  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ ss.secMarginTop_tab | append: 'px' }};
      margin-bottom: {{ ss.secMarginBottom_tab | append: 'px' }};
    }
    #shopify-section-{{ section.id }} .hpFeatures {
      padding-top: {{ ss.secPaddingTop_tab | append: 'px' }};
      padding-bottom: {{ ss.secPaddingBottom_tab | append: 'px' }};
    }
  }
  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ ss.secMarginTop_mobile | append: 'px' }};
      margin-bottom: {{ ss.secMarginBottom_mobile | append: 'px' }};
    }
    #shopify-section-{{ section.id }} .hpFeatures {
      padding-top: {{ ss.secPaddingTop_mobile | append: 'px' }};
      padding-bottom: {{ ss.secPaddingBottom_mobile | append: 'px' }};
    }
  }
{%- endcapture -%}
<style>{{ getStyles }}</style>

{% schema %}
{
  "name": "HP - Industry Features",
  "class": "hp-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "WHY 500,000+ CHOOSE NINJA" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Industry Standard in DTF" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bgColor", "label": "Background Color", "default": "#f5f0eb" },
    { "type": "color", "id": "kickerColor", "label": "Kicker Color", "default": "#019AFF" },
    { "type": "color", "id": "cardBg", "label": "Card Background", "default": "#ffffff" },
    { "type": "header", "content": "Desktop Spacing" },
    { "type": "range", "id": "secMarginTop_desktop", "label": "Margin Top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "secMarginBottom_desktop", "label": "Margin Bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "secPaddingTop_desktop", "label": "Padding Top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "secPaddingBottom_desktop", "label": "Padding Bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 64 },
    { "type": "header", "content": "Tablet Spacing" },
    { "type": "range", "id": "secMarginTop_tab", "label": "Margin Top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "secMarginBottom_tab", "label": "Margin Bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "secPaddingTop_tab", "label": "Padding Top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "secPaddingBottom_tab", "label": "Padding Bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 48 },
    { "type": "header", "content": "Mobile Spacing" },
    { "type": "range", "id": "secMarginTop_mobile", "label": "Margin Top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "secMarginBottom_mobile", "label": "Margin Bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "secPaddingTop_mobile", "label": "Padding Top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "secPaddingBottom_mobile", "label": "Padding Bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon/Emoji", "default": "🎨" },
        { "type": "image_picker", "id": "icon_image", "label": "Or Icon Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "16.7 Million Colors" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "VIVID AF 9-color system — widest gamut in DTF." }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP - Industry Features",
      "blocks": [
        { "type": "feature", "settings": { "icon": "🎨", "title": "16.7 Million Colors", "description": "VIVID AF 9-color system — widest gamut in DTF. G7-calibrated weekly." } },
        { "type": "feature", "settings": { "icon": "⚡", "title": "Ships in 24–48 Hours", "description": "100+ printers across 100K sq. ft. Faster than any competitor." } },
        { "type": "feature", "settings": { "icon": "✅", "title": "100+ Wash Durability", "description": "Third-party lab tested. No cracking, peeling, or fading." } },
        { "type": "feature", "settings": { "icon": "👕", "title": "Works on Everything", "description": "Cotton, polyester, nylon, leather, canvas, denim — any color." } },
        { "type": "feature", "settings": { "icon": "🔍", "title": "Ultra-Fine Detail", "description": "Captures details as fine as 3 pixels. Razor-sharp text." } },
        { "type": "feature", "settings": { "icon": "💰", "title": "No Hidden Costs", "description": "Free shipping. No setup fees. No art fees. No minimums." } }
      ]
    }
  ]
}
{% endschema %}
