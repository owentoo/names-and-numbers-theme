{% comment %}
  Cori's Corner NT landing page section.
  Cori-voiced hub: free SVGs, honest DTF guide for crafters, affiliate picks (HLMS20),
  free design tools cross-link, and "Cori talks Ninja" archive.

  All visual selectors are scoped under `.coris-corner` to avoid collisions with the
  host theme. Mirrors the structure of sections/sub-camp-2026.liquid.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=Source+Sans+3:wght@400;500;600&display=swap">

<style>
  .coris-corner {
    --cc-blue: #2563eb;
    --cc-blue-light: #dbeafe;
    --cc-cream: #F5EFE6;
    --cc-cream-mid: #EDE7DC;
    --cc-cream-dark: #DDD5C8;
    --cc-ink: #1a1a1a;
    --cc-ink-mid: #444;
    --cc-ink-light: #777;
    --cc-card-bg: #fff;
    --cc-border: #E0D8CE;
    --cc-radius: 10px;
    --cc-radius-sm: 6px;
    --cc-shadow: 0 2px 12px rgba(26,26,26,0.07);
    --cc-shadow-hover: 0 4px 20px rgba(26,26,26,0.12);
    --cc-font-head: 'Fraunces', Georgia, serif;
    --cc-font-body: 'Source Sans 3', system-ui, -apple-system, sans-serif;
    --cc-max-w: 1100px;
    --cc-pad: 1.25rem;

    background: var(--cc-cream);
    color: var(--cc-ink);
    font-family: var(--cc-font-body);
    font-size: 1rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    scroll-behavior: smooth;
  }
  .coris-corner *, .coris-corner *::before, .coris-corner *::after {
    box-sizing: border-box;
  }
  .coris-corner img { display: block; max-width: 100%; height: auto; }
  .coris-corner a { color: var(--cc-blue); text-decoration: none; }
  .coris-corner a:hover { text-decoration: underline; }

  .coris-corner .cc-container {
    width: 100%;
    max-width: var(--cc-max-w);
    margin-inline: auto;
    padding-inline: var(--cc-pad);
  }
  .coris-corner .cc-section { padding-block: 4rem; }
  .coris-corner .cc-section-header { margin-bottom: 2rem; }
  .coris-corner .cc-section-label {
    display: inline-block;
    font-family: var(--cc-font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cc-blue);
    margin-bottom: 0.5rem;
  }
  .coris-corner .cc-section-title {
    font-family: var(--cc-font-head);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--cc-ink);
    margin: 0 0 0.75rem;
  }
  .coris-corner .cc-section-body {
    font-size: 1.05rem;
    color: var(--cc-ink-mid);
    max-width: 60ch;
    margin: 0;
  }
  .coris-corner .cc-divider {
    border: none;
    border-top: 1px solid var(--cc-border);
    margin: 0;
  }

  /* HERO */
  .coris-corner .cc-hero {
    background: var(--cc-cream);
    padding-block: 3rem 4rem;
  }
  .coris-corner .cc-hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .coris-corner .cc-hero-photo-wrap { display: flex; justify-content: center; }
  .coris-corner .cc-hero-photo {
    width: 100%;
    max-width: 280px;
    aspect-ratio: 3/4;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: var(--cc-shadow);
    border: 1px solid var(--cc-cream-dark);
  }
  .coris-corner .cc-hero-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .coris-corner .cc-hero-eyebrow {
    font-family: var(--cc-font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cc-blue);
  }
  .coris-corner .cc-hero-h1 {
    font-family: var(--cc-font-head);
    font-size: clamp(2.4rem, 8vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--cc-ink);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .coris-corner .cc-hero-subhead {
    font-size: 1.1rem;
    color: var(--cc-ink-mid);
    max-width: 50ch;
    font-style: italic;
    font-family: var(--cc-font-head);
    font-weight: 400;
    line-height: 1.5;
    margin: 0;
  }
  .coris-corner .cc-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }
  .coris-corner .cc-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.65rem 1.25rem;
    border-radius: var(--cc-radius-sm);
    font-family: var(--cc-font-body);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    line-height: 1;
  }
  .coris-corner .cc-btn-primary {
    background: var(--cc-blue);
    color: #fff;
    border: 2px solid var(--cc-blue);
  }
  .coris-corner .cc-btn-primary:hover {
    background: #1d4ed8;
    border-color: #1d4ed8;
    text-decoration: none;
  }
  .coris-corner .cc-btn-outline {
    background: transparent;
    color: var(--cc-ink);
    border: 2px solid var(--cc-cream-dark);
  }
  .coris-corner .cc-btn-outline:hover {
    border-color: var(--cc-ink-mid);
    text-decoration: none;
  }
  .coris-corner .cc-btn-ghost {
    background: transparent;
    color: var(--cc-blue);
    border: 2px solid var(--cc-blue-light);
    font-weight: 500;
  }
  .coris-corner .cc-btn-ghost:hover {
    background: var(--cc-blue-light);
    text-decoration: none;
  }
  .coris-corner .cc-hero-back-link {
    font-size: 0.85rem;
    color: var(--cc-ink-light);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .coris-corner .cc-hero-back-link:hover {
    color: var(--cc-ink);
    text-decoration: underline;
  }

  /* HLMS SOCIAL ROW (mirrors HLMS site chrome) */
  .coris-corner .cc-hlms-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .coris-corner .cc-hlms-social-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cc-ink-light);
    margin-right: 0.35rem;
  }
  .coris-corner .cc-hlms-social-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .coris-corner .cc-hlms-social-icon:hover {
    transform: translateY(-1px);
    opacity: 0.9;
    text-decoration: none;
  }
  .coris-corner .cc-hlms-social-icon svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }
  .coris-corner .cc-hlms-pinterest { background: #D14878; }
  .coris-corner .cc-hlms-facebook { background: #4A90C8; }
  .coris-corner .cc-hlms-instagram { background: #D86F9C; }
  .coris-corner .cc-hlms-youtube { background: #E5A845; }
  .coris-corner .cc-hlms-mail { background: #4FA8A8; }

  /* SVG SECTION */
  .coris-corner .cc-svg-section { background: var(--cc-card-bg); }
  .coris-corner .cc-svg-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .coris-corner .cc-svg-card {
    background: var(--cc-cream);
    border: 1px solid var(--cc-border);
    border-radius: var(--cc-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--cc-shadow);
    transition: box-shadow 0.15s ease;
  }
  .coris-corner .cc-svg-card:hover { box-shadow: var(--cc-shadow-hover); }
  .coris-corner .cc-svg-thumb {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--cc-cream-mid);
  }
  .coris-corner .cc-svg-card-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
  .coris-corner .cc-svg-card-title {
    font-family: var(--cc-font-head);
    font-size: 1rem;
    font-weight: 600;
    color: var(--cc-ink);
    margin: 0;
  }
  .coris-corner .cc-svg-card-meta {
    font-size: 0.8rem;
    color: var(--cc-ink-light);
    margin: 0;
  }
  .coris-corner .cc-btn-download {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 1rem;
    border-radius: var(--cc-radius-sm);
    background: transparent;
    color: var(--cc-blue);
    border: 1.5px solid var(--cc-blue);
    font-size: 0.875rem;
    font-weight: 600;
    font-family: var(--cc-font-body);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s ease;
    align-self: flex-start;
  }
  .coris-corner .cc-btn-download:hover {
    background: var(--cc-blue);
    color: #fff;
    text-decoration: none;
  }

  /* GUIDE SECTION */
  .coris-corner .cc-guide-section { background: var(--cc-cream); }
  .coris-corner .cc-method-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .coris-corner .cc-method-card {
    background: var(--cc-card-bg);
    border: 1px solid var(--cc-border);
    border-radius: var(--cc-radius);
    padding: 1.5rem;
    box-shadow: var(--cc-shadow);
  }
  .coris-corner .cc-method-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .coris-corner .cc-method-name {
    font-family: var(--cc-font-head);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--cc-ink);
    margin: 0;
  }
  .coris-corner .cc-method-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .coris-corner .cc-badge-dtf { background: var(--cc-blue-light); color: var(--cc-blue); }
  .coris-corner .cc-badge-sub { background: #d1fae5; color: #065f46; }
  .coris-corner .cc-badge-vinyl { background: #fef3c7; color: #92400e; }
  .coris-corner .cc-badge-tools { background: var(--cc-cream-mid); color: var(--cc-ink-mid); }
  .coris-corner .cc-method-wins-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cc-ink-light);
    margin: 0 0 0.35rem;
  }
  .coris-corner .cc-method-wins {
    font-size: 0.95rem;
    color: var(--cc-ink-mid);
    line-height: 1.55;
    margin: 0;
  }
  .coris-corner .cc-method-link {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    margin-top: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--cc-blue);
  }
  .coris-corner .cc-method-link:hover { text-decoration: underline; }

  /* PICKS SECTION */
  .coris-corner .cc-picks-section { background: var(--cc-card-bg); }
  .coris-corner .cc-pick-code-tag {
    margin: 0;
    font-size: 0.8rem;
    color: var(--cc-ink-light);
    line-height: 1.4;
  }
  .coris-corner .cc-pick-code-tag code {
    font-family: 'Source Sans 3', monospace;
    font-weight: 700;
    color: var(--cc-ink);
    background: var(--cc-cream-mid);
    padding: 0.05rem 0.4rem;
    border-radius: 3px;
    letter-spacing: 0.02em;
  }
  .coris-corner .cc-picks-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .coris-corner .cc-pick-card {
    background: var(--cc-cream);
    border: 1px solid var(--cc-border);
    border-radius: var(--cc-radius);
    overflow: hidden;
    box-shadow: var(--cc-shadow);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.15s ease;
  }
  .coris-corner .cc-pick-card:hover { box-shadow: var(--cc-shadow-hover); }
  .coris-corner .cc-pick-img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    background: var(--cc-cream-mid);
  }
  .coris-corner .cc-pick-card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .coris-corner .cc-pick-card-title {
    font-family: var(--cc-font-head);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--cc-ink);
    margin: 0;
  }
  .coris-corner .cc-pick-card-voice {
    font-size: 0.95rem;
    color: var(--cc-ink-mid);
    font-style: italic;
    font-family: var(--cc-font-head);
    line-height: 1.5;
    margin: 0;
  }
  .coris-corner .cc-pick-card-cta {
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .coris-corner .cc-picks-disclosure {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    background: var(--cc-cream-mid);
    border-radius: var(--cc-radius-sm);
    border-left: 3px solid var(--cc-cream-dark);
    font-size: 0.875rem;
    color: var(--cc-ink-mid);
    line-height: 1.55;
  }

  /* TOOLS SECTION */
  .coris-corner .cc-tools-section { background: var(--cc-cream); }
  .coris-corner .cc-tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .coris-corner .cc-tool-card {
    background: var(--cc-card-bg);
    border: 1px solid var(--cc-border);
    border-radius: var(--cc-radius);
    overflow: hidden;
    box-shadow: var(--cc-shadow);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s ease;
  }
  .coris-corner .cc-tool-card:hover {
    box-shadow: var(--cc-shadow-hover);
    text-decoration: none;
  }
  .coris-corner .cc-tool-thumb {
    width: 64px;
    height: 64px;
    object-fit: contain;
    border-radius: var(--cc-radius-sm);
    background: var(--cc-cream-mid);
    flex-shrink: 0;
    padding: 8px;
  }
  .coris-corner .cc-tool-info { flex: 1; min-width: 0; }
  .coris-corner .cc-tool-name {
    font-family: var(--cc-font-head);
    font-size: 1rem;
    font-weight: 700;
    color: var(--cc-ink);
    margin: 0 0 0.2rem;
  }
  .coris-corner .cc-tool-desc {
    font-size: 0.875rem;
    color: var(--cc-ink-mid);
    line-height: 1.45;
    margin: 0;
  }
  .coris-corner .cc-tools-cta-wrap {
    display: flex;
    justify-content: center;
  }

  /* ARCHIVE SECTION */
  .coris-corner .cc-archive-section { background: var(--cc-card-bg); }
  .coris-corner .cc-archive-tagline {
    font-family: var(--cc-font-head);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--cc-ink-mid);
    margin: 0;
  }
  .coris-corner .cc-archive-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .coris-corner .cc-archive-card {
    background: var(--cc-cream);
    border: 1px solid var(--cc-border);
    border-radius: var(--cc-radius);
    overflow: hidden;
    box-shadow: var(--cc-shadow);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.15s ease;
  }
  .coris-corner .cc-archive-card:hover { box-shadow: var(--cc-shadow-hover); }
  .coris-corner .cc-archive-thumb {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    background: var(--cc-cream-mid);
  }
  .coris-corner .cc-archive-card-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
  .coris-corner .cc-archive-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .coris-corner .cc-source-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }
  .coris-corner .cc-badge-blog { background: #e0f2fe; color: #0369a1; }
  .coris-corner .cc-badge-youtube { background: #fee2e2; color: #b91c1c; }
  .coris-corner .cc-badge-tiktok { background: #f0fdf4; color: #15803d; }
  .coris-corner .cc-badge-pinterest { background: #fce7f3; color: #9d174d; }
  .coris-corner .cc-badge-newsletter { background: #f5f3ff; color: #6d28d9; }
  .coris-corner .cc-archive-date {
    font-size: 0.75rem;
    color: var(--cc-ink-light);
  }
  .coris-corner .cc-archive-title {
    font-family: var(--cc-font-head);
    font-size: 1rem;
    font-weight: 600;
    color: var(--cc-ink);
    line-height: 1.3;
    margin: 0;
  }
  .coris-corner .cc-archive-excerpt {
    font-size: 0.875rem;
    color: var(--cc-ink-mid);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .coris-corner .cc-archive-card-footer {
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .coris-corner .cc-btn-sm {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--cc-radius-sm);
    font-size: 0.825rem;
    font-weight: 600;
    font-family: var(--cc-font-body);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s ease;
    background: transparent;
    color: var(--cc-blue);
    border: 1.5px solid var(--cc-blue);
  }
  .coris-corner .cc-btn-sm:hover {
    background: var(--cc-blue);
    color: #fff;
    text-decoration: none;
  }

  /* PAGE FOOTER (small disclosure block, theme footer renders below) */
  .coris-corner .cc-page-footer {
    background: var(--cc-cream-mid);
    border-top: 1px solid var(--cc-border);
    padding-block: 2.5rem;
  }
  .coris-corner .cc-page-footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .coris-corner .cc-footer-hlms-link {
    font-size: 0.95rem;
    color: var(--cc-ink-mid);
    font-weight: 500;
  }
  .coris-corner .cc-footer-hlms-link:hover {
    color: var(--cc-blue);
    text-decoration: underline;
  }
  .coris-corner .cc-footer-disclosure {
    font-size: 0.8rem;
    color: var(--cc-ink-light);
    max-width: 60ch;
    line-height: 1.55;
    margin: 0;
  }

  /* RESPONSIVE - TABLET (min-width: 640px) */
  @media (min-width: 640px) {
    .coris-corner .cc-svg-grid { grid-template-columns: repeat(2, 1fr); }
    .coris-corner .cc-picks-grid { grid-template-columns: repeat(2, 1fr); }
    .coris-corner .cc-tools-grid { grid-template-columns: repeat(2, 1fr); }
    .coris-corner .cc-archive-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* RESPONSIVE - DESKTOP (min-width: 900px) */
  @media (min-width: 900px) {
    .coris-corner { --cc-pad: 2rem; }
    .coris-corner .cc-hero-inner {
      grid-template-columns: 2fr 3fr;
      gap: 4rem;
    }
    .coris-corner .cc-hero-photo { max-width: 340px; }
    .coris-corner .cc-svg-grid { grid-template-columns: repeat(4, 1fr); }
    .coris-corner .cc-method-grid { grid-template-columns: repeat(2, 1fr); }
    .coris-corner .cc-picks-grid { grid-template-columns: repeat(3, 1fr); }
    .coris-corner .cc-tools-grid { grid-template-columns: repeat(4, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .coris-corner { scroll-behavior: auto; }
    .coris-corner .cc-btn,
    .coris-corner .cc-svg-card,
    .coris-corner .cc-pick-card,
    .coris-corner .cc-archive-card,
    .coris-corner .cc-tool-card { transition: none; }
  }
</style>

{%- liquid
  assign discount_code = section.settings.discount_code | default: 'HLMS20'
  assign discount_desc = section.settings.discount_desc | default: '20% off your first order from Ninja Transfers. Applies at checkout.'

  assign hlms_url = 'https://www.heyletsmakestuff.com'
