{%-liquid
  assign ss = section.settings
  assign sb = section.blocks
-%}
{{ 'hp-global.css' | asset_url | stylesheet_tag }}
{{ 'hp-patches-stickers.css' | asset_url | stylesheet_tag }}

<div class="container--large">
  <div class="hpPatchStick">
    <div class="hpPatchStick__header">
      {% if ss.kicker != blank %}
        <div class="hpPatchStick__kicker">{{ ss.kicker }}</div>
      {% endif %}
      {% if ss.heading != blank %}
        <h2 class="hpPatchStick__heading">{{ ss.heading }}</h2>
      {% endif %}
    </div>

    {% if sb.size > 0 %}
      <div class="hpPatchStick__columns">
        {%- for block in sb -%}
          {%- assign b = block.settings -%}
          <div class="hpPatchStick__col" {{ block.shopify_attributes }}>
            <div class="hpPatchStick__col-title">{{ b.title }}</div>
            {% if b.subtitle != blank %}
              <div class="hpPatchStick__col-subtitle">{{ b.subtitle }}</div>
            {% endif %}

            <div class="hpPatchStick__products">
              {% for i in (1..4) %}
                {%- assign img_id = 'product_' | append: i | append: '_image' -%}
                {%- assign name_id = 'product_' | append: i | append: '_name' -%}
                {%- assign price_id = 'product_' | append: i | append: '_price' -%}
                {%- assign url_id = 'product_' | append: i | append: '_url' -%}
                {% if b[name_id] != blank %}
                  <a href="{{ b[url_id] }}" class="hpPatchStick__product">
                    <div class="hpPatchStick__product-image">
                      {% if b[img_id] != blank %}
                        <img
                          src="{{ b[img_id] | image_url: width: 200 }}"
                          alt="{{ b[name_id] | escape }}"
                          loading="lazy"
                          width="{{ b[img_id].width }}"
                          height="{{ b[img_id].height }}"
                        >
                      {% endif %}
                    </div>
                    <div class="hpPatchStick__product-name">{{ b[name_id] }}</div>
                    {% if b[price_id] != blank %}
                      <div class="hpPatchStick__product-price">{{ b[price_id] }}</div>
                    {% endif %}
                  </a>
                {% endif %}
              {% endfor %}
            </div>

            {% if b.cta_text != blank %}
              <a href="{{ b.cta_url }}" class="hpPatchStick__cta">{{ b.cta_text }} →</a>
            {% endif %}
          </div>
        {%- endfor -%}
      </div>
    {% endif %}
  </div>
</div>

{%- capture getStyles -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ ss.bgColor }};
    margin-top: {{ ss.secMarginTop_desktop | append: 'px' }};
    margin-bottom: {{ ss.secMarginBottom_desktop | append: 'px' }};
  }
  #shopify-section-{{ section.id }} .hpPatchStick {
    padding-top: {{ ss.secPaddingTop_desktop | append: 'px' }};
    padding-bottom: {{ ss.secPaddingBottom_desktop | append: 'px' }};
  }
  #shopify-section-{{ section.id }} .hpPatchStick__kicker { color: {{ ss.kickerColor }}; }
  #shopify-section-{{ section.id }} .hpPatchStick__col { background-color: {{ ss.cardBgColor }}; }
  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ ss.secMarginTop_tab | append: 'px' }};
      margin-bottom: {{ ss.secMarginBottom_tab | append: 'px' }};
    }
    #shopify-section-{{ section.id }} .hpPatchStick {
      padding-top: {{ ss.secPaddingTop_tab | append: 'px' }};
      padding-bottom: {{ ss.secPaddingBottom_tab | append: 'px' }};
    }
  }
  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ ss.secMarginTop_mobile | append: 'px' }};
      margin-bottom: {{ ss.secMarginBottom_mobile | append: 'px' }};
    }
    #shopify-section-{{ section.id }} .hpPatchStick {
      padding-top: {{ ss.secPaddingTop_mobile | append: 'px' }};
      padding-bottom: {{ ss.secPaddingBottom_mobile | append: 'px' }};
    }
  }
{%- endcapture -%}
<style>{{ getStyles }}</style>

{% schema %}
{
  "name": "HP - Patches & Stickers",
  "class": "hp-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "EXPAND YOUR PRODUCT LINE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Custom Patches & Stickers" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bgColor", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "kickerColor", "label": "Kicker Color", "default": "#019AFF" },
    { "type": "color", "id": "cardBgColor", "label": "Card Background Color", "default": "#f5f0eb" },
    { "type": "header", "content": "Desktop Spacing" },
    { "type": "range", "id": "secMarginTop_desktop", "label": "Margin Top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "secMarginBottom_desktop", "label": "Margin Bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "secPaddingTop_desktop", "label": "Padding Top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "secPaddingBottom_desktop", "label": "Padding Bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 64 },
    { "type": "header", "content": "Tablet Spacing" },
    { "type": "range", "id": "secMarginTop_tab", "label": "Margin Top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "secMarginBottom_tab", "label": "Margin Bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "secPaddingTop_tab", "label": "Padding Top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "secPaddingBottom_tab", "label": "Padding Bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 48 },
    { "type": "header", "content": "Mobile Spacing" },
    { "type": "range", "id": "secMarginTop_mobile", "label": "Margin Top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "secMarginBottom_mobile", "label": "Margin Bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "secPaddingTop_mobile", "label": "Padding Top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "secPaddingBottom_mobile", "label": "Padding Bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "title", "label": "Column Title", "default": "Custom Patches" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "15+ styles · Heat-press in 20 seconds · As low as $0.84" },
        { "type": "text", "id": "cta_text", "label": "CTA Text", "default": "Shop All Patches" },
        { "type": "url", "id": "cta_url", "label": "CTA URL" },
        { "type": "header", "content": "Product 1" },
        { "type": "image_picker", "id": "product_1_image", "label": "Image" },
        { "type": "text", "id": "product_1_name", "label": "Name", "default": "Embroidered" },
        { "type": "text", "id": "product_1_price", "label": "Price", "default": "From $1.34" },
        { "type": "url", "id": "product_1_url", "label": "URL" },
        { "type": "header", "content": "Product 2" },
        { "type": "image_picker", "id": "product_2_image", "label": "Image" },
        { "type": "text", "id": "product_2_name", "label": "Name", "default": "Full Color" },
        { "type": "text", "id": "product_2_price", "label": "Price", "default": "From $0.84" },
        { "type": "url", "id": "product_2_url", "label": "URL" },
        { "type": "header", "content": "Product 3" },
        { "type": "image_picker", "id": "product_3_image", "label": "Image" },
        { "type": "text", "id": "product_3_name", "label": "Name", "default": "PVC Rubber" },
        { "type": "text", "id": "product_3_price", "label": "Price", "default": "From $1.97" },
        { "type": "url", "id": "product_3_url", "label": "URL" },
        { "type": "header", "content": "Product 4" },
        { "type": "image_picker", "id": "product_4_image", "label": "Image" },
        { "type": "text", "id": "product_4_name", "label": "Name", "default": "Leather" },
        { "type": "text", "id": "product_4_price", "label": "Price", "default": "From $1.22" },
        { "type": "url", "id": "product_4_url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP - Patches & Stickers",
      "blocks": [
        { "type": "column", "settings": { "title": "Custom Patches", "subtitle": "15+ styles · Heat-press in 20 seconds · As low as $0.84", "cta_text": "Shop All Patches", "product_1_name": "Embroidered", "product_1_price": "From $1.34", "product_2_name": "Full Color", "product_2_price": "From $0.84", "product_3_name": "PVC Rubber", "product_3_price": "From $1.97", "product_4_name": "Leather", "product_4_price": "From $1.22" } },
        { "type": "column", "settings": { "title": "Custom Stickers & More", "subtitle": "Vinyl, bumper, magnets & more", "cta_text": "Shop All Stickers", "product_1_name": "Vinyl", "product_1_price": "From $0.22", "product_2_name": "Bumper", "product_2_price": "From $0.42", "product_3_name": "Magnets", "product_3_price": "From $2.88", "product_4_name": "UV Perma", "product_4_price": "From By Size" } }
      ]
    }
  ]
}
{% endschema %}
