    /* ── Dynamic tier price refresh (same as quick-buy popup) ── */
    var _popupCartTotal = 0;
    var _popupRefreshTimer = null;
    function refreshPopupTierPrices() {
      var deltaTotal = 0;
      sizeGrid.querySelectorAll('.nbm-size-input').forEach(function(inp) {
        var newQty = parseInt(inp.value || '0', 10);
        if (isNaN(newQty)) newQty = 0;
        var origQty = parseInt(inp.dataset.originalQty || '0', 10);
        var delta = newQty - origQty;
        var base = parseInt(inp.dataset.basePrice || '0', 10);
        if (base > 0 && delta !== 0) deltaTotal += base * delta;
      });
      var virtualTotal = (_popupCartTotal + deltaTotal) / 100;
      var newLevel = getTierLevel(virtualTotal);
      sizeGrid.querySelectorAll('.nbm-size-input').forEach(function(inp) {
        var tp = inp.dataset.tierPricing;
        if (!tp) return;
        var base = parseInt(inp.dataset.basePrice || '0', 10);
        var tierPrice = getTierPrice(base, tp, newLevel);
        var retailPrice = Math.round(tierPrice * RETAIL_PRICE_MULTIPLIER);
        var cell = inp.parentElement;
        var cmp = cell.querySelector('.nbm-size-compare');
        var pr = cell.querySelector('.nbm-size-price');
        if (!cmp) {
          cmp = document.createElement('div'); cmp.className = 'nbm-size-compare';
          cell.insertBefore(cmp, pr);
          pr.classList.add('nbm-discounted');
        }
        cmp.textContent = money(retailPrice);
        pr.textContent = money(tierPrice);
      });
    }
    function schedulePopupRefresh() {
      if (_popupRefreshTimer) clearTimeout(_popupRefreshTimer);
      _popupRefreshTimer = setTimeout(refreshPopupTierPrices, 200);
    }

    /* ── Build size grid for a given color ── */
    /* Render size cells from a normalized variant array [{id, size, price, compareAtPrice, available}] */
    function renderSizeCells(variants) {
      sizeGrid.innerHTML = '';
      confirmBtn.disabled = true;
      var cartMap = cartVariantMap();

      variants.forEach(function(v) {
        var cartQty = cartMap[String(v.id)] || 0;
        var inCart = cartQty > 0;
        var soldOut = !v.available && !inCart;

        var cell = document.createElement('div');
        cell.className = 'nbm-size-cell';

        var nameEl = document.createElement('div');
        nameEl.className = 'nbm-size-name';
        nameEl.textContent = v.size;
        cell.appendChild(nameEl);

        var inp = document.createElement('input');
        inp.type = 'number';
        inp.className = 'nbm-size-input';
        inp.min = '0';
        inp.dataset.variantId = v.id;
        inp.dataset.basePrice = v.price;
        if (v.tierPricing) inp.dataset.tierPricing = v.tierPricing;
        if (inCart) {
          inp.value = cartQty;
          inp.dataset.originalQty = cartQty;
          inp.classList.add('nbm-has-qty', 'nbm-in-cart');
        } else if (soldOut) {
          inp.value = '';
          inp.placeholder = '';
          inp.disabled = true;
        } else {
          inp.value = '';
          inp.placeholder = '';
        }
        inp.addEventListener('input', function() {
          // Hide "In cart" badge if qty changed from original
          if (inp.dataset.originalQty) {
            var unchanged = (inp.value == inp.dataset.originalQty);
            var badge = inp.parentElement.querySelector('.nbm-size-badge');
            if (badge) badge.style.display = unchanged ? '' : 'none';
            inp.classList.toggle('nbm-in-cart', unchanged);
          }
          updateConfirmState();
          schedulePopupRefresh();
        });
        cell.appendChild(inp);

        /* Price display — use tier pricing (same as quick-buy popup) when available */
        var displayPrice;
        var strikePrice = null;
        if (v.tierPricing) {
          displayPrice = getTierPrice(v.price, v.tierPricing, _tierLevel);
          strikePrice = Math.round(displayPrice * RETAIL_PRICE_MULTIPLIER);
        } else {
          displayPrice = getDiscountedPrice(v.id, v.price);
          if (displayPrice < v.price) strikePrice = v.price;
          else if (v.compareAtPrice && v.compareAtPrice > displayPrice) strikePrice = v.compareAtPrice;
        }
        if (strikePrice && strikePrice > displayPrice) {
          var cmp = document.createElement('div');
          cmp.className = 'nbm-size-compare';
          cmp.textContent = money(strikePrice);
          cell.appendChild(cmp);
          var pr = document.createElement('div');
          pr.className = 'nbm-size-price nbm-discounted';
          pr.textContent = money(displayPrice);
          cell.appendChild(pr);
        } else {
          var pr2 = document.createElement('div');
          pr2.className = 'nbm-size-price';
          pr2.textContent = money(displayPrice);
          cell.appendChild(pr2);
