      // Restore chevron + count for Add a Color
      dropdownTrigger.querySelector('.nbm-chevron').style.display = '';
      dropdownTrigger.style.cursor = 'pointer';
      dropdownTrigger.style.pointerEvents = '';
      colorPreview.style.pointerEvents = '';
      colorCount.style.display = '';
      showLoading();
      showModal();
      refreshCartPriceMap();

      fetchProduct(handle, function(product) {
        _product = product;
        swatchRow.innerHTML = '';
        while (dropdownMenu.children.length > 1) dropdownMenu.removeChild(dropdownMenu.lastChild);
        modal.querySelector('.nbm-box').classList.remove('nbm-dd-open'); dropdownEl.classList.remove('open');

        // Colors already in cart
        var existingColors = {};
        document.querySelectorAll('.nt-blank-group[data-product-handle="' + handle + '"]').forEach(function(g) {
          var key = g.getAttribute('data-group-key') || '';
          var parts = key.split('_');
          if (parts.length > 1) existingColors[parts.slice(1).join('_')] = true;
        });

        // Get ALL color values from product options
        var allColorValues = [];
        product.options.forEach(function(o) {
          var optName = typeof o === 'string' ? o : o.name;
          if (optName && optName.toLowerCase() === 'color') allColorValues = typeof o === 'string' ? [] : (o.values || []);
        });

        // Fetch product page to get hue-ordered colors + exact hex from metafields
        fetchColorData(handle, function(pdpColors) {
          // pdpColors = [{name:'WHITE', hex:'#ffffff'}, ...] in PDP hue order
          // Build ordered color list: PDP order first, then remaining sorted by hue
          // Build variantId map from PDP color data for image lookups
          var colorVariantMap = {};
          pdpColors.forEach(function(pc) { if (pc.variantId) colorVariantMap[pc.name] = pc.variantId; });

          var orderedColors = [];
          var remaining = [];
          var seen = {};
          // Add PDP-ordered colors that exist in product options
          pdpColors.forEach(function(pc) {
            if (seen[pc.name] || !allColorValues.some(function(v) { return v.trim() === pc.name; })) return;
            seen[pc.name] = true;
            orderedColors.push({ name: pc.name, hex: pc.hex });
          });
          // Collect remaining product option colors not in PDP
          allColorValues.forEach(function(c) {
            var cKey = c.trim();
            if (!cKey || seen[cKey]) return;
            seen[cKey] = true;
            remaining.push({ name: cKey, hex: swatchBg(cKey) });
          });
          // Sort remaining by hue (whites/grays first, then warm→cool→pinks/reds)
          if (remaining.length > 0) {
            remaining.forEach(function(c) { c._hsl = hexToHSL(c.hex); });
            remaining.sort(function(a, b) {
              var aS = a._hsl[1], bS = b._hsl[1], aL = a._hsl[2], bL = b._hsl[2], aH = a._hsl[0], bH = b._hsl[0];
              // Neutrals (saturation < 10%) first, sorted light→dark
              if (aS < 10 && bS < 10) return bL - aL;
              if (aS < 10) return -1;
              if (bS < 10) return 1;
              // Chromatic: sort by hue
              return aH - bH;
            });
            orderedColors = orderedColors.concat(remaining);
          }

          // Build swatches (hue order) + dropdown (alphabetical)
          var swatchList = [];
          var ddItems = [];
          orderedColors.forEach(function(colorObj) {
            var cKey = colorObj.name;
