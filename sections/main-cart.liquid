            ddItem.dataset.colorKey = item.name;
            ddItem.innerHTML = '<span class="nbm-dd-dot" style="background:' + item.hex + '"></span>' + titleCase(item.name);
            ddItem.addEventListener('click', function(e) { e.stopPropagation(); item.sw.click(); });
            dropdownMenu.appendChild(ddItem);
          });

          // Set fallback product image
          if (product.featured_image) {
            productImg.src = product.featured_image.replace(/(\.\w+)(\?|$)/, '_300x$1$2');
            productImg.alt = product.title;
          }
          colorCount.textContent = swatchRow.children.length + ' colors';
          var first = swatchRow.querySelector('.nbm-swatch');
          if (first) first.click();
          showContent();
          setTimeout(updateScrollArrows, 50);
        });
      });
    }

    /* Fetch color order + hex values from the product page (same source as upsell popup) */
    var _colorDataCache = {};
    function fetchColorData(handle, cb) {
      if (_colorDataCache[handle]) { cb(_colorDataCache[handle]); return; }
      fetch('/products/' + handle)
        .then(function(r) { return r.text(); })
        .then(function(html) {
          var parser = new DOMParser();
          var doc = parser.parseFromString(html, 'text/html');
          var pills = doc.querySelectorAll('.grt-pdp-color-pill');
          var colors = [];
          pills.forEach(function(pill) {
            var name = pill.title || '';
            if (!name) return;
            var chip = pill.querySelector('.grt-pdp-color-pill__chip');
            var hex = '#ccc';
            if (chip) {
              var style = chip.getAttribute('style') || '';
              var m = style.match(/background-color:\s*([^;]+)/i) || style.match(/background:\s*([^;]+)/i);
              if (m) hex = m[1].trim();
            }
            var vid = pill.getAttribute('data-pdp-color-variant-id') || '';
            colors.push({ name: name.trim(), hex: hex, variantId: vid });
          });
          _colorDataCache[handle] = colors;
          cb(colors);
        })
        .catch(function() { cb([]); });
    }

    function fetchProduct(handle, cb) {
      fetch('/products/' + handle + '.js')
        .then(function(r) { return r.json(); })
        .then(function(data) { try { cb(data); } catch(e) { console.error('Blank modal error:', e); showContent(); showError(e.message); } })
        .catch(function() { showContent(); showError('Could not load product data.'); });
    }

    /* ── Confirm: collect changed sizes ── */
    confirmBtn.addEventListener('click', function() {
      var addItems = [];
      var updateMap = {}; /* line_key → new_qty — keyed by line key, NOT variant ID */
      var hasChange = false;
      sizeGrid.querySelectorAll('.nbm-size-input').forEach(function(inp) {
        var qty = parseInt(inp.value) || 0;
        var orig = parseInt(inp.dataset.originalQty) || 0;
        var vid = inp.dataset.variantId;
        if (!vid || qty === orig) return;
        hasChange = true;
        if (orig > 0) {
          /* Existing — distribute new qty across all lines for this variant,
             preserving any promo-tagged lines (free-item allocations etc.) */
          distributeVariantQty(vid, qty, updateMap);
        } else if (qty > 0) {
          /* New item — add to cart */
          addItems.push({ id: parseInt(vid), quantity: qty });
        }
      });
      if (!hasChange) { showError('No changes to save.'); return; }
      confirmBtn.disabled = true;
      confirmBtn.textContent = 'Updating';
      confirmBtn.classList.add('nt-updating');
      modal.querySelector('.nbm-box').classList.add('nt-modal-updating');

      /* Single batch update via /cart/update.js (accepts line_key → qty map) */
      var chain = Promise.resolve();
      if (Object.keys(updateMap).length > 0) {
        chain = chain.then(function() {
          return fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ updates: updateMap })
          });
        });
      }
      if (addItems.length > 0) {
        chain = chain.then(function() {
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: addItems })
          });
        });
      }
      chain
      .then(function() {
        // Keep modal open with "Updating…" until page reloads
        var isDrawer = document.querySelector('sidebar-drawer#site-cart-sidebar.sidebar--opened');
        if (isDrawer && window.refreshCart) { window.refreshCart(); hideModal(); } else { location.reload(); }
      })
      .catch(function() {
        confirmBtn.disabled = false;
        confirmBtn.textContent = _mode === 'size' ? 'Update' : 'Add to Cart';
        confirmBtn.classList.remove('nt-updating');
        modal.querySelector('.nbm-box').classList.remove('nt-modal-updating');
        showError('Failed to add item. Please try again.');
      });
    });

    /* ── Delegate click handlers ── */
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.nt-blank-add-size-btn');
      if (btn) { e.preventDefault(); openAddSize(btn.dataset.productHandle, btn.dataset.color); return; }
      btn = e.target.closest('.nt-blank-add-color-btn');
      if (btn) { e.preventDefault(); openAddColor(btn.dataset.productHandle); return; }
    });
  })();
</script>

