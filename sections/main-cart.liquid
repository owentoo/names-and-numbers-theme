    /* ── Add Color ── */
    function openAddColor(handle) {
      _mode = 'color';
      titleEl.textContent = 'Add a Color';
      confirmBtn.textContent = 'Add to Cart';
      colorLabel.style.display = 'none';
      swatchWrap.style.display = 'block';
