  {%- comment -%}                                                                                                                                                                                                       Gang Sheet Builder → cart-add bridge.
    The new gang sheet builder (ninja-gangsheet-builder) cannot call /cart/add.js                                                                                                                                       from its App Proxy URL in a way that triggers Shopify's product_added_to_cart                                                                                                                                   
    event — fetch isn't hooked by shop_events_listener, and the App Proxy URL
    doesn't load the listener at all. So instead, the builder writes the cart
    line items to sessionStorage and redirects to /cart. This snippet drains the
    stash on /cart load and performs the actual XHR /cart/add.js — which IS
    hooked by Shopify's listener, so product_added_to_cart auto-publishes
    natively to every subscribed pixel (Klaviyo, Meta, etc.) just as it would
    for a normal product page add.
  {%- endcomment -%}
  <script>
    (function() {
      try {
        var raw = sessionStorage.getItem('__gs_pending_added_to_cart');
        if (!raw) return;
        sessionStorage.removeItem('__gs_pending_added_to_cart');
        var payload = JSON.parse(raw);
        if (!payload || !payload.items || !payload.items.length) return;
        if ((Date.now() - payload.ts) > 60000) return;

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '/cart/add.js', true);
        xhr.setRequestHeader('Content-Type', 'application/json');
        xhr.setRequestHeader('Accept', 'application/json');
        xhr.onload = function() {
          if (xhr.status >= 200 && xhr.status < 300) {
            // Reload /cart so the just-added line items render in the cart UI.
            // Use replace() so the user can't Back-button into the pre-add state.
            window.location.replace(window.location.pathname + window.location.search);
          } else {
            console.warn('[gs-cart-bridge] /cart/add.js failed', xhr.status, xhr.responseText);
          }
        };
        xhr.onerror = function() {
          console.warn('[gs-cart-bridge] /cart/add.js network error');
        };
        xhr.send(JSON.stringify({ items: payload.items }));
      } catch (e) {
        console.warn('[gs-cart-bridge] error', e);
      }
    })();
  </script>