  .nbm-color-label-swatch { display:block; width:32px; height:32px; min-width:32px; min-height:32px; border-radius:6px; flex-shrink:0; border:1px solid rgba(0,0,0,0.08); }
  /* Color picker header */
  .nbm-color-header { display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem; padding-bottom:0.75rem; border-bottom:1px solid #eee; }
