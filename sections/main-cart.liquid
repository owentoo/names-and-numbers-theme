<div class="mobile-sticky-cart-sentinel" id="MobileStickyCartSentinel"></div>

<script>
(function() {
  var stickyBar = document.getElementById('MobileStickyCart');
  var sentinel = document.getElementById('MobileStickyCartSentinel');
  if (!stickyBar || !sentinel) return;

  // Hide sticky bar when sentinel (natural subtotal position) is in view
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
        stickyBar.classList.add('is-hidden');
      } else {
        stickyBar.classList.remove('is-hidden');
      }
    });
  }, { rootMargin: '0px 0px -80px 0px', threshold: 0 });
  observer.observe(sentinel);

  // Scroll-aware compact/full mode (collapse on scroll down, expand on scroll up)
  var lastScrollY = window.scrollY;
  var scrollThreshold = 10;
  window.addEventListener('scroll', function() {
    if (stickyBar.classList.contains('is-hidden')) return;
    var currentScrollY = window.scrollY;
    var delta = currentScrollY - lastScrollY;
    if (Math.abs(delta) < scrollThreshold) return;
    if (delta > 0 && currentScrollY > 100) {
      stickyBar.classList.add('is-compact');
    } else {
      stickyBar.classList.remove('is-compact');
    }
    lastScrollY = currentScrollY;
  }, { passive: true });

  // Mirror values from the real (page) cart subtotal into the sticky clone.
  var realSavings      = document.getElementById('_total_saving');
  var realMoney        = document.getElementById('moneySaved');
  var realRewardMoney  = document.getElementById('reward_money');
  var realRewardBlock  = document.getElementById('cart_reward-point-block');
  var realToggle       = document.getElementById('cart-gift-wrapping');

  var mSavings      = document.getElementById('MobileStickySavings');
  var mMoney        = document.getElementById('MobileStickyMoneySaved');
  var mRewardMoney  = document.getElementById('MobileStickyRewardMoney');
  var mRewardBlock  = document.getElementById('MobileStickyRewardBlock');
  var mRewardInfo   = document.getElementById('MobileStickyRewardInfo');
  var mToggle       = document.getElementById('MobileStickyJtlToggle');

  function realRewardInfo() {
    return realRewardBlock ? realRewardBlock.querySelector('#__reward_info') : null;
  }

  function mirror() {
    realToggle = document.getElementById('cart-gift-wrapping');
    realMoney = document.getElementById('moneySaved');
    realRewardMoney = document.getElementById('reward_money');
    if (realSavings && mSavings) mSavings.innerHTML = realSavings.innerHTML;
    if (realMoney && mMoney) {
      mMoney.value = realMoney.value || '';
      mMoney.setAttribute('data', realMoney.getAttribute('data') || '');
    }
    if (realRewardMoney && mRewardMoney) {
      mRewardMoney.value = realRewardMoney.value || '';
    }
    var src = realRewardInfo();
    if (src && mRewardInfo) mRewardInfo.innerHTML = src.innerHTML;
    if (realRewardBlock && mRewardBlock) {
      var visible = getComputedStyle(realRewardBlock).display !== 'none';
      mRewardBlock.style.display = visible ? 'flex' : 'none';
    }
    if (realToggle && mToggle) mToggle.checked = realToggle.checked;
    var cents = realMoney ? (parseInt(realMoney.getAttribute('data')) || 0) : 0;
    var mSavingsRow = mSavings ? mSavings.closest('.cart-saving-row') : null;
    if (mSavingsRow) mSavingsRow.style.display = cents > 0 ? 'flex' : 'none';
    // Keep compact checkout button total in sync
    var compactTotal = document.getElementById('MobileStickyCompactBtn');
    if (compactTotal) {
      var totalEl = compactTotal.querySelector('.mobile-sticky-cart__compact-total');
      var realTotal = document.querySelector('.cart__total strong:last-child');
      if (totalEl && realTotal) totalEl.textContent = realTotal.textContent.trim();
    }
    var rs = document.querySelector('#AjaxCartSubtotal .cart-subtotal-value');
    var ms = document.getElementById('MobileStickySubtotal');
    if (rs && ms) ms.textContent = rs.textContent;
  }

  if (mToggle) {
    mToggle.addEventListener('change', function() {
      var rt = document.getElementById('cart-gift-wrapping');
      if (rt) rt.click();
    });
  }
  var cf = document.getElementById('AjaxCartForm');
  if (cf) cf.addEventListener('cart-updated', function() { setTimeout(mirror, 0); });
  document.addEventListener('cart:updated', function() { setTimeout(mirror, 0); });
  document.addEventListener('cart-updated', function() { setTimeout(mirror, 0); });
  if ('MutationObserver' in window) {
    var mo = new MutationObserver(function() { mirror(); });
    if (realSavings)     mo.observe(realSavings,     { childList: true, characterData: true, subtree: true });
    if (realRewardBlock) mo.observe(realRewardBlock, { childList: true, characterData: true, subtree: true, attributes: true, attributeFilter: ['style'] });
  }
  mirror();
  setTimeout(mirror, 250);
  setTimeout(mirror, 1000);
})();
</script>

<script>
(function() {
  var target = document.querySelector('.nt-share-target');
  if (!target) return;

  // Relocates Bevy Share Cart's app-injected .share_cart_wrap
  // into the cart header row. Brittle: depends on the app's
  // class names (.share_cart_wrap) staying stable. If the app
  // updates its markup, this silently stops working.
  function moveShareCart() {
    var all = document.querySelectorAll('.share_cart_wrap');
    if (all.length === 0) return;
    var fresh = null;
    for (var i = all.length - 1; i >= 0; i--) {
      if (!target.contains(all[i])) { fresh = all[i]; break; }
    }
    if (!fresh) return;
    target.innerHTML = '';
    target.appendChild(fresh);
    document.querySelectorAll('.share_cart_wrap').forEach(function(el) {
      if (!target.contains(el)) el.remove();
    });
  }

  moveShareCart();

  var cartForm = document.getElementById('AjaxCartForm');
  if (cartForm && 'MutationObserver' in window) {
    new MutationObserver(moveShareCart).observe(cartForm, { childList: true, subtree: true });
  }

  document.addEventListener('change', function(e) {
    if (e.target && (e.target.id === 'cart-gift-wrapping' || e.target.id === 'MobileStickyJtlToggle') && e.target.checked) {
      var card = e.target.closest('.nt-jtl-card');
      if (card) {
        card.classList.add('jtl-flashing');
        setTimeout(function() { card.classList.remove('jtl-flashing'); }, 3000);
      }
    }
  });
})();
</script>

