  .nbm-dropdown-item { display:flex; align-items:center; gap:0.75rem; padding:12px 14px; cursor:pointer; border-radius:8px; transition:background .1s; font-size:15px; color:#333; }
  .nbm-dropdown-item:hover { background:#f3f3f3; }
  .nbm-dropdown-item.nbm-dd-active { background:#f0f0f0; font-weight:600; color:#111; }
  .nbm-dropdown-item .nbm-dd-dot { width:28px; height:28px; border-radius:6px; flex-shrink:0; border:1px solid rgba(0,0,0,0.06); }
  /* Color swatches — mobile scroll style */
  /* Color swatch row with overflow hint + arrows */
  .nbm-swatch-scroll { position:relative; margin-bottom:8px; }
  .nbm-swatches { display:flex; overflow-x:auto; gap:6px; padding:6px 4px 14px; -webkit-overflow-scrolling:touch; scrollbar-width:thin; scroll-behavior:smooth; }
  .nbm-swatches::-webkit-scrollbar { height:4px; }
  .nbm-swatches::-webkit-scrollbar-thumb { background:#ccc; border-radius:2px; }
  /* Fade hints on edges */
  .nbm-swatch-scroll::before,
  .nbm-swatch-scroll::after { content:''; position:absolute; top:0; bottom:14px; width:24px; z-index:10; pointer-events:none; }
  .nbm-swatch-scroll::before { left:0; background:linear-gradient(to right, #fff 0%, transparent 100%); opacity:0; }
  .nbm-swatch-scroll::after { right:0; background:linear-gradient(to left, #fff 0%, transparent 100%); }
  .nbm-swatch-scroll.nbm-scroll-start::before { opacity:0; }
  .nbm-swatch-scroll.nbm-scroll-end::after { opacity:0; }
  .nbm-swatch-scroll:not(.nbm-scroll-start)::before { opacity:1; }
  /* Arrow buttons */
  .nbm-scroll-btn { position:absolute; top:50%; transform:translateY(calc(-50% - 4px)); z-index:11; width:34px; height:34px; border-radius:50%; background:#fff; border:1px solid rgba(0,0,0,0.12); box-shadow:0 2px 6px rgba(0,0,0,0.12); cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .nbm-scroll-btn:hover { background:#f5f5f5; }
  .nbm-scroll-btn.nbm-scroll-left { left:-4px; }
  .nbm-scroll-btn.nbm-scroll-right { right:-4px; }
  .nbm-scroll-btn.nbm-hidden { display:none; }
  .nbm-swatch { flex-shrink:0; width:36px; height:36px; border-radius:8px; cursor:pointer; border:none; position:relative; transition:transform .15s ease; background-size:cover; background-position:center; }
  .nbm-swatch::after { content:''; position:absolute; inset:0; border-radius:8px; border:2px solid var(--ring,#888); opacity:0; transition:opacity .15s ease; pointer-events:none; }
  .nbm-swatch:hover { transform:scale(1.1); z-index:20; }
  .nbm-swatch.nbm-selected::after { opacity:1; }
  .nbm-swatch.nbm-selected { transform:scale(1.1); z-index:2; }
  .nbm-swatch.nbm-light { box-shadow:inset 0 0 0 1px rgba(0,0,0,0.06); }
  /* Size grid */
  .nbm-sizes { display:grid; grid-template-columns:repeat(5, 1fr); gap:12px 8px; margin-bottom:4px; min-height:180px; align-content:start; }
  /* Skeleton loader */
  @keyframes nbm-shimmer { 0% { background-position:200% 0; } 100% { background-position:-200% 0; } }
  .nbm-skeleton { border-radius:10px; background:linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%); background-size:200% 100%; animation:nbm-shimmer 1.5s ease infinite; }
  .nbm-skeleton-label { height:12px; width:30px; margin:0 auto 6px; }
  .nbm-skeleton-input { height:44px; }
  .nbm-skeleton-price { height:12px; width:40px; margin:6px auto 0; }
  @media (max-width:400px) { .nbm-sizes { grid-template-columns:repeat(4, 1fr); } }
  .nbm-size-cell { text-align:center; }
