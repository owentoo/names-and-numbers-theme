  {%- comment -%}
    Gang Sheet Builder bridge — early hide.
    If a gang sheet add is pending in sessionStorage, hide the cart UI and
    show a loader while the bottom-of-file bridge does the XHR add and reloads.
    Without this, customers briefly see the pre-add cart state (often empty
    or missing the gang sheet they just clicked Add on).
  {%- endcomment -%}
  <script>
    (function() {
      try {
        if (!sessionStorage.getItem('__gs_pending_added_to_cart')) return;
        document.documentElement.style.visibility = 'hidden';
        function showLoader() {
          if (document.getElementById('gs-bridge-loader')) return;
          var loader = document.createElement('div');
          loader.id = 'gs-bridge-loader';
          loader.setAttribute('style',
            'position:fixed;inset:0;background:#fff;display:flex;' +
            'align-items:center;justify-content:center;z-index:2147483647;' +
            'font-family:system-ui,-apple-system,sans-serif;color:#333;' +
            'visibility:visible !important;font-size:15px;'
          );
          loader.textContent = 'Adding your gang sheet to cart…';
          document.body.appendChild(loader);
        }
        if (document.body) showLoader();
        else document.addEventListener('DOMContentLoaded', showLoader);
      } catch (e) {}
    })();
  </script>

