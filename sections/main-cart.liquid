  .nbm-size-price { font-size:12px; font-weight:600; color:#111; margin-top:2px; }
  .nbm-size-price.nbm-discounted { color:#111; }
  .nbm-size-compare + .nbm-size-price { margin-top:0; }
  /* Shared modal footer buttons — used by design edit + blank add/edit */
  .nt-modal-footer { display:flex; gap:10px; padding:16px 20px 20px; border-top:1px solid #eee; margin-top:auto; }
  .nt-modal-cancel { flex:1; padding:11px; border:1.5px solid #ddd; border-radius:8px; background:#fff; color:#333; font-size:14px; font-weight:500; cursor:pointer; font-family:inherit; }
  .nt-modal-confirm { flex:2; padding:11px; border:none; border-radius:8px; background:#019AFF; color:#fff; font-size:14px; font-weight:600; cursor:pointer; font-family:inherit; touch-action:manipulation; }
  .nt-modal-confirm:disabled { opacity:0.5; cursor:default; }
  /* Updating dots animation */
  @keyframes nbm-dots { 0% { content:''; } 25% { content:'.'; } 50% { content:'..'; } 75% { content:'...'; } }
  .nt-modal-confirm.nt-updating { pointer-events:none; }
  .nt-modal-confirm.nt-updating::after { content:''; animation:nbm-dots 1.2s steps(1) infinite; }
  .nt-modal-updating input, .nt-modal-updating select, .nt-modal-updating button:not(.nt-modal-confirm) { pointer-events:none !important; opacity:0.5; }
  .nbm-error { color:#e53935; font-size:13px; margin-top:8px; display:none; }
  .nbm-loading { text-align:center; padding:24px 0; color:#888; }
</style>
