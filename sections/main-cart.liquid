<script>
  function updateCartItemCount() {
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        const titleElement = document.querySelector('.title.heading-size--page-title');
        titleElement.innerHTML = `{{ 'cart.title' | t }} <span class="nt-cart-count">(${cart.item_count} items)</span>`;
      })
      .catch(error => console.error('Error fetching cart:', error));
  }
  document.addEventListener('DOMContentLoaded', function() {

    updateCartItemCount();
    var cartForm = document.querySelector('cart-form');
    if (cartForm) {
      cartForm.addEventListener('cart-updated', function() {
        updateCartItemCount();
      });
    }

  });

  /* Blanks cart row patcher moved to global blanks-price-patcher.js (loaded from theme.liquid) */

  /* ── Blank apparel: Add Size / Add Color modal ── */
  (function() {
    'use strict';
    var modal = document.getElementById('nt-blank-modal');
    if (!modal) return;
    var _fileBase = modal.dataset.fileBase || '/cdn/shop/files/';

    var $  = function(id) { return document.getElementById(id); };
    var titleEl   = $('nbm-title');
    var loadingEl = $('nbm-loading');
    var contentEl = $('nbm-content');
    var colorLabel= $('nbm-color-label');
    var swatchWrap= $('nbm-swatch-wrap');
    var swatchRow = $('nbm-swatches');
    var colorNameEl = $('nbm-color-name');
    var colorPreview = $('nbm-color-preview');
    var colorCount  = $('nbm-color-count');
    var dropdownEl  = $('nbm-dropdown');
    var dropdownTrigger = $('nbm-dropdown-trigger');
    var dropdownMenu = $('nbm-dropdown-menu');
    var productImgWrap = $('nbm-product-img-wrap');

    // Dropdown toggle
    dropdownTrigger.addEventListener('click', function(e) { e.stopPropagation(); modal.querySelector('.nbm-box').classList.toggle('nbm-dd-open'); dropdownEl.classList.toggle('open'); });

    // Swatch scroll arrows
    var scrollWrap = $('nbm-swatch-scroll');
    var scrollLeft = $('nbm-scroll-left');
    var scrollRight = $('nbm-scroll-right');
    function updateScrollArrows() {
      var s = swatchRow;
      var atStart = s.scrollLeft <= 4;
      var atEnd = s.scrollLeft + s.clientWidth >= s.scrollWidth - 4;
      var hasOverflow = s.scrollWidth > s.clientWidth + 4;
      scrollLeft.classList.toggle('nbm-hidden', atStart || !hasOverflow);
      scrollRight.classList.toggle('nbm-hidden', atEnd || !hasOverflow);
      scrollWrap.classList.toggle('nbm-scroll-start', atStart);
      scrollWrap.classList.toggle('nbm-scroll-end', atEnd);
    }
    swatchRow.addEventListener('scroll', updateScrollArrows);
    scrollLeft.addEventListener('click', function() { swatchRow.scrollBy({left: -140, behavior: 'smooth'}); });
    scrollRight.addEventListener('click', function() { swatchRow.scrollBy({left: 140, behavior: 'smooth'}); });
    $('nbm-dd-close-btn').addEventListener('click', function(e) { e.stopPropagation(); modal.querySelector('.nbm-box').classList.remove('nbm-dd-open'); dropdownEl.classList.remove('open'); });
    var productImg = $('nbm-product-img');
    var sizeGrid  = $('nbm-sizes');
    var confirmBtn= $('nbm-confirm');
    var errorEl   = $('nbm-error');

    var _product = null;
    var _mode = '';
    var _selectedColor = '';

    function money(c) { return '$' + (c / 100).toFixed(2); }
    var RETAIL_PRICE_MULTIPLIER = 1.96;
    var _tierLevel = 0;
    function parseTierPricing(raw) {
      if (!raw) return [];
      var s = String(raw).trim(); if (!s) return [];
      try { var p = JSON.parse(s); if (Array.isArray(p)) s = p.join(','); } catch(e){}
      return s.split(',').map(function(v){return parseInt(v.trim(),10);}).filter(function(n){return n>0;});
    }
    function getTierLevel(dollars) {
      if (dollars>=3800) return 7; if (dollars>=1750) return 6; if (dollars>=1000) return 5;
      if (dollars>=500) return 4; if (dollars>=250) return 3; if (dollars>=150) return 2;
      if (dollars>=99) return 1; return 0;
    }
    function getTierPrice(base, raw, level) {
      var t = parseTierPricing(raw);
      if (level>0 && t.length>=level) return t[level-1];
      return base;
    }
    function titleCase(s) { return s.toLowerCase().replace(/\b\w/g, function(c) { return c.toUpperCase(); }); }
    function parseHex(hex) { var h = hex.replace('#',''); if (h.length===3) h=h[0]+h[0]+h[1]+h[1]+h[2]+h[2]; return [parseInt(h.slice(0,2),16),parseInt(h.slice(2,4),16),parseInt(h.slice(4,6),16)]; }
    function hexToHSL(hex) {
      try { var rgb = parseHex(hex); } catch(e) { return [0,0,50]; }
      var r=rgb[0]/255,g=rgb[1]/255,b=rgb[2]/255,mx=Math.max(r,g,b),mn=Math.min(r,g,b),h=0,s=0,l=(mx+mn)/2;
      if(mx!==mn){var d=mx-mn;s=l>0.5?d/(2-mx-mn):d/(mx+mn);if(mx===r)h=((g-b)/d+(g<b?6:0))/6;else if(mx===g)h=((b-r)/d+2)/6;else h=((r-g)/d+4)/6;}
      return [Math.round(h*360),Math.round(s*100),Math.round(l*100)];
    }
    function lum(rgb) { return rgb[0]*0.299+rgb[1]*0.587+rgb[2]*0.114; }
    function isLight(hex) { return lum(parseHex(hex)) > 210; }
    function ringColor(hex) {
      var rgb = parseHex(hex); var l = lum(rgb);
      if (l > 100) { var f=0.4; return 'rgb('+Math.round(rgb[0]*f)+','+Math.round(rgb[1]*f)+','+Math.round(rgb[2]*f)+')'; }
      else { var f=0.55; return 'rgb('+Math.min(255,Math.round(rgb[0]+(255-rgb[0])*f))+','+Math.min(255,Math.round(rgb[1]+(255-rgb[1])*f))+','+Math.min(255,Math.round(rgb[2]+(255-rgb[2])*f))+')'; }
    }

    function showModal() { modal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
    function hideModal() { modal.style.display = 'none'; document.body.style.overflow = ''; _product = null; confirmBtn.disabled = true; confirmBtn.textContent = 'Add to Cart'; confirmBtn.classList.remove('nt-updating'); modal.querySelector('.nbm-box').classList.remove('nt-modal-updating'); }
    function showLoading() { loadingEl.style.display = 'block'; contentEl.style.display = 'none'; errorEl.style.display = 'none'; }
    function showContent() { loadingEl.style.display = 'none'; contentEl.style.display = 'block'; errorEl.style.display = 'none'; }
    function showError(m) { errorEl.textContent = m; errorEl.style.display = 'block'; }

    $('nbm-backdrop').addEventListener('click', hideModal);
    $('nbm-close').addEventListener('click', hideModal);
    $('nbm-cancel').addEventListener('click', hideModal);

    function optIdx(product, name) {
      for (var i = 0; i < product.options.length; i++) {
        var n = typeof product.options[i] === 'string' ? product.options[i] : product.options[i].name;
        if (n && n.toLowerCase() === name.toLowerCase()) return i + 1;
      }
      return -1;
    }

    /* Sums qtys across ALL cart lines for each variant. Handles the case where
       a promo splits one variant into multiple lines (e.g. 95 untagged + 5 tagged FREE) */
    function cartVariantMap() {
      var map = {};
      Object.keys(_cartLinesByVariant).forEach(function(vid) {
        map[vid] = _cartLinesByVariant[vid].reduce(function(s, l) { return s + l.qty; }, 0);
      });
      return map;
    }

    /* Cart price map: variant_id → discounted per-unit price (cents) from /cart.js */
    var _cartPriceMap = {};
    /* Per-product discount ratio: product_id → ratio (final/original) from in-cart items */
    var _productRatioMap = {};
    /* variant_id → product_id lookup */
    var _variantProductMap = {};
    /* variant_id → [{key, qty, tagged}] — stores ALL lines per variant so we can
       distribute qty updates across promo-split lines instead of blindly overwriting one. */
    var _cartLinesByVariant = {};
    function refreshCartPriceMap(cb) {
      /* ── Shared cart cache: reuse a recent patcher fetch if available ── */
      var CACHE_TTL_MS = 2000;
      var cached = window.__ntCartCache;
      var cartPromise;
      if (cached && cached.data && (Date.now() - cached.ts) < CACHE_TTL_MS) {
        cartPromise = Promise.resolve(cached.data);
      } else {
        cartPromise = fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
          if (cart) window.__ntCartCache = { data: cart, ts: Date.now() };
          return cart;
        });
      }
      cartPromise.then(function(cart) {
        _popupCartTotal = cart.total_price || 0;
        _tierLevel = getTierLevel(_popupCartTotal / 100);
        _cartPriceMap = {};
        _productRatioMap = {};
        _variantProductMap = {};
        _cartLinesByVariant = {};
        cart.items.forEach(function(item) {
          var vid = String(item.variant_id);
          var hasDisc = (item.line_level_discount_allocations || []).length > 0;
          /* Prefer untagged line's price for display (full/normal price) */
          if (_cartPriceMap[vid] === undefined || !hasDisc) _cartPriceMap[vid] = item.final_price;
          _variantProductMap[vid] = String(item.product_id);
          if (!_cartLinesByVariant[vid]) _cartLinesByVariant[vid] = [];
          _cartLinesByVariant[vid].push({ key: item.key, qty: item.quantity, tagged: hasDisc });
          /* Build per-product ratio from discounted items */
          if (item.original_price > 0 && item.final_price < item.original_price) {
            var pid = String(item.product_id);
            var ratio = item.final_price / item.original_price;
            if (!_productRatioMap[pid] || ratio < _productRatioMap[pid]) {
              _productRatioMap[pid] = ratio;
            }
          }
        });
        if (cb) cb();
      }).catch(function() { if (cb) cb(); });
    }

    /* Distribute a new total qty for a variant across its existing cart lines,
       preserving promo-tagged lines (the ones the free-item promo has claimed).
       Returns an updateMap of line_key → new_qty for POST to /cart/update.js. */
    function distributeVariantQty(variantId, newQty, updateMap) {
      var lines = _cartLinesByVariant[String(variantId)] || [];
      var tagged = lines.filter(function(l) { return l.tagged; });
      var untagged = lines.filter(function(l) { return !l.tagged; });
      var taggedTotal = tagged.reduce(function(s, l) { return s + l.qty; }, 0);
      if (newQty >= taggedTotal) {
        /* Keep all promo-tagged lines intact; first untagged line absorbs the remainder */
        tagged.forEach(function(l) { updateMap[l.key] = l.qty; });
        var remainder = newQty - taggedTotal;
        if (untagged.length > 0) {
          updateMap[untagged[0].key] = remainder;
          for (var i = 1; i < untagged.length; i++) updateMap[untagged[i].key] = 0;
        }
      } else {
        /* newQty < taggedTotal: zero all untagged, then reduce tagged lines */
        untagged.forEach(function(l) { updateMap[l.key] = 0; });
        var rem = newQty;
        for (var j = 0; j < tagged.length; j++) {
          if (rem >= tagged[j].qty) { updateMap[tagged[j].key] = tagged[j].qty; rem -= tagged[j].qty; }
          else { updateMap[tagged[j].key] = rem; rem = 0; }
        }
      }
    }

