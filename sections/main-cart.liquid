          badge.textContent = 'In cart';
          cell.appendChild(badge);
        } else if (soldOut) {
          var badge2 = document.createElement('div');
          badge2.className = 'nbm-size-badge';
          badge2.textContent = 'Sold out';
          cell.appendChild(badge2);
        }

        sizeGrid.appendChild(cell);
      });

      // Empty state
      if (sizeGrid.children.length === 0) {
        var empty = document.createElement('div');
        empty.style.cssText = 'grid-column:1/-1; text-align:center; padding:16px 0; color:#888; font-size:13px;';
        empty.innerHTML = 'No sizes available for this color.<br><a href="/products/' + (_product ? _product.handle : '') + '" style="color:#019AFF;font-weight:600;">View product page</a>';
        sizeGrid.appendChild(empty);
      }
    }

    /* ── Data tier 1: get_handle Liquid view (same as upsell popup) ── */
    function variantsFromGetHandle(handle, color, cb) {
      fetch('/products/' + handle + '?view=get_handle&variant=' + encodeURIComponent(color))
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var html = data.sizes || '';
          if (!html || html.length < 20) { cb([]); return; }
          var parser = new DOMParser();
          var doc = parser.parseFromString('<div>' + html + '</div>', 'text/html');
          var inputs = doc.querySelectorAll('input.itemQuantity');
          var result = [];
          inputs.forEach(function(inp) {
            var label = (inp.getAttribute('data-label') || '').trim();
            var parts = label.split(' / ');
            var price = parseInt(inp.getAttribute('data-price')) || 0;
            result.push({
              id: inp.getAttribute('data-id'),
              size: parts[1] || parts[0] || label,
              price: price,
              compareAtPrice: null,
              available: true
            });
          });
          cb(result);
        })
        .catch(function() { cb([]); });
    }

    /* ── Data tier 2: Storefront API with pagination (for 250+ variant products) ── */
    var _sfToken = 'f0da551a7e5dc4391d942f1bd786e8b9';
    var _sfCache = {};
    function variantsFromStorefrontApi(handle, color, cb) {
      if (_sfCache[handle]) { cb(filterByColor(_sfCache[handle], color)); return; }
      var all = [];
      function fetchPage(cursor) {
        var afterClause = cursor ? ', after:"' + cursor + '"' : '';
        var query = '{ product(handle: "' + handle + '") { variants(first:250' + afterClause + ') { pageInfo { hasNextPage endCursor } edges { node { id title availableForSale selectedOptions { name value } price { amount } compareAtPrice { amount } metafield(namespace:"custom", key:"tier_pricing") { value } } } } } }';
        fetch('https://transferss.myshopify.com/api/2025-01/graphql.json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Shopify-Storefront-Access-Token': _sfToken },
          body: JSON.stringify({ query: query })
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.data || !d.data.product) { cb([]); return; }
          var variants = d.data.product.variants;
          variants.edges.forEach(function(e) {
            var n = e.node;
            var vc = '', vs = '';
            n.selectedOptions.forEach(function(o) { if (o.name === 'Color') vc = o.value; if (o.name === 'Size') vs = o.value; });
            all.push({ id: n.id.replace('gid://shopify/ProductVariant/', ''), size: vs, color: vc, price: Math.round(parseFloat(n.price.amount) * 100), compareAtPrice: n.compareAtPrice ? Math.round(parseFloat(n.compareAtPrice.amount) * 100) : null, available: n.availableForSale, tierPricing: n.metafield ? n.metafield.value : null });
          });
          if (variants.pageInfo.hasNextPage) fetchPage(variants.pageInfo.endCursor);
          else { _sfCache[handle] = all; cb(filterByColor(all, color)); }
        })
        .catch(function() { cb([]); });
      }
      fetchPage(null);
    }
    function filterByColor(variants, color) {
      return variants.filter(function(v) { return v.color === color.trim(); });
    }

    /* ── Main entry: get_handle → Storefront API → empty state ── */
    function buildSizeGrid(color) {
      _selectedColor = color;
      var handle = _product ? _product.handle : '';
      if (!handle) { renderSizeCells([]); return; }
      // Lock grid height to prevent layout shift
      var curH = sizeGrid.offsetHeight;
      if (curH > 0) sizeGrid.style.minHeight = curH + 'px';
      // Show skeleton loader matching the size grid layout
      var skeletonHtml = '';
      for (var si = 0; si < 8; si++) {
        skeletonHtml += '<div class="nbm-size-cell"><div class="nbm-skeleton nbm-skeleton-label"></div><div class="nbm-skeleton nbm-skeleton-input"></div><div class="nbm-skeleton nbm-skeleton-price"></div></div>';
      }
      sizeGrid.innerHTML = skeletonHtml;
      // Check if this product is a blank (need tier pricing from Storefront API)
      var isBlank = !!document.querySelector('[data-product-id="' + (_product ? _product.id : '') + '"][is-blank="true"]');
      if (isBlank) {
        // Blanks: prefer Storefront API (has tier_pricing metafield), fall back to get_handle
        variantsFromStorefrontApi(handle, color, function(sfVariants) {
          if (sfVariants.length > 0) { renderSizeCells(sfVariants); return; }
          variantsFromGetHandle(handle, color, function(variants) { renderSizeCells(variants); });
        });
      } else {
        // Non-blanks: get_handle first, fall back to Storefront API
        variantsFromGetHandle(handle, color, function(variants) {
          if (variants.length > 0) { renderSizeCells(variants); return; }
          variantsFromStorefrontApi(handle, color, function(sfVariants) { renderSizeCells(sfVariants); });
        });
      }
    }

