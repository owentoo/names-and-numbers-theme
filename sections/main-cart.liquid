            img.src = bgImg;

            sw.addEventListener('click', function() {
              swatchRow.querySelectorAll('.nbm-selected').forEach(function(s) { s.classList.remove('nbm-selected'); });
              sw.classList.add('nbm-selected');
              colorNameEl.textContent = titleCase(cKey);
              colorPreview.style.background = hexBg;
              // Highlight matching dropdown item
              dropdownMenu.querySelectorAll('.nbm-dd-active').forEach(function(d) { d.classList.remove('nbm-dd-active'); });
              var ddMatch = dropdownMenu.querySelector('[data-color-key="' + cKey + '"]');
              if (ddMatch) ddMatch.classList.add('nbm-dd-active');
              modal.querySelector('.nbm-box').classList.remove('nbm-dd-open'); dropdownEl.classList.remove('open');
              // Update product image — Storefront API needs Color + Size to find variant
              if (_sfToken) {
                var firstSize = '';
                product.options.forEach(function(o) {
                  var n = typeof o === 'string' ? o : o.name;
                  if (n && n.toLowerCase() === 'size' && typeof o !== 'string' && o.values && o.values[0]) firstSize = o.values[0];
                });
                var opts = '[{name:"Color",value:"' + cKey.replace(/"/g,'\\"') + '"}';
                if (firstSize) opts += ',{name:"Size",value:"' + firstSize.replace(/"/g,'\\"') + '"}';
                opts += ']';
                var q = '{ product(handle:"' + handle + '") { variantBySelectedOptions(selectedOptions:' + opts + ') { image { url } } } }';
                fetch('https://transferss.myshopify.com/api/2025-01/graphql.json', {
                  method:'POST', headers:{'Content-Type':'application/json','X-Shopify-Storefront-Access-Token':_sfToken},
                  body:JSON.stringify({query:q})
                }).then(function(r){return r.json()}).then(function(d){
                  try { var url = d.data.product.variantBySelectedOptions.image.url; if(url) { productImg.src = url + '&width=400'; productImg.alt = titleCase(cKey); } } catch(e){}
                }).catch(function(){});
              }
              buildSizeGrid(cKey);
            });
            swatchRow.appendChild(sw);
            swatchList.push(sw);
            ddItems.push({ name: cKey, hex: hexBg, sw: sw, swIdx: swIdx });
          });

          // Dropdown: alphabetical order
          ddItems.sort(function(a, b) { return a.name.localeCompare(b.name); });
          ddItems.forEach(function(item) {
            var ddItem = document.createElement('div');
