<div class="ninja-collection-grid {{ section.settings.custom_class }} custom-flilter-{{ section.id }}"> 
  {%- if isblankproduct -%}
  <style>
    .bh-blanks-content .active-facets,
    .bh-blanks-content .active-facets-desktop { display: none !important; }
  </style>

    {%- liquid
      assign bh_has_filters = false
      for filter in collection.filters
        if filter.active_values.size > 0
          assign bh_has_filters = true
        endif
        if filter.type == 'price_range'
          if filter.min_value.value != nil or filter.max_value.value != nil
            assign bh_has_filters = true
          endif
        endif
      endfor
      assign bh_non_default_sort = false
      if collection.sort_by != blank and collection.sort_by != collection.default_sort_by
        assign bh_non_default_sort = true
      endif
      assign bh_has_slices = false
      for block in section.blocks
        if block.type == 'blanks_slice'
          assign bh_has_slices = true
          break
        endif
      endfor
      assign bh_show_flat = false
      if bh_has_filters or bh_non_default_sort or bh_has_slices == false
        assign bh_show_flat = true
      endif

      assign active_count = 0
      for filter in collection.filters
        assign active_count = active_count | plus: filter.active_values.size
        if filter.type == 'price_range'
          if filter.min_value.value != nil or filter.max_value.value != nil
            assign active_count = active_count | plus: 1
          endif
        endif
      endfor

      assign bh_sort_by = collection.sort_by | default: collection.default_sort_by
    -%}

