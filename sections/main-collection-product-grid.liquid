{%- render 'bh-quick-buy-assets' -%}
<script>
(function () {
  function bhSwatchHover(e) {
    var sw = e.target.closest('.bh-sw[data-img]');
    if (!sw) return;
    var card = sw.closest('.product-item');
    if (!card) return;
    var imgEl = card.querySelector('.product-item__image-figure img.img');
    if (imgEl) {
      if (!imgEl.dataset.bhOrigSrc) imgEl.dataset.bhOrigSrc = imgEl.src;
      if (!imgEl.dataset.bhOrigSrcset) imgEl.dataset.bhOrigSrcset = imgEl.getAttribute('srcset') || '';
      imgEl.setAttribute('srcset', '');
      imgEl.src = sw.dataset.img;
    }
    var label = card.querySelector('.bh-color-name');
    if (label) {
      if (!label.dataset.bhOrigColor) label.dataset.bhOrigColor = label.textContent;
      label.textContent = sw.dataset.color || label.dataset.bhOrigColor;
    }
  }
  function bhSwatchOut(e) {
    var sw = e.target.closest('.bh-sw[data-img]');
    if (!sw) return;
    if (e.relatedTarget && e.relatedTarget.closest('.bh-swatches') === sw.closest('.bh-swatches')) return;
    var card = sw.closest('.product-item');
    if (!card) return;
    var imgEl = card.querySelector('.product-item__image-figure img.img');
    if (imgEl && imgEl.dataset.bhOrigSrc) {
      imgEl.src = imgEl.dataset.bhOrigSrc;
      if (imgEl.dataset.bhOrigSrcset) imgEl.setAttribute('srcset', imgEl.dataset.bhOrigSrcset);
    }
    var label = card.querySelector('.bh-color-name');
    if (label && label.dataset.bhOrigColor) label.textContent = label.dataset.bhOrigColor;
  }
  document.addEventListener('mouseover', bhSwatchHover);
  document.addEventListener('mouseout', bhSwatchOut);
  document.addEventListener('click', function(e) {
    var sw = e.target.closest('.bh-sw[data-url]');
    if (!sw) return;
    e.preventDefault();
    e.stopPropagation();
    window.location.href = sw.dataset.url;
  });

  // Close upsell overlay on × or backdrop click
  document.addEventListener('click', function(e) {
    var overlay = document.getElementById('bh-upsell-overlay');
    if (!overlay) return;
    if (e.target.closest('.bh-upsell-close') || e.target === overlay) {
      overlay.classList.remove('bh-uo--active');
    }
  });
})();
</script>
{% endif %}

