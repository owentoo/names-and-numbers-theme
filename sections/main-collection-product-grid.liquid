<script>
/* Recalculate swatch "+X" counts based on visible swatches */
(function(){
  function refreshSwatchCounts(){
    var isMobile = window.innerWidth <= 767;
    document.querySelectorAll('.bh-swatches').forEach(function(row){
      var total = parseInt(row.getAttribute('data-total'),10) || 0;
      var swatches = row.querySelectorAll('.bh-sw');
      var visible = 0;
      for(var i=0;i<swatches.length;i++){
        if(getComputedStyle(swatches[i]).display!=='none') visible++;
      }
      var more = row.querySelector('.bh-sw-more');
      if(!more) return;
      var remaining = total - visible;
      if(remaining > 0){
        more.textContent = '+' + remaining;
        more.style.display = '';
      } else {
        more.style.display = 'none';
      }
    });
  }
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',refreshSwatchCounts);}else{refreshSwatchCounts();}
  var resizeTimer;
  window.addEventListener('resize',function(){clearTimeout(resizeTimer);resizeTimer=setTimeout(refreshSwatchCounts,150);});
})();
</script>
{% schema %}
  {
    "name": "t:sections.main-collection-product-grid.name",
    "class": "container--vertical-space container--remove-margin-before mount-quick-buy mount-css-slider no-inert",
    "blocks": [
      {
        "type": "blanks_sidebar_banner",
        "name": "Sidebar Banner",
        "settings": [
          { "type": "text", "id": "label", "label": "Label", "default": "Fast Delivery" },
          { "type": "checkbox", "id": "show_icon", "label": "Show icon", "default": true },
          { "type": "text", "id": "headline_line1", "label": "Headline line 1", "default": "Order today," },
          { "type": "text", "id": "headline_line2", "label": "Headline line 2", "default": "get it tomorrow." },
          { "type": "text", "id": "subtext", "label": "Subtext", "default": "Order before 5 PM to qualify" },
