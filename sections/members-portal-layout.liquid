{%- liquid
  assign first_name = customer.first_name | default: ''
  assign last_name = customer.last_name | default: ''
  assign initial_first = first_name | slice: 0, 1 | upcase
  assign initial_last = last_name | slice: 0, 1 | upcase
  assign initials = initial_first | append: initial_last
  if initials == blank
    assign initials = customer.email | slice: 0, 1 | upcase
  endif
  assign display_name = customer.first_name | append: ' ' | append: customer.last_name
  if display_name == ' '
    assign display_name = customer.email
  endif
  assign max_orders = section.settings.max_orders

  comment
    Dashboard header stats
  endcomment
  assign now_year = 'now' | date: '%Y' | plus: 0
  assign now_month = 'now' | date: '%-m' | plus: 0
  assign now_day = 'now' | date: '%-d' | plus: 0
  assign orders_ytd = 0
  assign orders_last_year = 0
  assign spend_12mo_cents = customer.metafields.ninja_rewards.trailing_spend | default: 0
  assign spend_ytd_cents = 0
  assign total_ship_days = 0
  assign ship_count = 0
  assign last_order_date = nil
  assign last_blanks_date = nil
  assign blanks_order_epochs = ''
  assign dtf_order_epochs = ''
  assign member_since = ''

-%}
{%- comment -%}Stats loop — paginate by 50 (25 for heavy customers >300 orders). Merged line_items into single pass. Early break at 13 months.{%- endcomment -%}
{%- if customer -%}
{%- assign heavy_customer = false -%}
{%- if customer.orders_count > 300 -%}{%- assign heavy_customer = true -%}{%- endif -%}
{%- if heavy_customer -%}
{%- paginate customer.orders by 25 -%}
{%- liquid
  for order in customer.orders
    assign o_year = order.created_at | date: '%Y' | plus: 0
    assign o_month = order.created_at | date: '%-m' | plus: 0
    if o_year == now_year
      unless order.cancelled
        assign orders_ytd = orders_ytd | plus: 1
        assign spend_ytd_cents = spend_ytd_cents | plus: order.total_price
      endunless
    endif
    assign prev_year = now_year | minus: 1
    if o_year == prev_year
      unless order.cancelled
        assign orders_last_year = orders_last_year | plus: 1
      endunless
    endif
    unless order.cancelled
      assign months_ago = now_year | minus: o_year | times: 12 | plus: now_month | minus: o_month
      if last_order_date == nil
        assign last_order_date = order.created_at
      endif
      if last_blanks_date == nil
        for li in order.line_items
          assign li_tags_m = li.product.tags | join: ',' | downcase
          if li_tags_m contains 'blank apparel'
            assign last_blanks_date = order.created_at
            break
          endif
        endfor
      endif
      assign member_since = order.created_at | date: "%b %Y"
      if months_ago > 13
        break
      endif
    endunless
  endfor
-%}
{%- endpaginate -%}
{%- else -%}
{%- paginate customer.orders by 50 -%}
{%- liquid
  for order in customer.orders
    assign o_year = order.created_at | date: '%Y' | plus: 0
    assign o_month = order.created_at | date: '%-m' | plus: 0
    if o_year == now_year
      unless order.cancelled
        assign orders_ytd = orders_ytd | plus: 1
        assign spend_ytd_cents = spend_ytd_cents | plus: order.total_price
      endunless
    endif
    assign prev_year = now_year | minus: 1
    if o_year == prev_year
      unless order.cancelled
        assign orders_last_year = orders_last_year | plus: 1
      endunless
    endif
    unless order.cancelled
      assign months_ago = now_year | minus: o_year | times: 12 | plus: now_month | minus: o_month
      if last_order_date == nil
        assign last_order_date = order.created_at
      endif
      comment
        Single pass through line_items: blanks detection, DTF detection, fulfillment tracking
      endcomment
      assign order_has_blanks = false
      assign order_all_blanks = true
      assign first_fulfill_at = nil
      for li in order.line_items
        assign li_tags_m = li.product.tags | join: ',' | downcase
        if li_tags_m contains 'blank apparel'
          assign order_has_blanks = true
        else
          assign order_all_blanks = false
        endif
        if first_fulfill_at == nil and li.fulfillment.created_at != blank
          assign first_fulfill_at = li.fulfillment.created_at | date: '%s' | plus: 0
        endif
      endfor
      if last_blanks_date == nil and order_has_blanks
        assign last_blanks_date = order.created_at
      endif
      assign blanks_epoch_count = blanks_order_epochs | split: ',' | size
      if blanks_epoch_count < 10 and order_has_blanks
        assign this_epoch = order.created_at | date: '%s'
        if blanks_order_epochs == ''
          assign blanks_order_epochs = this_epoch
        else
          assign blanks_order_epochs = blanks_order_epochs | append: ',' | append: this_epoch
        endif
      endif
      assign dtf_epoch_count = dtf_order_epochs | split: ',' | size
      if dtf_epoch_count < 10
        unless order_all_blanks
          assign dtf_epoch = order.created_at | date: '%s'
          if dtf_order_epochs == ''
            assign dtf_order_epochs = dtf_epoch
          else
            assign dtf_order_epochs = dtf_order_epochs | append: ',' | append: dtf_epoch
          endif
        endunless
      endif
      assign member_since = order.created_at | date: "%b %Y"
      if order.fulfillment_status == 'fulfilled' and first_fulfill_at != nil
        assign created_epoch = order.created_at | date: '%s' | plus: 0
        assign diff_secs = first_fulfill_at | minus: created_epoch
        assign diff_days = diff_secs | divided_by: 86400
        if diff_days >= 0 and diff_days < 60
          assign total_ship_days = total_ship_days | plus: diff_days
          assign ship_count = ship_count | plus: 1
        endif
      endif
      if months_ago > 13
        assign _can_break = false
        assign _de = dtf_order_epochs | split: ',' | size
        assign _be = blanks_order_epochs | split: ',' | size
        if _de >= 10
          if _be >= 10
            assign _can_break = true
          endif
          if last_blanks_date == nil
            assign _can_break = true
          endif
        endif
        if _can_break
          break
        endif
      endif
    endunless
  endfor
-%}
{%- endpaginate -%}
{%- endif -%}
{%- endif -%}
{%- liquid
  assign klaviyo_first_order = customer.metafields.klaviyo.First_Order_Date
  if klaviyo_first_order != blank
    assign member_since = klaviyo_first_order | date: "%b %Y"
  endif
  if member_since == blank
    assign member_since = "now" | date: "%b %Y"
  endif

  assign spend_12mo_dollars = spend_12mo_cents | times: 100 | money

  assign cashback_cents = customer.store_credit_account.balance | default: 0
  assign cashback_display = cashback_cents | money



  assign current_tier_raw = customer.metafields.ninja_rewards.tier_label | default: ''
  assign current_tier_check = current_tier_raw | downcase | strip
  if current_tier_check == 'none' or current_tier_check == ''
    assign current_tier = 'White Belt'
  else
    assign current_tier = current_tier_raw
  endif
  assign spend_remaining_cents = customer.metafields.ninja_rewards.next_tier_gap | default: 0
  assign spend_remaining_display = spend_remaining_cents | times: 100 | money

  assign dash_next_tier = 'Yellow Belt'
  assign dash_next_tier_color = '#eab308'
  case current_tier
    when 'White Belt'
      assign dash_next_tier = 'Yellow Belt'
      assign dash_next_tier_color = '#eab308'
    when 'Yellow Belt'
      assign dash_next_tier = 'Blue Belt'
      assign dash_next_tier_color = '#1580d0'
    when 'Blue Belt'
      assign dash_next_tier = 'Black Belt'
      assign dash_next_tier_color = '#2c3239'
    when 'Black Belt'
      assign dash_next_tier = ''
      assign dash_next_tier_color = ''
  endcase

  assign belt_color = '#e5e7eb'
  case current_tier
    when 'White Belt'
      assign belt_color = '#e5e7eb'
    when 'Yellow Belt'
      assign belt_color = '#eab308'
    when 'Blue Belt'
      assign belt_color = '#019AFF'
    when 'Black Belt'
      assign belt_color = '#111827'
  endcase

  comment
    Determine active panel based on page handle
  endcomment
  assign current_handle = page.handle | default: 'welcome'
  assign active_panel = 'dashboard'
-%}

{%- if customer -%}
<script>
  /* Redirect Design Studio "Save and Use Design" to the correct product page.
     The app sets window.location.href using the current pathname as the base,
     so it lands on /pages/welcome?_design_studio=Yes instead of /products/dtf-transfers. */
  (function() {
    var params = new URLSearchParams(window.location.search);
    if (params.has('_design_studio') && window.location.pathname.indexOf('/products/') === -1) {
      window.location.replace('/products/dtf-transfers' + window.location.search);
      return;
    }
  })();
</script>
<style>
  /* Critical CSS — prevents FOUC by hiding portal until full styles load */
  .members-portal { opacity: 0; }
  .members-portal.mp-ready { opacity: 1; transition: opacity 0.15s ease; }
  .mp-login-prompt { opacity: 0; }
  .mp-login-prompt.mp-ready { opacity: 1; transition: opacity 0.15s ease; }
  .template-page-members-portal,
  .template-page-my-orders { background: {{ section.settings.dash_bg | default: '#f8fafc' }} !important; }
  .template-page-members-portal #main,
  .template-page-my-orders #main { padding: 0 !important; margin: 0 !important; max-width: 100% !important; background: {{ section.settings.dash_bg | default: '#f8fafc' }} !important; }
</style>
<div id="mp-{{ section.id }}" class="members-portal">

  {%- comment -%} ===== MOBILE HEADER ===== {%- endcomment -%}
  {%- liquid
    assign active_label = 'Dashboard'
    assign current_path = request.path | default: ''
    for block in section.blocks
      if block.type == 'nav_link'
        assign block_url = block.settings.url | default: ''
        assign resolved_url = block_url | replace: 'shopify://pages/', '/pages/'
        if current_path != '' and resolved_url == current_path
          assign active_label = block.settings.label
        endif
      endif
    endfor
  -%}
  <div class="mp-mobile-header">
    <button class="mp-mobile-picker" type="button" aria-label="Open menu" data-mp-picker>
      <span class="mp-mobile-picker__label">{{ section.settings.portal_label }}</span>
      <span class="mp-mobile-picker__current">
        <svg class="mp-mobile-picker__caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        <span class="mp-mobile-picker__page" data-mp-picker-page>{{ active_label }}</span>
      </span>
    </button>
    <span class="mp-mobile-avatar">{{ initials }}</span>
  </div>

  {%- comment -%} ===== SIDEBAR OVERLAY (mobile) ===== {%- endcomment -%}
  <div class="mp-sidebar-overlay"></div>

  {%- comment -%} ===== SIDEBAR ===== {%- endcomment -%}
  <aside class="mp-sidebar">
    <nav class="mp-nav">
      {%- assign unfulfilled_count = 0 -%}
      {%- for order in customer.orders -%}
        {%- unless order.fulfillment_status == 'fulfilled' or order.cancelled -%}
          {%- assign unfulfilled_count = unfulfilled_count | plus: 1 -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- assign current_path = request.path | default: '' -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'group_header' -%}
          <div class="mp-nav__group" {{ block.shopify_attributes }}>{{ block.settings.label }}</div>
        {%- elsif block.type == 'nav_link' -%}
          {%- assign is_default_active = false -%}
          {%- assign block_url = block.settings.url | default: '' -%}
          {%- assign resolved_url = block_url -%}
          {%- if resolved_url contains 'shopify://pages/' -%}
            {%- assign resolved_url = resolved_url | replace: 'shopify://pages/', '/pages/' -%}
          {%- endif -%}
          {%- if active_panel == 'dashboard' and resolved_url contains '/pages/welcome' -%}
            {%- assign is_default_active = true -%}
          {%- elsif current_path != '' and resolved_url == current_path -%}
            {%- assign is_default_active = true -%}
          {%- endif -%}
          <a href="#"
             class="mp-nav__link{% if is_default_active %} mp-nav__link--active{% endif %}"
             data-link-type="{{ block.settings.link_type }}"
             data-url="{{ block.settings.url }}"
             data-label="{{ block.settings.label | escape }}"
             data-icon="{{ block.settings.icon }}"
             {{ block.shopify_attributes }}>
            <span class="mp-nav__icon">
              {%- case block.settings.icon -%}
                {%- when 'dashboard' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                {%- when 'orders' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2h12l4 4v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><path d="M16 2v4h4"/><path d="M9 15l2 2 4-4"/></svg>
                {%- when 'library' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
                {%- when 'designs' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                {%- when 'messages' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                {%- when 'rewards' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- when 'upload' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                {%- when 'gangsheet' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
                {%- when 'blanks' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                {%- when 'profile' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                {%- when 'addresses' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                {%- when 'tshirt' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 1 .84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.14a1 1 0 0 0 1-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                {%- when 'paintbrush' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.37 2.63L14 7l-1.59-1.59a2 2 0 0 0-2.82 0L8 7l9 9 1.59-1.59a2 2 0 0 0 0-2.82L17 10l4.37-4.37a2.12 2.12 0 1 0-3-3z"/><path d="M9 8c-2 3-4 3.5-7 4l8 10c2-1 6-5 6-7"/><path d="M14.5 17.5L4.5 15"/></svg>
                {%- when 'search' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                {%- when 'bgremover' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" stroke-dasharray="3 2"/><circle cx="12" cy="10" r="3"/><path d="M6 18c1-3 3.5-4 6-4s5 1 6 4"/></svg>
                {%- when 'aigen' -%}
                  {%- comment -%} Sparkles icon — visual shorthand for "AI / generative" used across the site. Big 4-point star with two small accent stars. {%- endcomment -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3L12 3z"/><path d="M5 3v4"/><path d="M3 5h4"/><path d="M19 17v4"/><path d="M17 19h4"/></svg>
                {%- else -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/></svg>
              {%- endcase -%}
            </span>
            <span class="mp-nav__label">{{ block.settings.label }}</span>
            {%- if block.settings.icon == 'orders' and unfulfilled_count > 0 -%}
              <span class="mp-nav__badge">{{ unfulfilled_count }}</span>
            {%- elsif block.settings.icon == 'messages' -%}
              <span class="mp-nav__badge mp-nav__badge--msg" data-nt-msg-badge data-count="0"></span>
            {%- elsif block.settings.badge_text != blank -%}
              <span class="mp-nav__badge">{{ block.settings.badge_text }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Log Out — opens account settings in new tab {%- endcomment -%}
      <a href="{{routes.account_logout_url}}" rel="noopener" class="mp-nav__link mp-nav__logout">
        <span class="mp-nav__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </span>
        <span class="mp-nav__label">{{ section.settings.logout_label | default: 'Log Out' }}</span>
      </a>
    </nav>
  </aside>

  {%- comment -%} ===== CONTENT AREA ===== {%- endcomment -%}
  <div class="mp-content">

    {%- comment -%} ===== DASHBOARD PANEL ===== {%- endcomment -%}
    <div class="mp-panel{% if active_panel == 'dashboard' %} mp-panel--active{% endif %}" data-panel="dashboard">
      <div class="mp-content__inner">

        {%- comment -%} --- Dashboard Header --- {%- endcomment -%}
        <div class="dash-header">
          <div class="dash-header__greeting-row">
            <div class="dash-header__left">
              <h1 class="dash-header__greeting" id="mp-greeting">{{ section.settings.greeting_text | default: 'Good Day Ninja' }} {{ customer.first_name | default: 'there' }}</h1>
              {%- if cashback_cents > 0 -%}
                <p class="dash-header__subline">{{ section.settings.subline_text | default: 'One portal. All the tools a true Ninja needs. Reorder in seconds. Track every order. Design with AI. Unlock exclusive offers.' }}</p>
              {%- else -%}
                <p class="dash-header__subline"></p>
              {%- endif -%}
            </div>
            <div class="dash-header__right">
            </div>
          </div>

          {%- comment -%} --- Rewards strip card --- {%- endcomment -%}
          {%- liquid
            assign tc_cashback = '2%'
            assign tier_threshold_cents = 0
            case current_tier
              when 'White Belt'
                assign tc_cashback = '2%'
                assign tier_threshold_cents = 25000
              when 'Yellow Belt'
                assign tc_cashback = '4%'
                assign tier_threshold_cents = 50000
              when 'Blue Belt'
                assign tc_cashback = '6%'
                assign tier_threshold_cents = 100000
              when 'Black Belt'
                assign tc_cashback = '10%'
                assign tier_threshold_cents = 0
            endcase

            assign progress_pct = 0
            if tier_threshold_cents > 0 and spend_remaining_cents > 0
              assign spent_toward_next = tier_threshold_cents | minus: spend_remaining_cents
              if spent_toward_next < 0
                assign spent_toward_next = 0
              endif
              assign progress_pct = spent_toward_next | times: 100 | divided_by: tier_threshold_cents
              if progress_pct > 100
                assign progress_pct = 100
              endif
            endif
          -%}

          {%- comment -%} VIP Perks tag matching {%- endcomment -%}
          {%- assign dbs_matched_group = '' -%}
          {%- if customer -%}
            {%- for i in (1..3) -%}
              {%- assign dbs_tag_key = 'dbs_perks_tag_' | append: i -%}
              {%- assign dbs_tag_val = section.settings[dbs_tag_key] -%}
              {%- if dbs_tag_val != blank -%}
                {%- for t in customer.tags -%}
                  {%- if t == dbs_tag_val -%}
                    {%- assign dbs_matched_group = i -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- if dbs_matched_group != '' -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          <div class="dash-belt-card">
            <div class="dash-belt-row">
              {%- if current_tier != blank -%}
                <div class="dash-belt-group" style="flex:1;">
                  <span class="dash-belt-label">Tier:</span>
                  <span class="dash-belt-val">{{ current_tier }}</span>
                </div>
                <div class="dash-belt-div"></div>
                <div class="dash-belt-group" style="flex:1;">
                  <span class="dash-belt-label">Earning:</span>
                  <span class="dash-belt-val">{{ tc_cashback }} Cash Back</span>
                </div>
                <div class="dash-belt-div"></div>
              {%- endif -%}
              <div class="dash-belt-group" style="flex:1;">
                <span class="dash-belt-label">Ninja Cash:</span>
                <span class="dash-belt-val dash-belt-val--cash">{{ cashback_display }}</span>
              </div>
              {%- if dash_next_tier != '' and spend_remaining_cents > 0 -%}
                <div class="dash-belt-div"></div>
                <div class="dash-belt-group dash-belt-group--next" style="flex:1;">
                  <div class="dash-belt-next-top">
                    <span class="dash-belt-label">To {{ dash_next_tier }}:</span>
                    <span class="dash-belt-val">{{ spend_remaining_display }}</span>
                  </div>
                  <div class="dash-belt-progress">
                    <div class="dash-belt-progress__fill" style="width:{{ progress_pct }}%;"></div>
                  </div>
                </div>
              {%- endif -%}
            </div>

            {%- if dbs_matched_group != '' -%}
              {%- assign dbs_label_key = 'dbs_perks_label_' | append: dbs_matched_group -%}
              {%- assign dbs_perks_label = section.settings[dbs_label_key] | default: 'VIP Perks Unlocked' -%}
              <div class="dash-belt-perks">
                <span class="dash-belt-perks__label">{{ dbs_perks_label }}</span>
                <span class="dash-belt-perks__list">
                  {%- assign perk_output = false -%}
                  {%- for j in (1..6) -%}
                    {%- assign dbs_perk_key = 'dbs_perks_' | append: dbs_matched_group | append: '_perk_' | append: j -%}
                    {%- assign dbs_perk_text = section.settings[dbs_perk_key] -%}
                    {%- if dbs_perk_text != blank -%}
                      {%- if perk_output -%}<span class="dash-belt-perks__dot"> · </span>{%- endif -%}
                      <span>{{ dbs_perk_text }}</span>
                      {%- assign perk_output = true -%}
                    {%- endif -%}
                  {%- endfor -%}
                </span>
              </div>
            {%- endif -%}
          </div>

          {%- comment -%} --- Quick-order CTAs --- {%- endcomment -%}
          <div class="dash-ctas">
            <div class="dash-cta dash-cta--dtf">
              <span class="dash-cta__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              </span>
              <span class="dash-cta__text">
                <span class="dash-cta__label">{{ section.settings.cta1_label | default: 'Order DTF by Size' }}</span>
                <span class="dash-cta__sub">{{ section.settings.cta1_sub | default: 'Upload & pick your size' }}</span>
              </span>
              <a href="{{ section.settings.cta1_btn_url | default: '/products/dtf-transfers' }}" class="dash-cta__btn">{{ section.settings.cta1_btn_text | default: 'Order' }}</a>
            </div>
            <div class="dash-cta dash-cta--gang">
              <span class="dash-cta__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
              </span>
              <span class="dash-cta__text">
                <span class="dash-cta__label">{{ section.settings.cta2_label | default: 'Build a Gang Sheet' }}</span>
                <span class="dash-cta__sub">{{ section.settings.cta2_sub | default: 'Fill your sheet & maximize savings' }}</span>
              </span>
              <a href="{{ section.settings.cta2_btn_url | default: 'https://ninjatransfers.com/products/build-your-own-gang-sheet' }}" class="dash-cta__btn">{{ section.settings.cta2_btn_text | default: 'Build' }}</a>
            </div>
            <div class="dash-cta dash-cta--blanks">
              <span class="dash-cta__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 1 .84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.14a1 1 0 0 0 1-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
              </span>
              <span class="dash-cta__text">
                <span class="dash-cta__label">{{ section.settings.cta3_label | default: 'Blank Apparel' }}</span>
                <span class="dash-cta__sub">{{ section.settings.cta3_sub | default: 'Browse tees, hoodies & more' }}</span>
              </span>
              <a href="{{ section.settings.cta3_btn_url | default: 'https://ninjatransfers.com/collections/blank-apparel' }}" class="dash-cta__btn">{{ section.settings.cta3_btn_text | default: 'Shop' }}</a>
            </div>
          </div>

        </div>

        {%- comment -%} --- Recent Orders (all orders created within last 30 days) --- {%- endcomment -%}
        {%- assign now_ts = "now" | date: "%s" | plus: 0 -%}
        {%- assign thirty_days_ago_ts = now_ts | minus: 2592000 -%}
        <div class="recent-orders-section">
          <div class="recent-orders__header">
            <div class="recent-orders__header-left">
              <h2 class="recent-orders__title">{{ section.settings.orders_title | default: 'Recent Orders' }}</h2>
              <span class="recent-orders__title-sub">{{ section.settings.orders_subtitle | default: 'Last 30 Days' }}</span>
            </div>
            <a href="{{ section.settings.orders_view_all_url | default: '/pages/my-orders' }}" class="recent-orders__view-all ao-nav-to-orders">{{ section.settings.orders_view_all_text | default: 'View all orders →' }}</a>
          </div>

          {%- assign active_orders_count = 0 -%}
          {%- assign active_shown = 0 -%}
          <div class="recent-orders__table" id="mp-recent-{{ section.id }}">

            <div class="recent-orders__body">
            {%- for order in customer.orders -%}
            {%- assign order_ts = order.created_at | date: "%s" | plus: 0 -%}
            {%- if order_ts < thirty_days_ago_ts -%}{%- break -%}{%- endif -%}
            {%- assign active_orders_count = active_orders_count | plus: 1 -%}
            {%- if active_shown < max_orders -%}
            {%- assign active_shown = active_shown | plus: 1 -%}
              {%- assign first_item = order.line_items | first -%}
              {%- assign item_image = nil -%}
              {%- assign custom_image_url = "" -%}
              {%- assign ro_first_width = "" -%}
              {%- assign ro_first_height = "" -%}
              {%- assign property_size = first_item.properties | size -%}
              {%- if property_size > 0 -%}
                {%- for p in first_item.properties -%}
                  {%- assign pfirst = p.first | downcase | strip -%}
                  {%- if pfirst == 'preview' and custom_image_url == "" -%}
                    {%- assign custom_image_url = p.last -%}
                  {%- endif -%}
                  {%- if pfirst == '_cartimg' -%}
                    {%- assign custom_image_url = p.last -%}
                  {%- endif -%}
                  {%- if pfirst == 'upload (vector files preferred)' and custom_image_url == "" -%}
                    {%- assign custom_image_url = p.last -%}
                  {%- endif -%}
                  {%- if pfirst == 'preview gang sheet (low res)' and custom_image_url == "" -%}
                    {%- assign custom_image_url = p.last -%}
                  {%- endif -%}
                  {%- if pfirst == 'width' or pfirst == '_width' -%}{%- if p.last != blank -%}{%- assign ro_first_width = p.last -%}{%- endif -%}{%- endif -%}
                  {%- if pfirst == 'height' or pfirst == '_height' -%}{%- if p.last != blank -%}{%- assign ro_first_height = p.last -%}{%- endif -%}{%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- assign ro_first_variant_title = first_item.variant.title -%}
              {%- assign ro_first_is_style = false -%}
              {%- if ro_first_variant_title contains 'Style #' -%}{%- assign ro_first_is_style = true -%}{%- endif -%}
              {%- if custom_image_url == "" -%}
                {%- if first_item.image -%}
                  {%- assign item_image = first_item.image -%}
                {%- elsif first_item.product.featured_image -%}
                  {%- assign item_image = first_item.product.featured_image -%}
                {%- endif -%}
              {%- endif -%}

              {%- assign total_quantity = 0 -%}
              {%- for line_item in order.line_items -%}
                {%- assign total_quantity = total_quantity | plus: line_item.quantity -%}
              {%- endfor -%}

              {%- assign product_name = first_item.product.title | default: first_item.title -%}
              {%- if product_name == blank -%}{%- assign product_name = first_item.title -%}{%- endif -%}
              {%- if product_name contains ' - Style #' -%}{%- assign product_name = product_name | split: ' - Style #' | first | strip -%}{%- elsif product_name contains 'Style #' -%}{%- assign product_name = product_name | split: 'Style #' | first | strip -%}{%- endif -%}
              {%- if ro_first_variant_title != blank and ro_first_variant_title != 'Default Title' -%}{%- assign ro_vt_suffix = ' - ' | append: ro_first_variant_title -%}{%- if product_name contains ro_vt_suffix -%}{%- assign product_name = product_name | remove: ro_vt_suffix -%}{%- endif -%}{%- endif -%}

              {%- assign order_nickname = order.metafields.custom.checkout -%}

              {%- assign line_count = order.line_items.size -%}
              {%- if line_count == 1 -%}
                {%- if ro_first_is_style and ro_first_width != "" and ro_first_height != "" -%}
                  {%- capture item_desc -%}{{ ro_first_width }}" &times; {{ ro_first_height }}" &middot; {{ total_quantity }} {% if total_quantity == 1 %}piece{% else %}pieces{% endif %}{%- endcapture -%}
                {%- else -%}
                  {%- capture item_desc -%}{{ total_quantity }} {% if total_quantity == 1 %}piece{% else %}pieces{% endif %}{%- endcapture -%}
                {%- endif -%}
              {%- else -%}
                {%- capture item_desc -%}{{ line_count }} items &middot; {{ total_quantity }} pieces{%- endcapture -%}
              {%- endif -%}

              {%- assign fulfillment = order.fulfillment_status -%}
              {%- assign tracking_url = "" -%}
              {%- assign tracking_number = "" -%}
              {%- assign ro_tracking_seen = "|" -%}
              {%- assign ro_tracking_count = 0 -%}
              {%- capture ro_trackings_desktop %}{% endcapture -%}
              {%- capture ro_trackings_mobile %}{% endcapture -%}
              {%- capture ro_trackings_json_inner %}{% endcapture -%}
              {%- if order.cancelled -%}
                {%- assign fulfillment_label = "Cancelled" -%}
                {%- assign badge_class = "ro-badge--grey" -%}
              {%- elsif fulfillment == "fulfilled" -%}
                {%- assign fulfillment_label = "Fulfilled" -%}
                {%- assign badge_class = "ro-badge--blue" -%}
                {%- for li in order.line_items -%}
                  {%- assign ro_li_tn = li.fulfillment.tracking_number -%}
                  {%- if ro_li_tn != blank -%}
                    {%- assign ro_li_tn_key = "|" | append: ro_li_tn | append: "|" -%}
                    {%- unless ro_tracking_seen contains ro_li_tn_key -%}
                      {%- assign ro_tracking_seen = ro_tracking_seen | append: ro_li_tn | append: "|" -%}
                      {%- assign ro_li_tu = li.fulfillment.tracking_url -%}
                      {%- if tracking_number == "" -%}
                        {%- assign tracking_number = ro_li_tn -%}
                        {%- assign tracking_url = ro_li_tu -%}
                      {%- endif -%}
                      {%- capture ro_trackings_desktop -%}{{ ro_trackings_desktop }}<div class="ro-tracking-callout"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg><span class="ro-tracking-callout__label">Tracking:</span> <a href="{{ ro_li_tu }}" target="_blank" rel="noopener" class="ro-tracking-callout__link" onclick="event.stopPropagation()">{{ ro_li_tn }}</a></div>{%- endcapture -%}
                      {%- capture ro_trackings_mobile -%}{{ ro_trackings_mobile }}<div class="ro-tracking-callout"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg><span class="ro-tracking-callout__label">Tracking:</span> <a href="{{ ro_li_tu }}" target="_blank" rel="noopener" class="ro-tracking-callout__link" onclick="event.stopPropagation()">{{ ro_li_tn }}</a></div>{%- endcapture -%}
                      {%- if ro_tracking_count > 0 -%}{%- capture ro_trackings_json_inner -%}{{ ro_trackings_json_inner }},{%- endcapture -%}{%- endif -%}
                      {%- capture ro_trackings_json_inner -%}{{ ro_trackings_json_inner }}{ "number": {{ ro_li_tn | json }}, "url": {{ ro_li_tu | json }} }{%- endcapture -%}
                      {%- assign ro_tracking_count = ro_tracking_count | plus: 1 -%}
                    {%- endunless -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- assign custom_status = order.metafields.custom.status -%}
                {%- if custom_status != blank -%}
                  {%- assign fulfillment_label = custom_status -%}
                {%- else -%}
                  {%- assign fulfillment_label = "Unfulfilled" -%}
                {%- endif -%}
                {%- if fulfillment_label == "Artwork Blocked" -%}
                  {%- assign badge_class = "ro-badge--red" -%}
                {%- else -%}
                  {%- assign badge_class = "ro-badge--green" -%}
                {%- endif -%}
              {%- endif -%}

              {%- comment -%} Merged: 6 variant captures into single pass {%- endcomment -%}
              {%- assign variant_ids = '' -%}
              {%- assign line_item_ids = '' -%}
              {%- assign variant_quantities = '' -%}
              {%- assign variant_inventories = '' -%}
              {%- assign variant_inv_policies = '' -%}
              {%- assign variant_inv_trackers = '' -%}
              {%- for li in order.line_items -%}
                {%- assign variant_ids = variant_ids | append: li.variant_id | append: ',' -%}
                {%- assign line_item_ids = line_item_ids | append: li.id | append: ',' -%}
                {%- assign variant_quantities = variant_quantities | append: li.quantity | append: ',' -%}
                {%- assign variant_inventories = variant_inventories | append: li.variant.inventory_quantity | append: ',' -%}
                {%- assign variant_inv_policies = variant_inv_policies | append: li.variant.inventory_policy | append: ',' -%}
                {%- assign variant_inv_trackers = variant_inv_trackers | append: li.variant.inventory_management | append: ',' -%}
              {%- endfor -%}

              {%- comment -%} Determine if reorder should be hidden — mirrors the
                              logic in snippets/all-orders-row.liquid so the My
                              Orders page and the dashboard's Recent Orders
                              section behave identically (cancelled orders,
                              deleted products, custom-type-without-artwork,
                              sample-pack-only, and resolution-reason rules
                              all hide the reorder button). {%- endcomment -%}
              {%- assign hide_reorder = false -%}
              {%- if order.cancelled -%}{%- assign hide_reorder = true -%}{%- endif -%}
              {%- unless hide_reorder -%}
              {%- for li in order.line_items -%}
                {%- if li.product.title == blank and li.variant.title == blank -%}
                  {%- assign hide_reorder = true -%}
                  {%- break -%}
                {%- endif -%}
                {%- assign li_type_check = li.product.type | downcase -%}
                {%- assign li_title_check = li.title | downcase -%}
                {%- assign is_custom_type = false -%}
                {%- if li_type_check contains 'uv dtf' or li_title_check contains 'uv dtf' or li_type_check contains 'custom transfers' or li_title_check contains 'custom transfers' -%}
                  {%- assign is_custom_type = true -%}
                {%- endif -%}
                {%- if is_custom_type -%}
                  {%- assign has_artwork = false -%}
                  {%- for p in li.properties -%}
                    {%- assign pkey = p.first | downcase -%}
                    {%- if pkey == 'preview' or pkey == '_cartimg' or pkey == 'upload (vector files preferred)' or pkey == 'preview gang sheet (low res)' -%}
                      {%- if p.last != blank -%}
                        {%- assign has_artwork = true -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- unless has_artwork -%}
                    {%- assign hide_reorder = true -%}
                    {%- break -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
              {%- endunless -%}

              {%- comment -%} Hide reorder if order contains ONLY sample pack products (ID 6922214080595) {%- endcomment -%}
              {%- unless hide_reorder -%}
                {%- assign all_sample_packs = true -%}
                {%- for li in order.line_items -%}
                  {%- if li.product.id != 6922214080595 -%}
                    {%- assign all_sample_packs = false -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if all_sample_packs -%}{%- assign hide_reorder = true -%}{%- endif -%}
              {%- endunless -%}

              {%- assign is_reprint = false -%}
              {%- for tag in order.tags -%}
                {%- if tag == 'Reprint Order' -%}{%- assign is_reprint = true -%}{%- break -%}{%- endif -%}
              {%- endfor -%}

              {%- assign reprint_label_text = "Reprint Order" -%}
              {%- if is_reprint -%}
                {%- assign reprint_of = order.metafields.custom.reprint_order -%}
                {%- if reprint_of != blank -%}
                  {%- assign reprint_label_text = "(Reprint Order of " | append: reprint_of | append: ")" -%}
                {%- endif -%}
              {%- endif -%}

              {%- assign zero_price_order = false -%}
              {%- if is_reprint or order.cancelled -%}{%- assign zero_price_order = true -%}{%- endif -%}
              {%- assign zero_price_label = '$0.00' -%}
              {%- if is_reprint -%}{%- assign zero_price_label = 'FREE' -%}{%- endif -%}

              {%- comment -%} Hide reorder if order has a resolution reason (unless it contains "shipping") {%- endcomment -%}
              {%- if order.metafields.custom.reso_reason != blank -%}
                {%- assign reso_lower = order.metafields.custom.reso_reason | downcase -%}
                {%- unless reso_lower contains 'shipping' -%}{%- assign hide_reorder = true -%}{%- endunless -%}
              {%- endif -%}

              {%- comment -%} Thumb HTML captured once so we can render it in the left column (default) or at the bottom of the order info column (when cancelled) {%- endcomment -%}
              {%- capture ro_thumb_inner -%}
                {%- if custom_image_url != "" -%}
                  {%- comment -%}
                    ANY broken custom preview gates the reorder button
                    immediately — call __noImg(this) on the FIRST error
                    rather than waiting for the product-image fallback
                    to also fail. Reorder relies on the original
                    artwork URL still being valid; if it isn't, the
                    customer can't reorder this design even if we can
                    fall back to a generic product image for display.
                  {%- endcomment -%}
                  <img src="{{ custom_image_url }}" alt="{{ first_item.title | escape }}" width="44" height="44" loading="lazy" onerror="var e=this;if(window.__noImg)window.__noImg(e);e.onerror=null;e.src='{{ first_item.product.featured_image | image_url: width: 120 }}';">
                {%- elsif item_image -%}
                  <img src="{{ item_image | image_url: width: 120 }}" alt="{{ first_item.title | escape }}" width="44" height="44" loading="lazy">
                {%- else -%}
                  <div class="ro-thumb-placeholder">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                  </div>
                {%- endif -%}
              {%- endcapture -%}

              {%- comment -%} Desktop row {%- endcomment -%}
              <div class="ro-order-row{% if line_count > 1 %} ro-has-items{% endif %}{% if zero_price_order %} ro-cancelled{% endif %}" data-order-id="ro-{{ order.name | handleize }}">
                <div class="recent-orders__row"{% if line_count > 1 %} data-toggle-ro="ro-{{ order.name | handleize }}"{% endif %}>
                  <div class="recent-orders__col recent-orders__col--order">
                    <div class="recent-orders__order-name-row">
                      <a href="#" class="recent-orders__order-name-link ro-view-details-btn" data-order-handle="{{ order.name | handleize }}">{{ order.name }}</a>
                      {{ ro_trackings_desktop }}
                    </div>
                    <div class="recent-orders__order-date">{{ order.created_at | date: "%b %-d, %Y" }}</div>
                    <div class="recent-orders__order-product">{{ product_name }}</div>
                    <div class="recent-orders__order-desc">{{ item_desc }}{%- if line_count > 1 -%} &mdash; <button type="button" class="ao-expand-btn" style="display:inline;background:none;border:none;outline:none;font-size:inherit;font-weight:600;color:#019AFF;padding:0;margin:0;cursor:pointer;font-family:inherit;-webkit-appearance:none;appearance:none;" data-toggle-ro="ro-{{ order.name | handleize }}" onclick="event.stopPropagation()">view all <span class="ao-arrow">&darr;</span></button>{%- endif -%}</div>
                    {%- if order_nickname != blank -%}
                      <div class="recent-orders__order-nickname"><span class="recent-orders__nickname-label">Order Nickname:</span> {{ order_nickname }}</div>
                    {%- endif -%}
                    {%- assign ro_toggle_value_d = order.name | handleize | prepend: 'ro-' -%}
                    {% render 'order-thumb-strip', order: order, line_count: line_count, toggle_value: ro_toggle_value_d, toggle_attr: 'data-toggle-ro' %}
                  </div>
                  <div class="recent-orders__col recent-orders__col--status">
                    {%- if is_reprint -%}<span class="ro-reprint-label">{{ reprint_label_text }}</span>{%- endif -%}
                    <span class="ro-status {{ badge_class }}">
                      {%- unless order.cancelled -%}
                        <span class="ro-status-icon">
                          {%- if fulfillment == "fulfilled" -%}
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                          {%- elsif fulfillment_label == "Artwork Blocked" -%}
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                          {%- else -%}
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                          {%- endif -%}
                        </span>
                      {%- endunless -%}
                      {{ fulfillment_label }}
                    </span>
                    {%- if fulfillment_label == "Artwork Blocked" -%}
