  /* Click "View Image" button in Recent Designs (uses portal-level openRdLightbox) */
  section.addEventListener('click', function(e) {
    var btn = e.target.closest('.rd-card__view-img');
    if (btn) {
      e.preventDefault();
      if (window.openRdLightbox) window.openRdLightbox(btn.getAttribute('data-rd-view-src'), btn.getAttribute('data-rd-view-name'));
    }
  });

  /* --- Archive Confirmation --- */
  var rdArchiveOverlay = section.querySelector('.rd-archive-overlay');
  var rdArchiveModalName = section.querySelector('.rd-archive-modal__name');
  var rdArchiveConfirm = section.querySelector('.rd-archive-modal__confirm');
  var rdArchiveCancel = section.querySelector('.rd-archive-modal__cancel');
  var pendingRdArchiveId = null;

  function openRdArchiveModal(id) {
    pendingRdArchiveId = id;
    var design = allDesignsFiltered.find(function(d) { return String(d.id) === String(id); });
    if (rdArchiveModalName) rdArchiveModalName.textContent = design ? design.fileName : 'this design';
    if (rdArchiveOverlay) rdArchiveOverlay.style.display = 'flex';
  }
  function closeRdArchiveModal() {
    pendingRdArchiveId = null;
    section._pendingBulkArchiveIds = null;
    if (rdArchiveOverlay) rdArchiveOverlay.style.display = 'none';
  }
  if (rdArchiveCancel) rdArchiveCancel.addEventListener('click', closeRdArchiveModal);
  if (rdArchiveOverlay) rdArchiveOverlay.addEventListener('click', function(e) { if (e.target === rdArchiveOverlay) closeRdArchiveModal(); });
  if (rdArchiveConfirm) rdArchiveConfirm.addEventListener('click', function() {
    var bulkIds = section._pendingBulkArchiveIds;
    var ids = bulkIds && bulkIds.length ? bulkIds : (pendingRdArchiveId ? [pendingRdArchiveId] : []);
    if (ids.length === 0) return;
    var archived = getArchived();
    ids.forEach(function(id) {
      if (archived.indexOf(String(id)) === -1) {
        archived.push(String(id));
      }
    });
    try { localStorage.setItem(ARCHIVE_KEY, JSON.stringify(archived)); } catch(e) {}
    /* Notify My Designs about archive change */
    try { window.dispatchEvent(new CustomEvent('nt-archive-changed', { detail: { source: 'recent-designs', ids: ids } })); } catch(e) {}
    /* Remove cards from carousel */
    ids.forEach(function(id) {
      var card = track.querySelector('[data-rd-design-id="' + id + '"]');
      if (card) card.remove();
    });
    /* Clear selection */
    rdSelectedIds = rdSelectedIds.filter(function(sid) { return ids.indexOf(sid) === -1; });
    rdUpdateSelectionBar();
    /* Check if carousel is now empty */
    if (!track.querySelector('.rd-card')) {
      scrollWrap.style.display = 'none';
      emptyEl.style.display = 'block';
    }
    requestAnimationFrame(updateArrows);
    closeRdArchiveModal();
  });

  /* Archive button click (desktop text + mobile trash) */
  section.addEventListener('click', function(e) {
    var archBtn = e.target.closest('[data-rd-archive-id]');
    if (archBtn) {
      e.preventDefault();
      e.stopPropagation();
      openRdArchiveModal(archBtn.getAttribute('data-rd-archive-id'));
    }
  });

  /* --- Selection checkbox + thumb click --- */
  section.addEventListener('click', function(e) {
    var selectBtn = e.target.closest('[data-rd-select-id]');
    if (selectBtn) {
      e.preventDefault();
      e.stopPropagation();
      if (selectBtn.classList.contains('rd-card__select--disabled')) return;
      rdToggleSelection(selectBtn.getAttribute('data-rd-select-id'));
      return;
    }
    var thumbArea = e.target.closest('.rd-card__thumb');
    if (thumbArea && !e.target.closest('.rd-card__trash') && !e.target.closest('.rd-card__badge') && !e.target.closest('.rd-card__overlay-btn')) {
      var thumbCard = thumbArea.closest('.rd-card[data-rd-design-id]');
      if (thumbCard) {
        e.preventDefault();
        e.stopPropagation();
        rdToggleSelection(thumbCard.getAttribute('data-rd-design-id'));
        return;
      }
    }
  });

  /* --- Upload tile click (redirect to My Designs page) --- */
  section.addEventListener('click', function(e) {
    var uploadBtn = e.target.closest('[data-rd-upload-open]');
    if (!uploadBtn) return;
    e.preventDefault();
    e.stopPropagation();
    var target = uploadBtn.getAttribute('data-rd-upload-open');
    var input = section.querySelector('.rd-upload-input[data-rd-upload-target="' + target + '"]');
    if (input) input.click();
  });

  /* Upload file inputs — handle directly */
  section.querySelectorAll('.rd-upload-input').forEach(function(input) {
    input.addEventListener('change', function() {
      if (input.files && input.files.length > 0) {
        var isGang = input.getAttribute('data-rd-upload-target') === 'gangsheet';
        rdHandleUploadFiles(input.files, isGang);
      }
      input.value = '';
    });
  });

  /* Upload tile drag-and-drop */
  section.addEventListener('dragover', function(e) {
    var tile = e.target.closest('[data-rd-upload-dropzone]');
    if (!tile) return;
    e.preventDefault();
    tile.classList.add('rd-upload-tile--dragover');
  });
  section.addEventListener('dragleave', function(e) {
    var tile = e.target.closest('[data-rd-upload-dropzone]');
    if (!tile) return;
    if (tile.contains(e.relatedTarget)) return;
    tile.classList.remove('rd-upload-tile--dragover');
  });
  section.addEventListener('drop', function(e) {
    var tile = e.target.closest('[data-rd-upload-dropzone]');
    if (!tile) return;
    e.preventDefault();
    tile.classList.remove('rd-upload-tile--dragover');
    var isGang = tile.getAttribute('data-rd-upload-dropzone') === 'gangsheet';
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      rdHandleUploadFiles(e.dataTransfer.files, isGang);
    }
  });

  /* --- Selection bar action handlers --- */
  if (rdSelPrimaryBtn) {
    rdSelPrimaryBtn.addEventListener('click', function() {
      var selectedItems = rdGetSelectedDesigns();
      if (selectedItems.length === 0) return;
      if (selectedItems.length === 1 && selectedItems[0].gangsheet) {
        window.location.href = reorderUrl(selectedItems[0]);
        return;
      }
      if (selectedItems.length === 1) {
        window.location.href = reorderUrl(selectedItems[0]);
        return;
      }
      /* Multi-select: build bulk payload matching My Designs format */
      var S3_EXTS = ['ai', 'eps', 'pdf', 'psd'];
      var payload = selectedItems.map(function(d) {
        var ext = (d.file || '').split('?')[0].split('.').pop().toLowerCase();
        var needsS3 = S3_EXTS.indexOf(ext) > -1;
        var fileURL;
        if (needsS3) {
          fileURL = d.s3File ? d.s3File.split('?')[0] : d.file.replace(IMGIX, S3).split('?')[0];
        } else {
          fileURL = d.file.split('?')[0];
        }
        var entry = { id: String(d.id), name: d.fileName, fileURL: fileURL };
        var dims = extractDimensions(d.variantTitle);
        if (dims) { entry.designWidth = dims.width; entry.designHeight = dims.height; }
        return entry;
      });
      var url = new URL('/products/dtf-transfers', window.location.origin);
      url.searchParams.set('my_designs_selection', encodeURIComponent(JSON.stringify(payload)));
      var currentParams = new URLSearchParams(window.location.search);
      if (currentParams.has('preview_theme_id')) {
        url.searchParams.set('preview_theme_id', currentParams.get('preview_theme_id'));
      }
      window.location.href = url.pathname + url.search;
    });
  }
  if (rdSelArchiveBtn) {
    rdSelArchiveBtn.addEventListener('click', function() {
      var selectedItems = rdGetSelectedDesigns();
      if (selectedItems.length === 0) return;
      var ids = selectedItems.map(function(d) { return String(d.id); });
      /* Use existing archive modal for bulk */
      if (rdArchiveModalName) rdArchiveModalName.textContent = ids.length === 1 ? selectedItems[0].fileName : (ids.length + ' selected designs');
      pendingRdArchiveId = null;
      /* Store bulk IDs for confirm handler */
      section._pendingBulkArchiveIds = ids;
      if (rdArchiveOverlay) rdArchiveOverlay.style.display = 'flex';
    });
  }
  if (rdSelSecondaryBtn) {
    rdSelSecondaryBtn.addEventListener('click', function() {
      var selectedItems = rdGetSelectedDesigns();
      if (selectedItems.length === 0) return;
      if (selectedItems.length === 1 && selectedItems[0].gangsheet) {
        var gsItem = selectedItems[0];
        var gsVp = vectorParams(gsItem);
        rdOoGsOverlay.querySelectorAll('.rd-oo-gs-card').forEach(function(card) {
          var handle = card.getAttribute('data-rd-gs-handle');
          var variant = card.getAttribute('data-rd-gs-variant');
          var url = '/products/' + handle + '?';
          if (variant) url += 'variant=' + variant + '&';
          url += 'file=' + encodeURIComponent(gsItem.file.split('?')[0]) + gsVp;
          card.href = url;
        });
        rdOoGsOverlay.style.display = 'flex';
        return;
      }
      if (selectedItems.length === 1) {
        var bsItem = selectedItems[0];
        var bsVp = vectorParams(bsItem);
        var bsFile = bsItem.file.split('?')[0];
        rdOoOverlay.querySelectorAll('.rd-oo-card').forEach(function(card) {
          var handle = card.getAttribute('data-rd-handle');
          card.href = '/products/' + handle + '?file=' + encodeURIComponent(bsFile) + bsVp;
        });
        rdOoOverlay.style.display = 'flex';
        return;
      }
      /* Multi-select: UV DTF — build bulk payload matching My Designs format */
      var S3_EXTS2 = ['ai', 'eps', 'pdf', 'psd'];
      var payload2 = selectedItems.map(function(d) {
        var ext = (d.file || '').split('?')[0].split('.').pop().toLowerCase();
        var needsS3 = S3_EXTS2.indexOf(ext) > -1;
        var fileURL;
        if (needsS3) {
          fileURL = d.s3File ? d.s3File.split('?')[0] : d.file.replace(IMGIX, S3).split('?')[0];
        } else {
          fileURL = d.file.split('?')[0];
        }
        var entry = { id: String(d.id), name: d.fileName, fileURL: fileURL };
        var dims = extractDimensions(d.variantTitle);
        if (dims) { entry.designWidth = dims.width; entry.designHeight = dims.height; }
        return entry;
      });
      var url2 = new URL('/products/uv-dtf-stickers-decals-by-size', window.location.origin);
      url2.searchParams.set('my_designs_selection', encodeURIComponent(JSON.stringify(payload2)));
      var currentParams2 = new URLSearchParams(window.location.search);
      if (currentParams2.has('preview_theme_id')) {
        url2.searchParams.set('preview_theme_id', currentParams2.get('preview_theme_id'));
      }
      window.location.href = url2.pathname + url2.search;
    });
  }

  /* --- Ordering Options Modal (By-Size) --- */
  var rdOoOverlay = section.querySelector('.rd-oo-overlay');
  var rdOoClose = section.querySelector('.rd-oo-close');

  section.addEventListener('click', function(e) {
    var ooBtn = e.target.closest('[data-rd-oo-file]');
    if (ooBtn) {
      e.preventDefault();
      e.stopPropagation();
      var ooFile = decodeURIComponent(ooBtn.getAttribute('data-rd-oo-file'));
      var vp = decodeURIComponent(ooBtn.getAttribute('data-rd-oo-vp') || '');
      rdOoOverlay.querySelectorAll('.rd-oo-card').forEach(function(card) {
        var handle = card.getAttribute('data-rd-handle');
        card.href = '/products/' + handle + '?file=' + encodeURIComponent(ooFile) + vp;
      });
      rdOoOverlay.style.display = 'flex';
    }
  });
  if (rdOoClose) rdOoClose.addEventListener('click', function() { rdOoOverlay.style.display = 'none'; });
  if (rdOoOverlay) rdOoOverlay.addEventListener('click', function(e) { if (e.target === rdOoOverlay) rdOoOverlay.style.display = 'none'; });

  /* --- Gang Sheet Ordering Options Modal --- */
  var rdOoGsOverlay = section.querySelector('.rd-oo-gs-overlay');
  var rdOoGsClose = section.querySelector('.rd-oo-gs-close');

  section.addEventListener('click', function(e) {
    var gsBtn = e.target.closest('[data-rd-oo-gs-file]');
    if (gsBtn) {
      e.preventDefault();
      e.stopPropagation();
      var gsFile = decodeURIComponent(gsBtn.getAttribute('data-rd-oo-gs-file'));
      var gsVp = decodeURIComponent(gsBtn.getAttribute('data-rd-oo-vp') || '');
      rdOoGsOverlay.querySelectorAll('.rd-oo-gs-card').forEach(function(card) {
        var handle = card.getAttribute('data-rd-gs-handle');
        var variant = card.getAttribute('data-rd-gs-variant');
        var url = '/products/' + handle + '?';
        if (variant) url += 'variant=' + variant + '&';
        url += 'file=' + encodeURIComponent(gsFile) + gsVp;
        card.href = url;
      });
      rdOoGsOverlay.style.display = 'flex';
    }
  });
  if (rdOoGsClose) rdOoGsClose.addEventListener('click', function() { rdOoGsOverlay.style.display = 'none'; });
  if (rdOoGsOverlay) rdOoGsOverlay.addEventListener('click', function(e) { if (e.target === rdOoGsOverlay) rdOoGsOverlay.style.display = 'none'; });

  /* Fetch all designs */
  var allItems = [];
  var done = 0;
  var total = 3;
  function checkDone() {
    done++;
    if (done >= total) renderCards(allItems);
  }

  /* Unwrap `{ data: [...] }` responses if the API returns that shape; some
     endpoints (esp. /uploads/orderDataNew) wrap the array. Keeps the rest
     of the pipeline assuming a plain array. */
  function unwrapArray(resp) {
    if (Array.isArray(resp)) return resp;
    if (resp && Array.isArray(resp.data)) return resp.data;
    return [];
  }

  /* IMPORTANT: use the same endpoints as my-designs-panel.liquid so the two
     panels stay in sync. The /orders/fetchDataNew + /orders/gangsheet pair
     omits recent purchases (e.g. Orange Rush) that /uploads/orderDataNew
     does include. */
  fetch(API + '/uploads/fetchDataNew?customer_id=' + CID)
    .then(function(r) { return r.json(); })
    .then(function(data) { unwrapArray(data).forEach(function(i) { allItems.push(processItem(i, 'upload')); }); checkDone(); })
    .catch(checkDone);

  fetch(API + '/uploads/orderDataNew?customer_id=' + CID + '&gangsheet=false')
    .then(function(r) { return r.json(); })
    .then(function(data) { unwrapArray(data).forEach(function(i) { allItems.push(processItem(i, 'purchase')); }); checkDone(); })
    .catch(checkDone);

  fetch(API + '/uploads/orderDataNew?customer_id=' + CID + '&gangsheet=true')
    .then(function(r) { return r.json(); })
    .then(function(data) { unwrapArray(data).forEach(function(i) { i.gangsheet = true; allItems.push(processItem(i, 'purchase')); }); checkDone(); })
    .catch(checkDone);

  /* Re-fetch designs after upload */
  async function rdFetchDesigns() {
    try {
      var results = await Promise.all([
        fetch(API + '/uploads/fetchDataNew?customer_id=' + CID).then(function(r) { return r.json(); }).catch(function() { return []; }),
        fetch(API + '/uploads/orderDataNew?customer_id=' + CID + '&gangsheet=false').then(function(r) { return r.json(); }).catch(function() { return []; }),
        fetch(API + '/uploads/orderDataNew?customer_id=' + CID + '&gangsheet=true').then(function(r) { return r.json(); }).catch(function() { return []; })
      ]);
      var items = [];
      unwrapArray(results[0]).forEach(function(i) { items.push(processItem(i, 'upload')); });
      unwrapArray(results[1]).forEach(function(i) { items.push(processItem(i, 'purchase')); });
      unwrapArray(results[2]).forEach(function(i) { i.gangsheet = true; items.push(processItem(i, 'purchase')); });
      /* Merge with local uploaded designs */
      var merged = rdLocalUploadedDesigns.slice();
      items.forEach(function(item) {
        if (!merged.some(function(m) { return makeUploadMatchKey(m, !!m.gangsheet) === makeUploadMatchKey(item, !!item.gangsheet); })) merged.push(item);
      });
      /* Sync local IDs to server IDs */
      rdLocalUploadedDesigns.forEach(function(local) {
        var matchKey = makeUploadMatchKey(local, !!local.gangsheet);
        var fetched = items.find(function(item) { return makeUploadMatchKey(item, !!item.gangsheet) === matchKey; });
        if (fetched && String(local.id).indexOf('local-') === 0) {
          var oldId = String(local.id);
          rdSelectedIds = rdSelectedIds.map(function(id) { return String(id) === oldId ? String(fetched.id) : id; });
          local.id = fetched.id;
          /* Update merged array to use server design with local thumb */
          for (var mi = 0; mi < merged.length; mi++) {
            if (String(merged[mi].id) === oldId) { fetched.localThumb = local.localThumb || ''; merged[mi] = fetched; break; }
          }
        }
      });
      rdSelectedIds = uniq(rdSelectedIds);
      renderCards(merged);
    } catch(e) { console.error('[Recent Designs] Refresh error:', e); }
  }

  /* Listen for archive changes from My Designs → re-render Recent Designs */
  window.addEventListener('nt-archive-changed', function(e) {
    if (e.detail && e.detail.source === 'my-designs') {
      rdRenderCards();
    }
  });

  /* Resize observer for arrows */
  if (window.ResizeObserver) {
    new ResizeObserver(updateArrows).observe(track);
  }
})();
</script>

