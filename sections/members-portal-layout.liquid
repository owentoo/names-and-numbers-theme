        if (rewritten) args[0] = rewritten;
      }
      return origOpen.apply(window, args);
    };

    /* 4. Catch form submissions with design studio params */
    document.addEventListener('submit', function(e) {
      var form = e.target;
      var action = form.getAttribute('action') || '';
      if (action.indexOf(dsParam) !== -1 && !isAllowedDestination(action)) {
        e.preventDefault();
        var rewritten = rewriteDesignStudioUrl(action);
        if (rewritten) window.location.href = rewritten;
      }
