        }
      });
      props['reorder'] = 'of order #' + btn.attr('data-order-name') + ' / ' + btn.attr('data-lineitem-id');
      var qty = parseInt(btn.attr('data-quantity'));
      if (btn.attr('data-inventory-policy') === 'deny' && btn.attr('data-inventory-tracker') !== '') {
