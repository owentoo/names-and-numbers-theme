<script>
  /* Reveal portal now that styles are loaded — prevents FOUC */
  (function() {
    var el = document.querySelector('.members-portal') || document.querySelector('.mp-login-prompt');
    if (el) el.classList.add('mp-ready');
  })();

  /* Dashboard header: time-based greeting */
  (function() {
    var greetEl = document.getElementById('mp-greeting');
    if (greetEl) {
      var h = new Date().getHours();
      var tod = h < 12 ? 'Morning' : h < 17 ? 'Afternoon' : 'Evening';
      greetEl.textContent = greetEl.textContent.replace(/^Good \w+/, 'Good ' + tod);
    }
  })();
</script>

