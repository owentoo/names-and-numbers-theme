          links.forEach(function(a) {
            var href = a.getAttribute('href');
            if (href && !isAllowedDestination(href)) {
              var rewritten = rewriteDesignStudioUrl(href);
              if (rewritten) a.setAttribute('href', rewritten);
            }
          });
          /* Check the node itself */
          if (node.tagName === 'A' && node.getAttribute('href')) {
            var h = node.getAttribute('href');
            if (h.indexOf(dsParam) !== -1 && !isAllowedDestination(h)) {
              var r = rewriteDesignStudioUrl(h);
              if (r) node.setAttribute('href', r);
            }
