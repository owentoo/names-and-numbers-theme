{%- comment -%}
  Mobile-only override: when the Design Studio is loaded inside the portal
  AJAX panel and the user taps the X Exit toggle (#fullscreen-toggle-btn),
  redirect them back to /pages/welcome instead of running the studio's
  default fullscreen-toggle behavior. Capture-phase document listener so we
  win before the studio's own click handler. Only active on screens ≤ 768px
  and only when the Exit button is inside .mp-ajax-content.
{%- endcomment -%}
<script>
  (function () {
    if (window.__mpStudioExitInit) return;
    window.__mpStudioExitInit = true;
    document.addEventListener('click', function (e) {
      if (window.innerWidth > 768) return;
      var btn = e.target && e.target.closest && e.target.closest('#fullscreen-toggle-btn');
      if (!btn) return;
      if (!btn.closest('.mp-ajax-content')) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      window.location.href = '/pages/welcome';
    }, true);
  })();
</script>

