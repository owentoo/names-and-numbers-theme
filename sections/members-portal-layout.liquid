  /* Fallback: resolve panel from nav-link icon when URL isn't in inlinePanels */
  var iconPanels = { 'profile': 'profile' };
  function panelForLink(l) {
    var u = resolveUrl(l.getAttribute('data-url'));
    if (!u || u === '' || u === '/pages/welcome') return 'dashboard';
