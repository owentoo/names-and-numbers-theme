<script>
  /* Broken-preview → no-reorder gate.
     order-thumb-strip.liquid and order-line-items.liquid call
     window.__noImg(el) from each order row's <img onerror>. The previous
     theme referenced this function without defining it, so the call was
     a silent TypeError and the reorder button kept showing on orders
     with broken preview URLs (e.g. customers whose imgix-hosted upload
     expired or was deleted). Define it here once so both the Recent
     Orders strip (members-portal-layout.liquid inline) and the My
     Orders table (my-orders-content.liquid via all-orders-row) get the
     hide behavior.

     Strategy: walk up to the row wrapper, hide every reorder element
     inside it. Selectors cover all four row variants — recent-orders
     desktop (.ro-order-row), recent-orders mobile (.ro-order-row-mobile),
     all-orders desktop (.ao-order-row), all-orders mobile
     (.ao-order-row-mobile). Hides both the visible button
     (.recent-orders__reorder-btn / .all-orders__reorder-btn) and the
     hidden textarea wrap (.recent-orders__reorder-wrap /
     .all-orders__reorder-wrap) plus the per-line-item variant
     (.ao-li-reorder / .ro-li-reorder). */
  if (typeof window.__noImg !== 'function') {
    window.__noImg = function (el) {
