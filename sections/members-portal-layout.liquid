  /* --- Recent Designs carousel --- */
  .recent-designs-section { margin-top: 32px; }
  .recent-designs__header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px; }
  .rd-scroll-wrap { position: relative; }
  .rd-track { display: flex; gap: 16px; overflow-x: auto; scroll-behavior: smooth; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding: 4px 0 8px; align-items: flex-start; }
  .rd-track::-webkit-scrollbar { display: none; }
  .rd-track .rd-card { flex: 0 0 200px; min-width: 0; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s; }
  .rd-track .rd-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); transform: translateY(-2px); }
  /* Thumbnail — canonical site-wide transparent-checker pattern. SVG
     inlined (rather than var(--nt-checker-image)) so it cannot be
     silently lost in stacking contexts where the :root custom property
     fails to resolve. Same encoded SVG used in assets/theme.css and
     assets/__blanksUploadHelper.css file-preview, so the My Designs
     panel, Recent Designs, Previous Designs picker, and the upload
     preview all share the exact same checker. !important guards
     against the older light-grey gradient bleeding back. */
  .rd-card__thumb { position: relative; aspect-ratio: 1; overflow: hidden; cursor: pointer;
    background-color: #f2f2f2 !important;
    background-image: url("data:image/svg+xml;base64,") !important;
    background-position: center center !important;
    background-size: 10px !important;
    display: flex; align-items: center; justify-content: center; padding: 8px; box-sizing: border-box; }
  .rd-card__thumb img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; object-position: center; display: block; }
  .rd-card--gangsheet .rd-card__thumb img { object-fit: contain; object-position: center; padding: 4px; }
  .rd-card__badge { position: absolute; top: 8px; right: 8px; font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.03em; z-index: 2; }
  .rd-card__badge--bysize { background: #dbeafe; color: #1e40af; }
  .rd-card__badge--gangsheet { background: #fae8ff; color: #7e22ce; }
  .rd-card__info { padding: 8px 12px 6px; }
  .rd-card__name { font-size: 12px; font-weight: 600; color: #111; margin: 0 0 4px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; line-height: 1.4; }
  .rd-card__ext { white-space: nowrap; font-weight: 500; color: #6b7280; }
  .rd-card__meta { font-size: 11px; color: #9ca3af; margin: 0; }
  .rd-card__action { padding: 0 12px 8px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .rd-card__action-row { display: flex; align-items: center; justify-content: space-between; width: 100%; }
  .rd-card__view-img { background: none; border: none; font-size: 11px; color: #019AFF; cursor: pointer; padding: 0; font-family: inherit; font-weight: 500; transition: color 0.15s; display: inline-flex; align-items: center; gap: 3px; }
  .rd-card__view-img:hover { color: #0079cc; }
  .rd-card__action-btn { background: none; border: none; font-size: 11px; color: #6b7280; cursor: pointer; padding: 0; font-family: inherit; text-decoration: underline; transition: color 0.15s; }
  .rd-card__action-btn:hover { color: #111; }
  .rd-card__archive-icon { text-decoration: none; display: inline-flex; align-items: center; justify-content: center; transition: color 0.15s, opacity 0.15s; }
  .rd-card__archive-icon:hover { color: #111; opacity: 0.85; }
  .rd-card__archive-icon svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; }

  /* Hover overlay — disabled, using selection + action row instead */
  .rd-card__overlay { display: none; }

  /* --- Upload card in carousel --- */
  .rd-upload-card { flex: 0 0 200px; min-width: 0; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; box-sizing: border-box; padding: 8px; align-self: stretch; }
  @media (min-width: 769px) {
    .rd-upload-card { position: sticky; left: 0; z-index: 6; box-shadow: 4px 0 8px -4px rgba(15,23,42,0.08); }
  }
  .rd-upload-card__stack { display: flex; flex-direction: column; gap: 6px; height: 100%; }
  .rd-upload-tile { width: 100%; border: 1.5px dashed #cbd5e1; border-radius: 12px; background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 10px 10px; box-sizing: border-box; color: #111827; font-family: inherit; cursor: pointer; transition: border-color 0.15s, background 0.15s, box-shadow 0.15s; flex: 1; min-height: 0; }
  .rd-upload-tile:hover { border-color: #019aff; box-shadow: 0 8px 22px rgba(1,154,255,0.12); background: linear-gradient(180deg, #ffffff 0%, #eff8ff 100%); }
  .rd-upload-tile--dragover { border-color: #019aff; background: linear-gradient(180deg, #eef8ff 0%, #dff2ff 100%); box-shadow: 0 0 0 2px rgba(1,154,255,0.12); }
  .rd-upload-tile__icon { width: 28px; height: 28px; border-radius: 999px; background: #e0f2ff; color: #019aff; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 4px; }
  .rd-upload-tile__icon svg { width: 14px; height: 14px; }
  .rd-upload-tile__title { font-size: 11px; font-weight: 700; color: #111827; margin-bottom: 5px; line-height: 1.3; }
  .rd-upload-tile__browse { display: inline-flex; align-items: center; justify-content: center; min-width: 72px; padding: 5px 12px; border-radius: 999px; background: #019aff; color: #fff; font-size: 10px; font-weight: 700; margin-bottom: 4px; }
  .rd-upload-tile__note { font-size: 9px; color: #6b7280; line-height: 1.35; }

  /* --- Card select checkbox --- */
  .rd-card__select { position: absolute; top: 8px; left: 8px; z-index: 4; width: 22px; height: 22px; border: 1.5px solid #cbd5e1; border-radius: 6px; background: rgba(255,255,255,0.96); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: all 0.15s; box-shadow: 0 1px 3px rgba(15,23,42,0.08); padding: 0; }
  .rd-card__select:hover { border-color: #019aff; }
  .rd-card__select svg { width: 13px; height: 13px; stroke: #fff; opacity: 0; transition: opacity 0.15s; fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .rd-card__select--selected { border-color: #019aff; background: #019aff; }
  .rd-card__select--selected svg { opacity: 1; }
  .rd-card__select--disabled { background: #e5e7eb; border-color: #d1d5db; cursor: not-allowed; }
  .rd-card__select--disabled svg { display: none; }

  /* --- Selected card state --- */
  .rd-card--selected { border-color: #019aff; box-shadow: 0 0 0 2px rgba(1,154,255,0.18); }
  .rd-card--selection-disabled { opacity: 0.45; pointer-events: none; }

  /* --- Selection action bar --- */
  .rd-selection-bar { position: relative; display: flex; align-items: center; gap: 18px; padding: 14px 18px; background: rgba(17,24,39,0.96); color: #fff; border-radius: 16px; box-shadow: 0 18px 48px rgba(15,23,42,0.28); z-index: 9998; max-width: 760px; width: 100%; box-sizing: border-box; margin: 16px auto 0; }
  .rd-selection-bar__summary-group { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
  .rd-selection-bar__summary { font-size: 14px; font-weight: 700; white-space: nowrap; }
  .rd-selection-bar__note { font-size: 12px; font-weight: 600; color: #f87171; text-align: right; margin-left: auto; }
  .rd-selection-bar__actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex: 1; }
  .rd-selection-bar__btn { border-radius: 999px; border: 1px solid transparent; padding: 11px 18px; font-size: 13px; font-weight: 700; font-family: inherit; cursor: pointer; transition: transform 0.15s, filter 0.15s, background 0.15s, border-color 0.15s; white-space: nowrap; }
  .rd-selection-bar__btn:hover { filter: brightness(1.05); transform: translateY(-1px); }
  .rd-selection-bar__btn--primary { background: #019aff; color: #fff; }
  .rd-selection-bar__btn--secondary { background: transparent; color: #fff; border-color: rgba(255,255,255,0.3); }
  .rd-selection-bar__btn--danger { background: #4b5563; color: #fff; display: inline-flex; align-items: center; gap: 8px; }
  .rd-selection-bar__btn--danger svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* Mobile trash icon (hidden on desktop) */
  .rd-card__trash { display: none; }
  /* CTA & More Options */
  .rd-card__action-cta { display: none; }
  .rd-card__action-more { display: none; }

  /* Uploading state */
  .rd-card--uploading .rd-card__thumb { cursor: default; }
  .rd-card--uploading .rd-card__thumb::after { content: ''; position: absolute; inset: 0; background: rgba(255,255,255,0.72); z-index: 1; }
  .rd-card__upload-spinner { position: absolute; top: 50%; left: 50%; width: 28px; height: 28px; margin: -20px 0 0 -14px; border: 3px solid #e5e7eb; border-top-color: #019aff; border-radius: 50%; z-index: 2; animation: rdSpin 0.7s linear infinite; }
  .rd-card__upload-copy { position: absolute; top: 50%; left: 0; right: 0; margin-top: 18px; text-align: center; font-size: 11px; font-weight: 600; color: #019aff; z-index: 2; }
  @keyframes rdSpin { to { transform: rotate(360deg); } }

  /* Image Lightbox */
  .rd-lightbox { position: fixed; inset: 0; background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center; z-index: 99999; padding: 24px; cursor: pointer; }
  .rd-lightbox__close { position: absolute; top: 16px; right: 20px; background: none; border: none; color: #fff; font-size: 36px; cursor: pointer; line-height: 1; z-index: 2; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; opacity: 0.8; transition: opacity 0.15s; }
  .rd-lightbox__close:hover { opacity: 1; }
  .rd-lightbox__img { max-width: 90vw; max-height: 85vh; object-fit: contain; border-radius: 8px; box-shadow: 0 8px 40px rgba(0,0,0,0.4); cursor: default; background: #fff; }
  .rd-lightbox__img--loading { display: none; }
  .rd-lightbox__spinner { display: none; }
  .rd-lightbox__spinner--visible { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; justify-content: center; }
  .rd-lightbox__spinner-text { width: 100%; text-align: center; color: rgba(255,255,255,0.7); font-size: 13px; margin: 12px 0 0; font-weight: 400; }
  .rd-lightbox__spinner div { width: 12px; height: 12px; border-radius: 50%; background: #fff; animation: rd-lb-pulse 1.2s ease-in-out infinite; }
  .rd-lightbox__spinner div:nth-child(2) { animation-delay: 0.2s; }
  .rd-lightbox__spinner div:nth-child(3) { animation-delay: 0.4s; }
  @keyframes rd-lb-pulse { 0%, 80%, 100% { opacity: 0.25; transform: scale(0.8); } 40% { opacity: 1; transform: scale(1); } }

  /* Archive confirm modal */
  .rd-archive-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; z-index: 9999; padding: 20px; }
  .rd-modal { background: #fff; border-radius: 12px; padding: 28px; max-width: 420px; width: 100%; box-shadow: 0 20px 60px rgba(0,0,0,0.2); }
  .rd-modal__title { font-size: 18px; font-weight: 700; color: #111; margin: 0 0 12px; }
  .rd-modal__text { font-size: 14px; color: #6b7280; margin: 0 0 24px; line-height: 1.5; }
