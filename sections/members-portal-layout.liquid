{%- comment -%} ============================= STYLES ============================= {%- endcomment -%}
<style>
  /* Protect header from being hidden by AJAX-loaded content (e.g. Design Studio) — DESKTOP ONLY.
     On mobile (<=768px), let the design-tool-widget's fullscreen overlay rules take over so
     /pages/welcome → "Ninja Design Studio" replicates /pages/ninja-design-studio mobile
     experience: site chrome hidden, studio fills the viewport edge-to-edge. */
  @media (min-width: 769px) {
    .template-page-members-portal .shopify-section-group-header-group.site-header-container,
    .template-page-members-portal .shopify-section-group-header-group.mount-announcement-bar {
      display: block !important;
      opacity: 1 !important;
      height: auto !important;
      pointer-events: auto !important;
    }
    .template-page-members-portal .header-container.header-container--top {
      opacity: 1 !important;
      height: auto !important;
      pointer-events: auto !important;
    }
    /* Scope Design Studio editor to portal content area on desktop.
       Selector chains .customTabelPopup__overlay-editor to outrank the
       studio's own equally-specific .customTabelPopup__overlay-editor
       .editor-container rule that uses 100dvh — the studio CSS arrives
       via AJAX after this stylesheet, so on equal specificity it would
       win the load-order tie. Tight enough that the whole canvas square
       fits top-to-bottom on a typical laptop viewport. */
    .mp-ajax-content .customTabelPopup__overlay-editor .editor-container {
      height: calc(100vh - 220px) !important;
    }
    .mp-ajax-content .customTabelPopup__overlay-editor {
      position: static !important;
    }
  }
  /* Mobile: keep the AJAX panel itself out of the way so the studio's own
     position:fixed; inset:0; z-index:9999 rules from design-tool-widget can
     fill the viewport without being clipped/contained. */
  @media (max-width: 768px) {
    .template-page-members-portal .mp-panel[data-panel="ajax"] {
      overflow: visible !important;
    }
    .mp-ajax-content {
      overflow: visible !important;
    }
  }

  /* Hide the legacy "Create a design with Ninja AI" pink CTA box that the
     AJAX-loaded design studio renders below the canvas. The studio's own
     AI panel handles this flow now; the pink box is just visual noise here.
