  var ajaxPanel = section.querySelector('[data-panel="ajax"]');
  var ajaxContent = section.querySelector('.mp-ajax-content');
  var currentAjaxUrl = '';
  /* Pane-cache: each URL keeps its DOM subtree so scripts run once. */
  var ajaxPanes = {};
  var ajaxStatusEl = null;

  function clearAjaxStatus() {
    if (ajaxStatusEl && ajaxStatusEl.parentNode) {
      ajaxStatusEl.parentNode.removeChild(ajaxStatusEl);
    }
    ajaxStatusEl = null;
  }

  function showAjaxPane(url) {
    clearAjaxStatus();
    Object.keys(ajaxPanes).forEach(function(k) {
      ajaxPanes[k].style.display = (k === url) ? '' : 'none';
    });
  }

  function showAjaxStatus(html) {
    Object.keys(ajaxPanes).forEach(function(k) {
      ajaxPanes[k].style.display = 'none';
    });
    clearAjaxStatus();
    ajaxStatusEl = document.createElement('div');
    ajaxStatusEl.innerHTML = html;
    ajaxContent.appendChild(ajaxStatusEl);
  }

  function loadAjaxContent(url) {
    /* my-messages: evict pane each visit (Atomato shadow DOM drifts). */
    var bypassCache = url.indexOf('my-messages') !== -1;
    if (bypassCache && ajaxPanes[url]) {
      ajaxPanes[url].remove();
      delete ajaxPanes[url];
    }

    if (currentAjaxUrl === url && ajaxPanes[url]) {
      showAjaxPane(url);
      showPanel('ajax');
      return;
    }
    currentAjaxUrl = url;
    ajaxPanel.classList.add('mp-ajax--loading');
    showPanel('ajax');

    if (ajaxPanes[url]) {
      showAjaxPane(url);
      ajaxPanel.classList.remove('mp-ajax--loading');
      return;
    }

    fetch(url, { credentials: 'same-origin' })
      .then(function(res) { return res.text(); })
      .then(function(html) {
        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');
