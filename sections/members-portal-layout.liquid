  }

  function resolveUrl(raw) {
    if (raw && raw.indexOf('shopify://pages/') === 0) {
      return '/pages/' + raw.replace('shopify://pages/', '');
    }
    return raw || '';
  }

  function showPanel(panelName) {
    var current = section.querySelector('.mp-panel--active');
    var next = section.querySelector('[data-panel="' + panelName + '"]');
