<script>
(function ($) {
setTimeout(function(){
  var alertShown = false;

  function processNode(root) {
    $(root).find("*").addBack().each(function () {
      var el = this;

      $(el).contents().each(function () {
        if (this.nodeType === 3) { // TEXT NODE
          var text = this.nodeValue;

          if (text && text.toLowerCase().includes("delete account")) {

            if (!alertShown) {
              //alert("✅ 'Delete Account' text found and removed");
              alertShown = true;
            }

            // Remove only the matching text
            this.nodeValue = text.replace(/delete account/gi, "").trim();
          }
        }
      });
    });
  }

  // Initial load
  $(document).ready(function () {
    processNode(document.body);
  });

  // MutationObserver for dynamic content
  var observer = new MutationObserver(function (mutations) {
    mutations.forEach(function (mutation) {
      mutation.addedNodes.forEach(function (node) {
        if (node.nodeType === 1) {
          processNode(node);
        }
      });
    });
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
},5000)
})(jQuery);
</script>
