<script>
/* --- Image Lightbox (document-level, works from any panel / AJAX) --- */
(function() {
  var rdLightbox = document.querySelector('.rd-lightbox');
  var rdLightboxImg = rdLightbox ? rdLightbox.querySelector('.rd-lightbox__img') : null;
  var rdLightboxClose = rdLightbox ? rdLightbox.querySelector('.rd-lightbox__close') : null;
  var rdLightboxSpinner = rdLightbox ? rdLightbox.querySelector('.rd-lightbox__spinner') : null;

  function openRdLightbox(src, alt) {
    if (!rdLightbox || !rdLightboxImg) return;
    rdLightboxImg.classList.add('rd-lightbox__img--loading');
    if (rdLightboxSpinner) rdLightboxSpinner.classList.add('rd-lightbox__spinner--visible');
    var hiRes = src.replace(/h=\d+/, 'h=2400').replace(/w=\d+/, 'w=2400').replace(/q=\d+/, 'q=85');
    rdLightboxImg.onload = function() {
      rdLightboxImg.classList.remove('rd-lightbox__img--loading');
      if (rdLightboxSpinner) rdLightboxSpinner.classList.remove('rd-lightbox__spinner--visible');
    };
    rdLightboxImg.onerror = function() {
      rdLightboxImg.classList.remove('rd-lightbox__img--loading');
      if (rdLightboxSpinner) rdLightboxSpinner.classList.remove('rd-lightbox__spinner--visible');
    };
    rdLightboxImg.src = hiRes;
    rdLightboxImg.alt = alt || '';
    rdLightbox.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
  window.openRdLightbox = openRdLightbox;

  function closeRdLightbox() {
    if (!rdLightbox) return;
    rdLightbox.style.display = 'none';
    rdLightboxImg.onload = null;
    rdLightboxImg.onerror = null;
    rdLightboxImg.src = '';
    rdLightboxImg.classList.remove('rd-lightbox__img--loading');
    if (rdLightboxSpinner) rdLightboxSpinner.classList.remove('rd-lightbox__spinner--visible');
    document.body.style.overflow = '';
  }
  if (rdLightboxClose) rdLightboxClose.addEventListener('click', closeRdLightbox);
  if (rdLightbox) rdLightbox.addEventListener('click', function(e) { if (e.target === rdLightbox) closeRdLightbox(); });

  /* Click any thumbnail with ao-preview-thumb class to open lightbox */
  document.addEventListener('click', function(e) {
    var thumb = e.target.closest('.ao-preview-thumb');
    if (!thumb) return;
    e.preventDefault();
    e.stopPropagation();
    var src = thumb.getAttribute('data-preview-src') || thumb.src;
    if (src) openRdLightbox(src, thumb.alt || '');
  });
})();
</script>

<script>
/* Recent Designs carousel on dashboard */
(function() {
  var section = document.querySelector('.recent-designs-section');
  if (!section) return;
  var CID = section.getAttribute('data-customer-id');
  if (!CID) return;

  var API = 'https://hpz51rjda5.execute-api.us-east-1.amazonaws.com/production';
  var IMGIX = 'ninjauploads-production.imgix.net';
  var S3 = 'ninja-services-production-ninjauploadss3bucket-zks2mguobhe4.s3.amazonaws.com';
  var ARCHIVE_KEY = 'nt-designs-archived-' + CID;

  var loadingEl = section.querySelector('.rd-loading');
  var scrollWrap = section.querySelector('.rd-scroll-wrap');
  var track = section.querySelector('.rd-track');
  var emptyEl = section.querySelector('.rd-empty');
  var arrowL = section.querySelector('.rd-arrow--left');
  var arrowR = section.querySelector('.rd-arrow--right');

  function getArchived() { try { return JSON.parse(localStorage.getItem(ARCHIVE_KEY) || '[]'); } catch(e) { return []; } }

  function thumbUrl(url, isGang) {
    var c = url.replace(S3, IMGIX);
    var sep = c.indexOf('?') > -1 ? '&' : '?';
    if (needsRemotePreview && needsRemotePreview(url)) {
      if (isGang) return c + sep + 'fm=png&w=600&h=600&fit=clip&auto=compress&q=15';
      return c + sep + 'fm=png&w=600&auto=compress&q=15';
    }
    if (isGang) return c + sep + 'w=600&h=600&fit=clip&auto=compress&q=15&dpi=72';
    return c + sep + 'h=300&auto=compress&q=10&dpi=72&trim=colorUnlessAlpha';
  }

  function extractFileName(url) {
    var name = url;
    if (url.indexOf('imgix.net') > -1) { name = url.replace('https://','').split('?')[0].split('/')[1] || name; if (name.indexOf('____image') > -1) { var ext = name.split('.').pop(); name = name.split('____image')[0] + '.' + ext; } }
    else if (url.indexOf('upload.cloudlift.app') > -1) { name = url.split('transferss/')[1] || name; }
    else if (url.indexOf('ninja-services-production') > -1) { name = url.replace('https://','').split('?')[0].split('/')[1] || name; }
    else if (url.indexOf('amazonaws') > -1) { name = url.replace('https://','').split('?')[0].split('/')[2] || name; }
    try { name = decodeURIComponent(name); } catch(e) {}
    return name;
  }

  function smartName(name, max) {
    if (!name) return '';
    max = max || 22;
    var di = name.lastIndexOf('.');
    var ext = di > -1 ? name.substring(di + 1).toLowerCase() : '';
    var base = di > -1 ? name.substring(0, di) : name;
    var suffix = ext ? '.' + ext : '';
    var tMax = max - suffix.length;
    if (tMax < 6) tMax = 6;
    if (base.length > tMax) base = base.substring(0, tMax - 3) + '...';
    return base + suffix;
  }

  function timeAgo(ts, source) {
    var prefix = source === 'upload' ? 'Uploaded' : 'Purchased';
    if (!ts) return prefix;
    var diff = Math.floor(Date.now() / 1000) - ts;
    if (diff < 0) diff = 0;
    var days = Math.floor(diff / 86400);
    if (days === 0) { var hrs = Math.floor(diff / 3600); if (hrs === 0) return prefix + ' just now'; return prefix + ' ' + hrs + (hrs === 1 ? ' hour' : ' hours') + ' ago'; }
    if (days === 1) return prefix + ' 1 day ago';
    return prefix + ' ' + days + ' days ago';
  }

  function processItem(raw, source) {
    var gang = !!raw.gangsheet;
    var fileName = (raw.file_name && raw.file_name.length > 0) ? raw.file_name : extractFileName(raw.file || '');
    var id = raw.photo_id || raw.id || '';
    if (!id && raw.file) id = source + '-' + raw.file.split('/').pop().split('?')[0];
    if (!id) id = source + '-' + Math.random().toString(36).substr(2,9);
    var ts = 0;
    if (typeof raw.formatted_date === 'number') ts = raw.formatted_date;
    else if (typeof raw.formatted_date === 'string' && raw.formatted_date.length > 0) ts = new Date(raw.formatted_date).getTime() / 1000 || 0;
    return { id: id, file: raw.file || '', fileName: fileName, thumb: thumbUrl(raw.file || '', gang), timestamp: ts, gangsheet: gang, source: source, variantTitle: raw.variant_title || '', orderName: raw.order_name || '' };
  }

  var VECTOR_EXTS = ['ai', 'eps', 'pdf'];
  var REMOTE_PREVIEW_EXTS = ['ai', 'eps', 'pdf', 'svg', 'tif', 'tiff', 'psd'];
  function isVectorFile(url) {
    try { var ext = url.split('?')[0].split('.').pop().toLowerCase(); return VECTOR_EXTS.indexOf(ext) > -1; } catch(e) { return false; }
  }
  function needsRemotePreview(url) {
    try { var ext = url.split('?')[0].split('.').pop().toLowerCase(); return REMOTE_PREVIEW_EXTS.indexOf(ext) > -1; } catch(e) { return false; }
  }
  function normalizeFileKey(url) {
    try { var clean = (url || '').split('?')[0]; var parts = clean.split('/'); return decodeURIComponent(parts[parts.length - 1] || clean); } catch(e) { return (url || '').split('?')[0]; }
  }
  function makeUploadMatchKey(fileOrKey, isGangSheet) {
    var sv = typeof fileOrKey === 'string' ? fileOrKey : (fileOrKey ? (fileOrKey.file || fileOrKey.key || fileOrKey.s3File || '') : '');
    return normalizeFileKey(sv) + '|' + (isGangSheet ? '1' : '0');
  }
