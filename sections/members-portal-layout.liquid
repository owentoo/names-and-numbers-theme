  }

  /* Accordion toggle for expandable recent order rows */
  function roToggle(orderId) {
    var allRows = section.querySelectorAll('.ro-order-row[data-order-id], .ro-order-row-mobile[data-order-id]');
    allRows.forEach(function(row) {
      if (row.getAttribute('data-order-id') === orderId) {
        row.classList.toggle('expanded');
        var isExp = row.classList.contains('expanded');
        var btn = row.querySelector('.ao-expand-btn');
        if (btn && !btn.classList.contains('ao-strip-more')) {
          btn.innerHTML = isExp ? 'close <span class="ao-arrow">&uarr;</span>' : 'view all <span class="ao-arrow">&darr;</span>';
        }
      } else {
        row.classList.remove('expanded');
        var btn2 = row.querySelector('.ao-expand-btn');
        if (btn2 && !btn2.classList.contains('ao-strip-more')) {
          btn2.innerHTML = 'view all <span class="ao-arrow">&darr;</span>';
        }
      }
    });
  }

  section.querySelectorAll('.ro-expand-btn[data-toggle-ro], .ao-expand-btn[data-toggle-ro]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      roToggle(this.getAttribute('data-toggle-ro'));
    });
  });

  section.querySelectorAll('[data-toggle-ro]').forEach(function(el) {
    if (el.classList.contains('ro-expand-btn') || el.classList.contains('ao-expand-btn')) return;
    el.addEventListener('click', function(e) {
      /* Don't toggle the row if the click landed on (or inside) an
         action button that owns its own behavior — Reorder, Details,
         Invoice. We removed the inline `onclick="event.stopPropagation()"`
         from those buttons so the delegated jQuery handler on `section`
         could see the event bubble; this check is what now suppresses
         the row-toggle side effect. */
      if (e.target && e.target.closest && e.target.closest('.recent-orders__reorder-btn, .ro-view-details-btn, .ro-invoice-link')) return;
      roToggle(this.getAttribute('data-toggle-ro'));
    });
  });

  /* ===== ORDER DETAIL VIEW ===== */
  var orderDetailPanel = section.querySelector('[data-panel="order-detail"]');
  var odContainer = orderDetailPanel ? orderDetailPanel.querySelector('.od-container') : null;
  var odPreviousPanel = 'dashboard';

  function getFinancialBadge(status) {
    if (!status) return '';
    var map = {
      'paid': '<span class="od-badge od-badge--green">Paid</span>',
      'refunded': '<span class="od-badge od-badge--red">Refunded</span>',
      'partially_refunded': '<span class="od-badge od-badge--yellow">Partially Refunded</span>',
      'pending': '<span class="od-badge od-badge--yellow">Payment Pending</span>',
      'voided': '<span class="od-badge od-badge--grey">Voided</span>',
      'authorized': '<span class="od-badge od-badge--blue">Authorized</span>'
    };
    return map[status] || '<span class="od-badge od-badge--grey">' + status.replace(/_/g, ' ').replace(/\b\w/g, function(c){return c.toUpperCase();}) + '</span>';
  }

  function renderOrderDetail(data) {
    if (!odContainer) return;
    var html = '';

    /* Back link */
    html += '<button class="od-back" id="od-back-btn"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg> Back to Orders</button>';

    /* Header */
    html += '<div class="od-header">';
    html += '<h2>' + data.order_name + '</h2>';
    html += '<div class="od-header-meta">';
    html += '<span>' + data.date + '</span>';
    if (data.fulfillment_label) {
      var bc = (data.badge_class || '').replace('ao-badge--', 'od-badge--');
      html += '<span class="od-badge ' + bc + '">' + data.fulfillment_label + '</span>';
    }
    if (data.is_reprint) {
      html += '<span class="od-badge od-badge--green">Reprint Order</span>';
    } else {
      html += getFinancialBadge(data.financial_status);
    }
    html += '</div></div>';

    /* Helpers reused by grouped and fallback paths */
    function renderOdShipmentBadge(s) {
      if (!s) return '';
      var map = {
        delivered: { cls: 'delivered', label: 'Delivered' },
        out_for_delivery: { cls: 'transit', label: 'Out for delivery' },
        in_transit: { cls: 'transit', label: 'In transit' },
        ready_for_pickup: { cls: 'transit', label: 'Ready for pickup' },
        attempted_delivery: { cls: 'attempted', label: 'Delivery attempted' },
        failure: { cls: 'failed', label: 'Delivery failed' }
      };
      var entry = map[String(s).toLowerCase()];
      if (!entry) return '';
      return ' <span class="od-tracking-bar__status od-tracking-bar__status--' + entry.cls + '">' + entry.label + '</span>';
    }
    function renderOdTrackingBar(num, url, status) {
      var h = '<div class="od-tracking-bar">';
      var numHtml = url ? '<a href="' + url + '" target="_blank" rel="noopener" class="od-tracking-bar__num-link">' + num + '</a>' : num;
      h += '<div class="od-tracking-bar__left"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg> Tracking: ' + numHtml + renderOdShipmentBadge(status) + '</div>';
      if (url) h += '<a href="' + url + '" target="_blank" rel="noopener" class="od-tracking-link">Track Package <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></a>';
      h += '</div>';
      return h;
    }
    function renderOdLineItem(li) {
      var h = '<div class="od-line-item">';
      if (li.image_url) {
        h += '<img class="od-line-item__img" src="' + li.image_url + '" alt="" onerror="if(this.dataset.tried){this.style.display=\'none\'}else{this.dataset.tried=1;this.src=\'' + (li.fallback_url||'') + '\'}">';
      } else {
        h += '<div class="od-empty-placeholder"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></div>';
      }
      h += '<div class="od-line-item__info">';
      var odTitle = li.display_title || li.title;
      if (odTitle && li.variant_title && li.variant_title !== 'Default Title') {
        var _odSuffix = ' - ' + li.variant_title;
        if (odTitle.indexOf(_odSuffix) !== -1) {
          odTitle = odTitle.split(_odSuffix).join('').trim();
        }
      }
      if (odTitle && odTitle.indexOf('Style #') !== -1) {
        odTitle = odTitle.split('Style #')[0].replace(/\s*-\s*$/, '').trim();
      }
      h += '<div class="od-line-item__title">' + odTitle + '</div>';
      if (li.is_style_variant) {
        if (li.width && li.height) {
          h += '<div class="od-line-item__variant">' + li.width + '" \u00D7 ' + li.height + '"</div>';
        }
      } else if (li.variant_title && li.variant_title !== 'Default Title') {
        h += '<div class="od-line-item__variant">' + li.variant_title + '</div>';
      }
      if (li.properties && li.properties.length) {
        h += '<div class="od-line-item__props">';
        for (var pp = 0; pp < li.properties.length; pp++) {
          h += '<span><strong>' + li.properties[pp].key + ':</strong> ' + li.properties[pp].value + '</span>';
        }
        h += '</div>';
      }
      if (li.fulfillment && li.fulfillment.status === 'fulfilled') {
        h += '<div class="od-line-item__fulfillment">Fulfilled ' + (li.fulfillment.created_at || '') + '</div>';
      } else if (!data.cancelled) {
        h += '<div class="od-line-item__fulfillment od-line-item__fulfillment--pending">Unfulfilled</div>';
      }
      h += '</div>';
      h += '<div class="od-line-item__qty">x' + li.quantity + '</div>';
      h += '<div class="od-line-item__price">' + li.total + '</div>';
      h += '</div>';
      return h;
    }

    /* Group line items by their tracking number, preserving first-seen order.
       Items without tracking go into an ungrouped bucket rendered after. */
    var groupOrder = [];
    var groupMap = {};
    var ungroupedItems = [];
    for (var gix = 0; gix < data.line_items.length; gix++) {
      var gli = data.line_items[gix];
      var gff = gli.fulfillment || {};
      var gtn = gff.tracking_number || '';
      if (gtn) {
        if (!groupMap[gtn]) {
          groupMap[gtn] = { number: gtn, url: gff.tracking_url || '', status: gff.shipment_status || '', items: [] };
          groupOrder.push(gtn);
        } else {
          if (!groupMap[gtn].url && gff.tracking_url) groupMap[gtn].url = gff.tracking_url;
          if (!groupMap[gtn].status && gff.shipment_status) groupMap[gtn].status = gff.shipment_status;
        }
        groupMap[gtn].items.push(gli);
      } else {
        ungroupedItems.push(gli);
      }
    }

    if (groupOrder.length) {
      /* One [tracking bar][Items section] block per shipment */
      for (var gri = 0; gri < groupOrder.length; gri++) {
        var grp = groupMap[groupOrder[gri]];
        html += renderOdTrackingBar(grp.number, grp.url, grp.status);
        html += '<div class="od-section"><div class="od-section-title">Items</div>';
        for (var grj = 0; grj < grp.items.length; grj++) {
          html += renderOdLineItem(grp.items[grj]);
        }
        html += '</div>';
      }
      if (ungroupedItems.length) {
        html += '<div class="od-section"><div class="od-section-title">Items</div>';
        for (var ugi = 0; ugi < ungroupedItems.length; ugi++) {
          html += renderOdLineItem(ungroupedItems[ugi]);
        }
        html += '</div>';
      }
    } else {
      /* Fallback when line items carry no tracking (older orders): stack order-level trackings at top, then single Items section */
      var trackings = [];
      var seenTracking = {};
      if (data.trackings && data.trackings.length) {
        for (var ti = 0; ti < data.trackings.length; ti++) {
          var t = data.trackings[ti];
          if (t && t.number && !seenTracking[t.number]) {
            seenTracking[t.number] = 1;
            trackings.push({ number: t.number, url: t.url || '' });
          }
        }
      }
      if (!trackings.length && data.tracking_number) {
        trackings.push({ number: data.tracking_number, url: data.tracking_url || '' });
      }
      for (var tk = 0; tk < trackings.length; tk++) {
        html += renderOdTrackingBar(trackings[tk].number, trackings[tk].url);
      }
      html += '<div class="od-section"><div class="od-section-title">Items</div>';
      for (var i = 0; i < data.line_items.length; i++) {
        html += renderOdLineItem(data.line_items[i]);
      }
      html += '</div>';
    }

    /* Addresses */
    var sa = data.shipping_address || {};
    var ba = data.billing_address || {};
    html += '<div class="od-section"><div class="od-address-grid">';
    html += '<div class="od-address-card"><h4>Shipping Address</h4><p>';
    if (sa.name) html += sa.name + '<br>';
    if (sa.address1) html += sa.address1 + '<br>';
    if (sa.address2) html += sa.address2 + '<br>';
    html += [sa.city, sa.province, sa.zip].filter(Boolean).join(', ');
    if (sa.country) html += '<br>' + sa.country;
    if (sa.phone) html += '<br>' + sa.phone;
    html += '</p></div>';
    html += '<div class="od-address-card"><h4>Billing Address</h4><p>';
    if (ba.name) html += ba.name + '<br>';
    if (ba.address1) html += ba.address1 + '<br>';
    if (ba.address2) html += ba.address2 + '<br>';
    html += [ba.city, ba.province, ba.zip].filter(Boolean).join(', ');
    if (ba.country) html += '<br>' + ba.country;
    if (ba.phone) html += '<br>' + ba.phone;
    html += '</p></div></div>';
    if (data.shipping_method) {
      html += '<div style="margin-top:14px"><h4 style="font-size:12px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:0.04em;margin:0 0 4px">Shipping Method</h4><p style="font-size:14px;color:#374151;margin:0">' + data.shipping_method + '</p></div>';
    }
    if (data.email) {
      html += '<div style="margin-top:14px"><h4 style="font-size:12px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:0.04em;margin:0 0 4px">Contact</h4><p style="font-size:14px;color:#374151;margin:0">' + data.email + '</p></div>';
    }
    html += '</div>';

    /* Totals */
    html += '<div class="od-section"><div class="od-section-title">Order Summary</div><div class="od-totals">';
    html += '<div class="od-totals-row"><span>Subtotal</span><span>' + data.subtotal + '</span></div>';
    if (data.total_discounts && data.total_discounts !== '$0.00' && data.total_discounts !== 'FREE') {
      var discountLabel = 'Discount';
      if (data.discount_codes && data.discount_codes.length) discountLabel = data.discount_codes.join(', ');
      html += '<div class="od-totals-row od-totals-row--discount"><span>' + discountLabel + '</span><span>-' + data.total_discounts + '</span></div>';
    }
    html += '<div class="od-totals-row"><span>Shipping</span><span>' + data.shipping + '</span></div>';
    if (data.tax && data.tax !== '$0.00' && data.tax !== 'FREE') {
      html += '<div class="od-totals-row"><span>Tax</span><span>' + data.tax + '</span></div>';
    }
    html += '<div class="od-totals-row od-totals-row--total"><span>Total</span><span>' + data.total + '</span></div>';
    if (data.financial_status === 'refunded' && !data.is_reprint) {
      html += '<div class="od-totals-row od-totals-row--refund"><span>Refunded</span><span>-' + data.total + '</span></div>';
    }
    html += '</div></div>';

    odContainer.innerHTML = html;

    /* Back button handler */
    var backBtn = odContainer.querySelector('#od-back-btn');
    if (backBtn) {
      backBtn.addEventListener('click', function() {
        showPanel(odPreviousPanel);
      });
    }
  }

  /* Click delegation for View Order Details */
  section.addEventListener('click', function(e) {
    var btn = e.target.closest('.ao-view-details-btn, .ro-view-details-btn');
    if (!btn) return;
    e.preventDefault();
    var handle = btn.getAttribute('data-order-handle');
    if (!handle) return;

    /* Determine which panel we came from */
    var fromPanel = btn.closest('[data-panel]');
    odPreviousPanel = (fromPanel && fromPanel.getAttribute('data-panel')) || 'dashboard';

    /* Find the JSON data — search near the button first, then globally */
    var jsonEl = null;
    var row = btn.closest('.ao-order-row, .ao-order-row-mobile, .recent-orders__row, .recent-orders__row-mobile');
    if (row) jsonEl = row.querySelector('.od-detail-data[data-order="' + handle + '"]');
    if (!jsonEl) jsonEl = section.querySelector('.od-detail-data[data-order="' + handle + '"]');
    if (!jsonEl) return;

    try {
      var data = JSON.parse(jsonEl.textContent);
      renderOrderDetail(data);
      showPanel('order-detail');
    } catch(err) {
      console.error('Order detail parse error:', err);
    }
  });
})();
</script>

