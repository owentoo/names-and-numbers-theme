  <script>
document.addEventListener("DOMContentLoaded", function () {

  

  /* =====================================================
     ELEMENT REFERENCES
  ====================================================== */
  const container = document.querySelector(".multiupload-rebuild-container");
  const transparentBtn = document.querySelector(".set-transparent");
  const pickColorBtn = document.querySelector(".pick-color");
  const colorInput = document.getElementById("canvas-color");
  const transparencyCheck = document.querySelector(".transparency-check");

  const videoBox = document.querySelector(".video-box.video-wrapper");
  const desktopStickyContainer = document.querySelector(".desktop-sticky-container");
  const pricesTable = document.querySelector("prices-table");
  const nextElement = document.querySelector("next-element");
  const previewBlock = document.querySelector("preview-block");
  const fileProgress = document.querySelector(".fileProgress");

  let newUploadControls = null;

  /* =====================================================
     BACKGROUND TOGGLE LOGIC (UPDATED)
  ====================================================== */
  if (container && transparentBtn && pickColorBtn) {

    function resetSelection() {
      transparentBtn.classList.remove("is_selected");
      pickColorBtn.classList.remove("is_selected");
    }

    // Transparent click
    transparentBtn.addEventListener("click", function () {
      resetSelection();
      transparentBtn.classList.add("is_selected");

      container.classList.remove("custom-bg-active");
      container.style.removeProperty("--canvas-bg");
      container.style.removeProperty("background-color");

      if (transparencyCheck) {
        transparencyCheck.style.display = "none";
        transparencyCheck.style.color = "#ffffff";
      }
    });

    // Pick color click (NOW FIXED COLOR) 
      pickColorBtn.addEventListener("click", function () {
        resetSelection();
        pickColorBtn.classList.add("is_selected");

        // Always set fixed background color
        container.classList.add("custom-bg-active");
        container.style.setProperty("--canvas-bg", "#85E659");

        if (transparencyCheck) {
          transparencyCheck.style.display = "inline-block";
          transparencyCheck.style.color = "#85E659"; // <-- ADD THIS
        }
      });
  }

  /* =====================================================
     VIDEO + PRICES TABLE LOGIC
  ====================================================== */
  if (window.innerWidth > 768 && videoBox && pricesTable && nextElement) {

    pricesTable.remove();

    newUploadControls = document.createElement("upload-controls");
    newUploadControls.classList.add("upload-controls--dynamic");
    newUploadControls.appendChild(pricesTable);

    desktopStickyContainer.insertAdjacentElement("afterend", newUploadControls);
    newUploadControls.style.display = "none";

        const observer = new MutationObserver(function () {

          const isNextHidden = nextElement.classList.contains("hidden");
          const isImageLoading = previewBlock?.classList.contains("image-loading");
          const isProgressHidden = fileProgress?.classList.contains("hidden");

          const shouldShowUploadControls =
            !isNextHidden &&
            !isImageLoading &&
            isProgressHidden;

          /* ------------------------------
            SHOW / HIDE UPLOAD CONTROLS
          ------------------------------ */
          if (shouldShowUploadControls) {
            videoBox.style.display = "none";
            newUploadControls.style.display = "";
          } else {
            videoBox.style.display = "";
            newUploadControls.style.display = "none";
          }

          /* ------------------------------
            STICKY SWAP LOGIC
          ------------------------------ */
  
if (window.innerWidth > 768 && shouldShowUploadControls) {

  const first = document.querySelector(".desktop-sticky-container");
  const second = document.querySelector(".upload-controls--dynamic");

  if (!first || !second) return;

  const stickyTop = parseFloat(getComputedStyle(first).top) || 0;
  const firstHeight = first.offsetHeight;
  const EXTRA_GAP = 20; // 👈 adjust this (10–40 is ideal)

  function handleScroll() {

    const secondRect = second.getBoundingClientRect();

    // Define push boundary BEFORE collision
    const pushStart = stickyTop + firstHeight + EXTRA_GAP;

    if (secondRect.top <= pushStart) {

      const translateAmount = pushStart - secondRect.top;

      first.style.transform =
        `translate3d(0, -${translateAmount}px, 0)`;

    } else {
      first.style.transform =
        `translate3d(0, 0, 0)`;
    }
  }

  window.addEventListener("scroll", handleScroll, { passive: true });
}
        });

    observer.observe(nextElement, { attributes: true });
    if (previewBlock) observer.observe(previewBlock, { attributes: true });
    if (fileProgress) observer.observe(fileProgress, { attributes: true });
  }

  /* =====================================================
     SINGLE REMOVE CLICK HANDLER
  ====================================================== */
  document.addEventListener("click", function (e) {

    const removeBtn = e.target.closest(".fileRemoveBlock__removeFile");
    if (!removeBtn) return;

    if (window.innerWidth > 768 && videoBox && newUploadControls) { 
      videoBox.style.display = "";
      newUploadControls.style.display = "none";
    }

    // Reset background via transparent click
    if (transparentBtn) {
      transparentBtn.click();
    }
    document.querySelector(".desktop-sticky-container").style.transform = `translate3d(0, 0, 0)`;
     document.body.classList.remove("image-uploaded")
  });
});
</script> 
