                                  echo option | strip
                                  unless forloop.last
                                    echo '/'
                                  endunless
                                endif
                              endfor
                            endcapture
                          -%}

                          {%- if options != blank and options contains '/Yes' -%}
                            ,{
                              "vid": {{ variant.id | json }},
                              "title": {{ options | split: '/Yes' | first | strip | json }}
                            }
                          {%- endif -%}
                        {%- endfor -%}
