                        }
                      }
                    {% endif %}
                    .product .widthHeight__custom {
                      margin-top: 0;
                    }
                  </style>
                {% endif %}
                <div id="custom_size" class="active">
                  {% for block in section.blocks %}
                    {%- if block.type == 'widthHeight' -%}
                      {%-liquid
                        assign b = block.settings
                        assign errorMessage_ = b.errorMsg | replace: '[maxSize]', b.maxSize
                        assign errorMessage_height = b.errorMsg_height | replace: '[maxSize]', b.maxSizeHeight
                        assign autoChangeWidthHeightShowHide_ = b.autoChangeWidthHeightShowHide
                        assign autoChangeWidthHeight_ = b.autoChangeWidthHeight
                        assign autoChangeText_ = b.autoChangeText
                        assign autoChangeText_unlock_ = b.autoChangeText_unlock
                        assign tooltipText_ = b.tooltipText
                        assign widthText_ = b.widthText
                        assign heightText_ = b.heightText
                      -%}
                      {%- comment -%}
                      {% render 'bySize__js' product: product, section: section, b: b, contentIs: 'toolTipData' %}
                      {%- endcomment -%}
                      <div class="widthHeight__block selected">
                        <input type="hidden" class="nodevariant" value="{{ product.selected_or_first_available_variant.id }}" />
                        <input type="hidden" class="nodevariant_precut" />
                        <div class="widthHeight__option customOption selected">
                          <div class="widthHeight__option-radio">&nbsp;</div>
                          <div class="widthHeight__option-name" style="display:none;">
                            {{ b.customOptionText | escape }}
                          </div>
                          <div class="widthHeight__option-detectedSize">
                            Detected size: 5.0" x 11.5"
                          </div>
                        </div>

                        <div class="widthHeight__option popularOption">
                          <div class="widthHeight__option-radio">&nbsp;</div>
                          <div class="product-variant__name text-size--small">
                            {{ b.popularOptionText | escape }}
                          </div>
                          {% if b.showTooltip %}
                            {% if b.tooltipContent != blank or b.tooltipImage != blank %}
                              <div class="widthHeight__option-toolTip">
                                <img src="//ninjatransfers.com/cdn/shop/files/info_da70c6e6-1e86-41d3-9035-2bf57d01d406_medium.svg?v=1678797665">
                                <div class="widthHeight__option-toolTip__content">
                                  {% if b.tooltipImage != blank %}
                                    <img src="{{ b.tooltipImage | image_url: width: 500 }}" class="widthHeight__option-toolTip__contentImg">
                                  {% endif %}
                                  {% if b.tooltipContent != blank %}
                                    <div>
                                      {{ b.tooltipContent }}
                                    </div>
                                  {% endif %}
                                </div>
                              </div>
                            {% endif %}
                          {% endif %}
                        </div>
                        <div class="widthHeight__popular"></div>
                      </div>

                      {% if b.hideVariants %}
                        <style>
                          product-variants .product-variant__item.product-variant__item--radio,
                          variant-radios .form__label,
                          product-variants .product-variants .product-variant[option="2"],
                          variant-selects {
                            display: none;
                          }
                          product-variants .product-variant__item.product-variant__item--radio[min=""] {
                            display: inline-block;
                          }
                        </style>
                      {% endif %}

                      <script>
                        function roundUpToHalf(value) {
                          // Round up to the nearest 0.5
                          return Math.ceil(value * 2) / 2;
                        }
                        function roundDownToHalf(value) {
                          // Round up to the nearest 0.5
                          return Math.floor(value * 2) / 2;
                        }
                        const userDefinedMaxLength = {{ b.maxSize | json }};
                        const userDefinedMaxHeight = {{ b.maxSizeHeight | json }};
                        const allowedMaxInches = {{ b.maxSqInches | json }};

                        const userDefinedMinWidth = {{ b.setMinWidth | times: 1 | json }};
                        const userDefinedMinHeight = {{ b.setMinHeight | times: 1 | json }};

                        $(document).ready(function() {
                          {% if b.hideVariants %}
                          //  $( `product-variants .product-variants .product-variant[option="1"]` ).addClass( `disabled` );
                          {% endif %}
                          $( `.widthHeight__value, .customQtyFile__qty` ).keypress(function (event) {
                            return isNumber(event, this)
                          });
                        });

                        function isNumber(evt, element) {
                          var charCode = (evt.which) ? evt.which : event.keyCode
                          if ( ( charCode != 45 || charCode != 48 || $(element).val().indexOf('-') != -1 ) && ( charCode != 46 || $( element ).val().indexOf('.') != -1 ) && ( charCode < 48 || charCode > 57 ) ) {
                            return false;
                          }
                          return true;
                        }

                        $( document )
                        .on(`click`, `.disabled[option="1"] .product-variant__item.product-variant__item--radio[min=""][max=""]`, function( e ) {
                          try {
                            e.stopImmediatePropagation();

                            $( `.widthHeight__custom .widthHeight__item` ).removeClass( `error` );
                            $( `product-variants .product-variant[option="1"] .product-variant__item.product-variant__item--radio` ).each(function() {
                              const isChecked   =   $( this ).find( ` > input[type="radio"]` ).is( `:checked` );
                              if ( isChecked ) {
                                customSelectedVariant_id  =   $( this ).find( `label` ).attr( `for` );

                                // console.log ( 'customSelectedVariant_id', customSelectedVariant_id );
                              }
                            })

                            $( `.widthHeight__option` ).removeClass( `selected` );

                            $( `.widthHeight__item__action, .widthHeight__autoChange` ).addClass( `disabled` );
                            $( `.product-variant` ).removeClass( `disabled` );

                            $( `.widthHeight__option.popularOption` ).addClass( `selected` );

                            $( `.form__properties input[name="properties[_width]"], .form__properties input[name="properties[_height]"], .form__properties input[name="properties[Detected Size]"]` )
                              .prop( `disabled`, true );

                            let detectedSize  =   $( `.widthHeight__option-detectedSize span[d-size]` ).text();
                            detectedSize      =   detectedSize.replace( '"', '' ).replace( '"', '' ).replace( ' ', '' ).replace( ' ', '' );

                            $( this ).find( `label` ).click();

                          } catch ( err ) {
                            console.log( `ERROR .product-variant__item.product-variant__item--radio[min=""][max=""]`, err.message );
                          }
                        })

                        .on(`click`, `.widthHeight__option:not(.selected)`,async function( e ) {
                          try {
                            e.stopImmediatePropagation();
                            const isCustomBlock = $( this ).hasClass( `customOption` );
                            $( `.widthHeight__option` ).removeClass( `selected` );
                            $( this ).addClass( `selected` );

                            if ( isCustomBlock ) {

                              $( `.widthHeight__item__action, .widthHeight__autoChange` ).removeClass( `disabled` );
                              $( `product-variants .product-variant` ).addClass( `disabled` );

                              if ( typeof customSelectedVariant_id !== 'undefined' && customSelectedVariant_id ) {
                                $( `product-variants .product-variant .product-variant__item.product-variant__item--radio > label[for="${ customSelectedVariant_id }"]` ).click();
                              }

                              $( `.form__properties input[name="properties[_width]"], .form__properties input[name="properties[_height]"], .form__properties input[name="properties[Detected Size]"]` )
                                .prop( `disabled`, false );

                              $( `.form__properties [name="properties[_specialNote]"]` )
                                .prop( `disabled`, true );

                            } else {

                              $( `.widthHeight__item__action, .widthHeight__autoChange` ).addClass( `disabled` );
                              $( `product-variants .product-variant` ).removeClass( `disabled` );

                              $( `product-variants .product-variant[option="1"] .product-variant__container .product-variant__item.product-variant__item--radio` ).each(function() {
                                const isChecked   =   $( this ).find( ` > input[type="radio"]` ).is( `:checked` );
                                if ( isChecked ) {
                                  customSelectedVariant_id  =   $( this ).find( `label` ).attr( `for` );

                                  // console.log ( 'customSelectedVariant_id', customSelectedVariant_id );
                                }
                              })

                              if ( typeof popularSizeID !== 'undefined' && popularSizeID ) {
                                let getUpdatedWidth__ = $( `product-variants .product-variant[option="1"] .product-variant__container .product-variant__item.product-variant__item--radio[min=""][max=""] label[for="${ popularSizeID }"]` ).text();
                                if ( getUpdatedWidth__.includes( `x` ) ) {
                                  getUpdatedWidth__ = getUpdatedWidth__.split( `x` )[0];
                                  getUpdatedWidth__ = parseFloat( getUpdatedWidth__ );
                                  getUpdatedWidth__ = getUpdatedWidth__.toFixed( 2 );
                                  // console.log ( 'getUpdatedWidth__', getUpdatedWidth__ );
                                  setTimeout(() => {
                                    $( `.fileupload_preview .horizontal_direction > span` ).text( `${ getUpdatedWidth__ }"` );
                                  }, 500);
                                }
                                $( `product-variants .product-variant[option="1"] .product-variant__container .product-variant__item.product-variant__item--radio[min=""][max=""] label[for="${ popularSizeID }"]` ).click();
                              } else {
                                $( `product-variants .product-variant[option="1"] .product-variant__container .product-variant__item.product-variant__item--radio[min=""][max=""]` ).first().find( `> label` ).click();
                              }

                              $( `.form__properties input[name="properties[_width]"], .form__properties input[name="properties[_height]"], .form__properties input[name="properties[Detected Size]"]` )
                                .prop( `disabled`, true );

                              $( `.form__properties [name="properties[_specialNote]"]` )
                                .prop( `disabled`, false );

                            }
                          } catch ( err ) {
                            console.log( `ERROR .widthHeight__option:not(.selected)`, err.message );
                          }
                        })

                        .on(`click`, `.widthHeight__item__action-minus`, function( e ) {
                          try {
                            e.stopImmediatePropagation();
                            // const wrapper   =   $( this ).closest( `.widthHeight__item__action` );
                            selectedItemNo = $( this ).closest( `.widthHeight__custom[item]` ).attr( `item` );
                            var wrapper = $( this ).closest( `.widthHeight__custom` );
                            var itemWrapper = wrapper.find( `.widthHeight__item__action` );
                            const min       =   wrapper.find( `.widthHeight__value` ).attr( `min` ) * 1;
                            const max       =   wrapper.find( `.widthHeight__value` ).attr( `max` ) * 1;
                            const step      =   wrapper.find( `.widthHeight__value` ).attr( `step` ) * 1;
                            const getVal    =   wrapper.find( `.widthHeight__value` ).val() * 1;
                            var afterMinus = 0;
                            if ( getVal % step > 0 ) {
                              afterMinus = roundDownToHalf(getVal);
                            } else {
                              afterMinus  =   getVal - step;
                            }
                            // const afterMinus  =   getVal - step;
                            const byWidthHeight = wrapper.attr( `by` );

                            if ( afterMinus >= min ) {
                              const winScreen =   $( window ).width();
                              if ( winScreen > 549 ) {
                                wrapper.find( `.widthHeight__value` ).val( afterMinus.toFixed(2) ).focus();
                              } else {
                                wrapper.find( `.widthHeight__value` ).val( afterMinus.toFixed(2) );
                              }

                              setTimeout(()=>{
                                getRadioMaintain( byWidthHeight );
                              }, 50);

                              setTimeout(()=>{
                                reAdjustSizes();
                                calculateDPI();
                              }, 1000);
                            }
                            calculateDPI();

                          } catch ( err ) {
                            console.log( `ERROR .widthHeight__item__action-minus`, err.message );
                          }
                        })
                        .on(`click`, `.widthHeight__item__action-plus`, function( e ) {
                          try {
                            e.stopImmediatePropagation();
                            //const wrapper   =   $( this ).closest( `.widthHeight__item__action` );
                            selectedItemNo = $( this ).closest( `.widthHeight__custom[item]` ).attr( `item` );
                            var wrapper = $( this ).closest( `.widthHeight__custom` );
                            var itemWrapper = wrapper.find( `.widthHeight__item__action` );
                            const min       =   wrapper.find( `.widthHeight__value` ).attr( `min` ) * 1;
                            const max       =   wrapper.find( `.widthHeight__value` ).attr( `max` ) * 1;
                            const step      =   wrapper.find( `.widthHeight__value` ).attr( `step` ) * 1;
                            const getVal    =   wrapper.find( `.widthHeight__value` ).val() * 1;
                            var afterAdd = 0;
                            if ( getVal % step > 0 ) {
                              afterAdd = roundUpToHalf(getVal);
                            } else {
                              afterAdd  =   getVal + step;
                            }
                            const byWidthHeight = wrapper.attr( `by` );
                            console.log(getVal," :getVal === Step: ",step);

                            if ( afterAdd <= max ) {
                              const winScreen =   $( window ).width();
                              if ( winScreen > 549 ) {
                                wrapper.find( `.widthHeight__value` ).val( afterAdd.toFixed(2) ).focus();
                              } else {
                                wrapper.find( `.widthHeight__value` ).val( afterAdd.toFixed(2) );
                              }

                              setTimeout(()=>{
                                getRadioMaintain( byWidthHeight );
                              }, 50);
                              setTimeout(()=>{
                                reAdjustSizes();
                                calculateDPI();
                              }, 1000);
                            } else {
                              const winScreen =   $( window ).width();
                              console.log ( 'chaaaaaaaa',  );
                              if ( winScreen > 549 ) {
                                wrapper.find( `.widthHeight__item__action[by="width"] .widthHeight__value` ).val( userDefinedMaxLength.toFixed(2) );
                                wrapper.find( `.widthHeight__item__action[by="height"] .widthHeight__value` ).val( userDefinedMaxHeight.toFixed(2) ).focus();
                              } else {
                                wrapper.find( `.widthHeight__item__action[by="width"] .widthHeight__value` ).val( userDefinedMaxLength.toFixed(2) );
                                wrapper.find( `.widthHeight__item__action[by="height"] .widthHeight__value` ).val( userDefinedMaxHeight.toFixed(2) );
                              }

                              wrapper.parents( `.widthHeight__item` ).addClass( `error` );
                              setTimeout(()=>{
                                getRadioMaintain( byWidthHeight );
                              }, 50);
                              setTimeout(()=>{
                                reAdjustSizes();
                                calculateDPI();
                              }, 1000);
                            }

                          } catch ( err ) {
                            console.log( `ERROR .widthHeight__item__action-plus`, err.message );
                          }

                        })
                        {% if b.autoChangeWidthHeight %}
                          .on(`change`, `.widthHeight__autoChange .autoChange`,async function( e ) {
                            try {
                              e.stopImmediatePropagation();
                              const lockStatement   = $( this ).closest( `.widthHeight__autoChange` ).find( `span[content]` ).attr( `lock-statement` );
                              const unlockStatement = $( this ).closest( `.widthHeight__autoChange` ).find( `span[content]` ).attr( `unlock-statement` );

                              const isChecked       = $( this ).is( `:checked` );

                              if ( isChecked ) {
                                $( this ).closest( `.widthHeight__autoChange` ).find( `span[content]` ).text( unlockStatement );
                              } else {
                                $( this ).closest( `.widthHeight__autoChange` ).find( `span[content]` ).text( lockStatement );
                              }

                              $( `.widthHeight__item__action` ).addClass( `active` );

                              await ApplyDelay( 1000 );

                              $( `.widthHeight__item__action` ).removeClass( `active` );

                            } catch ( err ) {
                              console.log( `ERROR .widthHeight__autoChange .autoChange`, err.message );
                            }
                          })
                        {% endif %}
                        ;
                      </script>
                    {% endif %}
                  {% endfor %}
                </div>

                {% if layoutTypeIs == 'previous' %}
                  <div class="tab_header previousDesign" style="display: block;">
                    <div
                      class="prevItem"
                      type="popular"
                      onclick="$('.widthHeight__option.popularOption .widthHeight__option-radio').click(),$('.custom-variant-selector').prop('selectedIndex',0),$(`.prevItem[type='custom']`).removeClass('active'),$(this).addClass('active'),$(`#popular_size`).addClass('active')"
                    >
                      <div class="prevItem__circle">&nbsp;</div>
                      <div class="prevItem__title">
                        Popular Sizes
                        <div>Choose a size your design will fit within (WxH in inches)</div>
                      </div>
                    </div>
                  </div>
                {% endif %}

                <div id="popular_size" {% if layoutTypeIs == 'previous' %}style="display: block;"{% endif %}>
                  {% assign ww = "" %}
                  {% for block in section.blocks %}
                    {%- if block.type == 'widthHeight' -%}
                      {% assign ww = block.settings %}
                    {%- endif -%}
                    {%- if block.type == 'variant_picker' -%}
                      {%- assign color_label = settings.color_swatches_labels | split: ',' -%}

                      <div class="sidebar-widget sidebar-widget--{{ block.settings.style }}"
                        {% if product.has_only_default_variant %} style="display:none" {% endif %}
                        {% if product.available == false and block.settings.unavailable_variants == 'hide' %} style="display:none" {% endif %}
                      >

                        {%- unless block.settings.heading == blank -%}
                          <span class="sidebar-widget__title">{{ block.settings.heading | escape }}</span>
                        {%- endunless -%}

                        <div class="sidebar-widget__content">

                          <product-variants
                            data-main-product-variants
                            data-variants="{{ product.options_with_values.size }}"
                            data-hide-variants="{%- liquid
                              if block.settings.unavailable_variants == 'disable'
                                echo 'disable'
                              elsif block.settings.unavailable_variants == 'show'
                                echo 'true'
                              else
                                echo 'hide'
                              endif
                            -%}"
                            data-url="{{ product.url }}" data-id="{{ section.id }}"
                            data-style="{{ block.settings.variants_style }}"
                            {% if block.settings.unavailable_variants == 'hide' %} class="product-variants--hide-unavailable" {% endif %}
                            {% unless default_to_first_variant %} data-variant-required {% endunless %}
                            {% unless product.has_only_default_variant %} data-has-variants {% elsif product.available == false %} data-unavailable {% endunless %}
                            {{ block.shopify_attributes }}
                          >

                            <div class="product-variants no-js-hidden"
                              {% if product.has_only_default_variant %} style="display:none" {% endif %}
                              {% if product.available == false and block.settings.unavailable_variants == 'hide' %} style="display:none" {% endif %}
                            >

                              {%- for option in product.options_with_values -%}

                                {%- assign option_downcased = option.name | downcase %}

                                <div class="product-variant" data-name="product-{{ option.name | escape | downcase | strip }}-{{ section.id }}" option="{{ option.position}}" data-js-product-variant>
                                  {% if layoutTypeIs == 'tab' or layoutTypeIs == 'tab_pills' %}
                                    <span class="product-variant__name text-size--small">
                                      {% if  option_downcased contains "size"  %}
                                        {% if layoutTypeIs == 'tab_pills' %}
                                          {%- comment -%}
                                          <strong>Popular Size</strong><br>
                                          {%- endcomment -%}
                                          {% if ww.popularOptionText != blank %}
                                            <span class="d-flex grt-pointer-text">
                                              <span>
                                                {{ ww.popularOptionText | escape }}
                                              </span>
                                              {% if ww.showTooltip %}
                                                {% if ww.tooltipContent != blank or ww.tooltipImage != blank %}
                                                  <span class="widthHeight__option-toolTip">
                                                    <img src="//ninjatransfers.com/cdn/shop/files/info_da70c6e6-1e86-41d3-9035-2bf57d01d406_medium.svg?v=1678797665">
                                                    <span class="widthHeight__option-toolTip__content">
                                                      {% if ww.tooltipImage != blank %}
                                                        <img src="{{ ww.tooltipImage | image_url: width: 500 }}" class="widthHeight__option-toolTip__contentImg">
                                                      {% endif %}
                                                      {% if ww.tooltipContent != blank %}
                                                        <span>
                                                          {{ ww.tooltipContent }}
                                                        </span>
                                                      {% endif %}
                                                    </span>
                                                    
                                                  </span>
                                                {% endif %}
                                                
                                              {% endif %}
                                            </span>
                                            {% endif %}
                                          <!-- <span style="font-weight: 400;">Choose a size your design will fit within (WxH in inches)</span> -->
                                        {% else %}
                                          Choose a popular size:&nbsp;
                                        {% endif %}
                                      {% else %}
                                        {{ 'products.grid.select_variant' | t: variant: option_downcased }}:&nbsp;
                                      {% endif %}
                                      
                                    </span>
                                  {% endif %}
                                  {%- liquid
                                    unless default_to_first_variant
                                      assign _firstColorVal = 'products.grid.color_variants_count' | t: count: option.values.size
                                    else
                                      assign _firstColorVal = option.selected_value
                                    endunless
                                  -%}
                                  <strong style="display: none;" data-val="{{ _firstColorVal }}" class="product-variant__item-text-label text-size--small text-line-height--small text-color--opacity __variant-{{ option_downcased | split : " " | join : "_" }}">
                                    {{ _firstColorVal }}
                                  </strong>

                                  {%- if color_label contains option_downcased and block.settings.color_swatches -%}
                                    <div class="product-variant__container product-variant__container--radio product-variant__container--radio--wrap" data-js-product-variant-container="radio">
                                      {%- for value in option.values -%}
                                        <div
                                          class="product-variant__item product-variant__item--radio product-variant__item--color  __color-option"
                                        >
                                          <input type="radio" name="product-{{ option.name | escape | downcase | strip }}-{{ section.id }}" id="{{ product.handle }}-option-{{ option.name | escape | downcase | strip }}-{{ forloop.index }}-{{ section.id }}" value="{{ value | escape }}" {% if default_to_first_variant and option.selected_value == value %}checked{% endif %} class="product-variant__input product-variant-value">
                                          <label for="{{ product.handle }}-option-{{ option.name | escape | downcase | strip }}-{{ forloop.index }}-{{ section.id }}" class="tooltip product-variant__label" title="{{ option.name }}">
                                            {%- liquid
                                              assign color_swatch_name = value | handle | append: '.png'
                                              assign color_swatch_image = images[color_swatch_name]
                                              assign color_swatch_background = value | downcase | escape | replace: ' ', ''
                                            -%}
                                            <span class="tooltiptext">
                                              {{ color_swatch_background }}
                                            </span>
                                            {%- if color_swatch_image != blank -%}
                                              <img class="product-variant__item-swatch product-variant__item-swatch--color"
                                                src="{{ color_swatch_image | image_url: width: 30, height: 30, crop: 'center' }}"
                                                srcset="
                                                  {{ color_swatch_image | image_url: width: 30, height: 30, crop: 'center' }} 30w,
                                                  {{ color_swatch_image | image_url: width: 60, height: 60, crop: 'center' }} 60w,
                                                  {{ color_swatch_image | image_url: width: 90, height: 90, crop: 'center' }} 90w
                                                "
                                                sizes="30px" width="30" height="30"
                                                loading="lazy"
                                                alt="{{ color_swatch_image.alt | escape }}"
                                              />
                                            {%- else -%}
                                              {%-liquid
                                                case color_swatch_background
                                                  when 'mint'
                                                    assign __colorcode = "#caf7e5"
                                                  when 'denim'
                                                    assign __colorcode = "#5e87a3"
                                                  when 'glowinthedark'
                                                    assign __colorcode = "rgb(242, 253, 158)"
                                                  when 'glowinthedark'
                                                    assign __colorcode = "rgb(242, 253, 158)"
                                                  when 'green'
                                                    assign __colorcode = "#82d145"
                                                  when 'pink'
                                                    assign __colorcode = "#f77ff0"
                                                  when 'orange'
                                                    assign __colorcode = '#FF3900'
                                                  when 'gold'
                                                    assign __colorcode = '#ffc121'
                                                  when 'yellow'
                                                    assign __colorcode = '#ffe500'
                                                  when 'yellow'
                                                    assign __colorcode = '#ffe500'
                                                  when 'teal'
                                                    assign __colorcode = '#66c9c4'
                                                  when 'teal'
                                                    assign __colorcode = '#66c9c4'
                                                  when 'blue'
                                                    assign __colorcode = '#005bd3'
                                                  when 'purple'
                                                    assign __colorcode = '#a54dcf'
                                                  when 'lavender'
                                                    assign __colorcode = '#d9b7ea'
                                                  when 'tan'
                                                    assign __colorcode = '#e9b396'
                                                  when 'red'
                                                    assign __colorcode = '#c40000'
                                                  when 'skyblue'
                                                    assign __colorcode = '#88d4f7'
                                                  else
                                                    assign __colorcode = color_swatch_background
                                                endcase
                                              -%}
                                              <span class="product-variant__item-swatch product-variant__item-swatch--image" style="background-color:{{ __colorcode }}"></span>
                                            {%- endif -%}
                                            <span class="visually-hidden">{{ value | escape }}</span>
                                          </label>
                                        </div>
                                      {%- endfor -%}
                                    </div>

                                  {%- elsif block.settings.variants_style == 'select' -%}
                                    <select class="product-variant__container product-variant__container--select text-size--small" id="product-{{ option.name | escape | downcase | strip }}-{{ section.id }}" data-js-product-variant-container="select">
                                      {%- for value in option.values -%}
                                        {%-liquid
                                          assign minVal = ''
                                          assign maxVal = ''
                                          if value contains 'Style #'
                                            assign getVal = value | remove: '"' | remove: "'"
                                            assign getVal = getVal | split: '#' | last
                                            assign getVal = getVal | split: '-'
                                            assign minVal = getVal[0] | strip
                                            assign maxVal = getVal[1] | strip
                                          endif
                                        -%}
                                        <option  min="{{ minVal }}"
                                          max="{{ maxVal }}" class="product-variant-value" value="{{ value | escape }}" {% if default_to_first_variant and option.selected_value == value %}selected{% endif %}
                                        >
                                          {{ value | escape }}
                                        </option>
                                      {%- endfor -%}
                                    </select>
                                  {%- else -%}
                                    <div class="product-variant__container product-variant__container--radio product-variant__container--radio--wrap" data-js-product-variant-container="radio">
                                      {%- for value in option.values -%}
                                        {%-liquid
                                          assign minVal = ''
                                          assign maxVal = ''
                                          if value contains 'Style #'
                                            assign getVal = value | remove: '"' | remove: "'"
                                            assign getVal = getVal | split: '#' | last
                                            assign getVal = getVal | split: '-'
                                            assign minVal = getVal[0] | strip
                                            assign maxVal = getVal[1] | strip
                                          endif
                                        -%}
                                        <div
                                          {% if layoutTypeIs == 'tab' %}
                                            style="display:none;"
                                          {% endif %}
                                          class="product-variant__item product-variant__item--radio"
                                          min="{{ minVal }}"
                                          max="{{ maxVal }}"
                                        >
                                          <input type="radio" name="product-{{ option.name | escape | downcase | strip }}-{{ section.id }}" id="{{ product.handle }}-option-{{ option.name | escape | downcase | strip }}-{{ forloop.index }}-{{ section.id }}" value="{{ value | escape }}" {% if default_to_first_variant and option.selected_value == value %}checked{% endif %} class="product-variant__input product-variant-value">
                                          <label for="{{ product.handle }}-option-{{ option.name | escape | downcase | strip }}-{{ forloop.index }}-{{ section.id }}" class="product-variant__label text-size--small" val="{{ value | replace: '"', '^' }}">
                                            {{ value | escape }}
                                          </label>
                                        </div>
                                      {%- endfor -%}
                                      <select class="custom-variant-selector product-variant__container product-variant__container--select text-size--small {% if layoutTypeIs == 'previous' or layoutTypeIs == 'tab_pills' %}hidden{% endif %}">
                                        {%- for value in option.values -%}
                                          {%- unless value contains 'Style #' -%}
                                          <option  class="product-variant-value" value="{{ value | escape }}" {% if default_to_first_variant and option.selected_value == value %}selected{% endif %}>
                                            {{ value | escape }}
                                          </option>
                                          {% endunless %}
                                        {%- endfor -%}
                                      </select>
                                    </div>
                                  {%- endif -%}
                                </div>
                              {%- endfor -%}
                            </div>

                            <noscript>
                              <label for="Variants-{{ section.id }}" class="text-size--small" style="display:block;margin-bottom:.75rem">{{ 'products.page.variants' | t }}</label>
                              <select name="id" id="Variants-{{ section.id }}" class="productSelect"
                                {% if product.has_only_default_variant %} style="display:none!important" {% endif %}
                                form="{{ product_form_id }}"
                              >
                                {%- for variant in product.variants -%}
                                  <option
                                    {% if variant == current_variant %}selected="selected"{% endif %}
                                    {% if variant.available == false %}disabled{% endif %}
                                    value="{{ variant.id }}"
                                  >
                                    {{ variant.title }}
                                    {% if variant.available == false %} - {{ 'products.page.inventory.sold_out_variant' | t }}{% endif %}
                                    - {{ variant.price | money | strip_html }}
                                  </option>
                                {%- endfor -%}
                              </select>
                            </noscript>

                            <script type="application/json">
                              {{ product.variants | json }}
                            </script>
                          </product-variants>
