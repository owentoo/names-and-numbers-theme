<div data-test-render-section="TEST_RENDER_OK_{{ section.id }}" style="background:red;color:white;padding:8px;text-align:center;font-weight:700;">{{ section.settings.label }}</div>

{% schema %}
{
  "name": "Test Render",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "TEST RENDER VISIBLE" }
  ],
  "presets": [{ "name": "Test Render" }]
}
{% endschema %}
