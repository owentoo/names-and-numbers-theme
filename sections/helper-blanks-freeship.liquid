{%- liquid
  assign blanks_total = 0
  for item in cart.items
    if item.product.tags contains 'Blank Apparel'
      assign blanks_total = blanks_total | plus: item.final_line_price
    endif
  endfor
-%}

<div data-pdp-blanks-freeship-helper data-blanks-total="{{ blanks_total }}"></div>

{% schema %}
  {
    "name": "Blanks Freeship Helper"
  }
{% endschema %}
