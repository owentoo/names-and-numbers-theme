{%- assign s = section.settings -%}


<style>
  #blanks-hero-{{ section.id }} *,
  #blanks-hero-{{ section.id }} *::before,
  #blanks-hero-{{ section.id }} *::after { box-sizing: border-box; }

  #blanks-hero-{{ section.id }} {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #1a1a1a;
    background: #fff;
    -webkit-font-smoothing: antialiased;
  }

  /* ===== Hero ===== */
  #blanks-hero-{{ section.id }} .nbh-hero {
    position: relative;
    background: #fff;
    overflow: hidden;
  }
  #blanks-hero-{{ section.id }} .nbh-hero-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    position: relative;
    display: flex;
    align-items: center;
    gap: 40px;
  }
  #blanks-hero-{{ section.id }} .nbh-left {
    flex: 1;
    min-width: 0;
  }

  /* Eyebrow */
  #blanks-hero-{{ section.id }} .nbh-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fffbf0;
    border: 1px solid #fde89a;
    border-radius: 20px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
    color: #9a6400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  #blanks-hero-{{ section.id }} .nbh-eyebrow-dot {
    width: 6px;
    height: 6px;
    background: #fba500;
    border-radius: 50%;
    animation: nbh-pulse-{{ section.id }} 2s infinite;
  }
  @keyframes nbh-pulse-{{ section.id }} {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  /* Headline */
  #blanks-hero-{{ section.id }} .nbh-h1 {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: {{ section.settings.padding_bottom }}px;
    max-width: 800px;
    color: #2a2a2a;
  }
  #blanks-hero-{{ section.id }} .nbh-highlight { color: #fba500; }

  /* Trust Bar */
  #blanks-hero-{{ section.id }} .nbh-trust-bar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    flex-shrink: 0;
    width: 340px;
  }
  #blanks-hero-{{ section.id }} .nbh-trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    color: #3a3a4a;
    background: rgba(255,255,255,0.8);
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 12px;
    padding: 14px 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
  }
  #blanks-hero-{{ section.id }} .nbh-trust-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(251,165,0,0.1);
    border-radius: 8px;
    color: #fba500;
    flex-shrink: 0;
  }
  #blanks-hero-{{ section.id }} .nbh-trust-icon svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Description */
  #blanks-hero-{{ section.id }} .nbh-description {
    font-size: 0.95rem;
    color: #666;
    line-height: 1.65;
    max-width: 800px;
    margin-bottom: 0;
  }
  #blanks-hero-{{ section.id }} .nbh-description p { margin: 0; }
  #blanks-hero-{{ section.id }} .nbh-description a { color: inherit; text-decoration: underline; }

  /* ===== Category Nav ===== */
  #blanks-hero-{{ section.id }} .nbh-cat-nav {
    position: relative;
    background: #fafafa;
  }
  #blanks-hero-{{ section.id }} .nbh-cat-nav-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.85rem 40px;
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #blanks-hero-{{ section.id }} .nbh-cat-nav-inner::-webkit-scrollbar { display: none; }
  #blanks-hero-{{ section.id }} .nbh-cat-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    height: 56px;
    background: transparent;
    border: 1px solid #E0E0E0;
    border-radius: 12px;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }
  #blanks-hero-{{ section.id }} .nbh-cat-card::after {
    content: "›";
    font-size: 18px;
    font-weight: 400;
    color: #bbb;
    margin-left: 2px;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  #blanks-hero-{{ section.id }} .nbh-cat-card:hover {
    background: #fff;
    border-color: #ddd;
    box-shadow: 0 3px 12px rgba(0,0,0,0.1);
    transform: translateY(-2px);
  }
  #blanks-hero-{{ section.id }} .nbh-cat-card:hover::after {
    color: #888;
    transform: translateX(2px);
  }
  #blanks-hero-{{ section.id }} .nbh-cat-card.nbh-active {
    background: #fff;
    border-color: #fba500;
    box-shadow: inset 3px 0 0 #fba500, 0 1px 8px rgba(251,165,0,0.1);
  }
  #blanks-hero-{{ section.id }} .nbh-cat-card-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }
  #blanks-hero-{{ section.id }} .nbh-cat-card-icon svg { width: 24px; height: 24px; }
  #blanks-hero-{{ section.id }} .nbh-cat-card-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #222;
    letter-spacing: -0.01em;
  }
  #blanks-hero-{{ section.id }} .nbh-cat-card.nbh-active .nbh-cat-card-label { color: #1a1a1a; }

  /* ===== Responsive ===== */
  @media (max-width: 700px) {
    #blanks-hero-{{ section.id }} .nbh-hero-inner { padding: 1.25rem 20px 1rem; flex-direction: column; align-items: flex-start; gap: 16px; }
    #blanks-hero-{{ section.id }} .nbh-h1 { font-size: 1.75rem; margin-bottom: 10px; }
    #blanks-hero-{{ section.id }} .nbh-eyebrow { margin-bottom: 8px; }
    #blanks-hero-{{ section.id }} .nbh-description { font-size: 0.82rem; line-height: 1.5; }
    /* Trust bar: compact 2x2 grid */
    #blanks-hero-{{ section.id }} .nbh-trust-bar { width: 100%; gap: 6px; }
    #blanks-hero-{{ section.id }} .nbh-trust-item {
      padding: 6px 10px;
      font-size: 11px;
      gap: 6px;
      border-radius: 8px;
    }
    #blanks-hero-{{ section.id }} .nbh-trust-icon {
      width: 22px;
      height: 22px;
      border-radius: 5px;
    }
    #blanks-hero-{{ section.id }} .nbh-trust-icon svg { width: 12px; height: 12px; }
    /* Category nav */
    #blanks-hero-{{ section.id }} .nbh-cat-nav-inner { padding: 0.65rem 8px 0.65rem 20px; }
    #blanks-hero-{{ section.id }} .nbh-cat-card { height: 48px; padding: 0 12px; gap: 8px; }
    #blanks-hero-{{ section.id }} .nbh-cat-card-icon { width: 30px; height: 30px; }
    #blanks-hero-{{ section.id }} .nbh-cat-card-icon svg { width: 20px; height: 20px; }
    #blanks-hero-{{ section.id }} .nbh-cat-card-label { font-size: 0.75rem; }
    /* Right-edge fade gradient indicating horizontal scrollability */
    #blanks-hero-{{ section.id }} .nbh-cat-nav::after {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 56px;
      pointer-events: none;
      background: linear-gradient(to right, rgba(250,250,250,0) 0%, #fafafa 100%);
    }
  }
</style>

<div id="blanks-hero-{{ section.id }}">

  <!-- Hero -->
  <header class="nbh-hero">
    <div class="nbh-hero-inner">

      <!-- Left -->
      <div class="nbh-left">
        {%- if s.eyebrow_text != blank -%}
          <div class="nbh-eyebrow"><span class="nbh-eyebrow-dot"></span>{{ s.eyebrow_text }}</div>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h1 class="nbh-h1">
            {{ s.heading }}
            {%- if s.heading_connector != blank -%}
              {{ s.heading_connector }}
            {%- endif -%}
            {%- if s.heading_highlight != blank -%}
              <span class="nbh-highlight"> {{ s.heading_highlight }}</span>
            {%- endif -%}
          </h1>
        {%- endif -%}

        {%- if s.description != blank -%}
          <div class="nbh-description">{{ s.description }}</div>
        {%- endif -%}
      </div>

      <!-- Trust Bar -->
      <div class="nbh-trust-bar">
        {%- if s.pill_delivery != blank -%}
          <div class="nbh-trust-item">
            <span class="nbh-trust-icon"><svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></span>
            {{ s.pill_delivery }}
          </div>
        {%- endif -%}
        {%- if s.pill_ship != blank -%}
          <div class="nbh-trust-item">
            <span class="nbh-trust-icon"><svg viewBox="0 0 24 24"><path d="M21 10H3M16 2l5 8M8 2L3 10M12 22l-4-12h8z"/></svg></span>
            {{ s.pill_ship }}
          </div>
        {%- endif -%}
        {%- if s.pill_min != blank -%}
          <div class="nbh-trust-item">
            <span class="nbh-trust-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/></svg></span>
            {{ s.pill_min }}
          </div>
        {%- endif -%}
        {%- if s.pill_price != blank -%}
          <div class="nbh-trust-item">
            <span class="nbh-trust-icon"><svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></span>
            {{ s.pill_price }}
          </div>
        {%- endif -%}
      </div>

    </div>
  </header>

  <!-- Category Nav -->
  {%- assign bh_meta_cats = collection.metafields.custom.popular_categories -%}
  {%- if section.blocks.size > 0 or bh_meta_cats != blank -%}
    <nav class="nbh-cat-nav">
      <div class="nbh-cat-nav-inner">
        {%- comment -%} Block-based category cards (from theme editor) {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- assign col_handle = b.url | split: '/' | last -%}
          {%- assign linked_col = collections[col_handle] -%}
          <a href="{{ b.url }}" class="nbh-cat-card{% if b.is_active %} nbh-active{% endif %}" {{ block.shopify_attributes }}>
            <span class="nbh-cat-card-icon" style="background:{{ b.icon_bg_color }}">
              {%- if linked_col.image != blank -%}
                {{ linked_col.image | image_url: width: 96 | image_tag: loading: 'lazy', width: 48, height: 48, style: 'width:100%;height:100%;object-fit:cover;border-radius:10px;' }}
              {%- else -%}
                <svg viewBox="0 0 64 64" fill="none">
                  <path d="M12 18l8-8h24l8 8-6 4v26a2 2 0 01-2 2H20a2 2 0 01-2-2V22l-6-4z" fill="{{ b.icon_color }}" opacity=".85"/>
                  <path d="M20 10h24l-4 12H24L20 10z" fill="{{ b.icon_color }}" opacity=".45"/>
                  <path d="M12 18l8-4 4 8-6 4-6-4v-4zM52 18l-8-4-4 8 6 4 6-4v-4z" fill="{{ b.icon_color }}" opacity=".55"/>
                </svg>
              {%- endif -%}
            </span>
            <span class="nbh-cat-card-label">{{ b.label }}</span>
          </a>
        {%- endfor -%}
        {%- comment -%} Metafield-based category cards (from collection.metafields.custom.popular_categories) {%- endcomment -%}
        {%- if bh_meta_cats != blank -%}
          {%- assign bh_cat_entries = bh_meta_cats | split: ',' -%}
          {%- for entry in bh_cat_entries -%}
            {%- assign bh_parts = entry | strip | split: '|' -%}
            {%- assign bh_slug = bh_parts[0] | strip -%}
            {%- assign bh_title = bh_parts[1] | strip -%}
            {%- if bh_slug == blank or bh_title == blank -%}{%- continue -%}{%- endif -%}
            {%- assign bh_cat_col = collections[bh_slug] -%}
            <a href="/collections/{{ bh_slug }}" class="nbh-cat-card{% if collection.handle == bh_slug %} nbh-active{% endif %}">
              <span class="nbh-cat-card-icon" style="background:#f0f4ff">
                {%- if bh_cat_col.image != blank -%}
                  {{ bh_cat_col.image | image_url: width: 96 | image_tag: loading: 'lazy', width: 48, height: 48, style: 'width:100%;height:100%;object-fit:cover;border-radius:10px;' }}
                {%- else -%}
                  <svg viewBox="0 0 64 64" fill="none">
                    <path d="M12 18l8-8h24l8 8-6 4v26a2 2 0 01-2 2H20a2 2 0 01-2-2V22l-6-4z" fill="#4A7BF7" opacity=".85"/>
                    <path d="M20 10h24l-4 12H24L20 10z" fill="#4A7BF7" opacity=".45"/>
                    <path d="M12 18l8-4 4 8-6 4-6-4v-4zM52 18l-8-4-4 8 6 4 6-4v-4z" fill="#4A7BF7" opacity=".55"/>
                  </svg>
                {%- endif -%}
              </span>
              <span class="nbh-cat-card-label">{{ bh_title | escape }}</span>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </nav>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Blanks Hero",
  "settings": [
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "Order today · ships tomorrow"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Blank Short Sleeve T-Shirts"
    },
    {
      "type": "text",
      "id": "heading_connector",
      "label": "Connector word",
      "default": "at",
      "info": "Word between the heading and the highlight (e.g. \"at\"). Leave blank to hide."
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted text",
      "default": "Wholesale Prices"
    },
    {
      "type": "header",
      "content": "Trust Features"
    },
    {
      "type": "text",
      "id": "pill_delivery",
      "label": "Feature 1",
      "default": "Next-day delivery"
    },
    {
      "type": "text",
      "id": "pill_min",
      "label": "Feature 2",
      "default": "No minimums"
    },
    {
      "type": "text",
      "id": "pill_ship",
      "label": "Feature 3",
      "default": "Free shipping on $50+"
    },
    {
      "type": "text",
      "id": "pill_price",
      "label": "Feature 4",
      "default": "Wholesale pricing"
    },
    {
      "type": "color",
      "id": "feature_check_color",
      "label": "Checkmark color",
      "default": "#16a34a"
    },
    {
      "type": "color",
      "id": "feature_text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Shop blank short sleeve t-shirts at wholesale prices with fast delivery and no minimums. From Gildan and Hanes to Next Level and Bella+Canvas — find the right blank tee to stock up for printing, events, or everyday resale.</p>"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "unit": "px",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "unit": "px",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "T-Shirts"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color",
          "default": "#4A7BF7"
        },
        {
          "type": "color",
          "id": "icon_bg_color",
          "label": "Icon background",
          "default": "#f0f4ff"
        },
        {
          "type": "checkbox",
          "id": "is_active",
          "label": "Show active style",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blanks Hero"
    }
  ]
}
{% endschema %}
