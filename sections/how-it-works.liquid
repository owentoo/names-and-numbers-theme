{%- comment -%}
  How It Works — light section with a small kicker, large heading,
  supporting subheading, and a row of step cards. Each step is a
  block with a number, icon, title, description, and footer label
  (e.g. "~ 20 SECONDS", "3-5 DAYS", "YOUR CALL").

  Designed to sit on PDPs (e.g. /products/free-samples) between the
  stat bar and the customer reviews section.
{%- endcomment -%}

{%- liquid
  assign bg_color         = section.settings.bg_color         | default: '#ffffff'
  assign kicker_color     = section.settings.kicker_color     | default: '#1d8ce0'
  assign heading_color    = section.settings.heading_color    | default: '#0a0a0a'
  assign subheading_color = section.settings.subheading_color | default: '#525252'
  assign card_bg          = section.settings.card_bg          | default: '#ffffff'
  assign card_border      = section.settings.card_border      | default: '#e5e7eb'
  assign card_radius      = section.settings.card_radius      | default: 14
  assign number_color     = section.settings.number_color     | default: '#9ca3af'
  assign icon_bg          = section.settings.icon_bg          | default: '#f3ead8'
  assign icon_color       = section.settings.icon_color       | default: '#0a0a0a'
  assign title_color      = section.settings.title_color      | default: '#0a0a0a'
  assign body_color       = section.settings.body_color       | default: '#525252'
  assign footer_color     = section.settings.footer_color     | default: '#1d8ce0'
-%}

<style>
  .hiw-{{ section.id }} {
    background: {{ bg_color }};
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  .hiw-{{ section.id }} .hiw__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }
  .hiw-{{ section.id }} .hiw__head {
    text-align: center;
    margin-bottom: {{ section.settings.head_gap }}px;
  }
  .hiw-{{ section.id }} .hiw__kicker {
    color: {{ kicker_color }};
    font-size: {{ section.settings.kicker_size }}px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .hiw-{{ section.id }} .hiw__heading {
    color: {{ heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .hiw-{{ section.id }} .hiw__subheading {
    color: {{ subheading_color }};
    font-size: {{ section.settings.subheading_size }}px;
    line-height: 1.55;
    margin: 0 auto;
    max-width: {{ section.settings.subheading_max_width }}px;
  }
  .hiw-{{ section.id }} .hiw__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    gap: {{ section.settings.card_gap }}px;
  }
  .hiw-{{ section.id }} .hiw__card {
    background: {{ card_bg }};
    border: 1px solid {{ card_border }};
    border-radius: {{ card_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
  }
  .hiw-{{ section.id }} .hiw__num {
    color: {{ number_color }};
    font-size: {{ section.settings.number_size }}px;
    font-weight: 500;
    letter-spacing: 0.04em;
    margin: 0 0 {{ section.settings.number_gap }}px;
  }
  .hiw-{{ section.id }} .hiw__icon {
    width: {{ section.settings.icon_box_size }}px;
    height: {{ section.settings.icon_box_size }}px;
    border-radius: {{ section.settings.icon_radius }}px;
    background: {{ icon_bg }};
    color: {{ icon_color }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ section.settings.icon_gap }}px;
  }
  .hiw-{{ section.id }} .hiw__icon img,
  .hiw-{{ section.id }} .hiw__icon svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
  }
  .hiw-{{ section.id }} .hiw__icon-emoji {
    font-size: {{ section.settings.icon_size }}px;
    line-height: 1;
  }
  .hiw-{{ section.id }} .hiw__title {
    color: {{ title_color }};
    font-size: {{ section.settings.title_size }}px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 10px;
  }
  .hiw-{{ section.id }} .hiw__body {
    color: {{ body_color }};
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.55;
    margin: 0 0 {{ section.settings.body_gap }}px;
    flex-grow: 1;
  }
  .hiw-{{ section.id }} .hiw__footer {
    color: {{ footer_color }};
    font-size: {{ section.settings.footer_size }}px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0;
  }

  @media (max-width: 989px) {
    .hiw-{{ section.id }} .hiw__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 749px) {
    .hiw-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    .hiw-{{ section.id }} .hiw__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
    .hiw-{{ section.id }} .hiw__subheading {
      font-size: {{ section.settings.subheading_size_mobile }}px;
    }
    .hiw-{{ section.id }} .hiw__grid {
      grid-template-columns: 1fr;
      gap: {{ section.settings.card_gap_mobile }}px;
    }
  }
</style>

<div class="hiw-{{ section.id }}">
  <div class="hiw__inner">
    {%- if section.settings.kicker != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="hiw__head">
        {%- if section.settings.kicker != blank -%}
          <p class="hiw__kicker">{{ section.settings.kicker }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hiw__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="hiw__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="hiw__grid">
        {%- for block in section.blocks -%}
          <div class="hiw__card" {{ block.shopify_attributes }}>
            {%- if block.settings.number != blank -%}
              <p class="hiw__num">{{ block.settings.number }}</p>
            {%- endif -%}

            {%- if block.settings.icon_image != blank or block.settings.icon_svg != blank or block.settings.icon_emoji != blank -%}
              <span class="hiw__icon">
                {%- if block.settings.icon_image != blank -%}
                  <img src="{{ block.settings.icon_image | image_url: width: 96 }}"
                       alt="{{ block.settings.icon_image.alt | default: block.settings.title | escape }}"
                       width="{{ section.settings.icon_size }}"
                       height="{{ section.settings.icon_size }}"
                       loading="lazy">
                {%- elsif block.settings.icon_svg != blank -%}
                  {{ block.settings.icon_svg }}
                {%- else -%}
                  <span class="hiw__icon-emoji">{{ block.settings.icon_emoji }}</span>
                {%- endif -%}
              </span>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="hiw__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="hiw__body">{{ block.settings.description }}</p>
            {%- endif -%}
            {%- if block.settings.footer_label != blank -%}
              <p class="hiw__footer">{{ block.settings.footer_label }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

