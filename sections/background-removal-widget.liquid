                 <script src="https://sdk.amazonaws.com/js/aws-sdk-2.1258.0.min.js"></script>  
                <script>
                (function() {
                  /* Scope all DOM queries to this section's own subtree. On
                     /pages/welcome the Background Remover and Upscaler panes
                     can both live in the DOM at once (they share `#uploadArea`,
                     `#dropZoon`, `#fileInput`, etc.). Plain
                     `document.querySelector('#fileInput')` would always return
                     the first match, so the second-loaded pane would bind its
                     handlers to the wrong (hidden) elements and the visible
                     "Choose file" button would stop working. */
                  var __thisScript = document.currentScript;
                  var root = (__thisScript && (__thisScript.closest('.mp-ajax-pane') || __thisScript.closest('.shopify-section'))) || document;
                  var uploadArea = root.querySelector('#uploadArea');
                  var dropZoon = root.querySelector('#dropZoon');
                  var fileInput = root.querySelector('#fileInput');
                  var previewImage = root.querySelector('#previewImage2');
                  var fileDetails = root.querySelector('#fileDetails');
                  if (!uploadArea || !dropZoon || !fileInput) return;
                  /* Expose for template-level custom_liquid (#second_upload) inline
                     script on direct visits to /pages/background-remover (where the
                     widget script runs before the button exists, so the widget's own
                     capture handler can't be wired). On the welcome page these
                     globals are overwritten by whichever pane loaded last, but the
                     widget's per-pane capture handler with stopImmediatePropagation
                     fires before the template bubble handler ever evaluates them. */
                  window.dropZoon = dropZoon;
                  window.fileInput = fileInput;
                  
                const imagesTypes = ["image/png","image/jpg","image/jpeg","image/tiff","application/pdf","image/vnd.adobe.photoshop","application/postscript","application/vnd.adobe.photoshop","application/x-photoshop","application/photoshop","application/psd","image/psd","image/svg+xml"];
                  
                  // When (drop-zoon) has (dragover) Event
                  uploadArea.addEventListener('dragover', function (event) {
                    // Prevent Default Behavior
                    event.preventDefault();

                    // Add Class (drop-zoon--over) On (drop-zoon)
                    uploadArea.classList.add('drop-zoon--over');
                    var ov = root.querySelector(".file-upload-overlay-1");
                    if (ov) ov.classList.add("active");
                    document.body.classList.add("file-upload-overlay-1-active");
                  });

                  // When (drop-zoon) has (dragleave) Event
                  uploadArea.addEventListener('dragleave', function (event) {
                    // Remove Class (drop-zoon--over) from (drop-zoon)
                    uploadArea.classList.remove('drop-zoon--over');
                     var ov = root.querySelector(".file-upload-overlay-1");
                     if (ov) ov.classList.remove("active");
                     document.body.classList.remove("file-upload-overlay-1-active");
                  });

                  // When (drop-zoon) has (drop) Event
                  uploadArea.addEventListener('drop', function (event) {
                    // Prevent Default Behavior
                    event.preventDefault();

                    // Remove Class (drop-zoon--over) from (drop-zoon)
                    uploadArea.classList.remove('drop-zoon--over');
                    var ov = root.querySelector(".file-upload-overlay-1");
                    if (ov) ov.classList.remove("active");
                     document.body.classList.remove("file-upload-overlay-1-active");
                  
                    // Select The Dropped File
                    const file = event.dataTransfer.files[0];
                  
                    // Call Function uploadFile(), And Send To Her The Dropped File :)
                    uploadFile(file);
                  });
                  
                  // When (drop-zoon) has (click) Event
                  uploadArea.addEventListener('click', function (event) {
                    // Click The (fileInput)
                    fileInput.click();
                  });

                  /* Bottom "Choose file..." button (#second_upload) in template's custom_liquid:
                     scroll to upload area, reset state, and open native file picker.
                     Capture phase + stopImmediatePropagation so the template's inline
                     handler doesn't fire fileInput.click() a second time.
                     Scoped to this pane so the BG-Remover and Upscaler don't fight
                     over each other's #second_upload buttons on /pages/welcome. */
                  var secondUploadBtn = root.querySelector('#second_upload');
                  if (secondUploadBtn) {
                    secondUploadBtn.addEventListener('click', function(e) {
                      e.stopImmediatePropagation();
                      try {
                        if (typeof $ !== 'undefined' && $('#main').length) {
                          $('html, body').animate({ scrollTop: $('#main').offset().top - 180 }, 600);
                        } else {
                          var mainEl = document.getElementById('main') || uploadArea;
                          if (mainEl && mainEl.scrollIntoView) mainEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }
                      } catch(err) {}
                      var beforeEl = root.querySelector('[item-show-on="beforeUpload"]');
                      var afterEl = root.querySelector('[item-show-on="afterUpload"]');
                      if (beforeEl) beforeEl.style.display = 'flex';
                      if (afterEl) afterEl.style.display = 'none';
                      dropZoon.classList.remove('drop-zoon--Uploaded');
                      fileInput.click();
                    }, true);
                  }

                  // When (fileInput) has (change) Event
                  fileInput.addEventListener('change', function (event) {
                    // Select The Chosen File
                    const file = event.target.files[0];
                  
                    // Call Function uploadFile(), And Send To Her The Chosen File :)
                    uploadFile(file);
                  });
                  
                      // Upload File Function
                 function uploadFile(file) {
                     $( `html, body` ).animate({
                scrollTop: ($( `#main` ).offset().top - 180)
              }, 1000);
                    // FileReader()
                    const fileReader = new FileReader();
                    // File Type 
                    const fileType = file.type;
                    // File Size 
                    const fileSize = file.size;
                   
                    
                    // If File Is Passed from the (File Validation) Function
                    if (fileValidate(fileType, fileSize)) {
                      // Add Class (drop-zoon--Uploaded) on (drop-zoon)
                      dropZoon.classList.add('drop-zoon--Uploaded');
                   
                     // After File Reader Loaded 
                      fileReader.addEventListener('load', function () {  
                        console.log("fileReader",fileReader);
                      previewImage.setAttribute('src', fileReader.result); 
                        fileDetails.innerHTML = file.name;  
                        
                   
                       const randomName = file.name.split('.')[0].replace(/[^a-z0-9\s]/gi, '').replace(/[_\s]/g, '-')+"____"+'image_' + Date.now() + '_' + Math.floor(Math.random() * 1000) + '.' + file.name.split('.').pop();
                    upscaleImage(fileReader,randomName, file)
                        
                       
                  });  
                        fileReader.readAsDataURL(file);  
				  }
                 }

                      async  function upscaleImage(fileReader,randomName, file){ 
           const presignData = await getPresignedUploadUrl(randomName, file.type)
                          if (presignData.url) { 
                            const response = await fetch(presignData.url, {
                              method: 'PUT', 
                              body: file
                            });
                            console.log("upload response: " + JSON.stringify(response)); 
                                   
                                     const filePath = "https://ninjauploads-production.imgix.net/"+randomName+"?bg-remove=true&trim=auto&fm=png";;
                                     previewImage.setAttribute('src', filePath);
                                                     
                                      setTimeout(function(){

                                        var beforeEl2 = root.querySelector('[item-show-on="beforeUpload"]');
                                        var afterEl2 = root.querySelector('[item-show-on="afterUpload"]');
                                        if (beforeEl2) beforeEl2.style.display = "none";
                                        if (afterEl2) afterEl2.style.display = "block";
                                        var dtfBtn = root.querySelector("#dtf_transfer");
                                        var uvBtn = root.querySelector("#uv_transfer");
                                        var dlBtn = root.querySelector("#download_image");
                                        if (dtfBtn) dtfBtn.setAttribute("href","/products/dtf-transfers?file="+filePath);
                                        if (uvBtn) uvBtn.setAttribute("href","/products/uv-dtf-stickers-decals-by-size?file="+filePath);
                                        if (dlBtn) dlBtn.setAttribute("href",filePath+"&dl");
                                        $(root).find("#fileSize").html($(root).find("#previewImage2").width()+" x "+$(root).find("#previewImage2").height()+"px");
                                      },8000)
                       
                      // Read (file) As Data Url 
                     
                    } else { // Else
                   
                  
                    };
      } 
                  
                  async function downloadImage(imageSrc, file_name) { 
  const image = await fetch(imageSrc)
  const imageBlob = await image.blob()
  const imageURL = URL.createObjectURL(imageBlob)

  const link = document.createElement('a')
  link.href = imageURL
  link.download = file_name
  document.body.appendChild(link)
  link.click()
  document.body.removeChild(link)
}

function fileValidate(fileType, fileSize) {
   setTimeout(function(){
     $(root).find("#uploadArea").removeClass("drop-disabled-size");
     $(root).find("#uploadArea").removeClass("drop-disabled-type");
  },3500)
  // File Type Validation
//  alert(fileType);
  let isImage = imagesTypes.filter((type) => fileType.indexOf(`${type}`) !== -1);


  // If The Uploaded File Is An Image
  if (isImage.length !== 0   ) {
    // Check, If File Size Is 2MB or Less
    if (fileSize <= 5368709120) { // 2MB :)
      return true;
    } else { // Else File Size
      $(root).find("#uploadArea").addClass("drop-disabled-size");
      return false
    };
  } else { // Else File Type
    $(root).find("#uploadArea").addClass("drop-disabled-type");
    return false
  };

};

                  $(root).find("#reupload").on("click", function(e){
                      e.preventDefault();
                     var beforeEl3 = root.querySelector('[item-show-on="beforeUpload"]');
                     var afterEl3 = root.querySelector('[item-show-on="afterUpload"]');
                     if (beforeEl3) beforeEl3.style.display = "flex";
                     if (afterEl3) afterEl3.style.display = "none";
                     dropZoon.classList.remove('drop-zoon--Uploaded');
                    fileInput.click();
                  })
          {% if customer %}
                  window.saveFile = function saveFile(){
                    $(root).find("#save_for_later").html("Saving...");
                    var dtfA = root.querySelector("#dtf_transfer");
                    var file = dtfA ? (dtfA.getAttribute("href")||'').split("?file=")[1] : '';
                    $(root).find("#save_for_later").css({"pointer-events":"none","opacity":0.7});
                      $.ajax({
                        url: "https://hpz51rjda5.execute-api.us-east-1.amazonaws.com/production/uploads/saveData",
                        method:"post",
                        dataType:"json",
                        data: JSON.stringify([{
                            "variant_title":  "2x2",
                            "file":file ,
                            "customer_id": {{ customer.id }},
                            "file_name": (root.querySelector('#fileDetails') ? root.querySelector('#fileDetails').innerHTML : ''),
                            "file_crc":"",
                            "gangsheet": false
                          }]),
                        complete:function(){
                          $(root).find("#save_for_later").html("File Saved");
                        }
                      });
                  };
            {% endif %}

                   const apiPresigningURL = `https://hpz51rjda5.execute-api.us-east-1.amazonaws.com/production/uploads/getPresignedUploadUrl`;
                  async function getPresignedUploadUrl(file_name, file_type ) {
                            try {
                              let rtn;
                              await $.get(`${apiPresigningURL}?file_name=${encodeURIComponent(file_name)}&file_type=${encodeURIComponent(file_type)}`, function ( res ) {
                                rtn   =   res;
                              });
                              return rtn;
                            } catch ( err ) {
                              console.log( `ERROR getPresignedUploadUrl`, err.message );
                            }
                          }

                  var mainDropZone = document.querySelector( "body" );
                    mainDropZone.addEventListener('dragover', (e) => {
                      e.preventDefault();
                    });
                    mainDropZone.addEventListener('drop', async (e) => {
                       e.preventDefault()
                    });
                })();
                </script>
