{%- comment -%}
  DTF Video Demo — fully editable hero video section.

  Supports a Shopify-uploaded video file, OR a YouTube/Vimeo URL.
  Falls back to a striped placeholder when no poster image is set.
  All text, colors, padding, and the video itself are editable in
  the theme editor.
{%- endcomment -%}

<style>
  .vdemo-{{ section.id }} {
    background: {{ section.settings.outer_bg_color }};
    padding: {{ section.settings.outer_padding_top }}px 24px {{ section.settings.outer_padding_bottom }}px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  .vdemo-{{ section.id }} .vdemo__panel {
    background: {{ section.settings.bg_color }};
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    border-radius: {{ section.settings.panel_radius }}px;
  }
  .vdemo-{{ section.id }} .vdemo__inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .vdemo-{{ section.id }} .vdemo__head {
    text-align: center;
    margin-bottom: 36px;
  }
  .vdemo-{{ section.id }} .vdemo__kicker {
    color: {{ section.settings.kicker_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .vdemo-{{ section.id }} .vdemo__heading {
    color: {{ section.settings.heading_color }};
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
  }
  .vdemo-{{ section.id }} .vdemo__subheading {
    color: {{ section.settings.subheading_color }};
    font-size: 16px;
    line-height: 1.6;
    max-width: 560px;
    margin: 0 auto;
  }

  .vdemo-{{ section.id }} .vdemo__player {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    background: #1a1f2e;
  }
  .vdemo-{{ section.id }} .vdemo__poster,
  .vdemo-{{ section.id }} .vdemo__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .vdemo-{{ section.id }} .vdemo__placeholder {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      45deg,
      #161b27,
      #161b27 20px,
      #1c2230 20px,
      #1c2230 40px
    );
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.22);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-align: center;
    padding: 0 16px;
  }
  .vdemo-{{ section.id }} .vdemo__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: #fff;
    border: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
    z-index: 3;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  }
  .vdemo-{{ section.id }} .vdemo__play:hover,
  .vdemo-{{ section.id }} .vdemo__play:focus-visible {
    transform: translate(-50%, -50%) scale(1.06);
    outline: none;
  }
  .vdemo-{{ section.id }} .vdemo__play svg {
    width: 28px;
    height: 28px;
    color: #0a0a0a;
    margin-left: 4px;
  }
  .vdemo-{{ section.id }} .vdemo__caption {
    position: absolute;
    bottom: 16px;
    left: 20px;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    z-index: 2;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }
  .vdemo-{{ section.id }} .vdemo__duration {
    position: absolute;
    bottom: 16px;
    right: 20px;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 12px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    z-index: 2;
  }
  .vdemo-{{ section.id }} .vdemo__player.is-playing .vdemo__poster,
  .vdemo-{{ section.id }} .vdemo__player.is-playing .vdemo__placeholder,
  .vdemo-{{ section.id }} .vdemo__player.is-playing .vdemo__play,
  .vdemo-{{ section.id }} .vdemo__player.is-playing .vdemo__caption,
  .vdemo-{{ section.id }} .vdemo__player.is-playing .vdemo__duration {
    display: none;
  }

  @media (max-width: 749px) {
    .vdemo-{{ section.id }} { padding-left: 12px; padding-right: 12px; }
    .vdemo-{{ section.id }} .vdemo__panel { padding-left: 20px; padding-right: 20px; border-radius: {{ section.settings.panel_radius | times: 0.6 | round }}px; }
    .vdemo-{{ section.id }} .vdemo__head { margin-bottom: 24px; }
    .vdemo-{{ section.id }} .vdemo__heading { font-size: 26px; }
    .vdemo-{{ section.id }} .vdemo__subheading { font-size: 14px; }
    .vdemo-{{ section.id }} .vdemo__play { width: 64px; height: 64px; }
    .vdemo-{{ section.id }} .vdemo__play svg { width: 22px; height: 22px; }
    .vdemo-{{ section.id }} .vdemo__caption { font-size: 12px; bottom: 12px; left: 14px; }
    .vdemo-{{ section.id }} .vdemo__duration { font-size: 11px; bottom: 12px; right: 14px; }
  }
</style>

<div class="vdemo-{{ section.id }}">
  <div class="vdemo__panel">
   <div class="vdemo__inner">
    <div class="vdemo__head">
      {%- if section.settings.kicker != blank -%}
        <p class="vdemo__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="vdemo__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="vdemo__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="vdemo__player" data-vdemo-player>
      {%- liquid
        assign has_video = false
        if section.settings.video != blank
          assign has_video = true
        elsif section.settings.video_url != blank
          assign has_video = true
        endif

        assign poster_image = section.settings.poster
        if poster_image == blank and section.settings.video != blank and section.settings.video.preview_image
          assign poster_image = section.settings.video.preview_image
        endif
      -%}

      {%- if poster_image != blank -%}
        <img
          class="vdemo__poster"
          src="{{ poster_image | image_url: width: 1600 }}"
          srcset="{{ poster_image | image_url: width: 800 }} 800w, {{ poster_image | image_url: width: 1200 }} 1200w, {{ poster_image | image_url: width: 1600 }} 1600w"
          sizes="(min-width: 1200px) 1200px, 100vw"
          alt="{{ section.settings.caption | escape }}"
          loading="lazy"
          width="1600"
          height="900">
      {%- else -%}
        <div class="vdemo__placeholder">{{ section.settings.placeholder_text }}</div>
      {%- endif -%}

      {%- if section.settings.video != blank -%}
        <video class="vdemo__media" data-vdemo-media playsinline preload="none" controls>
          {%- for source in section.settings.video.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
        </video>
      {%- elsif section.settings.video_url != blank -%}
        {%- if section.settings.video_url.type == 'youtube' -%}
          <iframe
            class="vdemo__media"
            data-vdemo-iframe
            data-src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&rel=0"
            src="about:blank"
            title="{{ section.settings.caption | escape }}"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen></iframe>
        {%- elsif section.settings.video_url.type == 'vimeo' -%}
          <iframe
            class="vdemo__media"
            data-vdemo-iframe
            data-src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1"
            src="about:blank"
            title="{{ section.settings.caption | escape }}"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen></iframe>
        {%- endif -%}
      {%- endif -%}

      <button class="vdemo__play" type="button" aria-label="{{ section.settings.play_label | default: 'Play video' | escape }}"{% unless has_video %} disabled{% endunless %}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
      </button>

      {%- if section.settings.caption != blank -%}
        <div class="vdemo__caption">{{ section.settings.caption }}</div>
      {%- endif -%}
      {%- if section.settings.duration != blank -%}
        <div class="vdemo__duration">{{ section.settings.duration }}</div>
      {%- endif -%}
    </div>
   </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('.vdemo-{{ section.id }}');
    if (!root) return;
    var player = root.querySelector('[data-vdemo-player]');
    var btn = root.querySelector('.vdemo__play');
    if (!player || !btn) return;
    var media = player.querySelector('[data-vdemo-media]');
    var iframe = player.querySelector('[data-vdemo-iframe]');

    btn.addEventListener('click', function (e) {
      e.preventDefault();
      player.classList.add('is-playing');
      if (media && media.tagName === 'VIDEO') {
        media.play();
      } else if (iframe) {
        var lazySrc = iframe.getAttribute('data-src');
        if (lazySrc) iframe.setAttribute('src', lazySrc);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "DTF Video Demo",
  "tag": "section",
  "class": "section--dtf-video-demo",
  "settings": [
    { "type": "header", "content": "Header" },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "See it in action"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "15 seconds. That's all it takes."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Preheat, press, peel. The process is fast enough that you'll rethink your entire production flow."
    },
    { "type": "header", "content": "Video" },
    {
      "type": "video",
      "id": "video",
      "label": "Video file",
      "info": "Upload an MP4 directly. Takes precedence over external URL."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "External video URL",
      "accept": ["youtube", "vimeo"],
      "info": "YouTube or Vimeo URL. Used only when no video file is uploaded."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image",
      "info": "Shown before the video plays. Falls back to the uploaded video's auto-thumbnail."
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Placeholder text",
      "info": "Shown when no poster image is set.",
      "default": "Demo thumbnail — press demo clip"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption (bottom-left)",
      "default": "Pressing a DTF transfer on a cotton tee"
    },
    {
      "type": "text",
      "id": "duration",
      "label": "Duration (bottom-right)",
      "default": "0:15"
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "Play button aria-label",
      "default": "Play video"
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "max_width",
      "label": "Panel max width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Panel corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Panel padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Panel padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "outer_padding_top",
      "label": "Section padding top",
      "info": "Space between this section and the one above it.",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "outer_padding_bottom",
      "label": "Section padding bottom",
      "info": "Space between this section and the one below it.",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    { "type": "header", "content": "Colors" },
    {
      "type": "color",
      "id": "outer_bg_color",
      "label": "Outer background",
      "info": "Color around the dark panel. Set to match the section above/below for a seamless look.",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Panel background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "kicker_color",
      "label": "Kicker color",
      "default": "#fde047"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#a3a3a3"
    }
  ],
  "presets": [
    {
      "name": "DTF Video Demo"
    }
  ]
}
{% endschema %}
